<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DefenseClaw.Core</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!--
      10.0.11 is the first release that depends on SQLitePCLRaw 2.1.12. Up to 10.0.10 the bundled native SQLite
      was 3.49.1 (SQLitePCLRaw.lib.e_sqlite3 2.1.11), which carries CVE-2025-6965 / GHSA-2m69-gcr7-jv3q; 2.1.12 ships
      SQLite 3.53.3. Directory.Build.props audits the whole dependency graph, so going back below 10.0.11 fails the restore.
    -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.12" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>

</Project>
