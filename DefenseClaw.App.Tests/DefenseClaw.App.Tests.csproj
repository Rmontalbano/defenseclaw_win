<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DefenseClaw.App.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF0001 guards Application.ThemeMode, which the App references; the App opts out of it too. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF drops these two from the implicit usings (WPF types collide with them); the tests want the BCL ones. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real audit.db DDL (schema and retention triggers only, no data), shared with the Core suite so
         the Audit panel is exercised against the genuine table rather than a hand-copied approximation. -->
    <None Include="..\DefenseClaw.Tests\Fixtures\audit-schema.sql" Link="Fixtures\audit-schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- Synthetic payloads shaped like what the 0.8.10 CLI and gateway print; see TestSupport/PayloadFixtures.cs. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DefenseClaw.App\DefenseClaw.App.csproj" />
  </ItemGroup>

</Project>
