<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DefenseClaw.App.Tests</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- WPF0001 guards Application.ThemeMode, which the App references; the App opts out of it too. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <!-- UseWPF drops these two from the implicit usings (WPF types collide with them); the tests want the BCL ones. -->
    <Using Include="System.IO" />
    <Using Include="System.Net.Http" />
    <!-- The two helpers linked below (TestTimeouts, SqlitePools) keep the Core suite's namespace, so both suites say them the same way. -->
    <Using Include="DefenseClaw.Tests.TestSupport" />
  </ItemGroup>

  <ItemGroup>
    <!-- The real audit.db DDL (schema and retention triggers only, no data), shared with the Core suite so
         the Audit panel is exercised against the genuine table rather than a hand-copied approximation. -->
    <None Include="..\DefenseClaw.Tests\Fixtures\audit-schema.sql" Link="Fixtures\audit-schema.sql" CopyToOutputDirectory="PreserveNewest" />
    <!-- The fixture sets for 0.8.10 and the pinned newer source (runtime detection CUST-291, compatibility CUST-292; docs/RUNTIME-COMPAT-95159fd.md), shared with the Core suite. -->
    <None Include="..\DefenseClaw.Tests\Fixtures\runtime-*\**\*" Link="Fixtures\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The 0.8.10 command tree (every command and option, captured with Click's introspection), for the argv contract of the buttons that run on it. -->
    <None Include="..\DefenseClaw.Tests\Fixtures\cli-tree-0.8.10.json" Link="Fixtures\cli-tree-0.8.10.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Synthetic payloads shaped like what the 0.8.10 CLI and gateway print; see TestSupport/PayloadFixtures.cs. -->
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The one definition of how long a test lets something that happens on its own take (CUST-301); linked rather than copied, so the
         Core suite and this one cannot disagree about the ceiling or about what counts as CI. -->
    <Compile Include="..\DefenseClaw.Tests\TestSupport\TestTimeouts.cs" Link="TestSupport\TestTimeouts.cs" />
    <!-- How a test lets go of its own SQLite files without disposing the connections another test's reader is taking from the pool (CUST-323). -->
    <Compile Include="..\DefenseClaw.Tests\TestSupport\SqlitePools.cs" Link="TestSupport\SqlitePools.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DefenseClaw.App\DefenseClaw.App.csproj" />
  </ItemGroup>

</Project>
