<UserControl x:Class="DefenseClaw.App.Views.Panels.RegistriesPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             xmlns:govern="clr-namespace:DefenseClaw.App.Views.Panels.Govern"
             d:DataContext="{d:DesignInstance Type=vm:RegistriesPanelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!--
        Migrated to the shared design system (Themes\DefenseClaw.xaml). Reads come from
        `registry list` (JSON) plus the selected source's index.json; every change goes through the shared
        review dialog (DiscoverReviewOverlay) that shows the exact command first.

        Layout. At the window's 940 x 620 DIP minimum the page has ~663 x 400 DIP under its header, which is less
        than the toolbar, the banners, the default-deny card and a pair of grids add up to. So the header stays put
        and everything under it is one scrolling page (PageScroll): the default-deny card is an expander (closed:
        one line, with the two switches' state in its header), and the sources + details block gets a definite
        height from the code-behind (the rest of the viewport under the toolbar and banners, never less than
        MinBlockHeight). A ScrollViewer measures its content with unlimited height, and a DataGrid measured that way
        realizes every row, so nothing in the block is star-sized against the scroller - each grid keeps a bounded,
        virtualized viewport of its own. The empty and error cards are ordinary page content: the page scrolls to
        whatever they need.
    -->
    <UserControl.Resources>
        <!-- Cell text: DcCellText - trimmed with an ellipsis, the full value in a tooltip only while it is actually trimmed. -->

        <!--
            The row menus (right-click, or the "..." button; the row is selected first, see ctl:DcRowMenu). Each item does what the
            toolbar's button of the same name does to the selected source / entry: it opens the shared review dialog with the exact
            command first. Nothing here changes anything by itself.
        -->
        <ContextMenu x:Key="SourceRowMenu">
            <MenuItem Header="Sync…"
                      Icon="{ctl:DcSymbolIcon ArrowSync24}"
                      ToolTip="Fetch, scan and promote this source's entries. Shows the command first."
                      Click="OnSyncSource" />
            <MenuItem Header="{Binding ToggleText}"
                      Icon="{ctl:DcSymbolIcon Power24}"
                      ToolTip="Turn this source on or off. Shows the command first."
                      Click="OnToggleSource" />
            <Separator />
            <MenuItem Header="Remove…"
                      Style="{StaticResource DcDangerMenuItem}"
                      Icon="{ctl:DcSymbolIcon Delete24}"
                      ToolTip="Delete this source, the rules it promoted and its cache. Shows the command first."
                      Click="OnRemoveSource" />
        </ContextMenu>

        <ContextMenu x:Key="EntryRowMenu">
            <MenuItem Header="Approve…"
                      Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                      IsEnabled="{Binding CanReview}"
                      ToolTip="Approve this entry and promote it into the allow policy. Shows the command first."
                      Click="OnApproveEntry" />
            <MenuItem Header="Reject…"
                      Style="{StaticResource DcDangerMenuItem}"
                      Icon="{ctl:DcSymbolIcon ShieldDismiss24}"
                      IsEnabled="{Binding CanReview}"
                      ToolTip="Reject this entry so it stays blocked. Shows the command first."
                      Click="OnRejectEntry" />
        </ContextMenu>

        <Style x:Key="SourceRow" TargetType="DataGridRow" BasedOn="{StaticResource DcDataGridRow}">
            <Setter Property="ContextMenu" Value="{StaticResource SourceRowMenu}" />
        </Style>

        <Style x:Key="EntryRow" TargetType="DataGridRow" BasedOn="{StaticResource DcDataGridRow}">
            <Setter Property="ContextMenu" Value="{StaticResource EntryRowMenu}" />
        </Style>

        <!-- The same two reviews for a row of the Entries and Approved tables, whose source is the row's own; plus a way back to that source. -->
        <ContextMenu x:Key="TabEntryRowMenu">
            <MenuItem Header="Approve…"
                      Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                      IsEnabled="{Binding CanReview}"
                      ToolTip="Approve this entry and promote it into the allow policy. Shows the command first."
                      Click="OnApproveListedEntry" />
            <MenuItem Header="Reject…"
                      Style="{StaticResource DcDangerMenuItem}"
                      Icon="{ctl:DcSymbolIcon ShieldDismiss24}"
                      IsEnabled="{Binding CanReview}"
                      ToolTip="Reject this entry so it stays blocked. Shows the command first."
                      Click="OnRejectListedEntry" />
            <Separator />
            <MenuItem Header="Show source"
                      Icon="{ctl:DcSymbolIcon Library24}"
                      ToolTip="Select this entry's source on the Sources tab: its publisher, fetch time and counts."
                      Click="OnShowEntrySource" />
        </ContextMenu>

        <Style x:Key="TabEntryRow" TargetType="DataGridRow" BasedOn="{StaticResource DcDataGridRow}">
            <Setter Property="ContextMenu" Value="{StaticResource TabEntryRowMenu}" />
        </Style>

        <!--
            A second line under an entry, only for one that has something to say: the scan's error (Bad tone) and a findings count badge (tone by
            the worst severity, High when none is given), with what the cache knows about the findings in its tooltip. An entry with neither
            collapses this to nothing. Each part has its own automation name; the row's own name (its ToString) carries the same words.
            Shared by the selected source's entries and the Entries and Approved tables.
        -->
        <DataTemplate x:Key="EntryRowDetails">
            <Grid Margin="10,0,10,8"
                  Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        VerticalAlignment="Top"
                        Style="{StaticResource DcBadge}"
                        Tag="{Binding FindingsKey}"
                        AutomationProperties.Name="{Binding FindingsAutomationName}"
                        AutomationProperties.HelpText="{Binding FindingsToolTip}"
                        Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                    <Border.ToolTip>
                        <TextBlock MaxWidth="420"
                                   TextWrapping="Wrap"
                                   Text="{Binding FindingsToolTip}" />
                    </Border.ToolTip>
                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding FindingsBadgeText}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Style="{StaticResource DcToneText}"
                           Tag="Bad"
                           TextWrapping="Wrap"
                           AutomationProperties.Name="{Binding ErrorAutomationName}"
                           Text="{Binding ErrorText}"
                           Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" />
            </Grid>
        </DataTemplate>

        <!-- One line of a source's facts (Location, Last sync): trimmed, the whole value in a tooltip when it is cut. -->
        <Style x:Key="RegistryFactValue" TargetType="TextBlock" BasedOn="{StaticResource DcFieldValue}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
            <EventSetter Event="ToolTipOpening" Handler="OnCellToolTipOpening" />
        </Style>

        <!-- The state of one default-deny switch, in the collapsed card's header. -->
        <Style x:Key="SkillsRegistryChipText" TargetType="TextBlock" BasedOn="{StaticResource DcBadgeText}">
            <Setter Property="Text" Value="Skills: optional" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SkillsRegistryRequired}" Value="True">
                    <Setter Property="Text" Value="Skills: required" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="McpsRegistryChipText" TargetType="TextBlock" BasedOn="{StaticResource DcBadgeText}">
            <Setter Property="Text" Value="MCP servers: optional" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding McpsRegistryRequired}" Value="True">
                    <Setter Property="Text" Value="MCP servers: required" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the read status, and the actions on the list / the selected source as icons. Each one that changes
             something opens the shared review dialog first. -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="Library24"
                           ctl:DcIcon.Section="Discover"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           Caption="{Binding StatusMessage}">
            <!-- Sources | Entries | Approved, right after the title (the TUI's three sub-tabs, the Mac's segmented picker). The counts are the rows under each. -->
            <ctl:DcPageToolbar.Leading>
                <ctl:DcSegmented x:Name="TabSwitch"
                                 Margin="12,0,0,0"
                                 SelectedValue="{Binding ActiveTab, Mode=TwoWay}"
                                 Visibility="{Binding HasSources, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Registries view"
                                 AutomationProperties.HelpText="Sources lists the registry sources. Entries lists the cached entries of every source. Approved lists the ones that were approved.">
                    <ctl:DcSegment Value="sources"
                                   Content="Sources"
                                   ToolTip="The registry sources, and the selected one's details and cached entries" />
                    <ctl:DcSegment Value="entries"
                                   Content="Entries"
                                   Count="{Binding EntriesCount}"
                                   ToolTip="The cached entries of every source in one table" />
                    <ctl:DcSegment Value="approved"
                                   Content="Approved"
                                   Count="{Binding ApprovedCount}"
                                   ToolTip="The entries of every source that were approved" />
                </ctl:DcSegmented>
            </ctl:DcPageToolbar.Leading>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon Add24}"
                               Command="{Binding OpenAddFormCommand}"
                               IsEnabled="{Binding IsDataTrusted}"
                               Visibility="{Binding IsSourcesTab, Converter={StaticResource BoolToVisibility}}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Add source…'}"
                               AutomationProperties.Name="Add source…"
                               AutomationProperties.HelpText="Register a new registry source. Nothing is fetched until you sync it." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowSync24}"
                               Command="{Binding SyncSelectedCommand}"
                               IsEnabled="{Binding CanChangeSelectedSource}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Sync selected…'}"
                               AutomationProperties.Name="Sync selected…"
                               AutomationProperties.HelpText="Fetch, scan and promote the selected source's entries." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowSyncCircle24}"
                               Command="{Binding SyncAllCommand}"
                               IsEnabled="{Binding CanSyncAll}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Sync all…'}"
                               AutomationProperties.Name="Sync all…"
                               AutomationProperties.HelpText="Fetch, scan and promote entries from every enabled source." />
                    <ui:Button Icon="{ctl:DcSymbolIcon Power24}"
                               Command="{Binding ToggleSelectedEnabledCommand}"
                               IsEnabled="{Binding CanChangeSelectedSource}"
                               Visibility="{Binding IsSourcesTab, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="{Binding ToggleEnabledText}"
                               AutomationProperties.Name="{Binding ToggleEnabledText}"
                               AutomationProperties.HelpText="Turn the selected source on or off." />
                    <ui:Button Icon="{ctl:DcSymbolIcon Delete24}"
                               Command="{Binding RemoveSelectedCommand}"
                               IsEnabled="{Binding CanChangeSelectedSource}"
                               Visibility="{Binding IsSourcesTab, Converter={StaticResource BoolToVisibility}}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Remove…'}"
                               AutomationProperties.Name="Remove…"
                               AutomationProperties.HelpText="Delete the selected source, the rules it promoted and its cache." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Refresh (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5"
                               AutomationProperties.HelpText="Re-read the registry sources (F5)." />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      Style="{StaticResource DcPageScroll}"
                      AutomationProperties.Name="Registries page">
            <StackPanel x:Name="PageContent">
                <!-- Toolbar, banners, policy switches, add form, progress: measured by the code-behind to size the block under them. -->
                <StackPanel x:Name="Chrome">
                    <!-- Banners, policy switches, add form, progress -->
                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                IsClosable="False"
                                IsOpen="{Binding HasActionMessage}"
                                Message="{Binding ActionMessage}"
                                Severity="{Binding ActionSeverity}" />

                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                Title="Could not read registry sources; changes are off until a read succeeds"
                                IsClosable="False"
                                IsOpen="{Binding HasCliError}"
                                Message="{Binding CliErrorMessage}"
                                Severity="Warning" />

                    <!-- An "Open in Registries" link that found no cached entry (CUST-276): said here, so it shows on every tab and with no sources. -->
                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                Title="That entry is not in the registries"
                                IsClosable="False"
                                IsOpen="{Binding HasFocusNote}"
                                Message="{Binding FocusNote}"
                                Severity="Informational" />

                    <!--
                        Default-deny switches (asset_policy.<type>.registry_required). Closed by default - they are set
                        once and then left alone - with each switch's state readable in the header.
                    -->
                    <ui:CardExpander Margin="{StaticResource DcCardGap}"
                                     AutomationProperties.Name="Default-deny for registries"
                                     Visibility="{Binding ShowPolicyCard, Converter={StaticResource BoolToVisibility}}">
                        <ui:CardExpander.Header>
                            <WrapPanel VerticalAlignment="Center">
                                <ctl:DcCardHeader Margin="0,0,4,0" Symbol="ShieldLock24" Section="Govern" Content="Default-deny for registries" />
                                <Border Style="{StaticResource DcChip}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource SkillsRegistryChipText}" />
                                </Border>
                                <Border Style="{StaticResource DcChip}" Margin="8,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource McpsRegistryChipText}" />
                                </Border>
                            </WrapPanel>
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Text="Off by default. When on, a skill or MCP server has to match a rule from a registry to be admitted; anything else falls back to the default action. Turning it on before approving entries blocks everything not already covered." />
                            <WrapPanel Style="{StaticResource DcToolbarPanel}" Margin="0,10,0,0" IsEnabled="{Binding IsDataTrusted}">
                                <TextBlock Style="{StaticResource DcToolbarLabel}" Text="{Binding SkillsRegistryText}" />
                                <ui:Button Content="Require…"
                                           Icon="{ctl:DcSymbolIcon ShieldLock24}"
                                           Command="{Binding SetRegistryRequiredCommand}"
                                           CommandParameter="skill:on"
                                           IsEnabled="{Binding SkillsRegistryOptional}"
                                           AutomationProperties.Name="Require a registry for skills" />
                                <ui:Button Content="Make optional…"
                                           Icon="{ctl:DcSymbolIcon LockOpen24}"
                                           Command="{Binding SetRegistryRequiredCommand}"
                                           CommandParameter="skill:off"
                                           IsEnabled="{Binding SkillsRegistryRequired}"
                                           AutomationProperties.Name="Make the registry optional for skills" />
                            </WrapPanel>
                            <WrapPanel Style="{StaticResource DcToolbarPanel}" IsEnabled="{Binding IsDataTrusted}">
                                <TextBlock Style="{StaticResource DcToolbarLabel}" Text="{Binding McpsRegistryText}" />
                                <ui:Button Content="Require…"
                                           Icon="{ctl:DcSymbolIcon ShieldLock24}"
                                           Command="{Binding SetRegistryRequiredCommand}"
                                           CommandParameter="mcp:on"
                                           IsEnabled="{Binding McpsRegistryOptional}"
                                           AutomationProperties.Name="Require a registry for MCP servers" />
                                <ui:Button Content="Make optional…"
                                           Icon="{ctl:DcSymbolIcon LockOpen24}"
                                           Command="{Binding SetRegistryRequiredCommand}"
                                           CommandParameter="mcp:off"
                                           IsEnabled="{Binding McpsRegistryRequired}"
                                           AutomationProperties.Name="Make the registry optional for MCP servers" />
                            </WrapPanel>
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Add form -->
                    <Border Style="{StaticResource DcCard}"
                            Margin="{StaticResource DcCardGap}"
                            Visibility="{Binding IsAddFormOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ctl:DcCardHeader Symbol="Add24" Section="Discover" Content="Add a registry source" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="{StaticResource DcColumnGap}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Style="{StaticResource DcField}">
                                    <TextBlock Style="{StaticResource DcFieldLabel}" Text="Source id" />
                                    <ui:TextBox PlaceholderText="corp-skills"
                                                AutomationProperties.Name="Source id"
                                                Text="{Binding AddId, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="2" Style="{StaticResource DcField}">
                                    <TextBlock Style="{StaticResource DcFieldLabel}" Text="Kind" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Source kind"
                                              ItemsSource="{Binding AddKindOptions}"
                                              SelectedItem="{Binding AddKind}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Style="{StaticResource DcField}">
                                    <TextBlock Style="{StaticResource DcFieldLabel}" Text="Content" />
                                    <ComboBox HorizontalAlignment="Stretch"
                                              AutomationProperties.Name="Declared content"
                                              ItemsSource="{Binding AddContentOptions}"
                                              SelectedItem="{Binding AddContent}" />
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="2" Style="{StaticResource DcField}">
                                    <TextBlock Style="{StaticResource DcFieldLabel}" Text="Auth environment variable (optional)" />
                                    <ui:TextBox PlaceholderText="CORP_REGISTRY_TOKEN"
                                                AutomationProperties.Name="Auth environment variable name"
                                                AutomationProperties.HelpText="The name of an environment variable that holds a bearer token. Never type the token itself."
                                                Text="{Binding AddAuthEnv, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource DcCaption}"
                                               Margin="0,4,0,0"
                                               Text="The variable's name, not the token. Set the variable yourself (Setup, keys, or your environment)." />
                                </StackPanel>

                                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3" Style="{StaticResource DcField}">
                                    <TextBlock Style="{StaticResource DcFieldLabel}" Text="URL or path" />
                                    <ui:TextBox PlaceholderText="https://catalog.example.com/skills.yaml"
                                                AutomationProperties.Name="Manifest URL or path"
                                                Text="{Binding AddUrl, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Style="{StaticResource DcCaption}"
                                               Margin="0,4,0,0"
                                               Text="{Binding AddUrlHint}" />
                                </StackPanel>
                            </Grid>

                            <WrapPanel Style="{StaticResource DcToolbarPanel}">
                                <CheckBox Content="Enabled" IsChecked="{Binding AddEnabled}" />
                                <CheckBox Content="Sync right after adding"
                                          IsChecked="{Binding AddSyncAfter}"
                                          IsEnabled="{Binding AddEnabled}"
                                          AutomationProperties.HelpText="Runs a second command that fetches and scans the source, only if the add succeeds." />
                            </WrapPanel>

                            <TextBlock Style="{StaticResource DcToneText}"
                                       Tag="Bad"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8"
                                       AutomationProperties.LiveSetting="Assertive"
                                       Text="{Binding AddValidationMessage}"
                                       Visibility="{Binding HasAddValidationMessage, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Style="{StaticResource DcActionBar}" HorizontalAlignment="Right">
                                <ui:Button Content="Cancel" Icon="{ctl:DcSymbolIcon Dismiss24}" Command="{Binding CancelAddFormCommand}" />
                                <ui:Button Appearance="Primary"
                                           Content="Review and add…"
                                           Icon="{ctl:DcSymbolIcon ClipboardCheckmark24}"
                                           Command="{Binding SubmitAddCommand}"
                                           AutomationProperties.HelpText="Shows the exact command before anything runs." />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <ui:ProgressRing Width="28"
                                     Height="28"
                                     HorizontalAlignment="Left"
                                     Margin="{StaticResource DcCardGap}"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Reading registry sources"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>

                <!-- Nothing configured: the normal state on a standalone install. -->
                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowNotConfigured, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Database24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="No registry sources yet" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}"
                                   Text="A registry is a catalog of skills or MCP servers that DefenseClaw can pull on demand: a company HTTPS manifest, smithery.ai, or a git repository with a defenseclaw-registry.yaml. Each synced entry is scanned, and clean ones can be promoted into your allow policy. Registries are optional; skills and MCP servers work without one." />

                        <StackPanel Margin="0,16,0,0" HorizontalAlignment="Center">
                            <TextBlock Style="{StaticResource DcCaption}" Text="1.  Add a source. Nothing is fetched yet." />
                            <TextBlock Style="{StaticResource DcCaption}" Text="2.  Sync it. Its entries are downloaded and scanned." />
                            <TextBlock Style="{StaticResource DcCaption}" Text="3.  Approve or reject entries, or require a registry for skills or MCP servers." />
                        </StackPanel>

                        <ui:Button Appearance="Primary"
                                   HorizontalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Content="Add a registry source…"
                                   Icon="{ctl:DcSymbolIcon Add24}"
                                   Command="{Binding OpenAddFormCommand}" />

                        <StackPanel Margin="0,20,0,0"
                                    Visibility="{Binding HasConfigSection, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcCardTitle}"
                                       Text="config.yaml does have a registries section, though. Raw text:" />
                            <Border Style="{StaticResource DcCodeBlock}" MaxHeight="160">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              panels:NestedScroll.ForwardWheel="True">
                                    <TextBlock Style="{StaticResource DcMono}" Text="{Binding ConfigSectionYaml}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- The read failed: not the same thing as "none configured". -->
                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowUnavailable, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="520">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Warning24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="Registry sources could not be read" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}"
                                   Text="The DefenseClaw command did not answer, so this panel cannot say whether any sources are configured. The reason is in the banner above." />
                        <ui:Button HorizontalAlignment="Center"
                                   Margin="0,16,0,0"
                                   Content="Try again"
                                   Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                                   Command="{Binding RefreshCommand}" />
                    </StackPanel>
                </Border>

                <!--
                    Sources and the selected one's details. Row 0's height is set in code (see UpdateLayoutSizes) so the
                    grids inside always have a definite, bounded height.
                -->
                <Grid x:Name="MasterDetail"
                      Visibility="{Binding ShowSourcesView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MasterRow" Height="420" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.3*" />
                        <ColumnDefinition Width="{StaticResource DcColumnGap}" />
                        <ColumnDefinition Width="1*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DcCardFlush}">
                        <!--
                            Column widths are star weights with a floor (MinWidth) each, resolved to plain widths by the
                            code-behind (ApplyColumnWidths / ColumnSizing): the leading columns - id, enabled, entries - take
                            the whole width when the rest do not fit (they scroll sideways from there; kind, content, last
                            sync and location are all in the details card too), and every column shares it when they all do.
                            The DataGrid's own star sizing is not used because it goes stale when the grid starts empty.

                            Virtualization needs CanContentScroll (WPF-UI's DataGrid style leaves it off, which makes the grid
                            measure - and realize - every row).
                        -->
                        <ui:DataGrid x:Name="SourcesGrid"
                                     Style="{StaticResource DcDataGrid}"
                                     RowStyle="{StaticResource SourceRow}"
                                     SelectionMode="Single"
                                     AutomationProperties.Name="Registry sources"
                                     ItemsSource="{Binding Sources}"
                                     SelectedItem="{Binding SelectedSource}">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn Width="1.3*" MinWidth="88" Header="Id"
                                                    SortMemberPath="Id"
                                                    ElementStyle="{StaticResource DcCellText}"
                                                    Binding="{Binding Id}" />
                                <DataGridTemplateColumn Width="0.9*" MinWidth="92" Header="Enabled"
                                                        SortMemberPath="EnabledDisplay">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ctl:DcStatePill Text="{Binding EnabledDisplay}"
                                                             Tone="{Binding EnabledKey}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="1.6*" MinWidth="88" Header="Entries"
                                                    SortMemberPath="EntriesDisplay"
                                                    ElementStyle="{StaticResource DcCellText}"
                                                    Binding="{Binding EntriesDisplay}" />
                                <DataGridTextColumn Width="0.8*" MinWidth="90" Header="Kind"
                                                    SortMemberPath="KindDisplay"
                                                    ElementStyle="{StaticResource DcCellTextQuiet}"
                                                    Binding="{Binding KindDisplay}" />
                                <DataGridTextColumn Width="0.6*" MinWidth="80" Header="Content"
                                                    SortMemberPath="ContentDisplay"
                                                    ElementStyle="{StaticResource DcCellTextQuiet}"
                                                    Binding="{Binding ContentDisplay}" />
                                <DataGridTextColumn Width="1.0*" MinWidth="120" Header="Last sync"
                                                    SortMemberPath="LastSyncDisplay"
                                                    ElementStyle="{StaticResource DcCellTextQuiet}"
                                                    Binding="{Binding LastSyncDisplay}" />
                                <DataGridTextColumn Width="2.0*" MinWidth="160" Header="Location"
                                                    SortMemberPath="Location"
                                                    ElementStyle="{StaticResource DcCellTextMono}"
                                                    Binding="{Binding Location}" />
                                <DataGridTemplateColumn Width="32" Header="Actions"
                                                        CanUserSort="False"
                                                        HeaderStyle="{StaticResource DcDataGridActionsHeader}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ctl:DcRowMenuButton AutomationProperties.HelpText="Sync, turn on or off, or remove this source." />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DcCardCompact}">
                        <Grid>
                            <TextBlock Style="{StaticResource DcEmptyDetail}"
                                       VerticalAlignment="Center"
                                       Text="Select a source to see its entries and details."
                                       Visibility="{Binding HasNoSelectedSource, Converter={StaticResource BoolToVisibility}}" />

                            <!--
                                The details card is a column of fixed lines around one star row: the entries grid takes whatever
                                is left, so it never depends on an inner scroller to be reachable.
                            -->
                            <Grid Visibility="{Binding HasSelectedSource, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <WrapPanel Grid.Row="0">
                                    <TextBlock Style="{StaticResource DcSectionHeader}"
                                               Margin="0,0,10,4"
                                               VerticalAlignment="Center"
                                               Text="{Binding SelectedSource.Id}" />
                                    <Border Style="{StaticResource DcBadge}"
                                            Margin="{StaticResource DcInlineGap}"
                                            VerticalAlignment="Center"
                                            Tag="{Binding SelectedSource.EnabledKey}">
                                        <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SelectedSource.EnabledDisplay}" />
                                    </Border>
                                    <Border Style="{StaticResource DcChip}"
                                            Margin="{StaticResource DcInlineGap}"
                                            VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SelectedSource.KindDisplay}" />
                                    </Border>
                                    <Border Style="{StaticResource DcChip}"
                                            Margin="{StaticResource DcInlineGap}"
                                            VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SelectedSource.ContentDisplay}" />
                                    </Border>
                                </WrapPanel>

                                <!--
                                    What the sources grid cannot always show: where it comes from, when it was last synced, and - from its cached index
                                    (CUST-276; the TUI's source detail) - who publishes it, when the manifest was fetched, and how the last sync judged
                                    its entries. The counts are always the four verdicts, a zero in the quiet tone; a source with no index shows none.
                                -->
                                <Grid Grid.Row="1" Margin="0,2,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,2" Style="{StaticResource DcFieldLabel}" Text="Location" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,2" Style="{StaticResource RegistryFactValue}"
                                               Text="{Binding SelectedSource.Location, TargetNullValue=—}" />
                                    <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,2" Style="{StaticResource DcFieldLabel}" Text="Last sync" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,2" Style="{StaticResource RegistryFactValue}"
                                               Text="{Binding SelectedSource.LastSyncDisplay}" />
                                    <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,2" Style="{StaticResource DcFieldLabel}" Text="Publisher" />
                                    <TextBlock x:Name="PublisherValue" Grid.Row="2" Grid.Column="1" Margin="0,0,0,2" Style="{StaticResource RegistryFactValue}"
                                               Text="{Binding SourceFacts.Publisher}" />
                                    <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,2" Style="{StaticResource DcFieldLabel}" Text="Fetched at" />
                                    <TextBlock x:Name="FetchedAtValue" Grid.Row="3" Grid.Column="1" Margin="0,0,0,2" Style="{StaticResource RegistryFactValue}"
                                               Text="{Binding SourceFacts.FetchedAt}" />
                                    <WrapPanel x:Name="CountChips"
                                               Grid.Row="4"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="2"
                                               Margin="0,4,0,0"
                                               Visibility="{Binding SourceFacts.HasCounts, Converter={StaticResource BoolToVisibility}}">
                                        <Border Style="{StaticResource DcChip}" Margin="0,0,6,4">
                                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SourceFacts.EntriesText}" />
                                        </Border>
                                        <Border Style="{StaticResource DcBadge}" Margin="0,0,6,4" Tag="{Binding SourceFacts.CleanTone}">
                                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SourceFacts.CleanText}" />
                                        </Border>
                                        <Border Style="{StaticResource DcBadge}" Margin="0,0,6,4" Tag="{Binding SourceFacts.WarningTone}">
                                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SourceFacts.WarningText}" />
                                        </Border>
                                        <Border Style="{StaticResource DcBadge}" Margin="0,0,6,4" Tag="{Binding SourceFacts.BlockedTone}">
                                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SourceFacts.BlockedText}" />
                                        </Border>
                                        <Border Style="{StaticResource DcBadge}" Margin="0,0,6,4" Tag="{Binding SourceFacts.ErrorTone}">
                                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SourceFacts.ErrorText}" />
                                        </Border>
                                    </WrapPanel>
                                </Grid>

                                <Grid Grid.Row="2" Margin="0,12,0,4">
                                    <ctl:DcCardHeader Margin="0" Symbol="Database24" Section="Discover" Content="Cached entries" />
                                    <ui:ProgressRing Width="20"
                                                     Height="20"
                                                     HorizontalAlignment="Right"
                                                     IsIndeterminate="True"
                                                     AutomationProperties.Name="Reading cached entries"
                                                     Visibility="{Binding IsEntriesLoading, Converter={StaticResource BoolToVisibility}}" />
                                </Grid>
                                <!-- Only says something when the entries could not be read or there are none; takes no room otherwise. -->
                                <TextBlock Grid.Row="3"
                                           Margin="0,0,0,8"
                                           Text="{Binding EntriesMessage}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <ui:DataGrid Grid.Row="4"
                                             Style="{StaticResource DcDataGrid}"
                                             RowStyle="{StaticResource EntryRow}"
                                             RowDetailsTemplate="{StaticResource EntryRowDetails}"
                                             MinHeight="100"
                                             SelectionMode="Single"
                                             RowDetailsVisibilityMode="Visible"
                                             AreRowDetailsFrozen="True"
                                             panels:NestedScroll.ForwardWheel="True"
                                             AutomationProperties.Name="Cached entries of the selected source"
                                             ItemsSource="{Binding Entries}"
                                             SelectedItem="{Binding SelectedEntry}">
                                    <ui:DataGrid.Columns>
                                        <DataGridTextColumn Width="*" MinWidth="64" Header="Name"
                                                            SortMemberPath="Name"
                                                            ElementStyle="{StaticResource DcCellText}"
                                                            Binding="{Binding Name}" />
                                        <DataGridTextColumn Width="52" Header="Type"
                                                            SortMemberPath="TypeDisplay"
                                                            ElementStyle="{StaticResource DcCellTextQuiet}"
                                                            Binding="{Binding TypeDisplay}" />
                                        <DataGridTemplateColumn Width="80" Header="Status"
                                                                SortMemberPath="StatusDisplay">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ctl:DcStatusLabel Text="{Binding StatusDisplay}" Tone="{Binding StatusKey}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="88" Header="Review"
                                                                SortMemberPath="ReviewDisplay">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ctl:DcStatusLabel Text="{Binding ReviewDisplay}" Tone="{Binding ReviewKey}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Width="30" Header="Actions"
                                                                CanUserSort="False"
                                                                HeaderStyle="{StaticResource DcDataGridActionsHeader}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ctl:DcRowMenuButton AutomationProperties.HelpText="Approve or reject this entry." />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </ui:DataGrid.Columns>
                                </ui:DataGrid>

                                <StackPanel Grid.Row="5" Style="{StaticResource DcActionBar}" Margin="0,8,0,0">
                                    <ui:Button Content="Approve…"
                                               Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                                               Command="{Binding ApproveEntryCommand}"
                                               IsEnabled="{Binding CanReviewEntry}"
                                               AutomationProperties.HelpText="Approve the selected entry and promote it into the allow policy." />
                                    <ui:Button Content="Reject…"
                                               Icon="{ctl:DcSymbolIcon ShieldDismiss24}"
                                               Command="{Binding RejectEntryCommand}"
                                               IsEnabled="{Binding CanReviewEntry}"
                                               AutomationProperties.HelpText="Reject the selected entry so it stays blocked." />
                                </StackPanel>

                                <!-- Closed by default: the raw key/value pairs are for chasing an odd source, not for every visit. -->
                                <Expander x:Name="RawFields"
                                          Grid.Row="6"
                                          Margin="0,8,0,0"
                                          AutomationProperties.Name="Raw fields of the selected source">
                                    <Expander.Header>
                                        <ctl:DcCardHeader Margin="0" Symbol="Code24" Section="Discover" Content="Raw fields" />
                                    </Expander.Header>
                                    <ScrollViewer
                                                  MaxHeight="150"
                                                  Margin="0,8,0,0"
                                                  VerticalScrollBarVisibility="Auto"
                                                  panels:NestedScroll.ForwardWheel="True">
                                        <ItemsControl ItemsSource="{Binding SelectedSource.Fields}"
                                                      Focusable="False"
                                                      AutomationProperties.Name="Raw fields of the selected source">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Style="{StaticResource DcField}">
                                                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="{Binding Key}" />
                                                        <TextBlock Style="{StaticResource DcFieldValueMono}" Text="{Binding Value}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Expander>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!--
                    The Entries and Approved tabs (CUST-276): the cached entries of every source in one table, the TUI's _entry_rows. Approved is the same
                    table with the approved ones only. Like the sources block, the card gets a definite height from the code-behind (UpdateLayoutSizes), so
                    the grid in it is bounded and virtualized inside the scrolling page. Over the grid: the strip of an "Open in Registries" link (the
                    table is narrowed to one entry until the strip's button or Esc ends it) and a warning for a source whose cache could not be read.
                -->
                <Grid x:Name="EntriesBlock"
                      Visibility="{Binding ShowEntriesView, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="EntriesRow" Height="420" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource DcCardFlush}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid x:Name="FocusStrip"
                                  Grid.Row="0"
                                  Margin="12,8,12,4"
                                  Visibility="{Binding HasEntryFocus, Converter={StaticResource BoolToVisibility}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource DcCaption}"
                                           TextWrapping="Wrap"
                                           Text="{Binding EntryFocusText}" />
                                <ui:Button Grid.Column="1"
                                           Margin="12,0,0,0"
                                           Content="Show all entries"
                                           Icon="{ctl:DcSymbolIcon FilterDismiss24}"
                                           Command="{Binding ClearEntryFocusCommand}"
                                           AutomationProperties.HelpText="Ends the narrowing to this one entry and lists every entry again (Esc)." />
                            </Grid>

                            <TextBlock x:Name="EntriesWarning"
                                       Grid.Row="1"
                                       Margin="12,4,12,4"
                                       Style="{StaticResource DcToneText}"
                                       Tag="Warn"
                                       TextWrapping="Wrap"
                                       Text="{Binding EntriesNote}"
                                       Visibility="{Binding HasEntriesNote, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.LiveSetting="Polite" />

                            <ui:DataGrid x:Name="TabGrid"
                                         Grid.Row="2"
                                         Style="{StaticResource DcDataGrid}"
                                         RowStyle="{StaticResource TabEntryRow}"
                                         RowDetailsTemplate="{StaticResource EntryRowDetails}"
                                         MinHeight="100"
                                         SelectionMode="Single"
                                         RowDetailsVisibilityMode="Visible"
                                         AreRowDetailsFrozen="True"
                                         VirtualizingPanel.ScrollUnit="Pixel"
                                         ctl:DcGridColumns.Fit="True"
                                         panels:NestedScroll.ForwardWheel="True"
                                         AutomationProperties.Name="Registry entries"
                                         ItemsSource="{Binding TabEntries}"
                                         SelectedItem="{Binding SelectedTabEntry}"
                                         Visibility="{Binding HasTabEntries, Converter={StaticResource BoolToVisibility}}">
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn Width="1.1*" MinWidth="96" Header="Source"
                                                        SortMemberPath="SourceDisplay"
                                                        ElementStyle="{StaticResource DcCellTextQuiet}"
                                                        Binding="{Binding SourceDisplay}" />
                                    <DataGridTextColumn Width="1.5*" MinWidth="90" Header="Name"
                                                        SortMemberPath="Name"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding Name}" />
                                    <DataGridTextColumn Width="52" Header="Type"
                                                        SortMemberPath="TypeDisplay"
                                                        ElementStyle="{StaticResource DcCellTextQuiet}"
                                                        Binding="{Binding TypeDisplay}" />
                                    <DataGridTemplateColumn Width="80" Header="Status"
                                                            SortMemberPath="StatusDisplay">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ctl:DcStatusLabel Text="{Binding StatusDisplay}" Tone="{Binding StatusKey}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="0.7*" MinWidth="64" Header="Severity"
                                                        SortMemberPath="SeverityDisplay"
                                                        ElementStyle="{StaticResource DcCellTextQuiet}"
                                                        Binding="{Binding SeverityDisplay}" />
                                    <DataGridTemplateColumn Width="84" Header="Review"
                                                            SortMemberPath="ReviewDisplay">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ctl:DcStatusLabel Text="{Binding ReviewDisplay}" Tone="{Binding ReviewKey}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Width="2*" MinWidth="80" Header="Location"
                                                        SortMemberPath="LocationDisplay"
                                                        ElementStyle="{StaticResource DcCellTextMono}"
                                                        Binding="{Binding LocationDisplay}" />
                                    <DataGridTemplateColumn Width="30" Header="Actions"
                                                            CanUserSort="False"
                                                            HeaderStyle="{StaticResource DcDataGridActionsHeader}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ctl:DcRowMenuButton AutomationProperties.HelpText="Approve or reject this entry, or show its source." />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>

                            <!-- Nothing to list: the TUI's sentence for the tab. -->
                            <StackPanel x:Name="TabEmpty"
                                        Grid.Row="2"
                                        Style="{StaticResource DcEmptyState}"
                                        MaxWidth="460"
                                        Visibility="{Binding ShowTabEmpty, Converter={StaticResource BoolToVisibility}}">
                                <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Database24" />
                                <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyEntriesText}" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Style="{StaticResource DcActionBar}" Margin="12,8,12,10">
                                <ui:Button Content="Approve…"
                                           Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                                           Command="{Binding ApproveListedEntryCommand}"
                                           IsEnabled="{Binding CanReviewTabEntry}"
                                           AutomationProperties.HelpText="Approve the selected entry and promote it into the allow policy." />
                                <ui:Button Content="Reject…"
                                           Icon="{ctl:DcSymbolIcon ShieldDismiss24}"
                                           Command="{Binding RejectListedEntryCommand}"
                                           IsEnabled="{Binding CanReviewTabEntry}"
                                           AutomationProperties.HelpText="Reject the selected entry so it stays blocked." />
                                <ui:Button Content="Show source"
                                           Icon="{ctl:DcSymbolIcon Library24}"
                                           Command="{Binding ShowEntrySourceCommand}"
                                           IsEnabled="{Binding HasSelectedTabEntry}"
                                           AutomationProperties.HelpText="Select the entry's source on the Sources tab: its publisher, fetch time and counts." />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Confirm-and-run dialog (collapsed until a change is requested) -->
        <panels:DiscoverReviewOverlay Grid.RowSpan="2" DataContext="{Binding Review}" />
    </Grid>
</UserControl>
