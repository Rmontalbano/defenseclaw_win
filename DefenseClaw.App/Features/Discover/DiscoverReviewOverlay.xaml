<UserControl x:Class="DefenseClaw.App.Views.Panels.DiscoverReviewOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:shell="clr-namespace:DefenseClaw.App.Views.Shell"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DiscoverActionReview}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False"
             Focusable="False">
    <!--
        The confirm-and-run dialog shared by the three Discover panels. DataContext is a
        DiscoverActionReview (the panel binds it: DataContext="{Binding Review}"). It sits on top of
        the panel's content (Grid.RowSpan) and is collapsed until IsOpen. Tab is confined to the
        dialog while it is up.

        The review itself (tier, exact argv per step, warnings, Cancel / Run / Close, focus, Esc, Copy)
        is the shared CommandReviewControl; this file only frames it and adds the run's progress and result.
    -->
    <Grid x:Name="Scrim"
          Style="{StaticResource DcScrim}"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Style="{StaticResource DcDialogCard}" MaxHeight="640">
            <shell:CommandReviewControl Review="{Binding CommandReview}"
                                        Phase="{Binding Phase}"
                                        ConfirmCommand="{Binding ConfirmCommand}"
                                        CancelCommand="{Binding DismissCommand}">
                <shell:CommandReviewControl.ExtraContent>
                    <StackPanel>
                        <!--
                            A change that reduces protection asks for this tick before the confirm button works (DiscoverActionReview.Open's
                            acknowledgement). Hidden for every other review; gone once the commands run.
                        -->
                        <CheckBox Margin="0,4,0,10"
                                  IsChecked="{Binding IsAcknowledged, Mode=TwoWay}"
                                  AutomationProperties.Name="Acknowledge before running"
                                  Visibility="{Binding ShowAcknowledgement, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock TextWrapping="Wrap" Text="{Binding AcknowledgementText}" />
                        </CheckBox>

                        <ui:ProgressRing Width="24"
                                         Height="24"
                                         HorizontalAlignment="Left"
                                         Margin="0,4,0,8"
                                         IsIndeterminate="True"
                                         AutomationProperties.Name="Running the command"
                                         Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Result, after the run -->
                        <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"
                                    AutomationProperties.LiveSetting="Polite">
                            <Border Style="{StaticResource DcBadge}"
                                    Tag="{Binding ResultKey}"
                                    HorizontalAlignment="Left"
                                    Margin="0,0,0,6">
                                <TextBlock Style="{StaticResource DcBadgeText}"
                                           TextWrapping="Wrap"
                                           Text="{Binding ResultText}" />
                            </Border>
                            <ctl:DcCommandOutput MaxHeight="200"
                                                 OutputName="Command output"
                                                 Visibility="{Binding HasResultOutput, Converter={StaticResource BoolToVisibility}}"
                                                 Text="{Binding ResultOutput, Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </shell:CommandReviewControl.ExtraContent>
            </shell:CommandReviewControl>
        </Border>
    </Grid>
</UserControl>
