<UserControl x:Class="DefenseClaw.App.Views.Wizards.ModelPickerBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             IsTabStop="False">
    <!--
        The searchable model box of a model field. The text box IS the answer; the list only fills it in. The list sits in the page (not in a
        popup) so it is part of the layout a screen reader and the page's scroll see, and is a real ListBox of real items.

        Keyboard, in the text box, as in the TUI's picker: Down/Up move the highlighted row, Enter takes it, Esc closes the list (and only then
        the wizard on the next Esc). The first row is the text typed so far ("use as typed") unless it already is a model, so Enter always has
        something to take. The rows cannot take focus, so clicking one never moves the focus out of the box and closes the list before it is read.
    -->
    <StackPanel>
        <ui:TextBox x:Name="Input"
                    Width="420"
                    HorizontalAlignment="Left"
                    PlaceholderText="Type to search the models, or enter any model id"
                    Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                    AutomationProperties.Name="{Binding ModelPickerAutomationName}"
                    AutomationProperties.HelpText="{Binding ModelListNote}"
                    GotKeyboardFocus="OnInputGotFocus"
                    LostKeyboardFocus="OnInputLostFocus"
                    PreviewKeyDown="OnInputKeyDown"
                    TextChanged="OnInputTextChanged" />

        <Border x:Name="ListHost"
                Width="420"
                Margin="0,4,0,0"
                HorizontalAlignment="Left"
                Style="{StaticResource DcCardFlush}"
                Visibility="{Binding IsModelListOpen, Converter={StaticResource BoolToVisibility}}">
            <ListBox x:Name="Rows"
                     MaxHeight="216"
                     Focusable="False"
                     IsTabStop="False"
                     ItemsSource="{Binding ModelRows}"
                     SelectedItem="{Binding SelectedModelRow, Mode=TwoWay}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     AutomationProperties.Name="{Binding ModelListAutomationName}">
                <ListBox.ItemContainerStyle>
                    <!-- The palette's quiet highlight: a fill and a 3 px accent bar, so the row keeps its text colours. -->
                    <Style TargetType="ListBoxItem">
                        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Padding" Value="10,5,10,5" />
                        <Setter Property="Margin" Value="0,0,0,2" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Row"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="{DynamicResource DcRadiusS}"
                                            SnapsToDevicePixels="True">
                                        <Grid>
                                            <Border x:Name="Bar"
                                                    Width="3"
                                                    Margin="-8,2,0,2"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="{DynamicResource DcBarRadius}"
                                                    Background="{DynamicResource DcAccentBrush}"
                                                    Visibility="Collapsed" />
                                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DcSubtleBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Row" Property="Background" Value="{DynamicResource DcSelectedBrush}" />
                                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                        <EventSetter Event="PreviewMouseLeftButtonUp" Handler="OnRowMouseUp" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center"
                                       Style="{StaticResource DcMono}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Text="{Binding Label}" />
                            <Border Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DcChip}"
                                    Visibility="{Binding IsTyped, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Style="{StaticResource DcBadgeText}" Text="not in the catalogue" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Where the list comes from and how many it holds; the live region lets a screen reader hear it change as the operator types. -->
        <TextBlock Margin="0,4,0,0"
                   MaxWidth="720"
                   HorizontalAlignment="Left"
                   Style="{StaticResource DcCaption}"
                   AutomationProperties.LiveSetting="Polite"
                   Text="{Binding ModelListNote}" />
    </StackPanel>
</UserControl>
