<UserControl x:Class="DefenseClaw.App.Views.Panels.RuntimeMonitoringDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:RuntimeMonitoringViewModel}"
             mc:Ignorable="d"
             IsTabStop="False"
             Focusable="False">
    <!--
        Runtime monitoring (CUST-348): the Setup hub's card for AI Discovery's runtime planes (DefenseClaw 1.0). State first - what config.yaml says, what the
        gateway runs, what each plane needs - then three switches (monitoring, plane C, DNS capture) whose change is one reviewed
        `agent discovery runtime enable|disable` command, shown in the shared DiscoverReviewOverlay at the bottom. DataContext is a RuntimeMonitoringViewModel
        (the Setup panel binds it: DataContext="{Binding Monitoring}"). The scrim is collapsed until IsOpen; Tab is confined to the dialog while it is up.
    -->
    <UserControl.Resources>
        <!-- One line of a plane's requirements: a word and a tone as well as the sentence, so state is never colour alone. -->
        <DataTemplate x:Key="RequirementTemplate" DataType="{x:Type vm:RequirementView}">
            <Grid Margin="0,0,0,4" Opacity="1" AutomationProperties.Name="{Binding AutomationName}">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsGreyed}" Value="True">
                                <Setter Property="Opacity" Value="0.55" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="116" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0"
                        Style="{StaticResource DcBadge}"
                        Tag="{Binding Tone}"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Top">
                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding Label}" />
                </Border>
                <TextBlock Grid.Column="1"
                           Style="{StaticResource DcCaption}"
                           TextWrapping="Wrap"
                           Text="{Binding Text}" />
            </Grid>
        </DataTemplate>

        <!-- One plane: name and run state, config's word, the gateway's word, what it records, what it needs, its privacy note. -->
        <DataTemplate x:Key="PlaneTemplate" DataType="{x:Type vm:PlaneView}">
            <Border Style="{StaticResource DcSubtleRow}" Margin="0,0,0,10" AutomationProperties.Name="{Binding AutomationName}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DcBody}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="{Binding Name}" />
                        <Border Style="{StaticResource DcBadge}"
                                Tag="{Binding RunTone}"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding RunLabel}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,4,0,0" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="In config.yaml: " /><Run Text="{Binding ConfigText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,2,0,6" TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="On the gateway: " /><Run Text="{Binding RunText, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,0,0,2" FontWeight="SemiBold" Text="What it records" />
                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,0,0,6" TextWrapping="Wrap" Text="{Binding Records}" />
                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,0,0,4" FontWeight="SemiBold" Text="What it needs on this PC" />
                    <ItemsControl ItemsSource="{Binding Requirements}"
                                  ItemTemplate="{StaticResource RequirementTemplate}"
                                  IsTabStop="False"
                                  AutomationProperties.Name="Requirements" />
                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,4,0,2" FontWeight="SemiBold" Text="Privacy" />
                    <TextBlock Style="{StaticResource DcCaption}" TextWrapping="Wrap" Text="{Binding Privacy}" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="Scrim"
              Style="{StaticResource DcScrim}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource DcDialogCard}"
                    MaxWidth="760"
                    MaxHeight="800"
                    Margin="24"
                    AutomationProperties.Name="Runtime monitoring">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcSectionHeader}"
                                       AutomationProperties.HeadingLevel="Level1"
                                       Text="{Binding Title}" />
                            <ui:ProgressRing Width="16"
                                             Height="16"
                                             Margin="10,0,0,0"
                                             IsIndeterminate="True"
                                             AutomationProperties.Name="Checking this DefenseClaw's options"
                                             Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource DcBody}" Text="{Binding Subtitle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="0,0,8,0">
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Warning"
                                        Title="State-changing actions disabled"
                                        IsOpen="{Binding HasInstallationBlock, Mode=OneWay}"
                                        Message="{Binding InstallationBlockedReason, Mode=OneWay}" />
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Informational"
                                        Title="Needs DefenseClaw 1.0"
                                        IsOpen="{Binding HasSupportProblem, Mode=OneWay}"
                                        Message="{Binding Support, Mode=OneWay}" />
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Error"
                                        Title="config.yaml could not be read"
                                        IsOpen="{Binding HasConfigProblem, Mode=OneWay}"
                                        Message="{Binding ConfigProblem, Mode=OneWay}" />
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Warning"
                                        Title="This state may be out of date"
                                        IsOpen="{Binding IsStale, Mode=OneWay}"
                                        Message="{Binding StaleReason, Mode=OneWay}" />
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Warning"
                                        Title="This DefenseClaw's options could not be checked"
                                        IsOpen="{Binding HasHelpProblem, Mode=OneWay}"
                                        Message="{Binding HelpProblem, Mode=OneWay}" />

                            <TextBlock Style="{StaticResource DcCaption}" Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding Scope}" />

                            <!-- State: the headline, the file's side and the gateway's side. -->
                            <Border Style="{StaticResource DcSubtleRow}" Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource DcBody}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               AutomationProperties.LiveSetting="Polite"
                                               Text="{Binding Headline}" />
                                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding ConfigLine}" />
                                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,2,0,0" TextWrapping="Wrap" Text="{Binding GatewayLine}" />
                                    <TextBlock Style="{StaticResource DcCaption}"
                                               Margin="0,2,0,0"
                                               TextWrapping="Wrap"
                                               FontWeight="SemiBold"
                                               Text="{Binding ApplyNote}"
                                               Visibility="{Binding HasApplyNote, Converter={StaticResource BoolToVisibility}}" />
                                </StackPanel>
                            </Border>

                            <!-- The planes -->
                            <ctl:DcCardHeader Margin="0,0,0,8"
                                              AutomationProperties.HeadingLevel="Level2"
                                              Symbol="Pulse24"
                                              Section="Setup"
                                              Content="Planes" />
                            <ItemsControl ItemsSource="{Binding Planes}"
                                          ItemTemplate="{StaticResource PlaneTemplate}"
                                          IsTabStop="False"
                                          AutomationProperties.Name="The three runtime planes" />
                            <TextBlock Style="{StaticResource DcCaption}" Margin="0,0,0,12" TextWrapping="Wrap" Text="{Binding PlanesNote}" />

                            <!-- The switches -->
                            <ctl:DcCardHeader Margin="0,0,0,8"
                                              AutomationProperties.HeadingLevel="Level2"
                                              Symbol="Power24"
                                              Section="Setup"
                                              Content="Change" />
                            <Grid Margin="0,0,0,10" IsEnabled="{Binding CanEdit}" ToolTip="{Binding SwitchTip}" ToolTipService.ShowOnDisabled="True">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource DcBody}" FontWeight="SemiBold" Text="{Binding MonitoringText}" AutomationProperties.LiveSetting="Polite" />
                                    <TextBlock Style="{StaticResource DcCaption}" TextWrapping="Wrap" Text="Starts planes A and B (process and network), and stops every plane when off." />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 IsChecked="{Binding MonitoringOn, Mode=TwoWay}"
                                                 IsEnabled="{Binding IsSupported}"
                                                 AutomationProperties.Name="Runtime monitoring" />
                            </Grid>
                            <Grid Margin="0,0,0,10" IsEnabled="{Binding CanEditPlaneSwitches}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource DcBody}" FontWeight="SemiBold" Text="Plane C: agent actions" />
                                    <TextBlock Style="{StaticResource DcCaption}" TextWrapping="Wrap" Text="{Binding HostPlaneNote}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 IsChecked="{Binding HostPlaneOn, Mode=TwoWay}"
                                                 IsEnabled="{Binding HostPlaneAvailable}"
                                                 AutomationProperties.Name="Plane C: agent actions" />
                            </Grid>
                            <Grid Margin="0,0,0,10" IsEnabled="{Binding CanEditPlaneSwitches}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                    <TextBlock Style="{StaticResource DcBody}" FontWeight="SemiBold" Text="DNS capture (plane B)" />
                                    <TextBlock Style="{StaticResource DcCaption}" TextWrapping="Wrap" Text="{Binding DnsNote}" />
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1"
                                                 VerticalAlignment="Center"
                                                 IsChecked="{Binding DnsCaptureOn, Mode=TwoWay}"
                                                 IsEnabled="{Binding DnsAvailable}"
                                                 AutomationProperties.Name="DNS capture" />
                            </Grid>

                            <CheckBox Margin="0,4,0,2"
                                      Content="Restart the gateway after the change"
                                      IsEnabled="{Binding CanChooseRestart}"
                                      IsChecked="{Binding RestartAfter, Mode=TwoWay}"
                                      AutomationProperties.HelpText="Unchecking adds --no-restart to the command" />
                            <TextBlock Style="{StaticResource DcCaption}" Margin="28,0,0,10" TextWrapping="Wrap" Text="{Binding RestartNote}" />

                            <Border Style="{StaticResource DcSubtleRow}"
                                    Margin="0,4,0,0"
                                    AutomationProperties.LiveSetting="Polite"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource DcBadge}" Tag="{Binding ResultKey}" HorizontalAlignment="Left">
                                        <TextBlock Style="{StaticResource DcBadgeText}" TextWrapping="Wrap" Text="{Binding ResultText}" />
                                    </Border>
                                    <ui:Button Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Top"
                                               Content="Dismiss"
                                               Command="{Binding DismissResultCommand}"
                                               AutomationProperties.Name="Dismiss the result" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource DcCardTitle}" AutomationProperties.LiveSetting="Polite" Text="{Binding Summary}" />
                        <ItemsControl ItemsSource="{Binding ChangeLines}" IsTabStop="False" AutomationProperties.Name="Changes to apply">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource DcCaption}" Margin="8,0,0,0" TextWrapping="Wrap" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="Refresh"
                                       Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                                       Command="{Binding RefreshCommand}"
                                       ToolTip="Reads config.yaml and this DefenseClaw's options again and starts the switches from what the file says."
                                       AutomationProperties.Name="Read config.yaml again" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Margin="0,0,8,0"
                                           Content="Close"
                                           Command="{Binding CloseCommand}"
                                           ToolTip="Esc"
                                           AutomationProperties.Name="Close the runtime monitoring dialog" />
                                <ui:Button Appearance="Primary"
                                           Content="Review changes…"
                                           Icon="{ctl:DcSymbolIcon Play24}"
                                           Command="{Binding ReviewChangesCommand}"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTip="{Binding ReviewTip}"
                                           AutomationProperties.HelpText="{Binding ReviewTip}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <panels:DiscoverReviewOverlay DataContext="{Binding Review}" />
    </Grid>
</UserControl>
