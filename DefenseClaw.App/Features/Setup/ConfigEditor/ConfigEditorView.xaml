<UserControl x:Class="DefenseClaw.App.Views.ConfigEditor.ConfigEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
             xmlns:vmc="clr-namespace:DefenseClaw.App.ViewModels.ConfigEditor"
             xmlns:vc="clr-namespace:DefenseClaw.App.Views.ConfigEditor"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             AutomationProperties.Name="Config editor">
    <!--
        The config.yaml editor (CUST-385), shown twice over ONE draft: inline at the foot of the Setup panel (the Mac's Setup page puts its editor
        under the area grid) and in the detached ConfigEditorWindow. Both bind to the same ConfigEditorWindowViewModel (ConfigEditorSession), so
        an edit in one is the edit in the other. The Mac's order, top to bottom: the setting search; where the sections come from and Reload; the
        section list beside the typed form; Revert and the reviewed Save. RAW (AvalonEdit, wired in code-behind: TextEditor.Text is not bindable)
        stays one tab away.

        FORM is built from the CLI's source view of the file (defenseclaw config show, source flag) - a MASKED view of config.yaml.
        Secret and masked fields are read-only here (templates below show a "Masked" chip and the
        reason); the view-model refuses to write a masked value back a second time.

        Keyboard (code-behind): Ctrl+S saves when Save is enabled (a focused FORM box is committed first), Ctrl+F goes to the setting search
        (to AvalonEdit's own search inside RAW), Esc leaves a review, closes the on-disk preview or clears the search.

        Every style is a shared Dc* key (DesignSystem\Themes\DefenseClaw.xaml); nothing here hard-codes a colour.
    -->
    <UserControl.Resources>
        <vc:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <vc:StringHasValueConverter x:Key="StringHasValue" />

        <!-- ============================ Field templates ============================ -->
        <!--
            Shape shared by every scalar row: label column (name + optional read-only reason, visible text
            rather than a tooltip so it is reachable by keyboard and screen reader) and a control column.
            The TUI's hint, then the dotted config path, is the tooltip and the UIA help text.
        -->

        <!--
            What a field's own check says (an error, or a warning), under its label. The severity is a word as well as a tone and a
            glyph, so colour is never the only carrier; the line is a polite live region so a screen reader reads it when it appears.
            Declared before the templates that use it: StaticResource in deferred template content needs the key registered already.
        -->
        <DataTemplate x:Key="FieldValidationTemplate" DataType="{x:Type vmc:FormField}">
            <StackPanel Margin="0,2,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowValidation, Converter={StaticResource BoolToVisibility}}">
                <ctl:DcStatusGlyph Margin="0,0,6,0"
                                   VerticalAlignment="Top"
                                   DotSize="8"
                                   GlyphSize="12"
                                   SlotHeight="16"
                                   Tone="{Binding ValidationTone}" />
                <TextBlock AutomationProperties.LiveSetting="Polite"
                           FontSize="12"
                           FontWeight="Normal"
                           Style="{StaticResource DcToneText}"
                           Tag="{Binding ValidationTone}"
                           Text="{Binding ValidationText}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="BoolFieldTemplate" DataType="{x:Type vmc:FormField}">
            <Grid Margin="{StaticResource DcFieldGap}" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DcBody}" Text="{Binding DisplayName}" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Text="{Binding DisabledReason}"
                               Visibility="{Binding ShowReadOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldValidationTemplate}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 AutomationProperties.HelpText="{Binding HelpText}"
                                 AutomationProperties.Name="{Binding DisplayName}"
                                 IsChecked="{Binding BoolValue, Mode=TwoWay}"
                                 IsEnabled="{Binding IsEditable}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="IntFieldTemplate" DataType="{x:Type vmc:FormField}">
            <Grid Margin="{StaticResource DcFieldGap}" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="150" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DcBody}" Text="{Binding DisplayName}" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Text="{Binding DisabledReason}"
                               Visibility="{Binding ShowReadOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldValidationTemplate}" />
                </StackPanel>
                <ui:NumberBox Grid.Column="1"
                              AutomationProperties.HelpText="{Binding HelpText}"
                              AutomationProperties.Name="{Binding DisplayName}"
                              IsEnabled="{Binding IsEditable}"
                              Value="{Binding NumberValue, Mode=TwoWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="StringFieldTemplate" DataType="{x:Type vmc:FormField}">
            <Grid Margin="{StaticResource DcFieldGap}" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource DcBody}"
                                   Text="{Binding DisplayName}" />
                        <Border Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DcChip}"
                                Visibility="{Binding IsMasked, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="MASKED" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DcCaption}"
                               Text="{Binding DisabledReason}"
                               Visibility="{Binding ShowReadOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldValidationTemplate}" />
                </StackPanel>
                <ui:TextBox Grid.Column="1"
                            AutomationProperties.HelpText="{Binding HelpText}"
                            AutomationProperties.Name="{Binding DisplayName}"
                            IsEnabled="{Binding IsEditable}"
                            Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="EnvNameFieldTemplate" DataType="{x:Type vmc:FormField}">
            <Grid Margin="{StaticResource DcFieldGap}" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource DcBody}"
                                   Text="{Binding DisplayName}" />
                        <Border Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DcChip}">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="ENV VAR NAME" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DcCaption}"
                               Text="{Binding DisabledReason}"
                               Visibility="{Binding ShowReadOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldValidationTemplate}" />
                </StackPanel>
                <ui:TextBox Grid.Column="1"
                            AutomationProperties.HelpText="Name of the environment variable that holds the value, not the value itself."
                            AutomationProperties.Name="{Binding DisplayName}"
                            FontFamily="{DynamicResource DcMonoFontFamily}"
                            IsEnabled="{Binding IsEditable}"
                            Text="{Binding TextValue, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
            </Grid>
        </DataTemplate>

        <!--
            Secret: never a value, never a reveal. The CLI hands secrets back masked, so all this shows is
            "set" (a masked placeholder) or "(not set)". The reason names the two ways to change one.
        -->
        <DataTemplate x:Key="SecretFieldTemplate" DataType="{x:Type vmc:FormField}">
            <Grid Margin="{StaticResource DcFieldGap}" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource DcBody}"
                                   Text="{Binding DisplayName}" />
                        <Border Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DcChip}">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="SECRET · READ-ONLY" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DcCaption}" Text="{Binding DisabledReason}" />
                </StackPanel>
                <Border Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource DcSubtleRow}">
                    <TextBlock AutomationProperties.HelpText="{Binding HelpText}"
                               AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0}: masked, read-only'}"
                               Style="{StaticResource DcMono}"
                               Text="{Binding MaskedText}" />
                </Border>
            </Grid>
        </DataTemplate>

        <!--
            Choice: a list the TUI offers (llm.provider, claw.mode, the severity actions, ...). The hint sits under the label, in words, because it
            says what the choices mean ("observe=log only; action=block."). A value the list does not have is one more item and is selected, so
            opening the form never changes it; the field's own note says it is kept as is. The combo binds SelectedChoice, which ignores the
            null a combo writes when its selection is cleared.
        -->
        <DataTemplate x:Key="ChoiceFieldTemplate" DataType="{x:Type vmc:FormField}">
            <Grid Margin="{StaticResource DcFieldGap}" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DcBody}" Text="{Binding DisplayName}" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Text="{Binding Hint}"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Text="{Binding DisabledReason}"
                               Visibility="{Binding ShowReadOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource FieldValidationTemplate}" />
                </StackPanel>
                <ComboBox Grid.Column="1"
                          Width="260"
                          HorizontalAlignment="Left"
                          AutomationProperties.HelpText="{Binding HelpText}"
                          AutomationProperties.Name="{Binding DisplayName}"
                          ItemsSource="{Binding Choices}"
                          DisplayMemberPath="Label"
                          SelectedValuePath="Value"
                          SelectedValue="{Binding SelectedChoice, Mode=TwoWay}"
                          IsEnabled="{Binding IsEditable}" />
            </Grid>
        </DataTemplate>

        <!--
            Info (CUST-391): a read-only line of the runtime's catalog - a summary (Webhooks, Trusted Paths), a status, a legacy value (Inspect LLM) or a
            key its editor does not edit. The Mac draws these as a label and its value; so does this, with the runtime's hint under it, and no control.
        -->
        <DataTemplate x:Key="InfoFieldTemplate" DataType="{x:Type vmc:FormField}">
            <Grid Margin="{StaticResource DcFieldGap}" ToolTip="{Binding ToolTipText}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DcBody}" Text="{Binding DisplayName}" TextWrapping="Wrap" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Text="{Binding Hint}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           AutomationProperties.HelpText="{Binding HelpText}"
                           AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0}, read-only'}"
                           Style="{StaticResource DcCaption}"
                           Text="{Binding TextValue, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <vc:FormFieldTemplateSelector x:Key="FieldSelector"
                                      BoolTemplate="{StaticResource BoolFieldTemplate}"
                                      ChoiceTemplate="{StaticResource ChoiceFieldTemplate}"
                                      EnvNameTemplate="{StaticResource EnvNameFieldTemplate}"
                                      InfoTemplate="{StaticResource InfoFieldTemplate}"
                                      IntTemplate="{StaticResource IntFieldTemplate}"
                                      SecretTemplate="{StaticResource SecretFieldTemplate}"
                                      StringTemplate="{StaticResource StringFieldTemplate}" />

        <!-- ============================ List field template ============================ -->

        <DataTemplate x:Key="ListFieldTemplate" DataType="{x:Type vmc:FormListField}">
            <StackPanel Margin="{StaticResource DcFieldGap}" ToolTip="{Binding Path}">
                <TextBlock Style="{StaticResource DcBody}" Text="{Binding DisplayName}" />
                <TextBlock Margin="0,0,0,4"
                           Style="{StaticResource DcCaption}"
                           Text="{Binding DisabledReason}"
                           Visibility="{Binding ShowReadOnlyNote, Converter={StaticResource BoolToVisibility}}" />
                <ItemsControl ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox Grid.Column="0"
                                            AutomationProperties.Name="{Binding DataContext.DisplayName, RelativeSource={RelativeSource AncestorType=ItemsControl}, StringFormat='{}{0} item'}"
                                            FontFamily="{DynamicResource DcMonoFontFamily}"
                                            IsReadOnly="True"
                                            Text="{Binding Mode=OneWay}" />
                                <ui:Button Grid.Column="1"
                                           Margin="8,0,0,0"
                                           Appearance="Secondary"
                                           AutomationProperties.Name="{Binding StringFormat='Remove {0}'}"
                                           Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                           CommandParameter="{Binding}"
                                           Content="Remove"
                                           IsEnabled="{Binding DataContext.IsEditable, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Margin="0,4,0,0" IsEnabled="{Binding IsEditable}" Orientation="Horizontal">
                    <ui:TextBox Width="260"
                                AutomationProperties.Name="{Binding DisplayName, StringFormat='Add an item to {0}'}"
                                PlaceholderText="Add item"
                                Text="{Binding NewItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ui:Button Margin="8,0,0,0"
                               Appearance="Secondary"
                               AutomationProperties.Name="{Binding DisplayName, StringFormat='Add the typed item to {0}'}"
                               Command="{Binding AddItemCommand}"
                               Content="Add" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- ============================ Raw block (read-only) ============================ -->

        <DataTemplate x:Key="RawBlockTemplate" DataType="{x:Type vmc:RawBlockNode}">
            <Border Margin="{StaticResource DcFieldGap}"
                    Style="{StaticResource DcCodeBlock}"
                    ToolTip="{Binding Reason}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Margin="0"
                                   Style="{StaticResource DcCardTitle}"
                                   Text="{Binding DisplayName}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DcCaption}"
                                   Text="(read-only)" />
                    </StackPanel>
                    <TextBlock Style="{StaticResource DcCaption}" Text="{Binding Reason}" />
                    <ScrollViewer Margin="0,6,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  MaxHeight="220"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox AutomationProperties.Name="{Binding DisplayName, StringFormat='{}{0}, read-only YAML'}"
                                 Style="{StaticResource DcMonoTextBox}"
                                 Text="{Binding Yaml, Mode=OneWay}"
                                 TextWrapping="NoWrap" />
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============================ Group / section content ============================ -->

        <DataTemplate x:Key="GroupContentTemplate" DataType="{x:Type vmc:FormGroup}">
            <StackPanel>
                <ItemsControl ItemsSource="{Binding Fields}" ItemTemplateSelector="{StaticResource FieldSelector}" />
                <ItemsControl ItemsSource="{Binding Lists}" ItemTemplate="{StaticResource ListFieldTemplate}" />
                <ItemsControl ItemsSource="{Binding RawBlocks}" ItemTemplate="{StaticResource RawBlockTemplate}" />
                <!--
                    DynamicResource, not StaticResource: SubGroupTemplate (below) contains a
                    ContentPresenter templated by *this* resource, so the two are mutually
                    recursive. StaticResource requires the key to already be registered at
                    the point deferred template content is parsed, which fails for whichever
                    of the pair is declared second — DynamicResource defers the lookup until
                    the template is actually used, by which point the whole dictionary (both
                    keys) is loaded.
                -->
                <ItemsControl ItemsSource="{Binding SubGroups}" ItemTemplate="{DynamicResource SubGroupTemplate}" />
                <!-- An empty mapping (e.g. `observability: {}`) is a normal state, not an error. -->
                <TextBlock Style="{StaticResource DcCaption}"
                           Text="Nothing to edit here: this section is empty in config.yaml. Add settings in the RAW tab, or use the Setup panel's wizards."
                           Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Recursive: a sub-group can itself contain sub-groups (e.g. guardrail.connectors.claudecode). -->
        <DataTemplate x:Key="SubGroupTemplate" DataType="{x:Type vmc:FormGroup}">
            <Border Margin="{StaticResource DcCardGap}" Style="{StaticResource DcCardCompact}">
                <StackPanel>
                    <TextBlock Style="{StaticResource DcCardTitle}" Text="{Binding DisplayName}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GroupContentTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" DataType="{x:Type vmc:FormSection}">
            <Border Margin="{StaticResource DcSectionGap}" Style="{StaticResource DcCard}">
                <StackPanel>
                    <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                        <TextBlock Margin="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DcSectionHeader}"
                                   Text="{Binding DisplayName}" />
                        <!--
                            FORM is built from the file's own masked source view, so nearly every section is in
                            config.yaml. The exception is a section removed from the RAW text since load: its fields
                            can not be located, and the badge says so (amber: needs a look, not an error).
                        -->
                        <Border Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource DcBadge}"
                                Tag="Warn"
                                Visibility="{Binding ExistsInRawConfig, Converter={StaticResource InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="NOT IN CONFIG.YAML" />
                        </Border>
                    </StackPanel>
                    <!-- A section of the runtime's catalog says what it is for, and a quieter second line, as the Mac's section form does (CUST-391). -->
                    <TextBlock Margin="0,0,0,2"
                               Style="{StaticResource DcCaption}"
                               Text="{Binding Summary}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSummary, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,0,0,6"
                               Opacity="0.8"
                               Style="{StaticResource DcCaption}"
                               Text="{Binding Help}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasHelp, Converter={StaticResource BoolToVisibility}}" />
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource GroupContentTemplate}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!-- ============================ Pre-save review ============================ -->
        <!--
            One row of the diff. The text was masked before it got here (ConfigDiffReviewBuilder), so a secret is never
            drawn; added / removed rows are tinted with the tone tokens and the +/- marker says the same without colour.
        -->
        <DataTemplate x:Key="DiffLineTemplate" DataType="{x:Type vmc:ConfigDiffLine}">
            <Border x:Name="Row" Padding="8,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="44" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource DcCaption}"
                               Text="{Binding OldNumberText}" />
                    <TextBlock Grid.Column="1"
                               Margin="0,0,8,0"
                               HorizontalAlignment="Right"
                               Style="{StaticResource DcCaption}"
                               Text="{Binding NewNumberText}" />
                    <TextBlock Grid.Column="2"
                               Style="{StaticResource DcMono}"
                               Text="{Binding Marker}" />
                    <TextBlock Grid.Column="3"
                               Style="{StaticResource DcMono}"
                               Text="{Binding Text}"
                               TextWrapping="NoWrap" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource DcToneOkSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource DcToneCriticalSubtleBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Fold">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource DcSubtleBrush}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- One setting the search found: the section it lives in, then the field itself, drawn by the same templates the form uses. -->
        <DataTemplate x:Key="SearchMatchTemplate" DataType="{x:Type vmc:ConfigFieldMatch}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Margin="0,10,12,0"
                           VerticalAlignment="Top"
                           Style="{StaticResource DcCaption}"
                           Text="{Binding SectionName}"
                           TextTrimming="CharacterEllipsis"
                           ToolTip="{Binding SectionName}" />
                <ContentPresenter Grid.Column="1"
                                  Content="{Binding Field}"
                                  ContentTemplateSelector="{StaticResource FieldSelector}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The search across every section, then where the sections come from and Reload (the Mac's toolbar row). -->
        <WrapPanel Grid.Row="0" Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
            <ui:TextBox x:Name="SearchBox"
                        Width="320"
                        Margin="0,0,8,8"
                        AutomationProperties.Name="Search all settings"
                        AutomationProperties.HelpText="Finds settings in every section by label, dotted key or hint. Ctrl+F."
                        PlaceholderText="Search all settings (label, key or hint)"
                        Text="{Binding FieldSearch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                <ui:TextBox.Icon>
                    <ui:SymbolIcon Symbol="Search24" />
                </ui:TextBox.Icon>
            </ui:TextBox>
            <ui:Button Margin="0,0,16,8"
                       Appearance="Secondary"
                       AutomationProperties.Name="Clear the setting search"
                       Command="{Binding ClearFieldSearchCommand}"
                       Content="Clear"
                       Visibility="{Binding HasFieldSearch, Converter={StaticResource BoolToVisibility}}" />
            <StackPanel Margin="0,0,0,8" VerticalAlignment="Center" Orientation="Horizontal">
                <ui:ProgressRing Width="16"
                                 Height="16"
                                 Margin="0,0,8,0"
                                 AutomationProperties.Name="Loading configuration"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Margin="0,0,10,0"
                           VerticalAlignment="Center"
                           AutomationProperties.LiveSetting="Polite"
                           Style="{StaticResource DcCaption}"
                           Text="{Binding CatalogLabel}"
                           ToolTip="{Binding CatalogToolTip}" />
                <ui:Button Margin="0"
                           VerticalAlignment="Center"
                           AutomationProperties.HelpText="Reloads config.yaml and the runtime's view of it. With unsaved edits it asks whether to save, discard or cancel first."
                           Command="{Binding ReloadCommand}"
                           Content="Reload"
                           ToolTip="Read config.yaml and the runtime's view of it again">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
                <!-- Inline only: the same draft in a window of its own (ConfigEditorWindow). -->
                <ui:Button x:Name="OpenInWindowButton"
                           Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Appearance="Secondary"
                           AutomationProperties.HelpText="Opens this config editor in a window of its own. It is the same draft: an edit in one shows in the other."
                           Click="OnOpenInWindowClick"
                           Content="Open in window"
                           ToolTip="Open this draft in a window of its own"
                           Visibility="Collapsed">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="WindowNew24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </WrapPanel>

        <!-- Banners: every state the editor can be in, one InfoBar each (a closed InfoBar takes no room) -->
        <StackPanel Grid.Row="1">
            <!-- A managed or invalid installation is only read: this editor writes config.yaml itself, so Save and Restore are off. -->
            <ui:InfoBar Title="State-changing actions disabled — Save is off"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding HasChangesBlockedReason, Mode=OneWay}"
                        Message="{Binding ChangesBlockedReason}"
                        Severity="Warning" />

            <!--
                A FORM value with an error is held in its box and not written to the buffer (see the view-model's remarks): Save is off until it is
                fixed or put back. The lines name the key and the kind of problem, never the value. Below the installation's banner, whose reason
                is the first one.
            -->
            <ui:InfoBar Title="Save is off — fix the field errors in the FORM tab"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding HasBlockingFieldErrors, Mode=OneWay}"
                        Message="{Binding FieldErrorsSummary, Mode=OneWay}"
                        Severity="Error" />

            <!--
                A failed *read* of config.yaml (locked, permissions) — distinct from a parse
                error. Save and FORM stay disabled until Reload succeeds, so the empty editor
                below can never be mistaken for, or saved over, the real file.
            -->
            <!--
                A config.yaml that cannot be loaded (CUST-377): unreadable, not YAML, or refused for its size. What is wrong, the line and
                column when the parser gave them, what to do about it, and the actions the app already has - open it in an editor, show it
                in Explorer, Reload. The form below is empty on purpose; this says why instead of leaving it blank.
            -->
            <Border Margin="{StaticResource DcCardGap}"
                    Style="{StaticResource DcCardCompact}"
                    AutomationProperties.Name="config.yaml could not be loaded"
                    Visibility="{Binding HasLoadProblem, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource DcCardTitle}" Text="{Binding LoadProblem.Title}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource DcCaption}"
                               Text="{Binding LoadProblem.Location}"
                               Visibility="{Binding LoadProblem.HasLocation, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Margin="0,4,0,0"
                               Style="{StaticResource DcMono}"
                               Text="{Binding LoadProblem.Reason}"
                               TextWrapping="Wrap" />
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource DcCaption}"
                               Text="{Binding LoadProblem.Guidance}"
                               TextWrapping="Wrap" />
                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                        <ui:Button Appearance="Secondary"
                                   AutomationProperties.HelpText="Opens config.yaml with the program Windows has for it."
                                   Command="{Binding OpenConfigInEditorCommand}"
                                   Content="Open in editor" />
                        <ui:Button Margin="8,0,0,0"
                                   Appearance="Secondary"
                                   AutomationProperties.HelpText="Shows config.yaml in Explorer."
                                   Command="{Binding ShowConfigInExplorerCommand}"
                                   Content="Show in Explorer" />
                        <ui:Button Margin="8,0,0,0"
                                   Appearance="Secondary"
                                   AutomationProperties.HelpText="Reads config.yaml again."
                                   Command="{Binding ReloadCommand}"
                                   Content="Reload" />
                    </StackPanel>
                    <TextBlock Margin="0,8,0,0"
                               Style="{StaticResource DcCaption}"
                               Text="{Binding LoadProblemActionMessage}"
                               Visibility="{Binding HasLoadProblemActionMessage, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Border>

            <ui:InfoBar Title="config.yaml does not parse as YAML"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding ShowParseErrorBar, Mode=OneWay}"
                        Message="{Binding ParseError}"
                        Severity="Error" />

            <!-- What the 1.0.4 runtime does with this file that a field cannot say: the local Splunk stack record, the strictest-profile rule. Only for a runtime that has them. -->
            <ItemsControl Margin="{StaticResource DcCardGap}"
                          ItemsSource="{Binding FormNotes}"
                          Visibility="{Binding HasFormNotes, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ui:InfoBar Margin="0,0,0,4"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{Binding}"
                                    Severity="Informational" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- After a rebase of the draft over a changed config.yaml: what it did and the keys changed in both places. Undo puts the draft back as it was. -->
            <ui:InfoBar Title="Draft rebased onto the new config.yaml"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding HasRebaseNotice, Mode=OneWay}"
                        Message="{Binding RebaseNotice}"
                        Severity="Informational" />
            <StackPanel Margin="{StaticResource DcCardGap}"
                        Orientation="Horizontal"
                        Visibility="{Binding HasRebaseNotice, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Appearance="Secondary"
                           AutomationProperties.HelpText="Puts your draft back exactly as it was before the rebase."
                           Command="{Binding UndoRebaseCommand}"
                           Content="Undo rebase"
                           Visibility="{Binding CanUndoRebase, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           Command="{Binding DismissRebaseNoticeCommand}"
                           Content="Dismiss" />
            </StackPanel>

            <ui:InfoBar Title="FORM view unavailable"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding FormUnavailableReason, Converter={StaticResource StringHasValue}, FallbackValue=False}"
                        Message="{Binding FormUnavailableReason}"
                        Severity="Warning" />

            <ui:InfoBar Title="config.yaml changed on disk"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding ShowDriftBanner}"
                        Message="{Binding DriftMessage}"
                        Severity="Warning" />
            <StackPanel Margin="{StaticResource DcCardGap}"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowDriftBanner, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Appearance="Secondary"
                           Command="{Binding ViewOnDiskCommand}"
                           Content="View on-disk version" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           AutomationProperties.HelpText="Shows what changed on disk, and what putting your edits on the new file would do. Nothing is changed."
                           Command="{Binding ReviewExternalChangeCommand}"
                           Content="Review the difference" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           Command="{Binding ReloadCommand}"
                           Content="Reload" />
            </StackPanel>

            <!--
                config.yaml changed on disk while the editor holds unsaved edits (a clean editor just reloads, so
                this never appears for one). The edits are never replaced by themselves: Reload drops them on
                purpose, Keep my edits leaves them alone, and a Save would still report the drift.
            -->
            <ui:InfoBar Title="config.yaml changed on disk"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding ShowExternalChangeBanner}"
                        Message="Something else edited the file while you had unsaved changes here. Your edits have not been touched. Review the difference, then rebase your edits onto the new file, keep them as they are, or drop them and reload."
                        Severity="Warning" />
            <StackPanel Margin="{StaticResource DcCardGap}"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowExternalChangeBanner, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Appearance="Primary"
                           AutomationProperties.HelpText="Shows what changed on disk, and what putting your edits on the new file would do. Nothing is changed."
                           Command="{Binding ReviewExternalChangeCommand}"
                           Content="Review the difference" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           AutomationProperties.HelpText="Replaces the editor with the file on disk. Your unsaved edits are dropped."
                           Command="{Binding ReloadDiscardingEditsCommand}"
                           Content="Discard my edits and reload" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           AutomationProperties.HelpText="Dismisses this notice and keeps the text in the editor. Saving will still report that the file changed."
                           Command="{Binding KeepEditsCommand}"
                           Content="Keep my edits" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           Command="{Binding ViewOnDiskCommand}"
                           Content="View on-disk version" />
            </StackPanel>

            <!-- The on-disk text, for comparing against the editor after a drift warning. Esc closes it. -->
            <Border Margin="{StaticResource DcCardGap}"
                    Style="{StaticResource DcCardCompact}"
                    Visibility="{Binding ShowOnDiskPreview, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid>
                        <TextBlock Margin="0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource DcCardTitle}"
                                   Text="Current on-disk content" />
                        <ui:Button HorizontalAlignment="Right"
                                   Appearance="Secondary"
                                   Command="{Binding DismissOnDiskPreviewCommand}"
                                   Content="Close"
                                   ToolTip="Close (Esc)" />
                    </Grid>
                    <Border Margin="0,8,0,0" Style="{StaticResource DcCodeBlock}">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                      MaxHeight="220"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBox AutomationProperties.Name="Current on-disk content of config.yaml"
                                     Style="{StaticResource DcMonoTextBox}"
                                     Text="{Binding OnDiskPreviewText, Mode=OneWay}"
                                     TextWrapping="NoWrap" />
                        </ScrollViewer>
                    </Border>
                </StackPanel>
            </Border>

            <ui:InfoBar Title="Saved"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding ShowSaveSuccessBanner}"
                        Message="{Binding SaveResultMessage}"
                        Severity="Success" />

            <!--
                The gateway reads config.yaml when it starts, so a saved change does not apply to the running one. The button
                opens the same review the tray's Restart opens; nothing restarts without that confirm.
            -->
            <ui:InfoBar Title="Saved — restart the gateway to apply"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding ShowRestartPrompt}"
                        Message="The running gateway still has the previous settings until it restarts."
                        Severity="Informational" />
            <StackPanel Margin="{StaticResource DcCardGap}"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowRestartPrompt, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Appearance="Primary"
                           AutomationProperties.HelpText="Opens the review for defenseclaw-gateway restart. Nothing restarts until you confirm it there."
                           Command="{Binding RestartGatewayCommand}"
                           Content="Restart gateway…"
                           Visibility="{Binding CanRestartGateway, Converter={StaticResource BoolToVisibility}}" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           Command="{Binding DismissRestartPromptCommand}"
                           Content="Not now" />
            </StackPanel>

            <!-- The message can be the CLI's own validation text, so it sits in a selectable, copyable box under the banner. -->
            <ui:InfoBar Title="Save problem"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding ShowSaveErrorBanner}"
                        Severity="Error">
                <ctl:DcCommandOutput MaxHeight="200"
                                     OutputName="Save problem details"
                                     Text="{Binding SaveResultMessage, Mode=OneWay}" />
            </ui:InfoBar>
            <StackPanel Margin="{StaticResource DcCardGap}"
                        Orientation="Horizontal"
                        Visibility="{Binding ShowRestoreAction, Converter={StaticResource BoolToVisibility}}">
                <ui:Button Appearance="Secondary"
                           AutomationProperties.HelpText="Puts the last known-good backup back over config.yaml."
                           Command="{Binding RestoreFromBackupCommand}"
                           Content="Restore from backup" />
                <TextBlock Margin="12,0,6,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource DcCaption}"
                           Text="Backup:" />
                <TextBox VerticalAlignment="Center"
                         AutomationProperties.Name="Path of the backup file"
                         Style="{StaticResource DcMonoTextBox}"
                         Text="{Binding LastBackupPath, Mode=OneWay}"
                         TextWrapping="NoWrap" />
            </StackPanel>

            <ui:InfoBar Title="Could not apply that field"
                        Margin="{StaticResource DcCardGap}"
                        IsClosable="False"
                        IsOpen="{Binding FieldErrorMessage, Converter={StaticResource StringHasValue}, FallbackValue=False}"
                        Message="{Binding FieldErrorMessage}"
                        Severity="Warning" />
        </StackPanel>

        <!--
            FORM (the section list beside the typed form, or the search results) and RAW. FORM comes first: it is the Mac's editor; RAW is the
            escape hatch for what FORM cannot write (secrets, masked values, structures it shows read-only).
        -->
        <TabControl x:Name="RootTabs"
                    Grid.Row="2"
                    AutomationProperties.Name="Config editor views">
            <TabItem x:Name="FormTabItem" AutomationProperties.Name="Form editor" Header="Form">
                <!-- Narrower than this (the Setup page at the window's minimum), the section list goes above the form as a row of names, so the form keeps its width. -->
                <Grid panels:CompactLayout.Below="860">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--
                        The section list (the Mac's sidebar list): the runtime's sections, in the order the form shows them. Picking one brings its
                        card to the top of the form; every section stays in the form, so nothing is hidden from a scroll or a screen reader.
                    -->
                    <ListBox x:Name="SectionList"
                             AutomationProperties.Name="Config sections"
                             AutomationProperties.HelpText="Picking a section brings it to the top of the form."
                             DisplayMemberPath="DisplayName"
                             ItemsSource="{Binding Sections}"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             SelectionChanged="OnSectionSelected"
                             Visibility="{Binding ShowSectionBrowser, Converter={StaticResource BoolToVisibility}}">
                        <ListBox.Style>
                            <Style TargetType="ListBox" BasedOn="{StaticResource {x:Type ListBox}}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="0" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Setter Property="Width" Value="190" />
                                <Setter Property="Margin" Value="0,12,12,0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(panels:CompactLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Grid.RowSpan" Value="1" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Setter Property="Width" Value="Auto" />
                                        <Setter Property="Margin" Value="0,12,0,4" />
                                        <Setter Property="ItemsPanel">
                                            <Setter.Value>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.Style>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                                <Setter Property="ToolTip" Value="{Binding Path}" />
                                <Setter Property="AutomationProperties.Name" Value="{Binding DisplayName}" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>

                    <ScrollViewer x:Name="FormScroll"
                                  Visibility="{Binding ShowSectionBrowser, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer" BasedOn="{StaticResource DcPageScroll}">
                                <Setter Property="Grid.Row" Value="0" />
                                <Setter Property="Grid.RowSpan" Value="2" />
                                <Setter Property="Grid.Column" Value="1" />
                                <Setter Property="Grid.ColumnSpan" Value="1" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Path=(panels:CompactLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True">
                                        <Setter Property="Grid.Row" Value="1" />
                                        <Setter Property="Grid.RowSpan" Value="1" />
                                        <Setter Property="Grid.Column" Value="0" />
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <StackPanel x:Name="FormContent" Margin="0,12,0,0">
                            <!--
                                Shown when the RAW tab holds YAML that does not parse: the tree below
                                is the last version that did, so it is disabled (IsFormEditable) and
                                FORM edits are refused until RAW parses again.
                            -->
                            <ui:InfoBar Title="FORM is out of date"
                                        Margin="{StaticResource DcCardGap}"
                                        IsClosable="False"
                                        IsOpen="{Binding ShowFormStaleNotice}"
                                        Message="The RAW tab has changes that do not parse as YAML, so this view is out of date and read-only. Fix the YAML in RAW, then switch back."
                                        Severity="Warning" />
                            <TextBlock Margin="{StaticResource DcCardGap}"
                                       Style="{StaticResource DcCaption}"
                                       Text="Values come from the CLI's masked view of config.yaml (defenseclaw config show --source). Secrets and header values are masked, so those fields are read-only here — edit them in the RAW tab, or keep a secret out of the file with defenseclaw keys set and an *_env setting."
                                       TextWrapping="Wrap"
                                       Visibility="{Binding ShowFormEmptyState, Converter={StaticResource InverseBoolToVisibility}}" />
                            <ItemsControl x:Name="SectionItems"
                                          IsEnabled="{Binding IsFormEditable}"
                                          ItemTemplate="{StaticResource SectionTemplate}"
                                          ItemsSource="{Binding Sections}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- The search: every matching setting of every section, editable where it stands (the same field objects as the form). -->
                    <ScrollViewer x:Name="SearchScroll"
                                  Grid.RowSpan="2"
                                  Grid.Column="0"
                                  Grid.ColumnSpan="2"
                                  Style="{StaticResource DcPageScroll}"
                                  Visibility="{Binding HasFieldSearch, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Margin="0,12,0,0">
                            <TextBlock Margin="{StaticResource DcCardGap}"
                                       AutomationProperties.LiveSetting="Polite"
                                       Style="{StaticResource DcCaption}"
                                       Text="{Binding NoSearchMatchesText}"
                                       Visibility="{Binding ShowNoSearchMatches, Converter={StaticResource BoolToVisibility}}" />
                            <ItemsControl AutomationProperties.Name="Settings that match the search"
                                          IsEnabled="{Binding IsFormEditable}"
                                          ItemTemplate="{StaticResource SearchMatchTemplate}"
                                          ItemsSource="{Binding SearchMatches}" />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Nothing to draw: say which of the four different reasons applies. -->
                    <StackPanel Grid.RowSpan="2"
                                Grid.Column="0"
                                Grid.ColumnSpan="2"
                                Style="{StaticResource DcEmptyState}"
                                Visibility="{Binding ShowFormEmptyState, Converter={StaticResource BoolToVisibility}}">
                        <ui:SymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Settings24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding FormEmptyTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding FormEmptyDetail}" />
                    </StackPanel>
                </Grid>
            </TabItem>
            <TabItem x:Name="RawTabItem" AutomationProperties.Name="Raw YAML editor" Header="Raw">
                <Border Style="{StaticResource DcCardFlush}">
                    <avalonEdit:TextEditor x:Name="RawEditor"
                                           AutomationProperties.Name="config.yaml raw text"
                                           Background="Transparent"
                                           FontFamily="{DynamicResource DcMonoFontFamily}"
                                           FontSize="13"
                                           Foreground="{DynamicResource DcTextPrimaryBrush}"
                                           IsReadOnly="{Binding LoadFailed, Mode=OneWay}"
                                           LineNumbersForeground="{DynamicResource DcTextSecondaryBrush}"
                                           ShowLineNumbers="True"
                                           WordWrap="False" />
                </Border>
            </TabItem>
        </TabControl>

        <!-- Revert and the reviewed Save (the Mac's last row), with what the draft is and, in the detached window, what closing it does. -->
        <Grid Grid.Row="3" Margin="0,8,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterNoteText"
                       Grid.Column="0"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource DcCaption}"
                       TextWrapping="Wrap" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Border Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Unsaved changes"
                        Style="{StaticResource DcBadge}"
                        Tag="Warn"
                        Visibility="{Binding IsRawModified, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource DcBadgeText}" Text="MODIFIED" />
                </Border>
                <ui:Button Appearance="Secondary"
                           AutomationProperties.HelpText="Drops every unsaved edit and reads config.yaml again. Nothing is written."
                           Command="{Binding RevertCommand}"
                           Content="Revert"
                           ToolTip="Drop the unsaved edits and read config.yaml again">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowUndo24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Margin="8,0,0,0"
                           Appearance="Primary"
                           AutomationProperties.HelpText="Shows what will change in config.yaml, then backs it up, writes the new text and validates it with the CLI. Shortcut: Ctrl+S."
                           Command="{Binding ReviewAndSaveCommand}"
                           Content="Save"
                           ToolTipService.ShowOnDisabled="True"
                           ToolTip="{Binding SaveToolTip}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!--
            Review changes: what Save is about to write, as a diff of config.yaml on disk against the editor, secrets masked.
            It covers the banners and the tabs (not the header), so nothing can be edited while it is open; Esc or
            Back to editing returns to the buffer untouched, Save runs the unchanged save pipeline.
        -->
        <Grid Grid.Row="1"
              Grid.RowSpan="3"
              Background="{DynamicResource DcWindowBackgroundBrush}"
              Visibility="{Binding IsReviewing, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="{StaticResource DcCardGap}">
                <TextBlock Style="{StaticResource DcSectionHeader}" Text="Review changes" />
                <TextBlock Style="{StaticResource DcCaption}" Text="{Binding Review.Summary}" />
                <TextBlock Style="{StaticResource DcCaption}"
                           Text="config.yaml on disk against your edits. Secret values are hidden on both sides; unchanged lines are folded." />
            </StackPanel>
            <Border Grid.Row="1"
                    Margin="{StaticResource DcCardGap}"
                    Style="{StaticResource DcCodeBlock}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl AutomationProperties.Name="Changes to config.yaml"
                                  ItemTemplate="{StaticResource DiffLineTemplate}"
                                  ItemsSource="{Binding Review.Lines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2"
                        Margin="{StaticResource DcCardGap}"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Appearance="Secondary"
                           AutomationProperties.HelpText="Returns to the editor without saving. Shortcut: Esc."
                           Command="{Binding CancelReviewCommand}"
                           Content="Back to editing"
                           ToolTip="Back to editing (Esc)" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Primary"
                           AutomationProperties.HelpText="Backs up config.yaml, writes the edited text, then validates it with the CLI. Shortcut: Ctrl+S."
                           Command="{Binding ConfirmReviewedSaveCommand}"
                           Content="Save">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Save24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!--
            config.yaml changed on disk under an unsaved draft (CUST-377): what changed on disk since the editor read it (masked, like the
            pre-save review), the keys changed in both places, and the choice - rebase the draft onto the new file, or drop it and reload.
            Nothing here changes anything until a button is pressed; Esc or Back to editing leaves the draft as it was.
        -->
        <Grid Grid.Row="1"
              Grid.RowSpan="3"
              Background="{DynamicResource DcWindowBackgroundBrush}"
              Visibility="{Binding IsReviewingExternalChange, Converter={StaticResource BoolToVisibility}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="{StaticResource DcCardGap}">
                <TextBlock Style="{StaticResource DcSectionHeader}" Text="config.yaml changed on disk" />
                <TextBlock Style="{StaticResource DcCaption}" Text="{Binding ExternalChangeSummary}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource DcCaption}"
                           Text="Below: what changed on disk since you opened it. Secret values are hidden; unchanged lines are folded. Rebase puts your edited settings on top of the new file."
                           TextWrapping="Wrap" />
                <ui:InfoBar Margin="0,8,0,0"
                            IsClosable="False"
                            IsOpen="{Binding RebaseBlockedReason, Converter={StaticResource StringHasValue}, FallbackValue=False}"
                            Message="{Binding RebaseBlockedReason}"
                            Severity="Warning"
                            Title="Rebase is not possible right now" />
                <StackPanel Margin="0,8,0,0" Visibility="{Binding HasRebaseConflicts, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource DcCardTitle}" Text="Changed in both places (the file's value is kept)" />
                    <ItemsControl AutomationProperties.Name="Settings changed in both places" ItemsSource="{Binding RebaseConflicts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vmc:RebaseConflict}">
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource DcMono}"
                                           Text="{Binding Line, Mode=OneWay}"
                                           TextWrapping="Wrap" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
            <Border Grid.Row="1"
                    Margin="{StaticResource DcCardGap}"
                    Style="{StaticResource DcCodeBlock}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl AutomationProperties.Name="Changes made to config.yaml on disk"
                                  ItemTemplate="{StaticResource DiffLineTemplate}"
                                  ItemsSource="{Binding ExternalChangeDiff.Lines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
            </Border>
            <StackPanel Grid.Row="2"
                        Margin="{StaticResource DcCardGap}"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <ui:Button Appearance="Secondary"
                           AutomationProperties.HelpText="Returns to the editor with your draft as it is. Shortcut: Esc."
                           Command="{Binding CancelExternalReviewCommand}"
                           Content="Back to editing"
                           ToolTip="Back to editing (Esc)" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Secondary"
                           AutomationProperties.HelpText="Replaces the editor with the file on disk. Your unsaved edits are dropped."
                           Command="{Binding ReloadDiscardingEditsCommand}"
                           Content="Discard my edits and reload" />
                <ui:Button Margin="8,0,0,0"
                           Appearance="Primary"
                           AutomationProperties.HelpText="Puts your edited settings on the new file. A setting changed in both places keeps the file's value. Nothing is saved; Undo rebase restores your draft."
                           Command="{Binding RebaseDraftCommand}"
                           Content="Rebase my edits"
                           IsEnabled="{Binding CanRebaseDraft}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
