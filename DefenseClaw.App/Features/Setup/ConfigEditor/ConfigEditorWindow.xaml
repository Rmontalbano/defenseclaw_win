<ui:FluentWindow x:Class="DefenseClaw.App.Views.ConfigEditor.ConfigEditorWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:vc="clr-namespace:DefenseClaw.App.Views.ConfigEditor"
                 Title="{Binding WindowTitle}"
                 Width="1150"
                 Height="800"
                 MinWidth="820"
                 MinHeight="560"
                 AutomationProperties.Name="DefenseClaw config editor"
                 WindowStartupLocation="CenterScreen">
    <!--
        No Mica backdrop here: WPF-UI's FluentWindow throws unless
        ExtendsContentIntoTitleBar is also true, which would mean building a custom
        title bar (as MainWindow does with ui:TitleBar) — not worth it for a secondary
        utility window whose native title bar already needs to show plain text (the
        "contains secret references" hint). Standard chrome is intentional here.
    -->
    <!--
        The detached config editor (CUST-385): the file's path over ConfigEditorView, the same control the Setup panel shows inline, over the app's one
        draft (ConfigEditorSession). An edit here is the edit in Setup, and closing this window keeps it there; the tray Exit still asks about unsaved
        edits (ConfigEditorWindow.CloseForExitAsync).
    -->
    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header: what file. Reload, Revert and Save are the editor's own (top and bottom of it), as in the Setup panel. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Style="{StaticResource DcPageTitle}" Text="Config editor" />
            <TextBox Margin="0,4,0,0"
                     AutomationProperties.Name="Path of the config.yaml being edited"
                     Style="{StaticResource DcMonoTextBox}"
                     Text="{Binding ConfigFilePath, Mode=OneWay}"
                     TextWrapping="NoWrap" />
        </StackPanel>

        <vc:ConfigEditorView x:Name="EditorView"
                             Grid.Row="1"
                             FooterNote="The same draft as the Setup panel's config editor: an edit here shows there, and closing this window keeps it." />
    </Grid>
</ui:FluentWindow>
