<UserControl x:Class="DefenseClaw.App.Views.Shell.PaletteLauncher"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             Focusable="False">
    <!--
        The command palette's door in the title bar (CUST-383): a button drawn like a search box, "Search panels and commands" with its Ctrl+K
        key cap, where the Mac keeps its Command Palette button (the window toolbar) and where Windows apps put their search. It only opens the
        palette: the window handles its Click (MainWindow.OnPaletteButtonClick), exactly as Ctrl+K does. Every colour is a Dc token.
    -->
    <Button x:Name="LauncherButton"
            Height="24"
            MinWidth="200"
            MaxWidth="360"
            Cursor="Hand"
            FocusVisualStyle="{DynamicResource DcFocusVisualStyle}"
            ToolTip="Command palette (Ctrl+K)"
            ToolTipService.InitialShowDelay="400"
            AutomationProperties.Name="Open command palette"
            AutomationProperties.AcceleratorKey="Ctrl+K"
            AutomationProperties.HelpText="Opens the command palette: go to any panel, or find an app, gateway or CLI command by typing.">
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border x:Name="Box"
                        Background="{DynamicResource DcInsetBrush}"
                        BorderBrush="{DynamicResource DcControlBorderBrush}"
                        BorderThickness="{DynamicResource DcBorderThickness}"
                        CornerRadius="{DynamicResource DcRadiusM}"
                        Padding="8,0,4,0"
                        SnapsToDevicePixels="True">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ctl:DcSymbolIcon Grid.Column="0"
                                          Symbol="Search24"
                                          FontSize="13"
                                          Margin="0,0,6,0"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource DcTextSecondaryBrush}" />
                        <TextBlock Grid.Column="1"
                                   Text="Search panels and commands"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource DcTextSecondaryBrush}" />
                        <Border Grid.Column="2" Style="{DynamicResource DcKeyCap}" Margin="8,0,0,0" Padding="5,0,5,0">
                            <TextBlock Style="{DynamicResource DcKeyCapText}" FontSize="10" Text="Ctrl+K" />
                        </Border>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource DcSubtleBrush}" />
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="Box" Property="Background" Value="{DynamicResource DcSelectedBrush}" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
