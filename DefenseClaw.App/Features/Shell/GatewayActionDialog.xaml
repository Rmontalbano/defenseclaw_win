<ui:FluentWindow x:Class="DefenseClaw.App.Views.Shell.GatewayActionDialog"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:shell="clr-namespace:DefenseClaw.App.Views.Shell"
                 Title="Review command"
                 Width="540"
                 SizeToContent="Height"
                 ResizeMode="NoResize"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ShowInTaskbar="True"
                 Topmost="True"
                 AutomationProperties.Name="Review command">
    <!--
        The review step for a state-changing gateway action started from the tray menu or the
        command palette: a window around the shared CommandReviewControl, which draws the exact argv,
        the tier and the buttons. Built as its own small window because the tray menu has to be able
        to ask while the dashboard is hidden. Esc cancels; the control puts focus on the confirm
        button (Cancel for a destructive command) so Enter does the obvious thing.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0"
                     Title="Review command"
                     ShowMinimize="False"
                     ShowMaximize="False" />

        <shell:CommandReviewControl x:Name="ReviewControl"
                                    Grid.Row="1"
                                    Margin="24,8,24,24" />
    </Grid>
</ui:FluentWindow>
