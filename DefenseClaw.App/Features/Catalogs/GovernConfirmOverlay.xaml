<UserControl x:Class="DefenseClaw.App.Views.Panels.Govern.GovernConfirmOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:shell="clr-namespace:DefenseClaw.App.Views.Shell"
             IsTabStop="False">
    <!--
        The review step every state-changing Govern command goes through (DataContext = a
        GovernPanelViewModelBase). A scrim and a dialog card around the shared CommandReviewControl,
        which draws the exact argv, the tier and the buttons and owns focus, Esc and Copy; the
        panel view-model supplies the review and the confirm / cancel commands. Tab cycles inside the
        dialog while it is open.
    -->
    <Grid x:Name="Overlay"
          Style="{StaticResource DcScrim}"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle"
          Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Style="{StaticResource DcDialogCard}">
            <shell:CommandReviewControl Review="{Binding ConfirmReview}"
                                        ConfirmCommand="{Binding ConfirmYesCommand}"
                                        CancelCommand="{Binding ConfirmNoCommand}" />
        </Border>
    </Grid>
</UserControl>
