<ui:FluentWindow x:Class="DefenseClaw.App.Views.Wizards.WizardWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wizards="clr-namespace:DefenseClaw.App.Views.Wizards"
                 Title="Setup wizard"
                 Width="860"
                 Height="720"
                 MinWidth="700"
                 MinHeight="560"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterOwner">
    <!--
        One window per wizard run. Pages left to right, review last and always: the app never
        edits DefenseClaw state itself, so the operator reads the exact argv before anything
        happens, and the same list is what CliRunner executes.
    -->
    <ui:FluentWindow.Resources>
        <wizards:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Tertiary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Exit-code and certification badges share one colour key: Ok / Warn / Bad / Neutral. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2,8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="{Binding Title, StringFormat='Setup: {0}'}" />

        <!-- Header: what is being configured, how certified it is, and where in the flow we are. -->
        <Border Grid.Row="1"
                Padding="24,10,24,14"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding PageTitle}" />
                        <Border Margin="12,0,0,0">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CertificationKey}" Value="Ok">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CertificationKey}" Value="Warn">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding CertificationKey}" Value="Bad">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding CertificationBadge}" />
                        </Border>
                    </StackPanel>

                    <TextBlock Margin="0,4,0,0"
                               FontSize="12"
                               Style="{StaticResource Secondary}"
                               Text="{Binding PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="12"
                               Style="{StaticResource Secondary}"
                               Text="{Binding ProgressText}" />
                    <TextBlock HorizontalAlignment="Right"
                               FontSize="11"
                               FontFamily="Cascadia Mono, Consolas"
                               Style="{StaticResource Tertiary}"
                               Text="{Binding Target, StringFormat='setup {0}'}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Body: either the current field page or the review page. -->
        <Grid Grid.Row="2" Margin="24,14,24,0">
            <!-- Field page -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding IsReview, Converter={StaticResource InverseBoolToVisibility}}">
                <StackPanel>
                    <ui:InfoBar Margin="0,0,0,12"
                                IsClosable="False"
                                Severity="Warning"
                                Title="Certification"
                                IsOpen="{Binding HasCertificationWarning, Mode=OneWay}"
                                Message="{Binding CertificationWarning}" />

                    <ItemsControl ItemsSource="{Binding CurrentStep.Fields}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,16"
                                            Visibility="{Binding IsVisible, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="{Binding Label}" />
                                        <TextBlock Margin="8,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   Style="{StaticResource Tertiary}"
                                                   Text="{Binding FlagDisplay}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,2,0,6"
                                               FontSize="12"
                                               MaxWidth="720"
                                               HorizontalAlignment="Left"
                                               Style="{StaticResource Secondary}"
                                               Text="{Binding Help}" />

                                    <!-- Text / integer / env-var-name -->
                                    <ui:TextBox Width="420"
                                                HorizontalAlignment="Left"
                                                PlaceholderText="{Binding Placeholder}"
                                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Path: same control, hinted for a filesystem location -->
                                    <ui:TextBox Width="420"
                                                HorizontalAlignment="Left"
                                                PlaceholderText="{Binding Placeholder}"
                                                Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                Visibility="{Binding IsPath, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Choice and tri-state paired flags -->
                                    <ComboBox Width="420"
                                              HorizontalAlignment="Left"
                                              DisplayMemberPath="Label"
                                              ItemsSource="{Binding Choices}"
                                              SelectedItem="{Binding SelectedChoice, Mode=TwoWay}"
                                              Visibility="{Binding IsChoice, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Bare switch: present in argv when on, absent when off -->
                                    <ui:ToggleSwitch HorizontalAlignment="Left"
                                                     IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                     Visibility="{Binding IsSwitch, Converter={StaticResource BoolToVisibility}}" />

                                    <!-- Secret: never rendered as plain text, never placed in argv -->
                                    <StackPanel Visibility="{Binding IsSecret, Converter={StaticResource BoolToVisibility}}">
                                        <ui:PasswordBox Width="420"
                                                        HorizontalAlignment="Left"
                                                        PlaceholderText="{Binding Placeholder}"
                                                        Password="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   MaxWidth="560"
                                                   HorizontalAlignment="Left"
                                                   FontSize="11"
                                                   Style="{StaticResource Tertiary}"
                                                   Text="{Binding SecretNote}" />
                                    </StackPanel>

                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}"
                                               Text="{Binding ValidationError}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="0,4,0,16"
                               FontSize="11"
                               Style="{StaticResource Tertiary}"
                               Text="{Binding SourceNote}" />
                </StackPanel>
            </ScrollViewer>

            <!-- Review page -->
            <Grid Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <ui:InfoBar Margin="0,0,0,12"
                                IsClosable="False"
                                Severity="Warning"
                                Title="Certification"
                                IsOpen="{Binding HasCertificationWarning, Mode=OneWay}"
                                Message="{Binding CertificationWarning}" />

                    <TextBlock Margin="0,0,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Command" />

                    <Border Padding="14"
                            CornerRadius="6"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                        <StackPanel>
                            <TextBox Style="{StaticResource Mono}" Text="{Binding CommandText, Mode=OneWay}" />
                            <TextBlock Margin="0,8,0,0"
                                       FontSize="11"
                                       Style="{StaticResource Tertiary}"
                                       Text="{Binding ExecutablePath, StringFormat='resolves to {0}'}" />
                        </StackPanel>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <ui:Button Padding="10,5,10,5"
                                   Appearance="Secondary"
                                   Content="Copy command"
                                   Command="{Binding CopyCommandCommand}" />
                        <Border Margin="12,0,0,0"
                                Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}">
                            <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ExitBadgeKey}" Value="Ok">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExitBadgeKey}" Value="Warn">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding ExitBadgeKey}" Value="Bad">
                                            <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ExitBadgeText}" />
                        </Border>
                    </StackPanel>

                    <ui:InfoBar Margin="0,12,0,0"
                                IsClosable="False"
                                Severity="Informational"
                                Title="A secret is piped on stdin"
                                IsOpen="{Binding HasStdinSecret, Mode=OneWay}"
                                Message="{Binding StdinNote}" />

                    <ui:InfoBar Margin="0,8,0,0"
                                IsClosable="False"
                                Severity="Warning"
                                Title="The command will not read that secret"
                                IsOpen="{Binding HasStdinConflict, Mode=OneWay}"
                                Message="{Binding StdinConflictNote}" />

                    <TextBlock Margin="0,12,0,6"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Output" />
                </StackPanel>

                <Border Grid.Row="1"
                        Margin="0,0,0,4"
                        Padding="10"
                        CornerRadius="6"
                        BorderThickness="1"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                    <Grid>
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemsSource="{Binding Output}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Text}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <TextBlock HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   MaxWidth="420"
                                   TextAlignment="Center"
                                   Style="{StaticResource Tertiary}"
                                   Visibility="{Binding HasRun, Converter={StaticResource InverseBoolToVisibility}}"
                                   Text="Nothing has run yet. Output streams here line by line once you press Execute, and the same invocation appears in the Activity panel." />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Footer: validation, then navigation. -->
        <Border Grid.Row="3"
                Padding="24,12,24,16"
                Margin="0,10,0,0"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource SystemFillColorCriticalBrush}"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasValidationSummary, Converter={StaticResource BoolToVisibility}}"
                               Text="{Binding ValidationSummary}" />
                    <TextBlock FontSize="12"
                               Style="{StaticResource Secondary}"
                               Text="{Binding ResultMessage}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0"
                               Content="Back"
                               IsEnabled="{Binding CanGoBack}"
                               Command="{Binding BackCommand}" />
                    <ui:Button Margin="0,0,8,0"
                               Content="Next"
                               IsEnabled="{Binding CanGoNext}"
                               Visibility="{Binding IsReview, Converter={StaticResource InverseBoolToVisibility}}"
                               Command="{Binding NextCommand}" />
                    <ui:Button Margin="0,0,8,0"
                               Appearance="Primary"
                               Content="Execute"
                               IsEnabled="{Binding CanExecute}"
                               Visibility="{Binding IsReview, Converter={StaticResource BoolToVisibility}}"
                               Command="{Binding ExecuteCommand}" />
                    <!--
                        After a successful run Execute is locked so a setup verb is not applied twice by
                        a stray click; this is the deliberate way back to a fresh review page. Going
                        Back, or changing an answer, also unlocks it.
                    -->
                    <ui:Button Margin="0,0,8,0"
                               Content="Run again"
                               Visibility="{Binding CanRunAgain, Converter={StaticResource BoolToVisibility}}"
                               Command="{Binding RunAgainCommand}" />
                    <!--
                        Same command, three meanings: before a run it abandons, during one it asks
                        whether to stop the command (the overlay below), after one it dismisses.
                    -->
                    <ui:Button Content="Cancel"
                               Visibility="{Binding HasRun, Converter={StaticResource InverseBoolToVisibility}}"
                               Command="{Binding CancelCommand}" />
                    <ui:Button Content="Close"
                               Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}"
                               Command="{Binding CancelCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Stop confirmation. Raised by Cancel, and by closing the window (X / Alt+F4), while a
            command is running: a setup verb writes configuration, so ending one partway can leave
            it half-applied and that should be a decision, not a click. Covers everything below the
            title bar and leaves the title bar alone so the window stays closable — a close attempt
            just raises this again. An overlay rather than a modal dialog on purpose: it is raised
            from Window.Closing, where a blocking dialog could hold up an app exit.
        -->
        <Grid Grid.Row="1"
              Grid.RowSpan="3"
              Background="#B0000000"
              Visibility="{Binding IsStopConfirmVisible, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="560"
                    Margin="24"
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <StackPanel>
                    <TextBlock FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                               Text="Stop the running setup command?" />

                    <TextBlock Margin="0,8,0,16"
                               FontSize="12"
                               Style="{StaticResource Secondary}"
                               Text="{Binding StopConfirmMessage}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <ui:Button Margin="0,0,8,0"
                                   Content="Keep running"
                                   Command="{Binding KeepRunningCommand}" />
                        <ui:Button Appearance="Primary"
                                   Content="Stop the command"
                                   Command="{Binding ConfirmStopCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
