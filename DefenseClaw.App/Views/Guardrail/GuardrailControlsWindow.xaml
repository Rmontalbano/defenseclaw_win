<ui:FluentWindow x:Class="DefenseClaw.App.Views.Guardrail.GuardrailControlsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:gr="clr-namespace:DefenseClaw.App.Views.Guardrail"
                 Title="Guardrail controls"
                 Width="760"
                 Height="760"
                 MinWidth="560"
                 MinHeight="480"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen"
                 AutomationProperties.Name="Guardrail controls">
    <!--
        A window around GuardrailControlsView, so the Setup tile grid and the Overview guardrail tile can open the controls
        without a panel of their own (see GuardrailControlsWindow.Open). One instance at a time: opening it again brings it forward.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Guardrail controls" ShowMinimize="True" ShowMaximize="False" />

        <gr:GuardrailControlsView x:Name="Controls" Grid.Row="1" />
    </Grid>
</ui:FluentWindow>
