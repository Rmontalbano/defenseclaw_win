<ui:FluentWindow x:Class="DefenseClaw.App.Views.Updates.UpdatesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:wizards="clr-namespace:DefenseClaw.App.Views.Wizards"
                 Title="DefenseClaw Updates"
                 Width="820"
                 Height="820"
                 MinWidth="640"
                 MinHeight="540"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!--
        Reports installed-vs-latest, reads three small sidecar files off the release to describe
        trust honestly (Authenticode + sigstore + stub-asset sanity), and — in the upgrade card —
        stages and runs the target release's own upgrade resolver.

        The upgrade path is the only thing in this window that changes the machine, and it does so
        the way every other mutation in this app does: through CliRunner, with the exact argv on
        screen before it runs. Check, verify and run are three separate clicks; the run is behind a
        confirm overlay. Nothing here is automatic.
    -->
    <ui:FluentWindow.Resources>
        <wizards:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Tertiary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Mono" TargetType="TextBox">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="16" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,0,14" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Ok / Warn / Bad / Neutral share one colour key, as elsewhere in this app. -->
        <Style x:Key="Badge" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="8,2,8,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
        </Style>

        <Style x:Key="BadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DefenseClaw Updates" />

        <ScrollViewer Grid.Row="1" Margin="24,4,24,16" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <ui:InfoBar Margin="0,0,0,14"
                            IsClosable="False"
                            Severity="Informational"
                            Title="Check, verify, then upgrade — one click at a time"
                            IsOpen="True"
                            Message="Checking and the trust panel are read-only. The upgrade card can also download the target release's own upgrade script, verify its SHA-256 against that release's signed checksums.txt, and run it — as three separate clicks, with the exact command shown in a confirm step first. The run is recorded in the Activity panel like every other command this app issues. Prefer to do it yourself? The copyable commands further down still work." />

                <!-- Version comparison -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <TextBlock Style="{StaticResource CardTitle}" Margin="0" Text="Version" />
                                <Border Margin="10,0,0,8">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StateBadgeKey}" Value="Ok">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateBadgeKey}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StateBadgeKey}" Value="Bad">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding StateLabel}" />
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button Content="Check again"
                                           Command="{Binding RefreshCommand}" />
                                <ui:Button Margin="8,0,0,0"
                                           Appearance="Secondary"
                                           Content="Open release page"
                                           Command="{Binding OpenReleasePageCommand}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,2,0,10" FontSize="12" Style="{StaticResource Secondary}" Text="{Binding StateDetail}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,4" FontSize="12" Style="{StaticResource Tertiary}" Text="Installed" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" FontSize="12" Text="{Binding InstalledVersionText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,4" FontSize="12" Style="{StaticResource Tertiary}" Text="Latest" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" FontSize="12" Text="{Binding LatestVersionText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,4" FontSize="12" Style="{StaticResource Tertiary}" Text="Published" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" FontSize="12" Text="{Binding PublishedAtText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,0" FontSize="12" Style="{StaticResource Tertiary}" Text="Assets" />
                            <TextBlock Grid.Row="3" Grid.Column="1" FontSize="12" Text="{Binding AssetsSummary}" />
                        </Grid>

                        <ui:InfoBar Margin="0,10,0,0"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="Rate limited"
                                    IsOpen="{Binding IsRateLimited, Mode=OneWay}"
                                    Message="GitHub's unauthenticated API rate limit (60 requests/hour/IP) was hit. Try again later." />

                        <ui:InfoBar Margin="0,10,0,0"
                                    IsClosable="False"
                                    Severity="Informational"
                                    Title="Cached result"
                                    IsOpen="{Binding FromCache, Mode=OneWay}"
                                    Message="{Binding CacheNote}" />

                        <ui:InfoBar Margin="0,10,0,0"
                                    IsClosable="False"
                                    Severity="Error"
                                    Title="Check failed"
                                    IsOpen="{Binding HasError, Mode=OneWay}"
                                    Message="{Binding ErrorMessage}" />
                    </StackPanel>
                </Border>

                <!-- Trust panel -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Trust" />

                        <!-- Authenticode -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding AuthenticodeBadgeKey}" Value="Ok">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AuthenticodeBadgeKey}" Value="Warn">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding AuthenticodeBadgeKey}" Value="Bad">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding AuthenticodeLabel}" />
                            </Border>
                            <TextBlock Grid.Column="1" FontSize="12" Style="{StaticResource Secondary}" Text="{Binding AuthenticodeDetail}" />
                        </Grid>

                        <!-- Sigstore / checksums -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SigstoreBadgeKey}" Value="Ok">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SigstoreBadgeKey}" Value="Warn">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding SigstoreBadgeKey}" Value="Bad">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding SigstoreLabel}" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock FontSize="12" Style="{StaticResource Secondary}" Text="{Binding SigstoreDetail}" />
                                <TextBlock Margin="0,2,0,0"
                                           FontSize="11"
                                           Style="{StaticResource Tertiary}"
                                           Visibility="{Binding HasChecksumsEntryCount, Converter={StaticResource BoolToVisibility}}"
                                           Text="{Binding ChecksumsEntryCountText}" />
                            </StackPanel>
                        </Grid>

                        <!-- Stub-asset sanity -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StubBadgeKey}" Value="Ok">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StubBadgeKey}" Value="Bad">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource BadgeText}" Text="Stub check" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12" Style="{StaticResource Secondary}" Text="{Binding StubSummary}" />

                            <ItemsControl Grid.Row="1" Grid.Column="1" Margin="0,6,0,0"
                                          Visibility="{Binding HasStubWarnings, Converter={StaticResource BoolToVisibility}}"
                                          ItemsSource="{Binding StubWarnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,6"
                                                Padding="10,6,10,6"
                                                CornerRadius="4"
                                                Background="{DynamicResource SystemFillColorCriticalBackgroundBrush}">
                                            <StackPanel>
                                                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding AssetName}" />
                                                <TextBlock FontSize="11" TextWrapping="Wrap" Style="{StaticResource Secondary}" Text="{Binding Reason}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    In-app upgrade. Three gated steps, top to bottom: cosign preflight, then
                    download+verify, then a confirm overlay before the resolver runs.
                -->
                <Border Style="{StaticResource Card}" DataContext="{Binding Upgrade}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Style="{StaticResource CardTitle}" Text="Upgrade this machine" />
                            <TextBlock Grid.Column="1"
                                       Margin="0,0,0,8"
                                       FontSize="12"
                                       FontFamily="Cascadia Mono, Consolas"
                                       Style="{StaticResource Tertiary}"
                                       Text="{Binding TargetVersion, StringFormat='target {0}'}" />
                        </Grid>

                        <TextBlock Margin="0,0,0,12" FontSize="12" Style="{StaticResource Secondary}" Text="{Binding ChannelNote}" />

                        <!-- Preflight: cosign, which the resolver refuses to run without -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Margin="0,0,10,0" VerticalAlignment="Top">
                                <Border.Style>
                                    <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CosignBadgeKey}" Value="Ok">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CosignBadgeKey}" Value="Warn">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding CosignBadgeKey}" Value="Bad">
                                                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Style="{StaticResource BadgeText}" Text="{Binding CosignLabel}" />
                            </Border>

                            <TextBlock Grid.Column="1" FontSize="12" Style="{StaticResource Secondary}" Text="{Binding CosignDetail}" />

                            <ui:Button Grid.Column="2"
                                       Margin="10,0,0,0"
                                       Padding="10,3,10,3"
                                       VerticalAlignment="Top"
                                       Appearance="Secondary"
                                       Content="Re-check"
                                       Command="{Binding RefreshCosignCommand}" />
                        </Grid>

                        <ui:InfoBar Margin="0,0,0,12"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="cosign is required"
                                    IsOpen="{Binding HasCosignGuidance, Mode=OneWay}"
                                    Message="{Binding CosignGuidance}" />

                        <!-- Step 1 -->
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Step 1 — download and verify" />
                        <TextBlock Margin="0,2,0,8"
                                   FontSize="11"
                                   Style="{StaticResource Tertiary}"
                                   Text="Fetches defenseclaw-upgrade.ps1 from the target release, refuses it if it is one of the placeholder stubs (under 10 KB — the real resolver is around 216 KB), and compares its SHA-256 with that release's checksums.txt. Nothing is written to disk unless both checks pass, and nothing on this machine changes." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <ui:Button Appearance="Primary"
                                       Content="Download &amp; verify"
                                       IsEnabled="{Binding CanDownload}"
                                       Command="{Binding DownloadAndVerifyCommand}" />
                            <TextBlock Margin="12,0,0,0"
                                       MaxWidth="470"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Style="{StaticResource Secondary}"
                                       Text="{Binding StagingSummary}" />
                        </StackPanel>

                        <!-- Verification detail, only once something verified -->
                        <Border Margin="0,0,0,10"
                                Padding="12"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                                Visibility="{Binding IsStaged, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,4" FontSize="11" Style="{StaticResource Tertiary}" Text="Staged at" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource Mono}" Text="{Binding StagedPath, Mode=OneWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,4" FontSize="11" Style="{StaticResource Tertiary}" Text="Size" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" FontSize="12" Text="{Binding StagedSizeText}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,4" FontSize="11" Style="{StaticResource Tertiary}" Text="SHA-256" />
                                <TextBox Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource Mono}" Text="{Binding ComputedHash, Mode=OneWay}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,4" FontSize="11" Style="{StaticResource Tertiary}" Text="checksums.txt" />
                                <TextBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,4" Style="{StaticResource Mono}" Text="{Binding ExpectedHash, Mode=OneWay}" />

                                <TextBlock Grid.Row="4" Grid.Column="1"
                                           Margin="0,2,0,0"
                                           FontSize="11"
                                           Style="{StaticResource Tertiary}"
                                           Text="{Binding ChecksumsSourceNote}" />

                                <ui:Button Grid.Row="5" Grid.Column="1"
                                           Margin="0,8,0,0"
                                           Padding="10,3,10,3"
                                           HorizontalAlignment="Left"
                                           Appearance="Secondary"
                                           Content="Show staged file"
                                           Command="{Binding ShowStagedFileCommand}" />
                            </Grid>
                        </Border>

                        <ui:InfoBar Margin="0,0,0,12"
                                    IsClosable="False"
                                    Severity="Error"
                                    Title="Verification failed — nothing was staged"
                                    IsOpen="{Binding HasStagingError, Mode=OneWay}"
                                    Message="{Binding StagingError}" />

                        <!-- Step 2 -->
                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="Step 2 — run the resolver" />
                        <TextBlock Margin="0,2,0,8"
                                   FontSize="11"
                                   Style="{StaticResource Tertiary}"
                                   Text="Opens a confirmation showing the exact argv, what the resolver will do, and how it rolls back. The button stays disabled until a verified script is staged, cosign is usable, and no other command this app issued is still running." />

                        <ui:Button Margin="0,0,0,10"
                                   Appearance="Primary"
                                   Content="Run upgrade…"
                                   IsEnabled="{Binding CanOpenConfirm}"
                                   Command="{Binding OpenConfirmCommand}" />

                        <ui:InfoBar Margin="0,0,0,4"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="After the upgrade"
                                    IsOpen="True"
                                    Message="{Binding StaleAssumptionsWarning}" />

                        <!-- Live resolver console -->
                        <StackPanel Margin="0,10,0,0" Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="Resolver output" />

                                <Border Grid.Column="1" Margin="10,0,0,0" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Badge}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ExitBadgeKey}" Value="Ok">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExitBadgeKey}" Value="Warn">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding ExitBadgeKey}" Value="Bad">
                                                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource BadgeText}" Text="{Binding ExitBadgeText}" />
                                </Border>

                                <CheckBox Grid.Column="2"
                                          VerticalAlignment="Center"
                                          Content="Pause auto-scroll"
                                          FontSize="12"
                                          IsChecked="{Binding IsOutputPaused, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="260"
                                    Padding="10"
                                    CornerRadius="6"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <Grid>
                                    <ScrollViewer x:Name="UpgradeOutputScroll" VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding Output}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontFamily="Cascadia Mono, Consolas"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Text}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsError}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>

                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               MaxWidth="420"
                                               TextAlignment="Center"
                                               Style="{StaticResource Tertiary}"
                                               Visibility="{Binding HasOutput, Converter={StaticResource InverseBoolToVisibility}}"
                                               Text="Waiting for the resolver's first line. Output streams here as it arrives, and the same invocation is in the Activity panel." />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,8,0,0" FontSize="12" Style="{StaticResource Secondary}" Text="{Binding ResultMessage}" />

                            <Border Margin="0,8,0,0"
                                    Padding="10,6,10,6"
                                    CornerRadius="4"
                                    Background="{DynamicResource SystemFillColorSuccessBackgroundBrush}"
                                    Visibility="{Binding HasVersionConfirmation, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontSize="12"
                                           FontFamily="Cascadia Mono, Consolas"
                                           TextWrapping="Wrap"
                                           Text="{Binding VersionConfirmation}" />
                            </Border>

                            <ui:InfoBar Margin="0,8,0,0"
                                        IsClosable="False"
                                        Severity="Error"
                                        Title="The resolver did not finish cleanly"
                                        IsOpen="{Binding ShowRollbackGuidance, Mode=OneWay}"
                                        Message="{Binding RollbackStory}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Upgrade guidance -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,4">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Upgrade guidance" />

                        <ui:InfoBar Margin="0,0,0,10"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="Known upgrade issue"
                                    IsOpen="True"
                                    Message="{Binding UpgradeCaveat}" />

                        <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Text="Upgrade script (release asset)" />
                        <Border Padding="10"
                                Margin="0,0,0,4"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <TextBox Style="{StaticResource Mono}" Text="{Binding UpgradeScriptCommandText, Mode=OneWay}" />
                        </Border>
                        <ui:Button Margin="0,0,0,14"
                                   Padding="10,4,10,4"
                                   Appearance="Secondary"
                                   Content="Copy"
                                   IsEnabled="{Binding HasUpgradeScriptAsset}"
                                   Command="{Binding CopyUpgradeScriptCommandCommand}" />

                        <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4" Text="Setup wizard (installer exe)" />
                        <Border Padding="10"
                                Margin="0,0,0,4"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <TextBox Style="{StaticResource Mono}" Text="{Binding SetupCommandText, Mode=OneWay}" />
                        </Border>
                        <ui:Button Padding="10,4,10,4"
                                   Appearance="Secondary"
                                   Content="Copy"
                                   IsEnabled="{Binding HasSetupAsset}"
                                   Command="{Binding CopySetupCommandCommand}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--
            Confirm overlay. Covers the content, not the title bar, so the window stays closable.
            Everything it shows about the run comes from the same source the run uses: the argv
            string is built by UpgradeRunner from the staged path, so the screen cannot drift from
            what executes.
        -->
        <Grid Grid.Row="1"
              Background="#B0000000"
              DataContext="{Binding Upgrade}"
              Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="660"
                    Margin="24"
                    Padding="22"
                    CornerRadius="10"
                    BorderThickness="1"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   Text="{Binding TargetVersion, StringFormat='Run the {0} upgrade resolver?'}" />

                        <TextBlock Margin="0,4,0,12"
                                   FontSize="12"
                                   Style="{StaticResource Secondary}"
                                   Text="Nothing has run yet. This is the exact command that will execute — the same argument list the CLI runner receives, with no shell in between." />

                        <Border Padding="12"
                                CornerRadius="6"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBox Style="{StaticResource Mono}" Text="{Binding CommandPreview, Mode=OneWay}" />
                                <TextBlock Margin="0,8,0,0"
                                           FontSize="11"
                                           Style="{StaticResource Tertiary}"
                                           Text="{Binding PowerShellPath, StringFormat='powershell.exe resolves to {0}'}" />
                            </StackPanel>
                        </Border>

                        <ui:Button Margin="0,8,0,14"
                                   Padding="10,3,10,3"
                                   Appearance="Secondary"
                                   Content="Copy command"
                                   Command="{Binding CopyCommandCommand}" />

                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="What the resolver does" />
                        <TextBlock Margin="0,4,0,12" FontSize="12" Style="{StaticResource Secondary}" Text="{Binding ResolverPlan}" />

                        <TextBlock FontSize="12" FontWeight="SemiBold" Text="If it fails" />
                        <TextBlock Margin="0,4,0,12" FontSize="12" Style="{StaticResource Secondary}" Text="{Binding RollbackStory}" />

                        <ui:InfoBar Margin="0,0,0,14"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="This app will be out of date until you restart it"
                                    IsOpen="True"
                                    Message="{Binding StaleAssumptionsWarning}" />

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <ui:Button Margin="0,0,8,0"
                                       Content="Cancel"
                                       Command="{Binding CancelConfirmCommand}" />
                            <ui:Button Appearance="Primary"
                                       Content="Run upgrade now"
                                       IsEnabled="{Binding CanRunUpgrade}"
                                       Command="{Binding RunUpgradeCommand}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
