<ui:FluentWindow x:Class="DefenseClaw.App.Views.Updates.UpdatesWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
                 xmlns:cfg="clr-namespace:DefenseClaw.App.Views.ConfigEditor"
                 Title="DefenseClaw Updates"
                 Width="820"
                 Height="820"
                 MinWidth="640"
                 MinHeight="540"
                 AutomationProperties.Name="DefenseClaw updates"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">
    <!--
        Reports installed-vs-latest, reads small sidecar files off the release to describe
        trust honestly (Authenticode status, which sigstore signature files are PUBLISHED - not whether they are
        valid, which only cosign can say, when the upgrade card runs it - and stub-asset sanity), and — in the
        upgrade card — stages and runs the target release's Setup installer or its own upgrade resolver.

        The upgrade path is the only thing in this window that changes the machine, and it does so
        the way every other mutation in this app does: through CliRunner, with the exact argv on
        screen before it runs. Check, verify and run are three separate clicks; the run is behind a
        confirm overlay. Nothing here is automatic.

        Styling is the shared Dc* design system (Themes\DefenseClaw.xaml): cards, type, tone badges
        (Tag = the view-model's Ok/Warn/Bad/Neutral key, so the badge text takes the tone colour
        too), scrim and dialog card. The only local styles are the two below that exist in exactly
        this window.

        Keyboard: F5 = Check again; Esc cancels the confirm overlay (code-behind). While the overlay
        is open the page behind it is disabled, so Tab cannot reach it.
    -->
    <ui:FluentWindow.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
    </ui:FluentWindow.InputBindings>

    <ui:FluentWindow.Resources>
        <cfg:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />
        <cfg:InverseBooleanConverter x:Key="InverseBoolean" />
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="DefenseClaw Updates" />

        <!--
            Pinned above the scrolling content (not inside it) so it is on screen whenever the window
            is: while an upgrade run is in flight UpdatesWindow.OnClosing refuses to close, and this is
            where the operator learns why. Collapsed (zero height) the rest of the time.
        -->
        <ui:InfoBar Title="Upgrade in progress — this window stays open until it finishes"
                    Grid.Row="1"
                    Margin="24,4,24,0"
                    IsClosable="False"
                    IsOpen="{Binding Upgrade.IsCloseBlocked, Mode=OneWay}"
                    Message="{Binding Upgrade.CloseBlockedNotice, Mode=OneWay}"
                    Severity="Warning" />

        <!-- The page. Disabled while the confirm overlay is open so keyboard focus stays in the dialog. -->
        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="2"
                      Padding="24,8,24,16"
                      IsEnabled="{Binding Upgrade.IsConfirmVisible, Converter={StaticResource InverseBoolean}}"
                      Style="{StaticResource DcPageScroll}">
            <StackPanel>

                <!-- The upgrade is the Setup installer replacing the runtime Setup installed: not for a managed or invalid installation, nor a developer runtime. -->
                <ui:InfoBar Title="Upgrade is off"
                            Margin="{StaticResource DcCardGap}"
                            IsClosable="False"
                            IsOpen="{Binding Upgrade.HasUpgradeBlockedReason, Mode=OneWay}"
                            Message="{Binding Upgrade.UpgradeBlockedReason, Mode=OneWay}"
                            Severity="Warning" />

                <ui:InfoBar Title="Check, verify, then upgrade — one click at a time"
                            Margin="{StaticResource DcCardGap}"
                            IsClosable="False"
                            IsOpen="True"
                            Message="Checking and the trust panel are read-only. The upgrade card can also download the target release's Setup installer (or its upgrade script, on installs where that works), compare its SHA-256 with that release's checksums.txt (and, when cosign is installed, verify that file's sigstore signature first), and run it — as three separate clicks, with the exact command shown in a confirm step first. The run is recorded in the Activity panel like every other command this app issues. Prefer to do it yourself? The copyable commands further down still work."
                            Severity="Informational" />

                <!-- Version comparison -->
                <Border Margin="{StaticResource DcCardGap}" Style="{StaticResource DcCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ctl:DcCardHeader Margin="0"
                                           VerticalAlignment="Center"
                                           Symbol="Tag24"
                                           Section="Updates"
                                           Content="Version" />
                                <Border Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DcBadge}"
                                        Tag="{Binding StateBadgeKey}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:DcStatusGlyph Tone="{Binding StateBadgeKey}" ShowDot="False" GlyphSize="12" Gap="5" />
                                        <TextBlock AutomationProperties.Name="{Binding StateLabel, StringFormat='Update status: {0}'}"
                                                   Style="{StaticResource DcBadgeText}"
                                                   Text="{Binding StateLabel}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Style="{StaticResource DcActionBar}">
                                <ui:Button AutomationProperties.HelpText="Asks GitHub for the latest release again. Shortcut: F5."
                                           Command="{Binding RefreshCommand}"
                                           Content="Check again">
                                    <ui:Button.Icon>
                                        <ctl:DcSymbolIcon Symbol="ArrowClockwise24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button Appearance="Secondary"
                                           Command="{Binding OpenReleasePageCommand}"
                                           Content="Open release page"
                                           Icon="{ctl:DcSymbolIcon Open24}" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,4,0,10"
                                   Style="{StaticResource DcCaption}"
                                   Text="{Binding StateDetail}" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource DcFieldKeyMinWidth}" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="Installed" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DcFieldValueInline}" Text="{Binding InstalledVersionText}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="Latest" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DcFieldValueInline}" Text="{Binding LatestVersionText}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="Published" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DcFieldValueInline}" Text="{Binding PublishedAtText}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="Assets" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DcFieldValueInline}" Text="{Binding AssetsSummary}" />

                            <TextBlock Grid.Row="4" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="Runtime" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DcFieldValueInline}" TextWrapping="Wrap" Text="{Binding RuntimeIdentityText}" />

                            <TextBlock Grid.Row="5" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="Features" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DcFieldValueInline}" TextWrapping="Wrap" Text="{Binding RuntimeFeaturesText}" />
                        </Grid>

                        <ui:InfoBar Title="Rate limited"
                                    Margin="0,12,0,0"
                                    IsClosable="False"
                                    IsOpen="{Binding IsRateLimited, Mode=OneWay}"
                                    Message="GitHub's unauthenticated API rate limit (60 requests/hour/IP) was hit. Try again later."
                                    Severity="Warning" />

                        <ui:InfoBar Title="Cached result"
                                    Margin="0,12,0,0"
                                    IsClosable="False"
                                    IsOpen="{Binding FromCache, Mode=OneWay}"
                                    Message="{Binding CacheNote}"
                                    Severity="Informational" />

                        <ui:InfoBar Title="Check failed"
                                    Margin="0,12,0,0"
                                    IsClosable="False"
                                    IsOpen="{Binding HasError, Mode=OneWay}"
                                    Message="{Binding ErrorMessage}"
                                    Severity="Error" />
                    </StackPanel>
                </Border>

                <!-- Trust panel -->
                <Border Margin="{StaticResource DcCardGap}" Style="{StaticResource DcCard}">
                    <StackPanel>
                        <ctl:DcCardHeader Symbol="ShieldCheckmark24" Section="Updates" Content="Trust" />

                        <!-- Authenticode -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource DcBadge}"
                                    Tag="{Binding AuthenticodeBadgeKey}">
                                <TextBlock AutomationProperties.Name="{Binding AuthenticodeLabel, StringFormat='Installer signature: {0}'}"
                                           Style="{StaticResource DcBadgeText}"
                                           Text="{Binding AuthenticodeLabel}" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource DcCaption}"
                                       Text="{Binding AuthenticodeDetail}" />
                        </Grid>

                        <!-- Sigstore / checksums -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource DcBadge}"
                                    Tag="{Binding SigstoreBadgeKey}">
                                <TextBlock AutomationProperties.Name="{Binding SigstoreLabel, StringFormat='Checksums signing: {0}'}"
                                           Style="{StaticResource DcBadgeText}"
                                           Text="{Binding SigstoreLabel}" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DcCaption}" Text="{Binding SigstoreDetail}" />
                                <TextBlock Margin="0,2,0,0"
                                           Style="{StaticResource DcCaption}"
                                           Text="{Binding ChecksumsEntryCountText}"
                                           Visibility="{Binding HasChecksumsEntryCount, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Stub-asset sanity -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource DcBadge}"
                                    Tag="{Binding StubBadgeKey}">
                                <TextBlock AutomationProperties.Name="{Binding StubSummary, StringFormat='Stub check: {0}'}"
                                           Style="{StaticResource DcBadgeText}"
                                           Text="Stub check" />
                            </Border>
                            <TextBlock Grid.Row="0"
                                       Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource DcCaption}"
                                       Text="{Binding StubSummary}" />

                            <ItemsControl Grid.Row="1"
                                          Grid.Column="1"
                                          Margin="0,8,0,0"
                                          ItemsSource="{Binding StubWarnings}"
                                          Visibility="{Binding HasStubWarnings, Converter={StaticResource BoolToVisibility}}">
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="AutomationProperties.Name" Value="{Binding AssetName}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <!-- A DcBadge row: the critical tint, and the asset name takes the tone colour. -->
                                        <Border Margin="0,0,0,6"
                                                Padding="10,6,10,6"
                                                AutomationProperties.Name="{Binding AssetName}"
                                                Style="{StaticResource DcBadge}"
                                                Tag="Bad">
                                            <StackPanel>
                                                <TextBlock FontWeight="SemiBold" Text="{Binding AssetName}" />
                                                <TextBlock Style="{StaticResource DcCaption}" Text="{Binding Reason}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </StackPanel>
                </Border>

                <!--
                    In-app upgrade. Channel picker first — the two channels are not
                    interchangeable, and which one works is decided by the install layout, not by
                    preference. Then the gated steps: cosign preflight (required on the resolver channel, optional on the installer one),
                    download+verify, and a confirm overlay before anything runs.
                -->
                <Border Margin="{StaticResource DcCardGap}"
                        DataContext="{Binding Upgrade}"
                        Style="{StaticResource DcCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ctl:DcCardHeader Grid.Column="0" Symbol="ArrowCircleUp24" Section="Updates" Content="Upgrade this machine" />
                            <TextBlock Grid.Column="1"
                                       Margin="0,0,0,8"
                                       FontFamily="{DynamicResource DcMonoFontFamily}"
                                       Style="{StaticResource DcCaption}"
                                       Text="{Binding TargetVersion, StringFormat='target {0}'}" />
                        </Grid>

                        <!-- Channel picker. Switching drops any staging, by design. -->
                        <Border Margin="0,0,0,12"
                                Padding="12"
                                Style="{StaticResource DcSubtleRow}">
                            <StackPanel>
                                <ctl:DcCardHeader Margin="0,0,0,4" Symbol="BranchFork24" Section="Updates" Content="Channel" />

                                <RadioButton Content="Setup installer (recommended on this install)"
                                             GroupName="UpgradeChannel"
                                             IsChecked="{Binding IsSetupInstallerSelected, Mode=TwoWay}" />
                                <RadioButton Margin="0,2,0,0"
                                             Content="Resolver script"
                                             GroupName="UpgradeChannel"
                                             IsChecked="{Binding IsResolverScriptSelected, Mode=TwoWay}" />

                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource DcCaption}"
                                           Text="{Binding ChannelReasonText}" />
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="0,0,0,12" Style="{StaticResource DcCaption}" Text="{Binding ChannelNote}" />

                        <!--
                            Preflight: cosign. A hard gate on the resolver channel (the script refuses to run without it); optional on the
                            installer channel, where it decides whether the signature on checksums.txt is verified. The row's words follow the channel.
                        -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Top"
                                    Style="{StaticResource DcBadge}"
                                    Tag="{Binding CosignBadgeKey}">
                                <TextBlock AutomationProperties.Name="{Binding CosignLabel, StringFormat='cosign: {0}'}"
                                           Style="{StaticResource DcBadgeText}"
                                           Text="{Binding CosignLabel}" />
                            </Border>

                            <TextBlock Grid.Column="1"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource DcCaption}"
                                       Text="{Binding CosignDetail}" />

                            <ui:Button Grid.Column="2"
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Top"
                                       Appearance="Secondary"
                                       AutomationProperties.HelpText="Looks for cosign on this machine again."
                                       Command="{Binding RefreshCosignCommand}"
                                       Content="Re-check"
                                       Icon="{ctl:DcSymbolIcon ArrowSync24}" />
                        </Grid>

                        <ui:InfoBar Title="cosign is required"
                                    Margin="0,0,0,12"
                                    IsClosable="False"
                                    IsOpen="{Binding ShowCosignGuidance, Mode=OneWay}"
                                    Message="{Binding CosignGuidance}"
                                    Severity="Warning" />

                        <!-- Step 1 -->
                        <ctl:DcCardHeader Margin="0,0,0,2" Symbol="ArrowDownload24" Section="Updates" Content="Step 1 — download and verify" />
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource DcCaption}" Text="{Binding StagingStepNote}" />

                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <ui:Button Appearance="Primary"
                                       Command="{Binding DownloadAndVerifyCommand}"
                                       Content="Download &amp; verify"
                                       Icon="{ctl:DcSymbolIcon ArrowDownload24}"
                                       IsEnabled="{Binding CanDownload}" />
                            <StackPanel Margin="12,0,0,0"
                                        MaxWidth="470"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource DcCaption}" Text="{Binding StagingSummary}" />
                                <!-- Installer channel only: a ~270 MB download deserves a number. -->
                                <TextBlock Margin="0,2,0,0"
                                           FontFamily="{DynamicResource DcMonoFontFamily}"
                                           Style="{StaticResource DcCaption}"
                                           Text="{Binding DownloadProgressText}"
                                           Visibility="{Binding HasDownloadProgress, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>

                        <!-- Verification detail, only once something verified -->
                        <Border Margin="0,0,0,12"
                                Padding="12"
                                Style="{StaticResource DcSubtleRow}"
                                Visibility="{Binding IsStaged, Converter={StaticResource BoolToVisibility}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" MinWidth="{StaticResource DcFieldKeyMinWidth}" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="Staged at" />
                                <TextBox Grid.Row="0"
                                         Grid.Column="1"
                                         Margin="0,0,0,4"
                                         AutomationProperties.Name="Path of the staged file"
                                         Style="{StaticResource DcMonoTextBox}"
                                         Text="{Binding StagedPath, Mode=OneWay}" />

                                <TextBlock Grid.Row="1" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="Size" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DcFieldValueInline}" Text="{Binding StagedSizeText}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="SHA-256" />
                                <TextBox Grid.Row="2"
                                         Grid.Column="1"
                                         Margin="0,0,0,4"
                                         AutomationProperties.Name="SHA-256 computed from the staged file"
                                         Style="{StaticResource DcMonoTextBox}"
                                         Text="{Binding ComputedHash, Mode=OneWay}" />

                                <TextBlock Grid.Row="3" Grid.Column="0" Style="{StaticResource DcFieldLabelInline}" Text="checksums.txt" />
                                <TextBox Grid.Row="3"
                                         Grid.Column="1"
                                         Margin="0,0,0,4"
                                         AutomationProperties.Name="Expected SHA-256 from checksums.txt"
                                         Style="{StaticResource DcMonoTextBox}"
                                         Text="{Binding ExpectedHash, Mode=OneWay}" />

                                <TextBlock Grid.Row="4"
                                           Grid.Column="1"
                                           Margin="0,2,0,0"
                                           Style="{StaticResource DcCaption}"
                                           Text="{Binding ChecksumsSourceNote}" />

                                <ui:Button Grid.Row="5"
                                           Grid.Column="1"
                                           Margin="0,8,0,0"
                                           HorizontalAlignment="Left"
                                           Appearance="Secondary"
                                           AutomationProperties.HelpText="Reveals the staged file in Explorer."
                                           Command="{Binding ShowStagedFileCommand}"
                                           Content="Show staged file"
                                           Icon="{ctl:DcSymbolIcon FolderOpen24}" />
                            </Grid>
                        </Border>

                        <ui:InfoBar Title="Verification failed — nothing was staged"
                                    Margin="0,0,0,12"
                                    IsClosable="False"
                                    IsOpen="{Binding HasStagingError, Mode=OneWay}"
                                    Message="{Binding StagingError}"
                                    Severity="Error" />

                        <!-- Step 2 -->
                        <ctl:DcCardHeader Margin="0,0,0,2" Symbol="Play24" Section="Updates" Content="Step 2 — run the upgrade" />
                        <TextBlock Margin="0,0,0,8" Style="{StaticResource DcCaption}" Text="{Binding RunStepNote}" />

                        <ui:Button x:Name="RunUpgradeButton"
                                   Margin="0,0,0,12"
                                   Appearance="Primary"
                                   AutomationProperties.HelpText="Opens a confirmation that shows the exact command. Nothing runs until you confirm."
                                   Command="{Binding OpenConfirmCommand}"
                                   Content="Run upgrade…"
                                   Icon="{ctl:DcSymbolIcon ArrowCircleUp24}"
                                   IsEnabled="{Binding CanOpenConfirm}" />

                        <ui:InfoBar Title="After the upgrade"
                                    Margin="0,0,0,4"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{Binding StaleAssumptionsWarning}"
                                    Severity="Warning" />

                        <!-- Live resolver console -->
                        <StackPanel Margin="0,12,0,0" Visibility="{Binding IsConsoleVisible, Converter={StaticResource BoolToVisibility}}">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ctl:DcCardHeader Grid.Column="0"
                                           Margin="0"
                                           VerticalAlignment="Center"
                                           Symbol="Code24"
                                           Section="Updates"
                                           Content="{Binding ConsoleTitle}" />

                                <Border Grid.Column="1"
                                        Margin="10,0,0,0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource DcBadge}"
                                        Tag="{Binding ExitBadgeKey}">
                                    <TextBlock AutomationProperties.Name="{Binding ExitBadgeText, StringFormat='Run result: {0}'}"
                                               Style="{StaticResource DcBadgeText}"
                                               Text="{Binding ExitBadgeText}" />
                                </Border>

                                <CheckBox Grid.Column="2"
                                          VerticalAlignment="Center"
                                          Content="Pause auto-scroll"
                                          IsChecked="{Binding IsOutputPaused, Mode=TwoWay}" />
                            </Grid>

                            <Border Height="260">
                                <Grid>
                                    <!-- Selectable and copyable; follows the newest line unless auto-scroll is paused. -->
                                    <ctl:DcCommandOutput FollowTail="{Binding IsFollowingOutput}"
                                                         OutputName="Upgrade output"
                                                         Text="{Binding OutputText}" />

                                    <TextBlock MaxWidth="420"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource DcEmptyDetail}"
                                               Text="No output yet. Anything printed streams here as it arrives, and the same invocation is in the Activity panel — a quiet installer run may print almost nothing."
                                               IsHitTestVisible="False"
                                               Visibility="{Binding HasOutput, Converter={StaticResource InverseBoolToVisibility}}" />
                                </Grid>
                            </Border>

                            <TextBlock Margin="0,8,0,0" Style="{StaticResource DcCaption}" Text="{Binding ResultMessage}" />

                            <!-- The tone is the badge's: success-tinted, and the text takes the success colour. -->
                            <Border Margin="0,8,0,0"
                                    Padding="10,6,10,6"
                                    Style="{StaticResource DcBadge}"
                                    Tag="Ok"
                                    Visibility="{Binding HasVersionConfirmation, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock FontFamily="{DynamicResource DcMonoFontFamily}"
                                           FontSize="12"
                                           Text="{Binding VersionConfirmation}"
                                           TextWrapping="Wrap" />
                            </Border>

                            <ui:InfoBar Title="The upgrade did not finish cleanly"
                                        Margin="0,8,0,0"
                                        IsClosable="False"
                                        IsOpen="{Binding ShowRollbackGuidance, Mode=OneWay}"
                                        Message="{Binding RollbackStory}"
                                        Severity="Error" />
                        </StackPanel>
                    </StackPanel>
                </Border>


                <!-- Upgrade guidance -->
                <Border Style="{StaticResource DcCard}">
                    <StackPanel>
                        <ctl:DcCardHeader Symbol="Info24" Section="Updates" Content="Upgrade guidance" />

                        <ui:InfoBar Title="Known upgrade issue"
                                    Margin="0,0,0,12"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{Binding UpgradeCaveat}"
                                    Severity="Warning" />

                        <!-- Setup exe first: it is the channel that works on this install layout. -->
                        <ctl:DcCardHeader Margin="0,0,0,4" Symbol="Rocket24" Section="Updates" Content="Setup installer (recommended)" />
                        <Border Margin="0,0,0,8" Style="{StaticResource DcCodeBlock}">
                            <TextBox AcceptsReturn="True"
                                     AutomationProperties.Name="Setup installer command"
                                     Style="{StaticResource DcMonoTextBox}"
                                     Text="{Binding SetupCommandText, Mode=OneWay}" />
                        </Border>
                        <ui:Button Margin="0,0,0,16"
                                   Appearance="Secondary"
                                   AutomationProperties.Name="Copy the Setup installer command"
                                   Command="{Binding CopySetupCommandCommand}"
                                   Content="Copy"
                                   Icon="{ctl:DcSymbolIcon Copy24}"
                                   IsEnabled="{Binding HasSetupAsset}" />

                        <ctl:DcCardHeader Margin="0,0,0,4" Symbol="DocumentText24" Section="Updates" Content="Upgrade script (release asset)" />
                        <Border Margin="0,0,0,8" Style="{StaticResource DcCodeBlock}">
                            <TextBox AcceptsReturn="True"
                                     AutomationProperties.Name="Upgrade script command"
                                     Style="{StaticResource DcMonoTextBox}"
                                     Text="{Binding UpgradeScriptCommandText, Mode=OneWay}" />
                        </Border>
                        <ui:Button Appearance="Secondary"
                                   AutomationProperties.Name="Copy the upgrade script command"
                                   Command="{Binding CopyUpgradeScriptCommandCommand}"
                                   Content="Copy"
                                   Icon="{ctl:DcSymbolIcon Copy24}"
                                   IsEnabled="{Binding HasUpgradeScriptAsset}" />
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!--
            Confirm overlay. Covers the content, not the title bar, so the window stays closable.
            Everything it shows about the run comes from the same source the run uses: the argv
            string is built by UpgradeRunner from the staged path, so the screen cannot drift from
            what executes.

            Review tier: running a Setup exe / resolver script is not a `defenseclaw` verb, so
            CommandTiers has nothing to classify; it is a state-changing action by any reading (it
            replaces the installed binaries and restarts the gateway) and the dialog says so with a
            Warn badge. There is no danger styling because nothing is deleted from this machine's
            data: %USERPROFILE%\.defenseclaw is preserved (see ResolverPlan).
        -->
        <Grid x:Name="ConfirmOverlay"
              Grid.Row="1"
              Grid.RowSpan="2"
              DataContext="{Binding Upgrade}"
              Style="{StaticResource DcScrim}"
              Visibility="{Binding IsConfirmVisible, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="660"
                    Margin="24"
                    Style="{StaticResource DcDialogCard}">
                <ScrollViewer MaxHeight="620" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                            <TextBlock Margin="0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource DcSectionHeader}"
                                       Text="{Binding ConfirmTitle}" />
                            <Border Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource DcBadge}"
                                    Tag="Warn">
                                <TextBlock AutomationProperties.Name="Review tier: state-changing"
                                           Style="{StaticResource DcBadgeText}"
                                           Text="STATE-CHANGING" />
                            </Border>
                        </StackPanel>

                        <TextBlock Margin="0,0,0,4"
                                   FontWeight="SemiBold"
                                   Style="{StaticResource DcBody}"
                                   Text="This restarts the DefenseClaw gateway." />
                        <TextBlock Margin="0,0,0,12"
                                   Style="{StaticResource DcCaption}"
                                   Text="Nothing has run yet. This is the exact command that will execute — the same argument list the CLI runner receives, with no shell in between." />

                        <Border Style="{StaticResource DcCodeBlock}">
                            <StackPanel>
                                <TextBox AutomationProperties.Name="Exact command that will run"
                                         Style="{StaticResource DcMonoTextBox}"
                                         Text="{Binding CommandPreview, Mode=OneWay}" />
                                <!-- Only the resolver channel has an interpreter to disambiguate. -->
                                <TextBlock Margin="0,8,0,0"
                                           Style="{StaticResource DcCaption}"
                                           Text="{Binding PowerShellPath, StringFormat='powershell.exe resolves to {0}'}"
                                           Visibility="{Binding IsInstallerChannel, Converter={StaticResource InverseBoolToVisibility}}" />
                            </StackPanel>
                        </Border>

                        <ui:Button Margin="0,8,0,16"
                                   Appearance="Secondary"
                                   Command="{Binding CopyCommandCommand}"
                                   Content="Copy command"
                                   Icon="{ctl:DcSymbolIcon Copy24}" />

                        <ctl:DcCardHeader Margin="0,0,0,4" Symbol="Info24" Section="Updates" Content="What this does" />
                        <TextBlock Margin="0,0,0,12" Style="{StaticResource DcCaption}" Text="{Binding ResolverPlan}" />

                        <ctl:DcCardHeader Margin="0,0,0,4" Symbol="Warning24" Tint="Orange" Content="If it fails" />
                        <TextBlock Margin="0,0,0,12" Style="{StaticResource DcCaption}" Text="{Binding RollbackStory}" />

                        <ui:InfoBar Title="This app will be out of date until you restart it"
                                    Margin="0,0,0,16"
                                    IsClosable="False"
                                    IsOpen="True"
                                    Message="{Binding StaleAssumptionsWarning}"
                                    Severity="Warning" />

                        <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                            <ui:Button x:Name="ConfirmCancelButton"
                                       AutomationProperties.HelpText="Closes this confirmation without running anything. Shortcut: Esc."
                                       Command="{Binding CancelConfirmCommand}"
                                       Content="Cancel"
                                       Icon="{ctl:DcSymbolIcon Dismiss24}" />
                            <ui:Button Margin="8,0,0,0"
                                       Appearance="Primary"
                                       Command="{Binding RunUpgradeCommand}"
                                       Content="Run upgrade now"
                                       Icon="{ctl:DcSymbolIcon ArrowCircleUp24}"
                                       IsEnabled="{Binding CanRunUpgrade}" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
