<Window x:Class="DefenseClaw.App.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
        Title="DefenseClaw"
        Width="360"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual"
        AutomationProperties.Name="DefenseClaw status">
    <Window.Resources>
        <!--
            A row that is a button (a metric, a finding): no chrome at rest, a subtle plate on hover and press, the design system's inset focus
            ring for the keyboard. The negative margin lets the plate reach into the card's padding so the text stays on the card's edge.
        -->
        <Style x:Key="FlyoutRowButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,4,6,4" />
            <Setter Property="Margin" Value="-6,0,-6,0" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DcFocusVisualStyleInset}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Plate"
                                Background="{TemplateBinding Background}"
                                CornerRadius="{DynamicResource DcRadiusS}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource DcSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Plate" Property="Background" Value="{DynamicResource DcSelectedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- The filled part of a metric bar; Tag is the row's bar tone (Accent = the theme's accent, else the design system's tones). -->
        <Style x:Key="MeterFill" TargetType="Border">
            <Setter Property="CornerRadius" Value="{DynamicResource DcBarRadius}" />
            <Setter Property="Background" Value="{DynamicResource DcToneNeutralBrush}" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Accent">
                    <Setter Property="Background" Value="{DynamicResource DcAccentBrush}" />
                </Trigger>
                <Trigger Property="Tag" Value="Bad">
                    <Setter Property="Background" Value="{DynamicResource DcToneCriticalBrush}" />
                </Trigger>
                <Trigger Property="Tag" Value="Warn">
                    <Setter Property="Background" Value="{DynamicResource DcToneHighBrush}" />
                </Trigger>
                <Trigger Property="Tag" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource DcToneOkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- A metric's number: secondary when zero or unknown (Neutral), primary text for activity, the tone's colour for blocks and findings. -->
        <Style x:Key="MetricValue" TargetType="TextBlock" BasedOn="{StaticResource DcToneText}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Primary">
                    <Setter Property="Foreground" Value="{DynamicResource DcTextPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenNoConnectors" TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding ShowNoConnectors}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WhenNoFindings" TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasFindings}" Value="False">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The card's hairline between sections (the Mac's Divider). -->
        <Style x:Key="FlyoutRule" TargetType="Border">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="0,10,0,10" />
            <Setter Property="Background" Value="{DynamicResource DcBorderBrush}" />
        </Style>

        <!-- Footer buttons: the small, text-size controls of the Mac's footer. -->
        <Style x:Key="FooterButton" TargetType="ui:Button" BasedOn="{StaticResource DefaultUiButtonStyle}">
            <Setter Property="Padding" Value="8,5,8,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
    </Window.Resources>

    <!--
        The left-click tray flyout, after the Mac's menu-bar popover: header, connectors, three metric rows, the newest findings, the footer.
        Every colour, font, radius and shadow is a design-system token, so the four looks and light / dark restyle it live.
    -->
    <Border Style="{StaticResource DcDialogCard}"
            Margin="10"
            Padding="12"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Top"
            Effect="{DynamicResource DcFlyoutShadow}">
        <!-- The shadow is a token: Default keeps today's drop shadow, Linear and TUI use the hairline border alone. -->

        <StackPanel>
            <!-- Header: shield, name, what the gateway is doing, the state. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ctl:DcSymbolIcon Grid.Column="0"
                                  Symbol="Shield24"
                                  FontSize="24"
                                  Margin="0,0,10,0"
                                  VerticalAlignment="Center"
                                  Foreground="{DynamicResource DcAccentBrush}" />

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource DcCardTitle}"
                               Text="DefenseClaw" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               ToolTip="{Binding HeaderCaption}"
                               Text="{Binding HeaderCaption}" />
                </StackPanel>

                <Border Grid.Column="2"
                        Style="{StaticResource DcBadge}"
                        Tag="{Binding StateTone}"
                        Padding="8,3,10,3"
                        Margin="8,0,0,0"
                        MaxWidth="150"
                        VerticalAlignment="Center"
                        ToolTip="{Binding StateDetail}">
                    <StackPanel Orientation="Horizontal">
                        <ctl:DcStatusGlyph Tone="{Binding StateTone}"
                                           Margin="0,0,6,0" />
                        <TextBlock Style="{StaticResource DcBadgeText}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding StateLabel}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Style="{StaticResource DcToneText}"
                       Tag="Warn"
                       FontSize="12"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Visibility="{Binding HasFailModeNote, Converter={StaticResource BoolToVisibility}}"
                       Text="{Binding FailModeNote}" />

            <Border Style="{StaticResource FlyoutRule}" />

            <!-- One line per connector: state dot, name, mode, and on the right what the gateway counted. -->
            <TextBlock Style="{StaticResource WhenNoConnectors}"
                       Text="No connector configured" />
            <ItemsControl ItemsSource="{Binding Connectors}"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,2,0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ctl:DcStatusGlyph Grid.Column="0"
                                               Tone="{Binding Tone}"
                                               DotSize="8"
                                               GlyphSize="14"
                                               Margin="0,0,8,0" />
                            <TextBlock Grid.Column="1"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource DcTextPrimaryBrush}"
                                       Text="{Binding Name}" />
                            <TextBlock Grid.Column="2"
                                       Style="{StaticResource DcCaption}"
                                       Margin="8,0,8,0"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"
                                       Visibility="{Binding HasMode, Converter={StaticResource BoolToVisibility}}"
                                       Text="{Binding Mode}" />
                            <TextBlock Grid.Column="3"
                                       Style="{StaticResource DcCaption}"
                                       HorizontalAlignment="Right"
                                       TextWrapping="NoWrap"
                                       Text="{Binding Counts}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Hook Calls / Blocks / Findings: a number, a 4 px bar, and a door into the dashboard. -->
            <ItemsControl ItemsSource="{Binding Metrics}"
                          Margin="0,8,0,0"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource FlyoutRowButton}"
                                Command="{Binding OpenCommand}"
                                AutomationProperties.Name="{Binding AutomationName}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource DcTextPrimaryBrush}"
                                               Text="{Binding Title}" />
                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource DcCaption}"
                                               Margin="8,0,8,0"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap"
                                               Text="{Binding Detail}" />
                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource MetricValue}"
                                               Tag="{Binding ValueTone}"
                                               Text="{Binding Value}" />
                                </Grid>
                                <Grid Height="4"
                                      Margin="0,5,0,0">
                                    <Border Background="{DynamicResource DcBorderBrush}"
                                            CornerRadius="{DynamicResource DcBarRadius}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="{Binding Fill}" />
                                            <ColumnDefinition Width="{Binding Rest}" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource MeterFill}"
                                                Tag="{Binding BarTone}" />
                                    </Grid>
                                </Grid>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- When the numbers are from. -->
            <TextBlock Style="{StaticResource DcCaption}"
                       Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTip="{Binding UpdatedText}"
                       Text="{Binding UpdatedText}" />

            <Border Style="{StaticResource FlyoutRule}" />

            <!--
                The newest unacknowledged findings; each one opens Alerts. The heading's link is the way into the reviewed acknowledge flow:
                the flyout itself never acknowledges anything.
            -->
            <Grid Margin="0,0,0,2"
                  Visibility="{Binding HasFindings, Converter={StaticResource BoolToVisibility}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Style="{StaticResource DcCaption}"
                           VerticalAlignment="Center"
                           Text="Recent findings" />
                <Button Grid.Column="1"
                        Style="{StaticResource FlyoutRowButton}"
                        Margin="8,-3,-6,-3"
                        Padding="6,3,6,3"
                        Command="{Binding ReviewAcknowledgeCommand}"
                        AutomationProperties.Name="Review acknowledge"
                        AutomationProperties.HelpText="Opens Alerts, where unacknowledged findings are reviewed and acknowledged. Nothing is acknowledged from here.">
                    <TextBlock FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DcAccentHoverBrush}"
                               Text="Review acknowledge…" />
                </Button>
            </Grid>
            <TextBlock Style="{StaticResource WhenNoFindings}"
                       TextWrapping="Wrap"
                       Text="{Binding FindingsEmptyText}" />
            <ItemsControl ItemsSource="{Binding RecentFindings}"
                          Focusable="False">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Style="{StaticResource FlyoutRowButton}"
                                Padding="6,3,6,3"
                                Command="{Binding OpenCommand}"
                                ToolTip="{Binding ToolTipText}"
                                AutomationProperties.Name="{Binding AutomationName}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctl:DcStatusGlyph Grid.Column="0"
                                                   Tone="{Binding Tone}"
                                                   DotSize="8"
                                                   GlyphSize="14"
                                                   Margin="0,0,8,0" />
                                <TextBlock Grid.Column="1"
                                           FontSize="12"
                                           Foreground="{DynamicResource DcTextPrimaryBrush}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Text="{Binding Kind}" />
                                <TextBlock Grid.Column="2"
                                           Style="{StaticResource DcToneText}"
                                           Tag="{Binding Tone}"
                                           FontSize="12"
                                           Margin="8,0,0,0"
                                           Text="{Binding Severity}" />
                                <TextBlock Grid.Column="3"
                                           Style="{StaticResource DcCaption}"
                                           Margin="6,0,0,0"
                                           TextWrapping="NoWrap"
                                           Text="{Binding When}" />
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <Border Style="{StaticResource FlyoutRule}" />

            <!-- Footer: Open Dashboard, Settings, Pause / Resume monitoring, Exit. -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:Button Grid.Column="0"
                           Style="{StaticResource FooterButton}"
                           Appearance="Primary"
                           Content="Open Dashboard"
                           Icon="{ctl:DcSymbolIcon Open24}"
                           Command="{Binding OpenDashboardCommand}" />

                <ui:Button Grid.Column="1"
                           Style="{StaticResource FooterButton}"
                           Icon="{ctl:DcSymbolIcon Settings24}"
                           ToolTip="Settings"
                           AutomationProperties.Name="Settings"
                           AutomationProperties.HelpText="Opens the dashboard."
                           Command="{Binding OpenSettingsCommand}" />

                <ui:Button Grid.Column="3"
                           Style="{StaticResource FooterButton}"
                           AutomationProperties.Name="{Binding PauseAutomationName}"
                           AutomationProperties.HelpText="Stops or restarts this app's polling of the gateway. The gateway itself keeps running."
                           Command="{Binding TogglePauseCommand}">
                    <StackPanel Orientation="Horizontal">
                        <ctl:DcSymbolIcon Symbol="{Binding PauseSymbol}"
                                          Style="{StaticResource DcIcon}"
                                          Margin="0,0,4,0" />
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding PauseText}" />
                    </StackPanel>
                </ui:Button>

                <ui:Button Grid.Column="4"
                           Style="{StaticResource FooterButton}"
                           Margin="0"
                           Content="Exit"
                           AutomationProperties.HelpText="Quit DefenseClaw for real. Closing the dashboard only hides it to the tray."
                           Command="{Binding ExitCommand}" />
            </Grid>

            <!-- Version, endpoint and last poll: one caption line. -->
            <TextBlock Style="{StaticResource DcCaption}"
                       Margin="0,8,0,0"
                       TextTrimming="CharacterEllipsis"
                       TextWrapping="NoWrap"
                       ToolTip="{Binding FactsLine}"
                       Text="{Binding FactsLine}" />
        </StackPanel>
    </Border>
</Window>
