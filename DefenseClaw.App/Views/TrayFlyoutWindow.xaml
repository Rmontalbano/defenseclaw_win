<Window x:Class="DefenseClaw.App.Views.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="DefenseClaw"
        Width="320"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="Manual">
    <Border Margin="10"
            Padding="16"
            CornerRadius="8"
            BorderThickness="1"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            Background="{DynamicResource ApplicationBackgroundBrush}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="Black" />
        </Border.Effect>

        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="10"
                         Height="10"
                         VerticalAlignment="Center"
                         Fill="{Binding StateBrush}" />
                <TextBlock Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding StateLabel}" />
            </StackPanel>

            <TextBlock Margin="0,6,0,0"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding StateDetail}" />

            <Separator Margin="0,12,0,10" Opacity="0.4" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Margin="0,0,10,4"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12" Text="Connectors" />
                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="12" TextWrapping="Wrap" Text="{Binding ConnectorSummary}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,0,10,4"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12" Text="Alerts" />
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="12" TextWrapping="Wrap" Text="{Binding AlertSummary}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Margin="0,0,10,4"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12" Text="Gateway" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="12" TextWrapping="Wrap" Text="{Binding VersionSummary}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Margin="0,0,10,0"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           FontSize="12" Text="Polled" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           FontSize="12" Text="{Binding LastPolled}" />
            </Grid>

            <StackPanel Margin="0,16,0,0" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Appearance="Primary"
                           Content="Open Dashboard"
                           Command="{Binding OpenDashboardCommand}" />
                <ui:Button Margin="8,0,0,0"
                           Content="Exit"
                           Command="{Binding ExitCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
