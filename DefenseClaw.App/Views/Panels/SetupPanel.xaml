<UserControl x:Class="DefenseClaw.App.Views.Panels.SetupPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:wizards="clr-namespace:DefenseClaw.App.Views.Wizards"
             xmlns:shell="clr-namespace:DefenseClaw.App.Views.Shell">
    <!--
        The Setup hub. Cards are generated from the CLI's own setup help at runtime, so this
        file describes a card, not a catalogue - adding a setup target upstream needs no edit
        here. Uncertified targets stay launchable and carry their warning into the wizard; targets
        that cannot work on Windows sit in a last group, disabled, each with its reason.

        Shared styling: Themes\DefenseClaw.xaml (Dc*). Local resources are the three visuals that exist
        in this panel only. Keyboard: Ctrl+F focuses the search box, Esc closes the guardrail review,
        F5 runs RefreshCommand (bound by the shell).
    -->
    <UserControl.Resources>
        <wizards:InverseBoolToVisibilityConverter x:Key="InverseBoolToVisibility" />

        <!-- A connector or roster row's name. -->
        <Style x:Key="ChipName" TargetType="TextBlock" BasedOn="{StaticResource DcBody}">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- A caution note: caption size, caution colour (theme brush, so it follows light/dark). -->
        <Style x:Key="WarnCaption" TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
            <Setter Property="Foreground" Value="{DynamicResource DcToneHighBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar. No search box up here: the wizard search filters the cards further down this scrolling page, so it stays over them. -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="ShieldSettings24"
                           ctl:DcIcon.Section="Setup"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}">
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon DocumentEdit24}"
                               Command="{Binding OpenConfigEditorCommand}"
                               ToolTip="Config editor - edit config.yaml with backup, validation and restore"
                               AutomationProperties.Name="Config editor"
                               AutomationProperties.HelpText="Edit config.yaml with backup, validation and restore." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowCircleUp24}"
                               Command="{Binding OpenUpdatesCommand}"
                               ToolTip="Updates &amp; trust - installed vs latest release, signing and provenance status"
                               AutomationProperties.Name="Updates &amp; trust"
                               AutomationProperties.HelpText="Installed vs latest release, signing and provenance status." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowSync24}"
                               Command="{Binding ReloadCatalogCommand}"
                               ToolTip="Re-read catalog - ask the CLI again which setup targets it has and re-read every help screen (slow: about thirty CLI calls)"
                               AutomationProperties.Name="Re-read catalog"
                               AutomationProperties.HelpText="Ask the CLI again which setup targets it has and re-read every help screen (slow: about thirty CLI calls)." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Re-read the guardrail posture and the connector roster (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5" />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <ScrollViewer Grid.Row="1" Style="{StaticResource DcPageScroll}">
            <StackPanel>
                <!-- Connector roster: what the wizards are acting on right now. -->
                <Border Margin="{StaticResource DcCardGap}" Style="{StaticResource DcCard}">
                    <StackPanel>
                        <ctl:DcCardHeader AutomationProperties.HeadingLevel="Level2"
                                   Symbol="PlugConnected24"
                                   Section="Setup"
                                   Content="Configured connectors" />

                        <ItemsControl ItemsSource="{Binding Connectors}"
                                      IsTabStop="False"
                                      AutomationProperties.Name="Configured connectors">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,10,8"
                                            Style="{StaticResource DcSubtleRow}"
                                            ToolTip="{Binding ToolTipText}"
                                            AutomationProperties.Name="{Binding Mode=OneWay}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource ChipName}" Text="{Binding Name}" />
                                                <Border Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource DcChip}">
                                                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding Mode}" />
                                                </Border>
                                                <!-- Fail-mode is a first-class chip: observe + fail-closed is the
                                                     recurring bad default this project keeps meeting. -->
                                                <Border Margin="6,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Style="{StaticResource DcBadge}"
                                                        Tag="{Binding FailKey}">
                                                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding FailMode}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Margin="0,4,0,0"
                                                       MaxWidth="320"
                                                       Style="{StaticResource WarnCaption}"
                                                       Visibility="{Binding HasMismatch, Converter={StaticResource BoolToVisibility}}"
                                                       Text="{Binding MismatchNote}" />

                                            <TextBlock Margin="0,2,0,0"
                                                       Style="{StaticResource DcCaption}"
                                                       Text="{Binding SourceNote}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Style="{StaticResource DcCaption}" Text="{Binding ConnectorNote}" />
                    </StackPanel>
                </Border>

                <!-- Guardrail quick controls: status, enable / disable, hook fail mode. -->
                <Border Margin="{StaticResource DcCardGap}" Style="{StaticResource DcCard}">
                    <StackPanel>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <ctl:DcCardHeader Margin="0,0,10,0"
                                           VerticalAlignment="Center"
                                           AutomationProperties.HeadingLevel="Level2"
                                           Symbol="ShieldCheckmark24"
                                           Section="Govern"
                                           Content="Guardrail" />
                                <Border VerticalAlignment="Center"
                                        Style="{StaticResource DcBadge}"
                                        Tag="{Binding GuardrailHeadlineKey}">
                                    <StackPanel Orientation="Horizontal">
                                        <ctl:DcStatusGlyph Tone="{Binding GuardrailHeadlineKey}" ShowDot="False" GlyphSize="12" Gap="5" />
                                        <TextBlock Style="{StaticResource DcBadgeText}"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Text="{Binding GuardrailHeadline}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:ProgressRing Width="16"
                                                 Height="16"
                                                 Margin="0,0,8,0"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsGuardrailBusy, Converter={StaticResource BoolToVisibility}}" />
                                <TextBlock Style="{StaticResource DcStatusText}" Text="{Binding GuardrailAsOf}" />
                            </StackPanel>
                        </Grid>

                        <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                    IsClosable="False"
                                    Severity="Error"
                                    Title="The guardrail status could not be read"
                                    IsOpen="{Binding HasGuardrailError, Mode=OneWay}"
                                    Message="{Binding GuardrailError}" />

                        <ItemsControl ItemsSource="{Binding GuardrailRows}"
                                      IsTabStop="False"
                                      AutomationProperties.Name="Guardrail roster, one row per active connector">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,8"
                                            Style="{StaticResource DcSubtleRow}"
                                            AutomationProperties.Name="{Binding Mode=OneWay}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource ChipName}" Text="{Binding Name}" />
                                                <Border Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Style="{StaticResource DcBadge}" Tag="{Binding StateKey}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <ctl:DcStatusGlyph Tone="{Binding StateKey}" ShowDot="False" GlyphSize="12" Gap="5" />
                                                        <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding State}" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource DcChip}">
                                                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding Mode}" />
                                                </Border>
                                                <Border Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Style="{StaticResource DcBadge}" Tag="{Binding FailKey}">
                                                    <TextBlock Style="{StaticResource DcBadgeText}"
                                                               Text="{Binding Fail, StringFormat='fail-{0}'}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="0,4,0,0"
                                                       Style="{StaticResource DcCaption}"
                                                       Text="{Binding Detail}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Style="{StaticResource WarnCaption}"
                                                       Visibility="{Binding HasMismatch, Converter={StaticResource BoolToVisibility}}"
                                                       Text="{Binding MismatchNote}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding GuardrailWarnings}"
                                      IsTabStop="False"
                                      AutomationProperties.Name="Guardrail notes from the CLI">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Margin="0,0,0,4"
                                               Style="{StaticResource WarnCaption}"
                                               Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Margin="0,0,0,8"
                                   Style="{StaticResource DcCaption}"
                                   Visibility="{Binding ShowNoGuardrailRoster, Converter={StaticResource BoolToVisibility}}"
                                   Text="No connector is active, so there is nothing for the guardrail to enforce yet. Configure one from the cards below." />

                        <WrapPanel Style="{StaticResource DcToolbarPanel}" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource DcToolbarLabel}"
                                       Visibility="{Binding HasMultipleGuardrailConnectors, Converter={StaticResource BoolToVisibility}}"
                                       Text="Scope" />
                            <ComboBox Width="200"
                                      AutomationProperties.Name="Guardrail scope: which connector a change applies to"
                                      ItemsSource="{Binding GuardrailScopes}"
                                      SelectedItem="{Binding SelectedGuardrailScope, Mode=TwoWay}"
                                      IsEnabled="{Binding CanUseGuardrailControls}"
                                      Visibility="{Binding HasMultipleGuardrailConnectors, Converter={StaticResource BoolToVisibility}}" />

                            <ui:Button Content="Enable"
                                       Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                                       AutomationProperties.Name="Enable the guardrail"
                                       IsEnabled="{Binding CanUseGuardrailControls}"
                                       Visibility="{Binding ShowEnableGuardrail, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding EnableGuardrailCommand}" />
                            <ui:Button Content="Disable"
                                       Icon="{ctl:DcSymbolIcon ShieldProhibited24}"
                                       AutomationProperties.Name="Disable the guardrail"
                                       IsEnabled="{Binding CanUseGuardrailControls}"
                                       Visibility="{Binding ShowDisableGuardrail, Converter={StaticResource BoolToVisibility}}"
                                       Command="{Binding DisableGuardrailCommand}" />
                            <ui:Button Content="Fail open"
                                       Icon="{ctl:DcSymbolIcon LockOpen24}"
                                       AutomationProperties.Name="Set the hook fail mode to open"
                                       ToolTip="Allow and log when the gateway errors (recommended)"
                                       IsEnabled="{Binding CanUseGuardrailControls}"
                                       Command="{Binding SetFailModeOpenCommand}" />
                            <ui:Button Content="Fail closed"
                                       Icon="{ctl:DcSymbolIcon LockClosed24}"
                                       AutomationProperties.Name="Set the hook fail mode to closed"
                                       ToolTip="Block whenever the gateway errors or is unreachable"
                                       IsEnabled="{Binding CanUseGuardrailControls}"
                                       Command="{Binding SetFailModeClosedCommand}" />
                            <CheckBox Content="Show CLI output"
                                      AutomationProperties.HelpText="Shows the verbatim text of defenseclaw guardrail status"
                                      IsChecked="{Binding ShowGuardrailRaw, Mode=TwoWay}" />
                        </WrapPanel>

                        <Border Margin="0,4,0,0"
                                Style="{StaticResource DcCodeBlock}"
                                Visibility="{Binding ShowGuardrailRaw, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Style="{StaticResource DcMonoTextBox}"
                                     AutomationProperties.Name="Verbatim output of defenseclaw guardrail status"
                                     Text="{Binding GuardrailRaw, Mode=OneWay}" />
                        </Border>

                        <!-- The outcome of the last change. -->
                        <Border Margin="0,8,0,0"
                                Style="{StaticResource DcSubtleRow}"
                                AutomationProperties.LiveSetting="Polite"
                                Visibility="{Binding HasGuardrailResult, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource ChipName}" Text="{Binding GuardrailResultHeading}" />
                                    <Border Margin="10,0,0,0" VerticalAlignment="Center"
                                            Style="{StaticResource DcBadge}" Tag="{Binding GuardrailResultKey}">
                                        <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding GuardrailResultBadge}" />
                                    </Border>
                                </StackPanel>
                                <Border Margin="0,8,0,0" Style="{StaticResource DcCodeBlock}">
                                    <TextBox Style="{StaticResource DcMonoTextBox}"
                                             AutomationProperties.Name="Output of the guardrail change"
                                             Text="{Binding GuardrailResultText, Mode=OneWay}" />
                                </Border>
                                <ui:Button Margin="0,8,0,0"
                                           HorizontalAlignment="Left"
                                           Appearance="Secondary"
                                           Content="Dismiss"
                                           Icon="{ctl:DcSymbolIcon Dismiss24}"
                                           Command="{Binding DismissGuardrailResultCommand}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Filter strip (no card of its own) -->
                <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                    <ui:TextBox x:Name="SearchBox"
                                Width="320"
                                AutomationProperties.Name="Search setup wizards"
                                PlaceholderText="Search wizards by name, target or description…  (Ctrl+F)"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />

                    <CheckBox Content="Hide uncertified connectors"
                              IsChecked="{Binding CertifiedOnly, Mode=TwoWay}"
                              ToolTip="Hides connectors the CLI reports as not_certified or unsupported on Windows. Flows that are not connectors (rotate-token, webhook, llm, scanners…) have nothing to certify and stay visible." />

                    <ui:Button Style="{StaticResource DcToolbarIconButton}"
                               Margin="0,0,12,8"
                               Icon="{ctl:DcSymbolIcon FilterDismiss24}"
                               Command="{Binding ClearFiltersCommand}"
                               ToolTip="Clear filters"
                               AutomationProperties.Name="Clear filters" />
                </WrapPanel>

                <TextBlock Margin="0,0,12,8"
                           Style="{StaticResource DcResultCaption}"
                           Text="{Binding StatusNote}" />

                <ui:InfoBar Margin="0,0,0,8"
                            IsClosable="False"
                            Severity="Error"
                            Title="The setup catalog could not be read"
                            IsOpen="{Binding HasLoadError, Mode=OneWay}"
                            Message="{Binding LoadError}" />

                <!-- Card grid, grouped -->
                <ItemsControl ItemsSource="{Binding Groups}" IsTabStop="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="{StaticResource DcSectionGap}">
                                <StackPanel Margin="2,0,0,8"
                                            Orientation="Horizontal"
                                            AutomationProperties.Name="{Binding AutomationName}">
                                    <TextBlock Style="{StaticResource DcSectionHeader}"
                                               Margin="0"
                                               AutomationProperties.HeadingLevel="Level2"
                                               Text="{Binding Name}" />
                                    <TextBlock Margin="8,0,0,0"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource DcCaption}"
                                               Text="{Binding CountText}" />
                                </StackPanel>

                                <ItemsControl ItemsSource="{Binding Cards}" IsTabStop="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="300"
                                                    MinHeight="184"
                                                    Margin="0,0,12,12"
                                                    Style="{StaticResource DcCard}"
                                                    AutomationProperties.Name="{Binding AutomationName}"
                                                    AutomationProperties.HelpText="{Binding CommandHint}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto" />
                                                        <RowDefinition Height="*" />
                                                        <RowDefinition Height="Auto" />
                                                    </Grid.RowDefinitions>

                                                    <StackPanel Grid.Row="0">
                                                        <TextBlock Style="{StaticResource DcCardTitle}"
                                                                   Margin="0,0,0,2"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Title}"
                                                                   Text="{Binding Title}" />
                                                        <TextBlock Style="{StaticResource DcMono}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Text="{Binding CommandHint}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="1" Margin="0,8,0,8">
                                                        <TextBlock MaxHeight="64"
                                                                   Style="{StaticResource DcCaption}"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   ToolTip="{Binding Summary}"
                                                                   Text="{Binding Summary}" />
                                                        <!-- Why a card cannot be launched, and where to go instead. -->
                                                        <TextBlock Margin="0,6,0,0"
                                                                   Style="{StaticResource WarnCaption}"
                                                                   Visibility="{Binding HasUnavailableReason, Converter={StaticResource BoolToVisibility}}"
                                                                   Text="{Binding UnavailableReason}" />
                                                    </StackPanel>

                                                    <StackPanel Grid.Row="2">
                                                        <!-- Certification badge: green only for a certified connector, amber for
                                                             not_certified, red for unsupported, neutral when unknown or when the
                                                             target is not a connector (nothing to certify). -->
                                                        <Border Margin="0,0,0,8"
                                                                HorizontalAlignment="Left"
                                                                Style="{StaticResource DcBadge}"
                                                                Tag="{Binding BadgeKey}">
                                                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding Badge}" />
                                                        </Border>

                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>

                                                            <TextBlock Grid.Column="0"
                                                                       Margin="0,0,8,0"
                                                                       VerticalAlignment="Center"
                                                                       Style="{StaticResource DcCaption}"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       ToolTip="{Binding StepNote}"
                                                                       Text="{Binding StepNote}" />

                                                            <ui:Button Grid.Column="1"
                                                                       Appearance="Secondary"
                                                                       Content="Configure"
                                                                       Icon="{ctl:DcSymbolIcon Settings24}"
                                                                       AutomationProperties.Name="{Binding LaunchAutomationName}"
                                                                       IsEnabled="{Binding IsAvailable}"
                                                                       Command="{Binding DataContext.LaunchCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                       CommandParameter="{Binding}" />
                                                        </Grid>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Empty and loading are states, not failures: say which one. -->
                <StackPanel Style="{StaticResource DcEmptyState}"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing IsIndeterminate="True" HorizontalAlignment="Center" />
                    <TextBlock Margin="0,12,0,0"
                               Style="{StaticResource DcEmptyDetail}"
                               AutomationProperties.LiveSetting="Polite"
                               Text="Asking the CLI which setup targets it has." />
                </StackPanel>

                <!--
                    Three different reasons for an empty grid, each with its own words: the read failed (the reason is in
                    the banner under the filters), the CLI answered with no setup targets, or a filter hides all of them.
                -->
                <StackPanel Style="{StaticResource DcEmptyState}"
                            Visibility="{Binding ShowLoadFailed, Converter={StaticResource BoolToVisibility}}">
                    <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                    <TextBlock Style="{StaticResource DcEmptyTitle}" Text="The setup catalog is unavailable" />
                    <TextBlock Style="{StaticResource DcEmptyDetail}"
                               Text="The DefenseClaw command did not answer, so there is no list of setup wizards to show. The reason is in the banner above." />
                    <ui:Button Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Content="Re-read catalog"
                               Icon="{ctl:DcSymbolIcon ArrowSync24}"
                               Command="{Binding ReloadCatalogCommand}" />
                </StackPanel>

                <StackPanel Style="{StaticResource DcEmptyState}"
                            Visibility="{Binding ShowNoTargets, Converter={StaticResource BoolToVisibility}}">
                    <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ShieldSettings24" />
                    <TextBlock Style="{StaticResource DcEmptyTitle}" Text="The CLI reported no setup targets" />
                    <TextBlock Style="{StaticResource DcEmptyDetail}"
                               Text="The installed DefenseClaw answered, and its setup help lists nothing to configure. If it was just upgraded, read the catalog again." />
                    <ui:Button Margin="0,16,0,0"
                               HorizontalAlignment="Center"
                               Content="Re-read catalog"
                               Icon="{ctl:DcSymbolIcon ArrowSync24}"
                               Command="{Binding ReloadCatalogCommand}" />
                </StackPanel>

                <StackPanel Style="{StaticResource DcEmptyState}"
                            Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                    <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Search24" />
                    <TextBlock Style="{StaticResource DcEmptyTitle}" Text="No wizards match" />
                    <TextBlock Style="{StaticResource DcEmptyDetail}"
                               Text="Clear the search, or turn off the certification filter: on this platform only Claude Code and Codex are certified connectors." />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--
            Guardrail review. Every guardrail verb restarts the gateway by default, and disable removes
            the live connector hooks, so nothing runs from a button press alone: the shared review control
            shows the exact argv, the CommandTiers tier and the restart, and the checkbox below the
            command offers the no-restart option (it changes the argv, so the review is rebuilt). Esc dismisses it.
        -->
        <Grid Grid.Row="0"
              Grid.RowSpan="2"
              Style="{StaticResource DcScrim}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="{Binding IsGuardrailReviewOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Margin="24" Style="{StaticResource DcDialogCard}">
                <shell:CommandReviewControl Review="{Binding GuardrailReview}"
                                            ConfirmCommand="{Binding ConfirmGuardrailCommand}"
                                            CancelCommand="{Binding CancelGuardrailReviewCommand}">
                    <shell:CommandReviewControl.ExtraContent>
                        <CheckBox Margin="0,4,0,10"
                                  Content="Restart the gateway after the change"
                                  IsChecked="{Binding GuardrailRestartAfter, Mode=TwoWay}"
                                  AutomationProperties.HelpText="Unchecking adds --no-restart to the command" />
                    </shell:CommandReviewControl.ExtraContent>
                </shell:CommandReviewControl>
            </Border>
        </Grid>
    </Grid>
</UserControl>
