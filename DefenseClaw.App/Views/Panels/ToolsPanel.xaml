<UserControl x:Class="DefenseClaw.App.Views.Panels.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:local="clr-namespace:DefenseClaw.App.Views.Panels">
    <!--
        Tools panel: GET /tools/catalog (tracked separately, since on this install it is
        not-connected while the enforcement lists below it are real) plus the tool slice of
        /enforce/blocked and /enforce/allowed, with block/allow/unblock mutations gated
        behind the confirm overlay at the bottom of this file. See
        ViewModels\ToolsPanelViewModel.cs for the data and command logic - this view only
        lays it out and binds to it.
    -->
    <UserControl.Resources>
        <local:ToolsTruthyToVisibilityConverter x:Key="Truthy" />
    </UserControl.Resources>

    <Grid Margin="28,24,28,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       Text="{Binding Title}" />
            <TextBlock Margin="0,4,0,0"
                       FontSize="13"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{Binding Description}" />
        </StackPanel>

        <!-- Toolbar -->
        <Border Grid.Row="1"
                Margin="0,0,0,14"
                Padding="12,10"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
            <StackPanel Orientation="Horizontal">
                <ui:Button Content="Refresh"
                           Command="{Binding RefreshCommand}"
                           IsEnabled="{Binding IsIdle}" />
                <TextBlock Margin="18,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Connector scope:" />
                <ComboBox MinWidth="180"
                          VerticalAlignment="Center"
                          ItemsSource="{Binding Connectors}"
                          SelectedItem="{Binding SelectedConnector, Mode=TwoWay}" />
                <TextBlock Margin="18,0,6,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                           Text="Reason:" />
                <ui:TextBox MinWidth="220"
                            VerticalAlignment="Center"
                            PlaceholderText="Optional, recorded on the mutation"
                            Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <!-- Mutation result -->
        <ui:InfoBar Grid.Row="2"
                    Margin="0,0,0,14"
                    Title="{Binding ResultTitle}"
                    Message="{Binding ResultMessage}"
                    Severity="{Binding ResultSeverity}"
                    IsOpen="{Binding IsResultOpen, Mode=TwoWay}"
                    IsClosable="True" />

        <!-- Content -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ui:InfoBar Margin="0,0,0,14"
                            Title="Tool catalog"
                            Message="{Binding CatalogBannerMessage}"
                            Severity="{Binding CatalogBannerSeverity}"
                            IsOpen="{Binding ShowCatalogBanner}"
                            IsClosable="False" />

                <ui:ProgressRing Width="32"
                                  Height="32"
                                  Margin="0,24,0,0"
                                  HorizontalAlignment="Center"
                                  IsIndeterminate="True"
                                  Visibility="{Binding IsCatalogLoadingState, Converter={StaticResource BoolToVisibility}}" />

                <ItemsControl Visibility="{Binding IsCatalogLoadedState, Converter={StaticResource BoolToVisibility}}"
                              ItemsSource="{Binding Catalog}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel VirtualizationMode="Recycling" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardExpander Margin="0,0,0,8">
                                <ui:CardExpander.Header>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding CapabilityClass, StringFormat='capability: {0}'}"
                                                       Visibility="{Binding CapabilityClass, Converter={StaticResource Truthy}}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Server, StringFormat='server: {0}'}"
                                                       Visibility="{Binding Server, Converter={StaticResource Truthy}}" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <ui:Button Margin="0,0,6,0"
                                                       Content="Block"
                                                       Command="{Binding DataContext.BlockToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                            <ui:Button Content="Allow"
                                                       Command="{Binding DataContext.AllowToolCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                       CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </Grid>
                                </ui:CardExpander.Header>

                                <Border Padding="4"
                                        Background="{DynamicResource LayerFillColorDefaultBrush}">
                                    <TextBox MaxHeight="220"
                                             VerticalScrollBarVisibility="Auto"
                                             HorizontalScrollBarVisibility="Auto"
                                             FontFamily="Consolas"
                                             FontSize="12"
                                             IsReadOnly="True"
                                             TextWrapping="NoWrap"
                                             Text="{Binding RawJson, Mode=OneWay}" />
                                </Border>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Enforcement overrides: always shown, independent of catalog connectivity. -->
                <Grid Margin="0,18,0,0" Visibility="{Binding IsCatalogNotLoading, Converter={StaticResource BoolToVisibility}}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Blocked.Count, StringFormat='Blocked ({0})'}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Blocked}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4"
                                                Padding="8"
                                                CornerRadius="4"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding Reason, StringFormat='reason: {0}'}"
                                                               Visibility="{Binding Reason, Converter={StaticResource Truthy}}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding Scope, StringFormat='scope: {0}'}"
                                                               Visibility="{Binding Scope, Converter={StaticResource Truthy}}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1"
                                                           VerticalAlignment="Top"
                                                           Content="Unblock"
                                                           Command="{Binding DataContext.UnblockEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,4,0,0"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="No blocked tools."
                                       Visibility="{Binding DataContext.NoBlockedItems, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2"
                            Padding="12"
                            CornerRadius="8"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                        <StackPanel>
                            <TextBlock FontWeight="SemiBold" Text="{Binding Allowed.Count, StringFormat='Allowed ({0})'}" />
                            <ItemsControl Margin="0,8,0,0" ItemsSource="{Binding Allowed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,4"
                                                Padding="8"
                                                CornerRadius="4"
                                                Background="{DynamicResource LayerFillColorDefaultBrush}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding Reason, StringFormat='reason: {0}'}"
                                                               Visibility="{Binding Reason, Converter={StaticResource Truthy}}" />
                                                    <TextBlock FontSize="12"
                                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                               Text="{Binding Scope, StringFormat='scope: {0}'}"
                                                               Visibility="{Binding Scope, Converter={StaticResource Truthy}}" />
                                                </StackPanel>
                                                <ui:Button Grid.Column="1"
                                                           VerticalAlignment="Top"
                                                           Content="Unblock"
                                                           Command="{Binding DataContext.UnblockEntryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                           CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,4,0,0"
                                       FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                       Text="No allow-listed tools."
                                       Visibility="{Binding DataContext.NoAllowedItems, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- Confirm-mutation overlay: shows the exact argv before anything runs. -->
        <Grid Grid.Row="0"
              Grid.RowSpan="4"
              Background="#88000000"
              Visibility="{Binding IsConfirmOpen, Converter={StaticResource BoolToVisibility}}">
            <Border MaxWidth="560"
                    Padding="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    Background="{DynamicResource ApplicationBackgroundBrush}">
                <StackPanel>
                    <TextBlock FontSize="16"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="{Binding ConfirmHeading}" />
                    <TextBlock Margin="0,10,0,0"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="This is the exact command that will run. Nothing happens until you confirm." />
                    <Border Margin="0,10,0,0"
                            Padding="10"
                            CornerRadius="4"
                            Background="{DynamicResource LayerFillColorDefaultBrush}">
                        <TextBox FontFamily="Consolas"
                                 FontSize="12"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"
                                 Text="{Binding ConfirmCommandText, Mode=OneWay}" />
                    </Border>
                    <StackPanel Margin="0,16,0,0"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <ui:Button Margin="0,0,8,0"
                                   Content="Cancel"
                                   Command="{Binding ConfirmNoCommand}" />
                        <ui:Button Appearance="Primary"
                                   Content="Run command"
                                   Command="{Binding ConfirmYesCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
