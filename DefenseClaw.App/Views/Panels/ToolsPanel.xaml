<UserControl x:Class="DefenseClaw.App.Views.Panels.ToolsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:govern="clr-namespace:DefenseClaw.App.Views.Panels.Govern"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:ToolsPanelViewModel}"
             mc:Ignorable="d">
    <!--
        Tools panel. Data is the CLI command 'tool list' with its JSON and connector flags: the block/allow rules that
        exist (there is no tool catalog on a standalone install; /tools/catalog answers "not connected").
        Each row is one rule; its scope (connector, every connector, or audit-only source) decides which
        flag its actions use. "Manage a tool by name" covers a tool that has no rule yet.
        Keys: F5 refresh (shell), Ctrl+F filter, Esc closes the dialog / result card / clears the filter.

        Layout. Everything under the header is one scrolling page (PageScroll): the toolbar, the "Manage a tool by name"
        card, the banners and the list together are taller than the page is at the window's 940 x 620 DIP minimum (and far
        taller with the shell's gateway banner open), and they used to share it, so the list kept whatever the fixed rows
        above it left over - as little as 11 DIPs. Now the list is the last thing on the page with a height of its own: the
        rest of the viewport under the chrome, and never less than 250 DIPs (FillHeightConverter). A ScrollViewer measures
        its content with unlimited height, and a virtualizing list measured that way realizes every row, so the list keeps
        a definite height and its own scroller. The manage card is an expander (closed, unless there are no rules yet); the
        result card of a read-only command sits under the list and is scrolled into view when it opens.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DefenseClaw.App;component/Views/Panels/Govern/GovernTable.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the busy ring and "as of 12:04", the page actions as icons, the filter box. -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="WrenchScrewdriver24"
                           ctl:DcIcon.Section="Govern"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           Caption="{Binding HeaderStatusText}"
                           HasSearch="True"
                           SearchText="{Binding FilterText}"
                           SearchPlaceholder="Filter tool rules…"
                           SearchAutomationName="Filter tool rules"
                           SearchHelpText="Matches tool name, connector, reason and state. Shortcut Ctrl+F; Esc clears it.">
            <ctl:DcPageToolbar.Leading>
                <ui:ProgressRing Width="16"
                                 Height="16"
                                 Margin="12,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Working" />
            </ctl:DcPageToolbar.Leading>
            <ctl:DcPageToolbar.ConnectorSlot>
                <ctl:DcConnectorScopeChip Model="{Binding ConnectorChip}" />
            </ctl:DcPageToolbar.ConnectorSlot>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               IsEnabled="{Binding IsIdle}"
                               ToolTip="Read the tool rules again (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5" />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      Style="{StaticResource DcPageScroll}"
                      Focusable="False"
                      AutomationProperties.Name="Tool rules page">
            <StackPanel x:Name="PageContent">
                <!-- Toolbar, the manage card, banners and the caption: what the list's height is worked out from. -->
                <StackPanel x:Name="Chrome">
                    <!-- Filter strip: which state, which connector, and the reason the next action records. -->
                    <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Show" />
                            <ComboBox Width="140"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                      AutomationProperties.Name="Show tool rules in state" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Connector scope" />
                            <ComboBox MinWidth="200"
                                      ItemsSource="{Binding Connectors}"
                                      SelectedItem="{Binding SelectedConnector, Mode=TwoWay}"
                                      AutomationProperties.Name="Connector scope"
                                      AutomationProperties.HelpText="Which connector's rules to list (plus the rules that apply to every connector), and the scope of Manage a tool by name. All configured connectors means the fallback rule." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Reason" />
                            <ui:TextBox MinWidth="180"
                                        Width="220"
                                        PlaceholderText="Recorded with the action"
                                        Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Reason"
                                        AutomationProperties.HelpText="Sent as --reason with block and allow." />
                        </StackPanel>
                    </WrapPanel>

                    <!--
                        Manage a tool by name. Closed to one line, so the list keeps the page; it opens by itself when there
                        are no rules yet (the one moment it is the way forward), and stays as the operator leaves it after that.
                    -->
                    <ui:CardExpander Margin="{StaticResource DcCardGap}"
                                     IsExpanded="{Binding ShowEmpty, Mode=OneWay}"
                                     AutomationProperties.Name="Manage a tool by name">
                        <ui:CardExpander.Header>
                            <ctl:DcCardHeader Margin="0" Symbol="WrenchScrewdriver24" Section="Govern" Content="Manage a tool by name" />
                        </ui:CardExpander.Header>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Text="A tool with no rule yet is not listed below. Enter its bare name to block or allow it, remove its rule, or read which rule applies (Status is read-only). The scope is the connector chosen in the toolbar: 'All configured connectors' sets the fallback rule for every connector; one connector sets a rule for that connector only." />
                            <WrapPanel Style="{StaticResource DcToolbarPanel}" Margin="0,10,0,0">
                                <ui:TextBox Width="260"
                                            PlaceholderText="Tool name, for example delete_file"
                                            Text="{Binding ManageToolName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="Tool name" />
                                <ui:Button Content="Status"
                                           Icon="{ctl:DcSymbolIcon Info24}"
                                           Command="{Binding ManageStatusCommand}"
                                           IsEnabled="{Binding IsIdle}"
                                           ToolTip="Read-only: shows the effective block/allow status of this tool"
                                           AutomationProperties.Name="Show the effective status of the named tool" />
                                <ui:Button Content="Block"
                                           Icon="{ctl:DcSymbolIcon ShieldProhibited24}"
                                           Command="{Binding ManageBlockCommand}"
                                           IsEnabled="{Binding CanChange}"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Opens a review of the exact command first'}"
                                           AutomationProperties.Name="Block the named tool" />
                                <ui:Button Content="Allow"
                                           Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                                           Command="{Binding ManageAllowCommand}"
                                           IsEnabled="{Binding CanChange}"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Opens a review of the exact command first'}"
                                           AutomationProperties.Name="Allow the named tool" />
                                <ui:Button Content="Unblock"
                                           Icon="{ctl:DcSymbolIcon LockOpen24}"
                                           Command="{Binding ManageUnblockCommand}"
                                           IsEnabled="{Binding CanChange}"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Removes the rule for this tool. Opens a review first.'}"
                                           AutomationProperties.Name="Remove the rule of the named tool" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource DcToneText}"
                                       Tag="Bad"
                                       TextWrapping="Wrap"
                                       Text="{Binding ManageError}"
                                       Visibility="{Binding HasManageError, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.LiveSetting="Assertive" />
                        </StackPanel>
                    </ui:CardExpander>

                    <!-- Result of the last action and a stale-data warning -->
                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                Title="{Binding ResultTitle}"
                                Message="{Binding ResultMessage}"
                                Severity="{Binding ResultSeverity}"
                                IsOpen="{Binding IsResultOpen, Mode=TwoWay}"
                                IsClosable="True"
                                AutomationProperties.LiveSetting="Polite" />
                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                Title="Showing an older read"
                                Message="{Binding RefreshWarning}"
                                Severity="Warning"
                                IsOpen="{Binding HasRefreshWarning, Mode=OneWay}"
                                IsClosable="False"
                                AutomationProperties.LiveSetting="Polite" />
                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                Title="Incomplete discovery"
                                Message="{Binding PartialDiscoveryMessage}"
                                Severity="Warning"
                                IsOpen="{Binding HasPartialDiscovery, Mode=OneWay}"
                                IsClosable="False"
                                AutomationProperties.LiveSetting="Polite" />

                    <TextBlock Style="{StaticResource DcResultCaption}"
                               Margin="{StaticResource DcCardGap}"
                               Text="{Binding CaptionText}" />
                </StackPanel>

                <!-- Content: exactly one of these is visible -->
                <StackPanel Style="{StaticResource DcEmptyState}"
                            Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing Width="32"
                                     Height="32"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Reading tool rules" />
                    <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Reading tool rules from the CLI…" />
                </StackPanel>

                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowCliMissing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Press Refresh to try again. The command and its output are in Activity." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="WrenchScrewdriver24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Search24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="No tool rules match the filter" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="The filter hides every rule the CLI listed. Clear it to see them all." />
                        <ui:Button Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Content="Clear filter"
                                   Icon="{ctl:DcSymbolIcon FilterDismiss24}"
                                   Command="{Binding ClearFilterCommand}" />
                    </StackPanel>
                </Border>

                <!-- The list: a dense table with a height of its own (the rest of the viewport, at least 250), virtualized. Each row's actions
                     are in its "..." menu (and on right-click); a selected row opens its details under itself. -->
                <ui:DataGrid x:Name="RowGrid"
                             Style="{StaticResource DcDataGrid}"
                             RowStyle="{StaticResource GovernGridRow}"
                             RowDetailsTemplate="{StaticResource GovernRowDetails}"
                             RowDetailsVisibilityMode="VisibleWhenSelected"
                             SelectionMode="Single"
                             AutomationProperties.Name="Tool rules"
                             ItemsSource="{Binding Rows}"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ctl:DcGridColumns.Fit="True"
                             panels:NestedScroll.ForwardWheel="True"
                             Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                    <ui:DataGrid.Height>
                        <MultiBinding Converter="{x:Static govern:FillHeightConverter.Instance}" ConverterParameter="250">
                            <Binding ElementName="PageScroll" Path="ViewportHeight" />
                            <Binding ElementName="Chrome" Path="ActualHeight" />
                        </MultiBinding>
                    </ui:DataGrid.Height>
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Width="1*" MinWidth="110" Header="Status"
                                                SortMemberPath="StateLabel"
                                                CellTemplate="{StaticResource GovernStatusCell}" />
                        <DataGridTextColumn Width="1.5*" MinWidth="100" Header="Tool"
                                            SortMemberPath="DisplayTitle"
                                            ElementStyle="{StaticResource DcCellText}"
                                            Binding="{Binding DisplayTitle}" />
                        <DataGridTextColumn Width="1.4*" MinWidth="100" Header="Applies to"
                                            SortMemberPath="AppliesText"
                                            ElementStyle="{StaticResource DcCellTextQuiet}"
                                            Binding="{Binding AppliesText}" />
                        <DataGridTextColumn Width="2*" MinWidth="90" Header="Reason"
                                            SortMemberPath="Reason"
                                            ElementStyle="{StaticResource DcCellTextQuiet}"
                                            Binding="{Binding Reason}" />
                        <DataGridTextColumn Width="1.1*" MinWidth="90" Header="Updated"
                                            SortMemberPath="UpdatedText"
                                            ElementStyle="{StaticResource DcCellTextQuiet}"
                                            Binding="{Binding UpdatedText}" />
                        <DataGridTextColumn Width="1*" MinWidth="76" Header="Connector"
                                            SortMemberPath="ConnectorLabel"
                                            ElementStyle="{StaticResource DcCellTextQuiet}"
                                            Binding="{Binding ConnectorLabel}" />
                        <DataGridTemplateColumn Width="32" Header="Actions"
                                                CanUserSort="False"
                                                HeaderStyle="{StaticResource DcDataGridActionsHeader}"
                                                CellTemplate="{StaticResource GovernMenuCell}" />
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <!-- Result of a read-only command (Status): under the list, scrolled into view when it opens. -->
                <govern:GovernOutputCard />
            </StackPanel>
        </ScrollViewer>

        <!-- Review dialog for every state-changing command -->
        <govern:GovernConfirmOverlay Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</UserControl>
