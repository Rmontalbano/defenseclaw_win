<UserControl x:Class="DefenseClaw.App.Views.Panels.ActivityPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels">
    <!--
        Newest-first list of every subprocess this app has run. The list is in memory only, so
        it is empty until something has been run in this session - the empty state carries the
        weight of explaining the panel rather than the list itself.

        Each entry shows its review tier (Read-only / State-changing / Destructive), its exit
        badge, and the actions: Cancel (only while it runs), Copy argv, Copy output, Export log.
        Everything is on the shared Dc* design system; the local styles are the output line
        (stderr and notice tones) and its list row.

        Output. A transcript can run to 200,000 lines (a JSON read keeps them all), so each entry's output is a
        virtualizing, recycling ListBox with a bounded height - the pattern of the Logs panel and the Updates console -
        and only the lines in view become elements. The bound height is what makes virtualization possible: a list
        given unlimited room (as it is inside this page's ScrollViewer) realizes every line. The list scrolls on its own,
        hands the mouse wheel to the page at its ends (panels:NestedScroll), follows the newest line while the run is going
        unless the operator has scrolled up (panels:TranscriptList), and its lines are selectable (Ctrl+A, Ctrl+C or
        the context menu copy them; Copy output copies all of it).
    -->
    <UserControl.Resources>
        <!-- One line of captured output; a stderr line reads in the critical tone, this app's own notice (the truncation marker) in the caution tone. -->
        <Style x:Key="OutputLine" TargetType="TextBlock" BasedOn="{StaticResource DcMono}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsError}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsNotice}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                    <Setter Property="FontStyle" Value="Italic" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- WPF-UI pads a list item 12 px on every side; a transcript is read by the screenful, so rows are as tight as the text. -->
        <Style x:Key="OutputRow" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="Padding" Value="6,1,6,1" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HeaderedContentControl Grid.Row="0" Style="{StaticResource DcPageHeader}">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource DcPageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource DcPageSubtitle}" Text="{Binding Description}" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Margin="0,4,0,0"
                               Text="{Binding CapacityNote}" />
                </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel Style="{StaticResource DcActionBar}">
                <ui:Button Content="Refresh"
                           Appearance="Secondary"
                           Command="{Binding RefreshCommand}"
                           AutomationProperties.HelpText="Re-sync the list with the commands this session has run. Runs nothing. Shortcut F5.">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Content="Clear"
                           Appearance="Secondary"
                           Command="{Binding ClearActivityCommand}"
                           AutomationProperties.HelpText="Forget every entry in this list. Commands that are still running keep running.">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="Delete24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Result of the last row action: copied, exported, cancel refused... -->
        <ui:InfoBar Grid.Row="1"
                    Margin="{StaticResource DcCardGap}"
                    Severity="Informational"
                    IsClosable="True"
                    IsOpen="{Binding HasNotice, Mode=TwoWay}"
                    Message="{Binding NoticeText}"
                    AutomationProperties.LiveSetting="Polite" />

        <!-- List -->
        <Grid Grid.Row="2">
            <ScrollViewer Style="{StaticResource DcPageScroll}">
                <ItemsControl ItemsSource="{Binding Rows}"
                              AutomationProperties.Name="Commands run in this session, newest first">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource DcCardCompact}" Margin="0,0,0,10">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Selectable, so a path or id in the argv can be copied piecemeal. -->
                                        <TextBox Grid.Column="0"
                                                 Style="{StaticResource DcMonoTextBox}"
                                                 VerticalAlignment="Center"
                                                 AutomationProperties.Name="Command line"
                                                 Text="{Binding CommandLine, Mode=OneWay}" />

                                        <WrapPanel Grid.Column="1"
                                                   Margin="10,0,0,0"
                                                   VerticalAlignment="Top"
                                                   HorizontalAlignment="Right">
                                            <Border Style="{StaticResource DcBadge}"
                                                    Tag="{Binding TierKey}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="{Binding TierHelp}"
                                                    AutomationProperties.Name="{Binding TierText, StringFormat='Review tier: {0}'}">
                                                <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding TierText}" />
                                            </Border>

                                            <Border Style="{StaticResource DcChip}"
                                                    Margin="0,0,8,0"
                                                    ToolTip="A secret was piped in on stdin. Its value is never recorded."
                                                    Visibility="{Binding UsedStdinSecret, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource DcBadgeText}" Text="stdin secret" />
                                            </Border>

                                            <Border Style="{StaticResource DcBadge}"
                                                    Tag="{Binding ExitBadgeKey}"
                                                    MinWidth="76"
                                                    AutomationProperties.Name="{Binding ExitBadgeText, StringFormat='Result: {0}'}">
                                                <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding ExitBadgeText}" />
                                            </Border>
                                        </WrapPanel>
                                    </Grid>

                                    <WrapPanel Margin="0,6,0,0">
                                        <TextBlock Style="{StaticResource DcCaption}" Margin="0,0,10,0" Text="{Binding StartedText}" />
                                        <TextBlock Style="{StaticResource DcCaption}" Margin="0,0,10,0" Text="{Binding RelativeStartText}" />
                                        <TextBlock Style="{StaticResource DcCaption}" Text="{Binding DurationText, StringFormat='duration {0}'}" />
                                    </WrapPanel>

                                    <TextBlock Style="{StaticResource DcToneText}"
                                               Tag="Warn"
                                               Margin="0,4,0,0"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding HasFailure, Converter={StaticResource BoolToVisibility}}"
                                               Text="{Binding FailureText}" />

                                    <!-- Row actions. Cancel exists only while the run does; for the upgrade
                                         installer it stays visible but disabled, with the reason as its tooltip. -->
                                    <WrapPanel Margin="0,8,0,0">
                                        <ui:Button Content="Cancel"
                                                   Appearance="Danger"
                                                   Margin="0,0,8,4"
                                                   IsEnabled="{Binding CanCancel}"
                                                   Command="{Binding CancelCommand}"
                                                   ToolTip="{Binding CancelHint}"
                                                   ToolTipService.ShowOnDisabled="True"
                                                   AutomationProperties.Name="Cancel this command"
                                                   AutomationProperties.HelpText="{Binding CancelHint}"
                                                   Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />
                                        <ui:Button Content="Copy argv"
                                                   Appearance="Secondary"
                                                   Margin="0,0,8,4"
                                                   Command="{Binding CopyCommand}"
                                                   ToolTip="Copy the exact command line"
                                                   AutomationProperties.Name="Copy argv"
                                                   AutomationProperties.HelpText="Copies the exact command line that was run.">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Copy24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Copy output"
                                                   Appearance="Secondary"
                                                   Margin="0,0,8,4"
                                                   Command="{Binding CopyOutputCommand}"
                                                   ToolTip="Copy everything this command has printed so far"
                                                   AutomationProperties.Name="Copy output"
                                                   AutomationProperties.HelpText="Copies the captured output of this command as plain text.">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Copy24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                        <ui:Button Content="Export log"
                                                   Appearance="Secondary"
                                                   Margin="0,0,8,4"
                                                   Command="{Binding ExportLogCommand}"
                                                   ToolTip="Save the command, its result and its output to a file you choose"
                                                   AutomationProperties.Name="Export log"
                                                   AutomationProperties.HelpText="Opens a save dialog and writes the command, its result and its output to the file you choose.">
                                            <ui:Button.Icon>
                                                <ui:SymbolIcon Symbol="Save24" />
                                            </ui:Button.Icon>
                                        </ui:Button>
                                    </WrapPanel>

                                    <Expander Margin="0,4,0,0"
                                              Header="{Binding OutputHeader}"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                                              AutomationProperties.Name="Output">
                                        <Border Style="{StaticResource DcCodeBlock}" Margin="0,6,0,0" Padding="6,6,6,6">
                                            <StackPanel>
                                                <!-- Only while the run is going: a finished transcript has nothing to follow. Turning it off is what
                                                     scrolling up does; this is the same setting, reachable without a mouse. -->
                                                <CheckBox HorizontalAlignment="Right"
                                                          Margin="0,0,6,4"
                                                          Content="Follow output"
                                                          IsChecked="{Binding IsFollowing, Mode=TwoWay}"
                                                          Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}"
                                                          AutomationProperties.Name="Follow output"
                                                          AutomationProperties.HelpText="On: the list stays on the newest line as output arrives. Scrolling up turns it off; scrolling back to the end turns it on again." />

                                                <Grid>
                                                    <ListBox ItemsSource="{Binding Output}"
                                                             MaxHeight="360"
                                                             Padding="0"
                                                             BorderThickness="0"
                                                             Background="Transparent"
                                                             SelectionMode="Extended"
                                                             HorizontalContentAlignment="Stretch"
                                                             ItemContainerStyle="{StaticResource OutputRow}"
                                                             ScrollViewer.CanContentScroll="True"
                                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                             VirtualizingPanel.IsVirtualizing="True"
                                                             VirtualizingPanel.VirtualizationMode="Recycling"
                                                             panels:TranscriptList.Enable="True"
                                                             panels:TranscriptList.Follow="{Binding IsFollowing, Mode=TwoWay}"
                                                             AutomationProperties.Name="Command output"
                                                             AutomationProperties.HelpText="Output lines. Arrow keys move, Ctrl+A selects every line, Ctrl+C copies the selected lines.">
                                                        <ListBox.ContextMenu>
                                                            <ContextMenu>
                                                                <MenuItem Header="Copy selected lines"
                                                                          Command="ApplicationCommands.Copy"
                                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                                <MenuItem Header="Select all lines"
                                                                          Command="ApplicationCommands.SelectAll"
                                                                          CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                                            </ContextMenu>
                                                        </ListBox.ContextMenu>
                                                        <ListBox.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Style="{StaticResource OutputLine}" Text="{Binding DisplayText}" />
                                                            </DataTemplate>
                                                        </ListBox.ItemTemplate>
                                                    </ListBox>

                                                    <TextBlock Style="{StaticResource DcEmptyDetail}"
                                                               Margin="0,4,0,4"
                                                               Text="No output captured yet."
                                                               Visibility="{Binding IsOutputEmpty, Converter={StaticResource BoolToVisibility}}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty is the expected state today, not a failure: say exactly why. -->
            <StackPanel Style="{StaticResource DcEmptyState}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <ui:SymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="History24" />
                <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
