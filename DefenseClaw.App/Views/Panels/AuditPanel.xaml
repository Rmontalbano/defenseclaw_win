<UserControl x:Class="DefenseClaw.App.Views.Panels.AuditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             panels:CompactLayout.Below="960">
    <!--
        Filter bar, virtualized table (a DataGrid, DcDataGrid: sortable headers, zebra rows, a row menu), keyset
        "Load more", and a detail pane that pretty-prints structured_json. The table recycles its rows
        and scrolls by the pixel, because it has to stay smooth over tens of thousands of rows.

        Keyboard: Ctrl+F focuses the search box (ApplicationCommands.Find, handled in the
        code-behind), Esc closes the detail pane.

        The detail is a flush inspector (ctl:DcInspector) that exists only while a row is selected. Beside an empty list it was a
        258 px card that said "Select a row" while the list's columns truncated to eight characters at the 940 px window
        minimum. With no selection the list takes the whole width; with one, the list and the 360 px inspector split - and on
        a narrow panel (CompactLayout, under 960 px) the inspector takes the whole width instead and the list steps aside
        until it is closed (Esc, or its X).
    -->
    <UserControl.Resources>
        <!-- The time cell: the clock time (the date too when it is not today); its tooltip is the stored timestamp. -->
        <Style x:Key="AuditTimeText" TargetType="TextBlock" BasedOn="{StaticResource DcCellText}">
            <Setter Property="ToolTip" Value="{Binding RawTimestamp}" />
            <Setter Property="ctl:DcCellToolTip.OnlyWhenTrimmed" Value="False" />
        </Style>

        <!--
            The row menu, shared by every row (right-click, or the "..." button): the row under the pointer is selected first unless it is
            already part of the selection (ctl:DcRowMenu). Nothing here changes anything - the audit log is read-only.
        -->
        <ContextMenu x:Key="AuditRowMenu">
            <MenuItem Header="Copy details"
                      Icon="{ctl:DcSymbolIcon Copy24}"
                      InputGestureText="Ctrl+C"
                      Click="OnCopyDetails" />
            <MenuItem Header="Copy structured JSON"
                      Icon="{ctl:DcSymbolIcon Code24}"
                      Click="OnCopyStructuredJson" />
            <Separator />
            <MenuItem Header="Show same target"
                      Icon="{ctl:DcSymbolIcon Filter24}"
                      ToolTip="Searches for this row's target, which narrows the list to the events about it."
                      Click="OnShowSameTarget" />
            <MenuItem Header="Show same run"
                      Icon="{ctl:DcSymbolIcon Filter24}"
                      ToolTip="Shows every event of this row's run, in any time range."
                      Click="OnShowSameRun" />
        </ContextMenu>

        <!-- The Filters header: the Activity panel's Output expander (WPF-UI's look without its slide animation), which changes at once. -->
        <Style x:Key="FiltersExpanderHeader" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource ExpanderHeaderForeground}" />
            <Setter Property="Background" Value="{DynamicResource ExpanderHeaderBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ExpanderHeaderBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Frame"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{DynamicResource DcRadiusM}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <ctl:DcSymbolIcon x:Name="Chevron"
                                                  Symbol="ChevronDown24"
                                                  FontSize="{DynamicResource ExpanderChevronSize}"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center"
                                                  RenderTransformOrigin="0.5,0.5">
                                    <ui:SymbolIcon.RenderTransform>
                                        <RotateTransform Angle="0" />
                                    </ui:SymbolIcon.RenderTransform>
                                </ctl:DcSymbolIcon>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chevron" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="FiltersExpander" TargetType="Expander">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <StackPanel>
                            <ToggleButton Style="{StaticResource FiltersExpanderHeader}"
                                          Content="{TemplateBinding Header}"
                                          AutomationProperties.Name="Filters"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A line of an inspector section that has nothing to say (an empty note) takes no room. -->
        <Style x:Key="AuditNote" TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=Text}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuditRow" TargetType="DataGridRow" BasedOn="{StaticResource DcDataGridRow}">
            <Setter Property="ContextMenu" Value="{StaticResource AuditRowMenu}" />
        </Style>

        <Style x:Key="AuditListCard" TargetType="Border" BasedOn="{StaticResource DcCardFlush}">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Style.Triggers>
                <!-- With the inspector open the list's right edge meets its divider: square, no border of its own on that side. -->
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="BorderThickness" Value="1,1,0,1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasSelection}" Value="True" />
                        <Condition Binding="{Binding Path=(panels:CompactLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the panel's name and result count, the page actions as icons, the free-text search (debounced 400 ms; Esc clears it). -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="DatabaseSearch24"
                           ctl:DcIcon.Section="Observe"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           Caption="{Binding ResultSummary}"
                           HasSearch="True"
                           SearchText="{Binding SearchText}"
                           SearchDelay="400"
                           SearchWidth="260"
                           SearchPlaceholder="Search details, event, tool, target…"
                           SearchAutomationName="Search details, event, tool and target"
                           SearchHelpText="Free text over the details, event name, tool and target. Shortcut Ctrl+F; Esc clears it.">
            <ctl:DcPageToolbar.ConnectorSlot>
                <ctl:DcConnectorScopeChip Model="{Binding ConnectorChip}" />
            </ctl:DcPageToolbar.ConnectorSlot>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowReset24}"
                               Command="{Binding ResetFiltersCommand}"
                               ToolTip="Reset filters"
                               AutomationProperties.Name="Reset filters"
                               AutomationProperties.HelpText="Set every filter back to its default: all buckets, any severity, all connectors, the last 24 hours, no text." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowDownload24}"
                               Command="{Binding ExportCommand}"
                               ToolTip="Export the list to JSON or CSV (Ctrl+E)"
                               AutomationProperties.Name="Export"
                               AutomationProperties.AcceleratorKey="Ctrl+E"
                               AutomationProperties.HelpText="Save the events these filters select (the newest 5,000 at most) as a JSON or CSV file. Shortcut Ctrl+E." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Refresh (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5"
                               AutomationProperties.HelpText="Run the current query again from the newest event. Shortcut F5." />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <!-- Filter strip (no card of its own). Bucket is read from the database, so it can be long: a combo box, not a segmented
             control. The caption under it is the result count (in the toolbar) and what cannot be read. -->
        <StackPanel Grid.Row="1">
            <!-- The archive on screen (Live | Archive below): what it is, or why it cannot be shown. Read-only: nothing in this panel changes the file. -->
            <ui:InfoBar x:Name="ArchiveBannerBar"
                        Margin="{StaticResource DcCardGap}"
                        Severity="Informational"
                        IsClosable="False"
                        Title="{Binding ArchiveBanner}"
                        Message="This is a read-only copy of an earlier DefenseClaw audit database. Switch to Live for current events."
                        IsOpen="{Binding ShowArchiveBanner, Mode=OneWay}"
                        AutomationProperties.LiveSetting="Polite" />
            <ui:InfoBar x:Name="ArchiveProblemBar"
                        Margin="{StaticResource DcCardGap}"
                        Severity="Error"
                        IsClosable="False"
                        Title="The archive could not be shown"
                        Message="{Binding ArchiveProblem}"
                        IsOpen="{Binding ShowArchiveProblem, Mode=OneWay}"
                        AutomationProperties.LiveSetting="Polite" />

            <!-- The Mac's "Audit View": five presets, then the run chip while a run is filtered, then what cannot be read. -->
            <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                <!-- Which database: shown while Settings names an archive (or the archive is on screen, so the way back stays). -->
                <ctl:DcSegmented x:Name="SourceSwitch"
                                 Margin="0,0,12,8"
                                 SelectedValue="{Binding SourceKey, Mode=TwoWay}"
                                 Visibility="{Binding ShowSourceSwitch, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Audit source"
                                 AutomationProperties.HelpText="Live shows the current audit log. Archive shows the read-only audit database kept from before an upgrade, set in Settings.">
                    <ctl:DcSegment Value="live" Content="Live" ToolTip="The current audit log" />
                    <ctl:DcSegment Value="archive" Content="Archive" ToolTip="The archived audit database from before the upgrade (read-only)" />
                </ctl:DcSegmented>

                <ctl:DcSegmented Margin="0,0,12,8"
                                 SelectedValue="{Binding ActivePreset, Mode=TwoWay}"
                                 AutomationProperties.Name="Audit view"
                                 AutomationProperties.HelpText="Narrow the list to one kind of event: all, risk (high and critical), blocks, scans or credentials. The filters below still apply.">
                    <ctl:DcSegment Value="all" Content="All" ToolTip="Every event" />
                    <ctl:DcSegment Value="risk" Content="Risk" ToolTip="High and critical severity" />
                    <ctl:DcSegment Value="blocks" Content="Blocks" ToolTip="Blocks, rejections, enforcement and quarantine" />
                    <ctl:DcSegment Value="scans" Content="Scans" ToolTip="Scan events" />
                    <ctl:DcSegment Value="credentials" Content="Credentials" ToolTip="Keys, tokens, credentials, auth and rotation" />
                </ctl:DcSegmented>

                <ui:Button Margin="0,0,12,8"
                           Appearance="Secondary"
                           Icon="{ctl:DcSymbolIcon Dismiss12}"
                           Content="{Binding RunFilterText}"
                           Command="{Binding ClearRunFilterCommand}"
                           ToolTip="Showing one run's events. Click to show every run again."
                           AutomationProperties.Name="Clear the run filter"
                           Visibility="{Binding HasRunFilter, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Style="{StaticResource DcToneText}"
                           Tag="Warn"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Text="{Binding StatusNote}" />
                <TextBlock Style="{StaticResource DcCaption}"
                           Margin="0,0,12,8"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Text="{Binding ExportNote}"
                           AutomationProperties.LiveSetting="Polite" />
                <!-- Where the empty detail pane's "Select a row ..." used to be. -->
                <TextBlock Margin="0,0,12,8" Text="Select a row for every column and its pretty-printed structured_json.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </WrapPanel>

            <!-- Today's filters, behind one header that counts the ones that are not at their defaults. -->
            <Expander x:Name="FiltersExpander"
                      Style="{StaticResource FiltersExpander}"
                      Margin="0,0,0,8"
                      AutomationProperties.Name="Filters">
                <Expander.Header>
                    <StackPanel Orientation="Horizontal">
                        <ctl:DcSymbolIcon Symbol="Filter24" Margin="0,0,8,0" VerticalAlignment="Center" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding FiltersHeader}" />
                    </StackPanel>
                </Expander.Header>
            <WrapPanel Margin="0,8,0,0" Style="{StaticResource DcToolbarPanel}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Bucket" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding Buckets}"
                              SelectedItem="{Binding SelectedBucket, Mode=TwoWay}"
                              AutomationProperties.Name="Bucket" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Min severity" />
                    <ComboBox Width="120"
                              ItemsSource="{Binding Severities}"
                              SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"
                              AutomationProperties.Name="Minimum severity" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Connector" />
                    <ComboBox Width="150"
                              ItemsSource="{Binding Connectors}"
                              SelectedItem="{Binding SelectedConnector, Mode=TwoWay}"
                              AutomationProperties.Name="Connector" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Time" />
                    <ComboBox Width="130"
                              ItemsSource="{Binding Ranges}"
                              SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                              AutomationProperties.Name="Time range" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Action" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding Actions}"
                              SelectedItem="{Binding SelectedActionOption, Mode=TwoWay}"
                              ToolTip="Pick an action to fill the action filter"
                              AutomationProperties.Name="Action, pick to fill the action filter" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Action contains" />
                    <ui:TextBox Width="110"
                                PlaceholderText="substring"
                                AutomationProperties.Name="Action contains"
                                Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                </StackPanel>

            </WrapPanel>
            </Expander>
        </StackPanel>

        <!-- Rows + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ListCard" Style="{StaticResource AuditListCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        The table: Time, Action, Type (the bucket), Target, Severity, Run, Details, and the row menu. Newest first (the
                        query's order) until a header is clicked; a header sorts the rows loaded so far. The columns share the width
                        (DcGridColumns), a cell says its whole value in a tooltip while it is cut, and the table is virtualized by the
                        pixel - this list can hold twenty pages of events. Extended selection: the first row drives the detail pane;
                        the row menu (right-click, or the "..." button) acts on the selection.
                    -->
                    <ui:DataGrid x:Name="RowList"
                                 Grid.Row="1"
                                 Style="{StaticResource DcDataGrid}"
                                 RowStyle="{StaticResource AuditRow}"
                                 ItemsSource="{Binding Rows}"
                                 SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                                 SelectionMode="Extended"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ctl:DcGridColumns.Fit="True"
                                 SelectionChanged="OnRowSelectionChanged"
                                 AutomationProperties.Name="Audit events">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Width="0.9*" MinWidth="96" Header="Time"
                                                SortMemberPath="Timestamp"
                                                ElementStyle="{StaticResource AuditTimeText}"
                                                Binding="{Binding TimestampText}" />
                            <DataGridTextColumn Width="1.3*" MinWidth="80" Header="Action"
                                                SortMemberPath="Action"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding Action}" />
                            <DataGridTextColumn Width="1.1*" MinWidth="76" Header="Type"
                                                SortMemberPath="Bucket"
                                                ElementStyle="{StaticResource DcCellTextQuiet}"
                                                Binding="{Binding Bucket}" />
                            <DataGridTextColumn Width="1.6*" MinWidth="80" Header="Target"
                                                SortMemberPath="Target"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding Target}" />
                            <DataGridTemplateColumn Width="0.9*" MinWidth="84" Header="Severity"
                                                    SortMemberPath="SeverityRank">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ctl:DcSeverityBadge Text="{Binding Severity}"
                                                             Tone="{Binding SeverityKey}"
                                                             Margin="0,0,8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="0.8*" MinWidth="60" Header="Run"
                                                SortMemberPath="RunId"
                                                ElementStyle="{StaticResource DcCellTextMono}"
                                                Binding="{Binding RunId}" />
                            <DataGridTextColumn Width="2*" MinWidth="90" Header="Details"
                                                SortMemberPath="Summary"
                                                ElementStyle="{StaticResource DcCellTextQuiet}"
                                                Binding="{Binding Summary}" />
                            <DataGridTemplateColumn Width="32" Header="Actions"
                                                    CanUserSort="False"
                                                    HeaderStyle="{StaticResource DcDataGridActionsHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ctl:DcRowMenuButton AutomationProperties.HelpText="Copy the event, or show events about the same target." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>

                    <!-- Empty is a state, not a failure: say which one. -->
                    <StackPanel Grid.Row="1"
                                Style="{StaticResource DcEmptyState}"
                                MaxWidth="420"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="DatabaseSearch24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                    </StackPanel>

                    <!-- A WrapPanel, not a StackPanel: it hands its children the column's width, so the limit
                         notice wraps inside a narrow list instead of running past the card's edge. -->
                    <WrapPanel Grid.Row="2"
                               Margin="8,8,8,2"
                               HorizontalAlignment="Center">
                        <ui:Button Content="Load more"
                                   Icon="{ctl:DcSymbolIcon ArrowDown24}"
                                   Appearance="Secondary"
                                   Command="{Binding LoadMoreCommand}"
                                   AutomationProperties.HelpText="Load the next 100 events after the last one shown."
                                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Where "Load more" would be, once the list is full: say why there is no next page. -->
                        <TextBlock Style="{StaticResource DcToneText}"
                                   Tag="Warn"
                                   FontSize="12"
                                   MaxWidth="440"
                                   Margin="0,2"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding RowCapNotice, Mode=OneWay}"
                                   Visibility="{Binding IsRowCapReached, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ProgressRing Width="20"
                                         Height="20"
                                         Margin="10,0,0,0"
                                         IsIndeterminate="True"
                                         AutomationProperties.Name="Loading"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Inspector: opens while a row is selected (ctl:DcInspector); the list takes the whole width otherwise. -->
            <ctl:DcInspector x:Name="Inspector"
                             Title="Event details"
                             IsOpen="{Binding HasSelection}"
                             CloseCommand="{Binding ClearSelectionCommand}"
                             CloseAutomationName="Close event details"
                             AutomationProperties.Name="Event details"
                             Content="{Binding SelectedRow}">
                <ctl:DcInspector.Badges>
                    <ctl:DcSeverityBadge Text="{Binding SelectedRow.Severity}" Tone="{Binding SelectedRow.SeverityKey}" />
                </ctl:DcInspector.Badges>
                <ctl:DcInspector.ContentTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DcSectionHeader}" Margin="0" Text="{Binding Action}" />
                            <TextBlock Style="{StaticResource DcTextSecondary}"
                                       Margin="0,6,0,0"
                                       Text="{Binding Summary}" />
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Margin="0,4,0,0"
                                       Text="{Binding TimestampText}" />

                            <!-- Correlation: both chips filter the list (this inspector follows the selection, so it closes with it). -->
                            <WrapPanel Margin="0,10,0,0">
                                <ui:Button Margin="0,0,8,4"
                                           Appearance="Secondary"
                                           Icon="{ctl:DcSymbolIcon Filter24}"
                                           Content="Same target"
                                           IsEnabled="{Binding HasTarget}"
                                           Command="{Binding DataContext.FilterBySameTargetCommand, RelativeSource={RelativeSource AncestorType={x:Type panels:AuditPanel}}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Narrow the list to the events about this target"
                                           AutomationProperties.Name="Same target"
                                           AutomationProperties.HelpText="Searches the list for this event's target." />
                                <ui:Button Margin="0,0,8,4"
                                           Appearance="Secondary"
                                           Icon="{ctl:DcSymbolIcon Filter24}"
                                           Content="Same run"
                                           IsEnabled="{Binding HasRun}"
                                           Command="{Binding DataContext.FilterBySameRunCommand, RelativeSource={RelativeSource AncestorType={x:Type panels:AuditPanel}}}"
                                           CommandParameter="{Binding}"
                                           ToolTip="Show every event of this run, in any time range"
                                           AutomationProperties.Name="Same run"
                                           AutomationProperties.HelpText="Shows only the events that share this event's run id, in every time range." />
                            </WrapPanel>

                            <StackPanel Visibility="{Binding HasDetailPairs, Converter={StaticResource BoolToVisibility}}">
                                <ctl:DcCardHeader Margin="0,10,0,4" Symbol="TextBulletList24" Section="Observe" Content="Parsed details" />
                                <ItemsControl ItemsSource="{Binding DetailPairs}"
                                              AutomationProperties.Name="Parsed details">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="112" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Style="{StaticResource DcCaption}"
                                                           Margin="0,0,10,0"
                                                           Text="{Binding Label}" />
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource DcMono}"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Value}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <StackPanel Visibility="{Binding HasRun, Converter={StaticResource BoolToVisibility}}">
                                <ctl:DcCardHeader Margin="0,10,0,4" Symbol="Bug24" Section="Observe" Content="Findings in this run" />
                                <TextBlock Style="{StaticResource AuditNote}"
                                           Text="{Binding DataContext.FindingsNote, RelativeSource={RelativeSource AncestorType={x:Type panels:AuditPanel}}}" />
                                <ItemsControl ItemsSource="{Binding DataContext.RunFindings, RelativeSource={RelativeSource AncestorType={x:Type panels:AuditPanel}}}"
                                              AutomationProperties.Name="Findings in this run">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,8">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctl:DcSeverityBadge Text="{Binding Severity}" Tone="{Binding SeverityKey}" Margin="0,0,8,0" />
                                                    <TextBlock Style="{StaticResource DcTextSecondary}"
                                                               VerticalAlignment="Center"
                                                               TextWrapping="Wrap"
                                                               Text="{Binding Title}" />
                                                </StackPanel>
                                                <TextBlock Style="{StaticResource DcCaption}"
                                                           Margin="0,2,0,0"
                                                           TextWrapping="Wrap"
                                                           Text="{Binding Origin}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <ctl:DcCardHeader Margin="0,10,0,4" Symbol="Link24" Section="Observe" Content="Related events" />
                            <TextBlock Style="{StaticResource AuditNote}"
                                       Text="{Binding DataContext.RelatedNote, RelativeSource={RelativeSource AncestorType={x:Type panels:AuditPanel}}}" />
                            <ItemsControl ItemsSource="{Binding DataContext.RelatedEvents, RelativeSource={RelativeSource AncestorType={x:Type panels:AuditPanel}}}"
                                          AutomationProperties.Name="Related events">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:DcSeverityBadge Text="{Binding Severity}" Tone="{Binding SeverityKey}" Margin="0,0,8,0" />
                                                <TextBlock Style="{StaticResource DcTextSecondary}"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Action}" />
                                                <TextBlock Style="{StaticResource DcCaption}"
                                                           Margin="8,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding TimestampText}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource DcCaption}"
                                                       Margin="0,2,0,0"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis"
                                                       MaxHeight="48"
                                                       Text="{Binding Summary}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="TableSimple24" Section="Observe" Content="Columns" />
                            <ItemsControl ItemsSource="{Binding Fields}"
                                          AutomationProperties.Name="Event columns">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource DcMono}"
                                                       Margin="0,0,10,0"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource DcCaption}"
                                                       Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="Code24" Section="Observe" Content="structured_json" />
                            <Border Style="{StaticResource DcCodeBlock}">
                                <ScrollViewer MaxHeight="420"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Auto">
                                    <TextBox Style="{StaticResource DcMonoTextBox}"
                                             TextWrapping="NoWrap"
                                             AutomationProperties.Name="structured_json"
                                             Text="{Binding StructuredJson, Mode=OneWay}" />
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ctl:DcInspector.ContentTemplate>
            </ctl:DcInspector>
        </Grid>
    </Grid>
</UserControl>
