<UserControl x:Class="DefenseClaw.App.Views.Panels.AuditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Filter bar, virtualized row list with a fixed-width header, keyset "Load more", and a
        detail pane that pretty-prints structured_json. Column widths are repeated between the
        header and the row template on purpose: shared-size groups defeat UI virtualization,
        and this table has to stay smooth over tens of thousands of rows.
    -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Tertiary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="FilterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,0,0,3" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <Style x:Key="ColumnHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
        </Style>

        <!-- Row accent: severity as a left bar, so scanning the list is a colour scan. -->
        <Style x:Key="SeverityBar" TargetType="Border">
            <Setter Property="Width" Value="3" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="High">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Medium">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="High">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Medium">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="13"
                           Style="{StaticResource Secondary}"
                           Text="{Binding Description}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button Margin="0,0,8,0"
                           Appearance="Secondary"
                           Content="Reset filters"
                           Command="{Binding ResetFiltersCommand}" />
                <ui:Button Content="Refresh" Command="{Binding RefreshCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <!-- Filter bar -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Bucket" />
                        <ComboBox Width="170"
                                  ItemsSource="{Binding Buckets}"
                                  SelectedItem="{Binding SelectedBucket, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Minimum severity" />
                        <ComboBox Width="170"
                                  ItemsSource="{Binding Severities}"
                                  SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Connector" />
                        <ComboBox Width="200"
                                  ItemsSource="{Binding Connectors}"
                                  SelectedItem="{Binding SelectedConnector, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Time range" />
                        <ComboBox Width="140"
                                  ItemsSource="{Binding Ranges}"
                                  SelectedItem="{Binding SelectedRange, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Action (pick to fill)" />
                        <ComboBox Width="190"
                                  ItemsSource="{Binding Actions}"
                                  SelectedItem="{Binding SelectedActionOption, Mode=TwoWay}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Action contains" />
                        <ui:TextBox Width="170"
                                    PlaceholderText="substring"
                                    Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    </StackPanel>

                    <StackPanel Margin="0,0,0,8">
                        <TextBlock Style="{StaticResource FilterLabel}" Text="Search details / event / tool / target" />
                        <ui:TextBox Width="240"
                                    PlaceholderText="free text"
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    </StackPanel>
                </WrapPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock FontSize="11" Style="{StaticResource Tertiary}" Text="{Binding ResultSummary}" />
                    <TextBlock Margin="12,0,0,0"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SystemFillColorCautionBrush}"
                               Text="{Binding StatusNote}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Rows + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="440" />
                <ColumnDefinition Width="2*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Column header. Widths mirror the row template below. -->
                    <Grid Grid.Row="0" Margin="25,4,10,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="1.1*" />
                            <ColumnDefinition Width="1.3*" />
                            <ColumnDefinition Width="0.6*" />
                            <ColumnDefinition Width="1.8*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource ColumnHeader}" Text="TIME" />
                        <TextBlock Grid.Column="1" Style="{StaticResource ColumnHeader}" Text="SEVERITY" />
                        <TextBlock Grid.Column="2" Style="{StaticResource ColumnHeader}" Text="BUCKET" />
                        <TextBlock Grid.Column="3" Style="{StaticResource ColumnHeader}" Text="ACTION" />
                        <TextBlock Grid.Column="4" Style="{StaticResource ColumnHeader}" Text="CONN." />
                        <TextBlock Grid.Column="5" Style="{StaticResource ColumnHeader}" Text="SUMMARY" />
                    </Grid>

                    <ListView Grid.Row="1"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Star widths, not fixed: the panel has to stay readable when
                                     the window is narrow or the display scale is high. Ratios
                                     mirror the header grid above. -->
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.3*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="1.8*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Style="{StaticResource SeverityBar}" />

                                    <TextBlock Grid.Column="1"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               ToolTip="{Binding RawTimestamp}"
                                               Text="{Binding TimestampText}" />

                                    <TextBlock Grid.Column="2"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource SeverityText}"
                                               Text="{Binding Severity}" />

                                    <TextBlock Grid.Column="3"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Bucket}" />

                                    <TextBlock Grid.Column="4"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               Text="{Binding Action}" />

                                    <TextBlock Grid.Column="5"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                               Text="{Binding Connector}" />

                                    <TextBlock Grid.Column="6"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                               Text="{Binding Summary}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty is a state, not a failure: say which one. -->
                    <StackPanel Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding EmptyTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   Style="{StaticResource Tertiary}"
                                   Text="{Binding EmptyDetail}" />
                    </StackPanel>

                    <StackPanel Grid.Row="2"
                                Margin="0,8,0,2"
                                Orientation="Horizontal"
                                HorizontalAlignment="Center">
                        <ui:Button Content="Load more"
                                   Appearance="Secondary"
                                   Command="{Binding LoadMoreCommand}"
                                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ProgressRing Width="20"
                                         Height="20"
                                         Margin="10,0,0,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail pane -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <!--
                        A ContentControl still applies its ContentTemplate when Content is null,
                        so the template's static labels would show over the placeholder. Hiding
                        the whole ScrollViewer on HasSelection is the fix - and HasSelection is a
                        plain bool, so the app-level BoolToVisibility converter covers it.
                    -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <ContentControl Content="{Binding SelectedRow}">
                            <ContentControl.ContentTemplate>
                                <DataTemplate>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource SeverityText}"
                                                       FontSize="13"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Severity}" />
                                            <TextBlock Margin="10,0,0,0"
                                                       FontSize="15"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding Action}" />
                                        </StackPanel>

                                        <TextBlock Margin="0,6,0,0"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding Summary}" />
                                        <TextBlock Margin="0,4,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   Text="{Binding TimestampText}" />

                                        <TextBlock Margin="0,14,0,4"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="Columns" />
                                        <ItemsControl ItemsSource="{Binding Fields}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="112" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0"
                                                                   Margin="0,0,10,0"
                                                                   FontSize="11"
                                                                   FontFamily="Cascadia Mono, Consolas"
                                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                                   Text="{Binding Name}" />
                                                        <TextBlock Grid.Column="1"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                                   Text="{Binding Value}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <TextBlock Margin="0,14,0,4"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                   Text="structured_json" />
                                        <Border Padding="10"
                                                CornerRadius="6"
                                                Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                            <TextBox FontFamily="Cascadia Mono, Consolas"
                                                     FontSize="11"
                                                     IsReadOnly="True"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     TextWrapping="NoWrap"
                                                     MaxHeight="420"
                                                     VerticalScrollBarVisibility="Auto"
                                                     HorizontalScrollBarVisibility="Auto"
                                                     Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                     Text="{Binding StructuredJson, Mode=OneWay}" />
                                        </Border>
                                    </StackPanel>
                                </DataTemplate>
                            </ContentControl.ContentTemplate>
                        </ContentControl>
                    </ScrollViewer>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="240"
                               TextAlignment="Center"
                               Text="Select a row to see every column and its pretty-printed structured_json.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tertiary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
