<UserControl x:Class="DefenseClaw.App.Views.Panels.AuditPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             panels:CompactLayout.Below="960">
    <!--
        Filter bar, virtualized row list with a fixed-width header, keyset "Load more", and a
        detail pane that pretty-prints structured_json. Column widths are repeated between the
        header and the row template on purpose: shared-size groups defeat UI virtualization,
        and this table has to stay smooth over tens of thousands of rows.

        On the shared Dc* design system: the row is the same grid it always was (the wave-1/2
        virtualization design is untouched) with the severity bar, severity text and cells restyled.
        Keyboard: Ctrl+F focuses the search box (ApplicationCommands.Find, handled in the
        code-behind), Esc closes the detail pane.

        The detail pane exists only while a row is selected. Beside an empty list it was a 258 px
        card that said "Select a row" while the list's columns truncated to eight characters at the
        940 px window minimum. With no selection the list takes the whole width; with one, the two
        split - and on a narrow panel (CompactLayout, under 960 px) the detail takes the whole width
        instead and the list steps aside until it is closed (Esc, or its own button).
    -->
    <UserControl.Resources>
        <Style x:Key="AuditListCard" TargetType="Border" BasedOn="{StaticResource DcCardFlush}">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="3" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasSelection}" Value="True" />
                        <Condition Binding="{Binding Path=(panels:CompactLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuditDetailCard" TargetType="Border" BasedOn="{StaticResource DcCardCompact}">
            <Setter Property="Grid.Column" Value="2" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasSelection}" Value="True" />
                        <Condition Binding="{Binding Path=(panels:CompactLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HeaderedContentControl Grid.Row="0" Style="{StaticResource DcPageHeader}"
                                ctl:DcIcon.Symbol="DatabaseSearch24"
                                ctl:DcIcon.Section="Observe">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource DcPageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource DcPageSubtitle}" Text="{Binding Description}" />
                </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel Style="{StaticResource DcActionBar}">
                <ui:Button Content="Reset filters"
                           Icon="{ctl:DcSymbolIcon ArrowReset24}"
                           Appearance="Secondary"
                           Command="{Binding ResetFiltersCommand}"
                           AutomationProperties.HelpText="Set every filter back to its default: all buckets, any severity, all connectors, the last 24 hours, no text." />
                <ui:Button Content="Refresh"
                           Command="{Binding RefreshCommand}"
                           AutomationProperties.HelpText="Run the current query again from the newest event. Shortcut F5.">
                    <ui:Button.Icon>
                        <ctl:DcSymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Filter bar. Each field is a label over its control; the toolbar's implicit styles space
             the controls, the labels carry no margin of their own beyond the gap under them. -->
        <Border Grid.Row="1" Style="{StaticResource DcToolbar}">
            <StackPanel>
                <WrapPanel Style="{StaticResource DcToolbarPanel}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource DcFieldLabel}" Margin="0,0,0,4" Text="Bucket" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding Buckets}"
                                  SelectedItem="{Binding SelectedBucket, Mode=TwoWay}"
                                  AutomationProperties.Name="Bucket" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource DcFieldLabel}" Margin="0,0,0,4" Text="Minimum severity" />
                        <ComboBox Width="140"
                                  ItemsSource="{Binding Severities}"
                                  SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"
                                  AutomationProperties.Name="Minimum severity" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource DcFieldLabel}" Margin="0,0,0,4" Text="Connector" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding Connectors}"
                                  SelectedItem="{Binding SelectedConnector, Mode=TwoWay}"
                                  AutomationProperties.Name="Connector" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource DcFieldLabel}" Margin="0,0,0,4" Text="Time range" />
                        <ComboBox Width="150"
                                  ItemsSource="{Binding Ranges}"
                                  SelectedItem="{Binding SelectedRange, Mode=TwoWay}"
                                  AutomationProperties.Name="Time range" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource DcFieldLabel}" Margin="0,0,0,4" Text="Action (pick to fill)" />
                        <ComboBox Width="180"
                                  ItemsSource="{Binding Actions}"
                                  SelectedItem="{Binding SelectedActionOption, Mode=TwoWay}"
                                  AutomationProperties.Name="Action, pick to fill the action filter" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource DcFieldLabel}" Margin="0,0,0,4" Text="Action contains" />
                        <ui:TextBox Width="140"
                                    PlaceholderText="substring"
                                    AutomationProperties.Name="Action contains"
                                    Text="{Binding ActionFilter, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Style="{StaticResource DcFieldLabel}" Margin="0,0,0,4" Text="Search details / event / tool / target" />
                        <ui:TextBox x:Name="SearchBox"
                                    Width="220"
                                    PlaceholderText="free text"
                                    AutomationProperties.Name="Search details, event, tool and target"
                                    AutomationProperties.HelpText="Shortcut Ctrl+F."
                                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,0,12,8">
                    <TextBlock Style="{StaticResource DcCaption}" Margin="0,0,12,0" Text="{Binding ResultSummary}" />
                    <TextBlock Style="{StaticResource DcToneText}"
                               Tag="Warn"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Text="{Binding StatusNote}" />
                    <!-- Where the empty detail pane's "Select a row ..." used to be. -->
                    <TextBlock Margin="0,0,12,0" Text="Select a row for every column and its pretty-printed structured_json.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Rows + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360" />
                <ColumnDefinition Width="{StaticResource DcColumnGap}" />
                <ColumnDefinition Width="2*" MinWidth="260" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ListCard" Style="{StaticResource AuditListCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Column header. Widths mirror the row template below: the short columns are fixed and the
                         summary takes whatever is left (the old star ratios gave a 661 px list about 8 characters each
                         for bucket, action and connector, and the summary no more than the rest). -->
                    <Grid Grid.Row="0" Margin="19,4,4,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="68" />
                            <ColumnDefinition Width="56" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="104" />
                            <ColumnDefinition Width="72" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Style="{StaticResource DcColumnHeader}" Text="TIME" />
                        <TextBlock Grid.Column="1" Style="{StaticResource DcColumnHeader}" Text="SEVERITY" />
                        <TextBlock Grid.Column="2" Style="{StaticResource DcColumnHeader}" Text="BUCKET" />
                        <TextBlock Grid.Column="3" Style="{StaticResource DcColumnHeader}" Text="ACTION" />
                        <TextBlock Grid.Column="4" Style="{StaticResource DcColumnHeader}" Text="CONN." />
                        <TextBlock Grid.Column="5" Style="{StaticResource DcColumnHeader}" Text="SUMMARY" />
                    </Grid>

                    <ListView x:Name="RowList"
                              Grid.Row="1"
                              ItemsSource="{Binding Rows}"
                              SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel"
                              AutomationProperties.Name="Audit events">
                        <!-- WPF-UI's list item pads 12 px on every side, which made each one-line event a 46 px row
                             and left room for three of them. A table is read by the screenful: rows are ~30 px. -->
                        <ListView.ItemContainerStyle>
                            <Style TargetType="{x:Type ListViewItem}" BasedOn="{StaticResource {x:Type ListViewItem}}">
                                <Setter Property="Padding" Value="6,2,6,2" />
                                <Setter Property="MinHeight" Value="0" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <!-- Widths mirror the header grid above; the summary is the one star column. -->
                                <Grid Margin="0,3,0,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="68" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="120" />
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="72" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            Style="{StaticResource DcToneBar}"
                                            Width="3"
                                            Margin="0,0,8,0"
                                            Tag="{Binding SeverityKey}" />

                                    <TextBlock Grid.Column="1"
                                               Style="{StaticResource DcCaption}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding RawTimestamp}"
                                               Text="{Binding TimestampText}" />

                                    <TextBlock Grid.Column="2"
                                               Style="{StaticResource DcToneText}"
                                               Tag="{Binding SeverityKey}"
                                               FontSize="11"
                                               VerticalAlignment="Center"
                                               Text="{Binding Severity}" />

                                    <TextBlock Grid.Column="3"
                                               Style="{StaticResource DcCaption}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Bucket}"
                                               Text="{Binding Bucket}" />

                                    <TextBlock Grid.Column="4"
                                               Style="{StaticResource DcCaption}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Action}"
                                               Text="{Binding Action}" />

                                    <TextBlock Grid.Column="5"
                                               Style="{StaticResource DcCaption}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Connector}"
                                               Text="{Binding Connector}" />

                                    <TextBlock Grid.Column="6"
                                               Style="{StaticResource DcCaption}"
                                               VerticalAlignment="Center"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Summary}"
                                               Text="{Binding Summary}" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty is a state, not a failure: say which one. -->
                    <StackPanel Grid.Row="1"
                                Style="{StaticResource DcEmptyState}"
                                MaxWidth="420"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="DatabaseSearch24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                    </StackPanel>

                    <!-- A WrapPanel, not a StackPanel: it hands its children the column's width, so the limit
                         notice wraps inside a narrow list instead of running past the card's edge. -->
                    <WrapPanel Grid.Row="2"
                               Margin="8,8,8,2"
                               HorizontalAlignment="Center">
                        <ui:Button Content="Load more"
                                   Icon="{ctl:DcSymbolIcon ArrowDown24}"
                                   Appearance="Secondary"
                                   Command="{Binding LoadMoreCommand}"
                                   AutomationProperties.HelpText="Load the next 100 events after the last one shown."
                                   Visibility="{Binding HasMore, Converter={StaticResource BoolToVisibility}}" />
                        <!-- Where "Load more" would be, once the list is full: say why there is no next page. -->
                        <TextBlock Style="{StaticResource DcToneText}"
                                   Tag="Warn"
                                   FontSize="12"
                                   MaxWidth="440"
                                   Margin="0,2"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Text="{Binding RowCapNotice, Mode=OneWay}"
                                   Visibility="{Binding IsRowCapReached, Converter={StaticResource BoolToVisibility}}" />
                        <ui:ProgressRing Width="20"
                                         Height="20"
                                         Margin="10,0,0,0"
                                         IsIndeterminate="True"
                                         AutomationProperties.Name="Loading"
                                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- Detail pane: present only while a row is selected (AuditDetailCard). -->
            <Border x:Name="DetailCard" Style="{StaticResource AuditDetailCard}">
                <Grid>
                    <!--
                        A ContentControl still applies its ContentTemplate when Content is null,
                        so the template's static labels would show over an empty pane. The card is
                        hidden without a selection, and the ScrollViewer with it - HasSelection is a
                        plain bool, so the app-level BoolToVisibility converter covers it.
                    -->
                    <ScrollViewer Style="{StaticResource DcPageScroll}"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ctl:DcCardHeader Grid.Column="0"
                                           VerticalAlignment="Center"
                                           Symbol="DocumentText24"
                                           Section="Observe"
                                           Content="Event details" />
                                <ui:Button x:Name="DetailClose"
                                           Grid.Column="1"
                                           Appearance="Transparent"
                                           Command="{Binding ClearSelectionCommand}"
                                           ToolTip="Close details (Esc)"
                                           AutomationProperties.Name="Close event details"
                                           AutomationProperties.HelpText="Closes this pane. Shortcut Esc.">
                                    <ui:Button.Icon>
                                        <ctl:DcSymbolIcon Symbol="Dismiss24" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </Grid>

                            <ContentControl Content="{Binding SelectedRow}" IsTabStop="False">
                                <ContentControl.ContentTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:DcSeverityGlyph Tone="{Binding SeverityKey}" Gap="6" />
                                                <TextBlock Style="{StaticResource DcToneText}"
                                                           Tag="{Binding SeverityKey}"
                                                           FontSize="13"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Severity}" />
                                                <TextBlock Style="{StaticResource DcSectionHeader}"
                                                           Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Text="{Binding Action}" />
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource DcTextSecondary}"
                                                       Margin="0,6,0,0"
                                                       Text="{Binding Summary}" />
                                            <TextBlock Style="{StaticResource DcCaption}"
                                                       Margin="0,4,0,0"
                                                       Text="{Binding TimestampText}" />

                                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="TableSimple24" Section="Observe" Content="Columns" />
                                            <ItemsControl ItemsSource="{Binding Fields}"
                                                          AutomationProperties.Name="Event columns">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Grid Margin="0,0,0,4">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="112" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0"
                                                                       Style="{StaticResource DcMono}"
                                                                       Margin="0,0,10,0"
                                                                       Text="{Binding Name}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Style="{StaticResource DcCaption}"
                                                                       Text="{Binding Value}" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="Code24" Section="Observe" Content="structured_json" />
                                            <Border Style="{StaticResource DcCodeBlock}">
                                                <ScrollViewer MaxHeight="420"
                                                              VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Auto">
                                                    <TextBox Style="{StaticResource DcMonoTextBox}"
                                                             TextWrapping="NoWrap"
                                                             AutomationProperties.Name="structured_json"
                                                             Text="{Binding StructuredJson, Mode=OneWay}" />
                                                </ScrollViewer>
                                            </Border>
                                        </StackPanel>
                                    </DataTemplate>
                                </ContentControl.ContentTemplate>
                            </ContentControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
