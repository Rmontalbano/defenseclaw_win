<UserControl x:Class="DefenseClaw.App.Views.Panels.Govern.GovernOutputCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             IsTabStop="False">
    <!--
        Result of a read-only row command (skill info, plugin info, tool status). It sits under the list, as the last
        thing on the page, and scrolls itself into view when it opens (see the code-behind): above the list it took up to
        ~370 DIPs of a page that has ~400, and left the list nothing. DataContext = a GovernPanelViewModelBase. Esc closes it.
    -->
    <Border x:Name="Card"
            Style="{StaticResource DcCard}"
            Margin="0,12,0,12"
            AutomationProperties.Name="Command result"
            Visibility="{Binding IsOutputOpen, Converter={StaticResource BoolToVisibility}}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ctl:DcCardHeader Grid.Row="0"
                       Grid.Column="0"
                       AutomationProperties.LiveSetting="Polite"
                       Symbol="TextDescription24"
                       Section="Govern"
                       Content="{Binding OutputTitle}" />

            <StackPanel Grid.Row="0"
                        Grid.Column="1"
                        Orientation="Horizontal">
                <ui:Button Margin="0,0,8,8"
                           Content="Copy"
                           Command="{Binding CopyOutputCommand}"
                           AutomationProperties.Name="Copy the result to the clipboard">
                    <ui:Button.Icon>
                        <ctl:DcSymbolIcon Symbol="Copy24" />
                    </ui:Button.Icon>
                </ui:Button>
                <ui:Button Margin="0,0,0,8"
                           Content="Close"
                           Icon="{ctl:DcSymbolIcon Dismiss24}"
                           Command="{Binding CloseOutputCommand}"
                           AutomationProperties.Name="Close the result" />
            </StackPanel>

            <Border Grid.Row="1"
                    Grid.Column="0"
                    Grid.ColumnSpan="2"
                    Style="{StaticResource DcCodeBlock}">
                <TextBox Style="{StaticResource DcMonoTextBox}"
                         MaxHeight="280"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Auto"
                         TextWrapping="NoWrap"
                         Text="{Binding OutputText, Mode=OneWay}"
                         AutomationProperties.Name="Command output" />
            </Border>
        </Grid>
    </Border>
</UserControl>
