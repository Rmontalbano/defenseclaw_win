<UserControl x:Class="DefenseClaw.App.Views.Panels.LogsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             panels:CompactLayout.Below="960">
    <!--
        Filters above, virtualized monospace list below. Four streams share the list: gateway.log and watchdog.log (live tails) and
        the canonical Verdicts / Events streams read from audit.db. Each row is a tone bar (its severity), a time, a bracketed
        [type:action] label and the message, two lines like the Mac's; a run of identical rows is one row with a "Repeated N times" chip.
        gateway.log / watchdog.log carry no timestamp and almost never a level - just "[component] message" - so on those two the
        component checklist is a filter axis too.

        On the shared Dc* design system (the page toolbar, the segmented source control). Keyboard: Ctrl+F
        focuses the filter box (the code-behind handles ApplicationCommands.Find), Esc clears the filter text, then closes the inspector.

        The inspector (ctl:DcInspector) opens beside the list while a line is selected: its parsed fields and the raw line.
        With no selection the list takes the whole width; on a narrow panel (CompactLayout, under 960 px) the inspector replaces the list.
    -->
    <UserControl.Resources>
        <!-- The row's time and [type:action] label. A row with no time of its own (most log-file lines) shows no gap; the label
             reads on the accent fill of a selected row instead of disappearing into it. -->
        <Style x:Key="LogTimeText" TargetType="TextBlock" BasedOn="{StaticResource DcMono}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource DcTextSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding TimeText}" Value="">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DcOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogLabelText" TargetType="TextBlock" BasedOn="{StaticResource DcMono}">
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Foreground" Value="{DynamicResource DcAccentBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource DcOnAccentBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="LogListCard" TargetType="Border" BasedOn="{StaticResource DcCardFlush}">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="BorderThickness" Value="1,1,0,1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasSelection}" Value="True" />
                        <Condition Binding="{Binding Path=(panels:CompactLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar. The filter is debounced (400 ms) before it re-projects the buffer; Esc clears it at once. -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="DocumentBulletList24"
                           ctl:DcIcon.Section="Observe"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           HasSearch="True"
                           SearchText="{Binding FilterText}"
                           SearchDelay="400"
                           SearchPlaceholder="Filter log lines…"
                           SearchAutomationName="Filter log lines"
                           SearchHelpText="Shows only lines that contain this text. Shortcut Ctrl+F; Esc clears it.">
            <ctl:DcPageToolbar.ConnectorSlot>
                <ctl:DcConnectorScopeChip Model="{Binding ConnectorChip}" />
            </ctl:DcPageToolbar.ConnectorSlot>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowSync24}"
                               Command="{Binding ReloadFromDiskCommand}"
                               ToolTip="Reload from disk"
                               AutomationProperties.Name="Reload from disk"
                               AutomationProperties.HelpText="Read the stream again: audit.db for Verdicts and Events, the start of the file for a log." />
                    <ui:Button Icon="{ctl:DcSymbolIcon Gavel24}"
                               Command="{Binding OpenJudgeHistoryCommand}"
                               Visibility="{Binding IsVerdictsSource, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Show the retained LLM judge responses (judge_bodies.db and the older audit.db table)"
                               AutomationProperties.Name="Judge responses"
                               AutomationProperties.HelpText="Open the retained LLM judge responses: verdict, confidence, latency and the redacted raw body." />
                    <ui:Button Icon="{ctl:DcSymbolIcon Broom24}"
                               Command="{Binding ClearCommand}"
                               ToolTip="Clear the buffered lines"
                               AutomationProperties.Name="Clear"
                               AutomationProperties.HelpText="Empty the buffered lines for the log file on screen. The file itself is untouched. Not available on Verdicts and Events." />
                    <ui:Button Icon="{ctl:DcSymbolIcon Copy24}"
                               Command="{Binding CopySelectionCommand}"
                               ToolTip="Copy selection"
                               AutomationProperties.Name="Copy selection"
                               AutomationProperties.HelpText="Copy the selected log lines to the clipboard." />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <!-- Filter strip: which stream, the preset and the pickers, which components, follow the newest row, then the count line. -->
        <StackPanel Grid.Row="1">
            <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                <!-- Four streams: a segmented control (the value is the view-model's ActiveSource; SelectSourceCommand stays for callers).
                     The Mac's "Otel" stream is the Events stream here: every canonical event. -->
                <ctl:DcSegmented SelectedValue="{Binding ActiveSource, Mode=TwoWay}"
                                 AutomationProperties.Name="Log stream">
                    <ctl:DcSegment Value="Gateway"
                                   Content="Gateway"
                                   ToolTip="Show gateway.log" />
                    <ctl:DcSegment Value="Verdicts"
                                   Content="Verdicts"
                                   ToolTip="Show the decisions in audit.db: guardrail evaluations, enforcement actions, scans, findings and errors" />
                    <ctl:DcSegment Value="Events"
                                   Content="Events"
                                   ToolTip="Show every canonical event in audit.db (telemetry ingest is hidden unless switched on)" />
                    <ctl:DcSegment Value="Watchdog"
                                   Content="Watchdog"
                                   ToolTip="Show watchdog.log" />
                </ctl:DcSegmented>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Preset" />
                    <ComboBox Width="130"
                              ItemsSource="{Binding Presets}"
                              SelectedItem="{Binding SelectedPreset, Mode=TwoWay}"
                              ToolTip="A saved filter: no-noise hides heartbeat chatter, important keeps errors, verdicts and lifecycle, the rest keep one topic"
                              AutomationProperties.Name="Preset" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Severity ≥" />
                    <ComboBox Width="140"
                              ItemsSource="{Binding SeverityOptions}"
                              SelectedItem="{Binding SelectedSeverity, Mode=TwoWay}"
                              AutomationProperties.Name="Minimum severity" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Action" />
                    <ComboBox Width="110"
                              ItemsSource="{Binding ActionOptions}"
                              SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                              AutomationProperties.Name="Action" />
                </StackPanel>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Event" />
                    <ComboBox Width="130"
                              ItemsSource="{Binding EventOptions}"
                              SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                              AutomationProperties.Name="Event kind" />
                </StackPanel>

                <CheckBox Margin="0,0,12,8"
                          MinWidth="0"
                          Content="Telemetry"
                          IsChecked="{Binding IncludeTelemetry, Mode=TwoWay}"
                          Visibility="{Binding IsEventsSource, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="Include the telemetry.ingest bucket, which is most of audit.db and hidden by default"
                          AutomationProperties.Name="Include telemetry"
                          AutomationProperties.HelpText="Events only: also show telemetry.ingest events, which are hidden by default because they are most of the table." />

                <ItemsControl Margin="0,0,12,8"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding ComponentFilters}"
                              AutomationProperties.Name="Component filters">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <CheckBox MinWidth="0"
                                      Content="{Binding Name}"
                                      IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                      AutomationProperties.HelpText="Shows or hides log lines from this component." />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ui:ToggleSwitch Margin="0,0,12,8"
                                 Content="{Binding LiveStateText}"
                                 IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                 AutomationProperties.Name="Auto-scroll"
                                 AutomationProperties.HelpText="On: the list scrolls to each new row as it arrives (live). Off: the list stays where you are (paused)." />

                <TextBlock Style="{StaticResource DcResultCaption}"
                           Margin="0,0,0,8"
                           Text="{Binding StatusLineCount}"
                           AutomationProperties.Name="Row counts" />
            </WrapPanel>

            <ui:InfoBar Margin="0,0,0,8"
                        Severity="Informational"
                        Title="Log file rotated"
                        IsOpen="{Binding ShowRotationNotice, Mode=TwoWay}"
                        Message="{Binding RotationNoticeText}" />

            <!-- The tail's loop survives a fault and says so here, instead of the list just going quiet. -->
            <ui:InfoBar Margin="0,0,0,8"
                        Severity="Warning"
                        Title="Log tail paused"
                        IsOpen="{Binding ShowTailFault, Mode=TwoWay}"
                        Message="{Binding TailFaultText}" />

            <!-- A database stream that cannot be read (or does not exist on this audit.db) says so; the rows already shown stay. -->
            <ui:InfoBar Margin="0,0,0,8"
                        Severity="Warning"
                        Title="Event stream unavailable"
                        IsOpen="{Binding ShowStreamNotice, Mode=TwoWay}"
                        Message="{Binding StreamNoticeText}" />
        </StackPanel>

        <!-- List + inspector -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

        <Border x:Name="ListCard" Style="{StaticResource LogListCard}">
            <Grid>
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding DisplayedLines}"
                         SelectedItem="{Binding SelectedEntry, Mode=TwoWay}"
                         SelectionMode="Extended"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Log rows"
                         SelectionChanged="OnSelectionChanged">
                    <!-- WPF-UI's list item pads 12 px on every side: a one-line log entry became a 42 px row and only
                         three fit on screen. A log is read by the screenful, so rows are 24 px. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,3,8,3" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!-- The severity bar; transparent for info. -->
                                <Border Grid.Column="0"
                                        Style="{StaticResource DcToneBar}"
                                        Margin="0,1,8,1"
                                        Width="3"
                                        Tag="{Binding Tone}" />
                                <StackPanel Grid.Column="1">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource LogTimeText}" Text="{Binding TimeText}" />
                                        <TextBlock Style="{StaticResource LogLabelText}" Text="{Binding Label}" />
                                        <Border Style="{StaticResource DcChip}"
                                                Padding="6,0,6,0"
                                                Visibility="{Binding IsRepeated, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource DcBadgeText}"
                                                       Text="{Binding RepeatText}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource DcMono}"
                                               TextWrapping="Wrap"
                                               TextTrimming="CharacterEllipsis"
                                               MaxHeight="54"
                                               Text="{Binding DisplayMessage}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty is a state, not a failure: say which one, and never treat a missing file as an error. -->
                <StackPanel Style="{StaticResource DcEmptyState}"
                            MaxWidth="420"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="DocumentBulletList24" />
                    <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                    <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                </StackPanel>
            </Grid>
        </Border>

            <!-- Inspector: the selected line's parsed fields and its raw text. -->
            <ctl:DcInspector x:Name="Inspector"
                             Title="Line details"
                             IsOpen="{Binding HasSelection}"
                             CloseCommand="{Binding ClearSelectionCommand}"
                             CloseAutomationName="Close line details"
                             AutomationProperties.Name="Line details"
                             Content="{Binding SelectedEntry}">
                <ctl:DcInspector.ContentTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DcBody}" Text="{Binding Message}" />
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Margin="0,6,0,0"
                                       Text="{Binding RepeatText}"
                                       Visibility="{Binding IsRepeated, Converter={StaticResource BoolToVisibility}}" />

                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="TagMultiple24" Section="Observe" Content="Fields" />
                            <ItemsControl Grid.IsSharedSizeScope="True"
                                          ItemsSource="{Binding Fields}"
                                          AutomationProperties.Name="Log line fields">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="72" SharedSizeGroup="LogFieldKey" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource DcMono}"
                                                       Margin="0,0,10,0"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource DcCaption}"
                                                       Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="Code24" Section="Observe" Content="Raw line" />
                            <Border Style="{StaticResource DcCodeBlock}">
                                <TextBox Style="{StaticResource DcMonoTextBox}"
                                         TextWrapping="Wrap"
                                         AutomationProperties.Name="Raw line"
                                         Text="{Binding Raw, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ctl:DcInspector.ContentTemplate>
            </ctl:DcInspector>
        </Grid>

        <!-- Status -->
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBox Style="{StaticResource DcMonoTextBox}"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     AutomationProperties.Name="Log file path"
                     Text="{Binding StatusPath, Mode=OneWay}" />
        </WrapPanel>
    </Grid>
</UserControl>
