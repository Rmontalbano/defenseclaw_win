<UserControl x:Class="DefenseClaw.App.Views.Panels.LogsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Filters above, virtualized monospace list below. gateway.log / watchdog.log carry no
        timestamp and almost never a level - just "[component] message" - so the component
        checklist is the filter axis that matters here, not severity.

        On the shared Dc* design system; the one local style is the source toggle's active-state
        trigger (a visual that exists only here). Keyboard: Ctrl+F focuses the filter box (the
        code-behind handles ApplicationCommands.Find), Esc clears the filter text.
    -->
    <UserControl.Resources>
        <!-- Source toggle: the two buttons share this base and each adds its own "am I active" trigger.
             An explicit Style bypasses the toolbar's implicit button style, so the gaps are set here. -->
        <Style x:Key="SourceButton" TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Margin" Value="0,0,6,8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HeaderedContentControl Grid.Row="0" Style="{StaticResource DcPageHeader}">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource DcPageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource DcPageSubtitle}" Text="{Binding Description}" />
                </StackPanel>
            </HeaderedContentControl.Header>
        </HeaderedContentControl>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource DcToolbar}">
            <StackPanel>
                <WrapPanel Style="{StaticResource DcToolbarPanel}">
                    <ui:Button Content="gateway.log"
                               Command="{Binding SelectSourceCommand}"
                               CommandParameter="Gateway"
                               ToolTip="Show gateway.log">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SourceButton}">
                                <Setter Property="AutomationProperties.Name" Value="gateway.log" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSource}" Value="Gateway">
                                        <Setter Property="Appearance" Value="Primary" />
                                        <Setter Property="AutomationProperties.Name" Value="gateway.log, currently shown" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="watchdog.log"
                               Margin="0,0,16,8"
                               Command="{Binding SelectSourceCommand}"
                               CommandParameter="Watchdog"
                               ToolTip="Show watchdog.log">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SourceButton}">
                                <Setter Property="AutomationProperties.Name" Value="watchdog.log" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSource}" Value="Watchdog">
                                        <Setter Property="Appearance" Value="Primary" />
                                        <Setter Property="AutomationProperties.Name" Value="watchdog.log, currently shown" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ItemsControl VerticalAlignment="Center"
                                  ItemsSource="{Binding ComponentFilters}"
                                  AutomationProperties.Name="Component filters">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox MinWidth="0"
                                          Content="{Binding Name}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                          AutomationProperties.HelpText="Shows or hides log lines from this component." />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <WrapPanel Style="{StaticResource DcToolbarPanel}">
                    <ui:TextBox x:Name="FilterBox"
                                Width="280"
                                PlaceholderText="Filter by raw line text…"
                                AutomationProperties.Name="Filter log lines"
                                AutomationProperties.HelpText="Shows only lines that contain this text. Shortcut Ctrl+F; Esc clears it."
                                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />

                    <ui:ToggleSwitch Content="{Binding LiveStateText}"
                                     IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                     AutomationProperties.Name="Follow the newest line"
                                     AutomationProperties.HelpText="On: the list scrolls to each new line as it arrives (live). Off: the list stays where you are (paused)." />

                    <ui:Button Content="Clear"
                               Appearance="Secondary"
                               Command="{Binding ClearCommand}"
                               AutomationProperties.HelpText="Empty the buffered lines for the source on screen. The log file itself is untouched.">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Broom24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Content="Copy selection"
                               Appearance="Secondary"
                               Command="{Binding CopySelectionCommand}"
                               AutomationProperties.HelpText="Copy the selected log lines to the clipboard.">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>

                <ui:InfoBar Margin="0,0,12,8"
                            Severity="Informational"
                            Title="Log file rotated"
                            IsOpen="{Binding ShowRotationNotice, Mode=TwoWay}"
                            Message="{Binding RotationNoticeText}" />
            </StackPanel>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource DcCardFlush}">
            <Grid>
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding DisplayedLines}"
                         SelectionMode="Extended"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         AutomationProperties.Name="Log lines"
                         SelectionChanged="OnSelectionChanged">
                    <!-- WPF-UI's list item pads 12 px on every side: a one-line log entry became a 42 px row and only
                         three fit on screen. A log is read by the screenful, so rows are 24 px. -->
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="{x:Type ListBoxItem}" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                            <Setter Property="Padding" Value="8,3,8,3" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Style="{StaticResource DcMono}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource DcTextSecondaryBrush}"
                                           ToolTip="{Binding ComponentText}"
                                           Text="{Binding ComponentText}" />
                                <TextBlock Grid.Column="1"
                                           Style="{StaticResource DcMono}"
                                           TextWrapping="NoWrap"
                                           Text="{Binding Message}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty is a state, not a failure: say which one, and never treat a missing file as an error. -->
                <StackPanel Style="{StaticResource DcEmptyState}"
                            MaxWidth="420"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <ui:SymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="DocumentBulletList24" />
                    <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                    <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <WrapPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBox Style="{StaticResource DcMonoTextBox}"
                     VerticalAlignment="Center"
                     Margin="0,0,16,0"
                     AutomationProperties.Name="Log file path"
                     Text="{Binding StatusPath, Mode=OneWay}" />
            <TextBlock Style="{StaticResource DcCaption}"
                       VerticalAlignment="Center"
                       Text="{Binding StatusLineCount}" />
        </WrapPanel>
    </Grid>
</UserControl>
