<UserControl x:Class="DefenseClaw.App.Views.Panels.LogsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Filters above, virtualized monospace list below. gateway.log / watchdog.log carry no
        timestamp and almost never a level - just "[component] message" - so the component
        checklist is the filter axis that matters here, not severity.
    -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Tertiary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Source toggle: the two buttons share this base and each adds its own "am I active" trigger. -->
        <Style x:Key="SourceButton" TargetType="{x:Type ui:Button}">
            <Setter Property="Appearance" Value="Secondary" />
            <Setter Property="Padding" Value="12,5,12,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <StackPanel>
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="13"
                           Style="{StaticResource Secondary}"
                           Text="{Binding Description}" />
            </StackPanel>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <ui:Button Content="gateway.log"
                               Command="{Binding SelectSourceCommand}"
                               CommandParameter="Gateway">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SourceButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSource}" Value="Gateway">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ui:Button Content="watchdog.log"
                               Margin="0,0,16,0"
                               Command="{Binding SelectSourceCommand}"
                               CommandParameter="Watchdog">
                        <ui:Button.Style>
                            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource SourceButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActiveSource}" Value="Watchdog">
                                        <Setter Property="Appearance" Value="Primary" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ui:Button.Style>
                    </ui:Button>

                    <ItemsControl ItemsSource="{Binding ComponentFilters}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          Content="{Binding Name}"
                                          IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <ui:TextBox Width="280"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                PlaceholderText="Filter by raw line text…"
                                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,16,0" VerticalAlignment="Center">
                        <ui:ToggleSwitch IsChecked="{Binding AutoScroll, Mode=TwoWay}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Secondary}"
                                   Text="{Binding LiveStateText}" />
                    </StackPanel>

                    <ui:Button Margin="0,0,8,0"
                               Padding="10,5,10,5"
                               Appearance="Secondary"
                               Content="Clear"
                               Command="{Binding ClearCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Broom24" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button Padding="10,5,10,5"
                               Appearance="Secondary"
                               Content="Copy selection"
                               Command="{Binding CopySelectionCommand}">
                        <ui:Button.Icon>
                            <ui:SymbolIcon Symbol="Copy24" />
                        </ui:Button.Icon>
                    </ui:Button>
                </WrapPanel>

                <ui:InfoBar Margin="0,10,0,0"
                            Severity="Informational"
                            Title="Log file rotated"
                            IsOpen="{Binding ShowRotationNotice, Mode=TwoWay}"
                            Message="{Binding RotationNoticeText}" />
            </StackPanel>
        </Border>

        <!-- List -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="4">
            <Grid>
                <ListBox x:Name="LogListBox"
                         ItemsSource="{Binding DisplayedLines}"
                         SelectionMode="Extended"
                         BorderThickness="0"
                         Background="Transparent"
                         HorizontalContentAlignment="Stretch"
                         ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         SelectionChanged="OnSelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="4,1,4,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="{Binding ComponentText}" />
                                <TextBlock Grid.Column="1"
                                           FontFamily="Cascadia Mono, Consolas"
                                           FontSize="12"
                                           TextWrapping="NoWrap"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding Message}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Empty is a state, not a failure: say which one, and never treat a missing file as an error. -->
                <StackPanel HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MaxWidth="420"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                               Text="{Binding EmptyTitle}" />
                    <TextBlock Margin="0,6,0,0"
                               TextAlignment="Center"
                               Style="{StaticResource Tertiary}"
                               Text="{Binding EmptyDetail}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Status -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="4,10,0,0">
            <TextBlock FontFamily="Cascadia Mono, Consolas"
                       FontSize="11"
                       Style="{StaticResource Tertiary}"
                       Text="{Binding StatusPath}" />
            <TextBlock Margin="16,0,0,0"
                       FontSize="11"
                       Style="{StaticResource Tertiary}"
                       Text="{Binding StatusLineCount}" />
        </StackPanel>
    </Grid>
</UserControl>
