<UserControl x:Class="DefenseClaw.App.Views.Panels.AlertsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Filters above, virtualized list left, detail pane right. The list is a ListView so
        WPF's own VirtualizingStackPanel does the recycling - the alert stream on a busy box
        is mostly the same handful of signatures repeating, and scrolling has to stay cheap.
    -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Tertiary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Severity chip: background tint plus matching foreground, both theme-aware. -->
        <Style x:Key="SeverityChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="7,2,7,2" />
            <Setter Property="MinWidth" Value="66" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="High">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Medium">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SeverityChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="High">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Medium">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="13"
                           Style="{StaticResource Secondary}"
                           Text="{Binding Description}" />
            </StackPanel>

            <ui:Button Grid.Column="1"
                       VerticalAlignment="Center"
                       Content="Refresh"
                       Command="{Binding RefreshCommand}">
                <ui:Button.Icon>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" />
                </ui:Button.Icon>
            </ui:Button>
        </Grid>

        <!-- Filters -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <WrapPanel>
                    <ItemsControl ItemsSource="{Binding SeverityFilters}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Margin="0,0,6,0"
                                              Padding="12,5,12,5"
                                              MinWidth="0"
                                              Content="{Binding Severity}"
                                              IsChecked="{Binding IsEnabled, Mode=TwoWay}" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:TextBox Width="280"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                PlaceholderText="Filter by signature, title, action, evidence…"
                                Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" />

                    <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ui:ToggleSwitch IsChecked="{Binding CollapseRepeats, Mode=TwoWay}" />
                        <TextBlock Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Secondary}"
                                   Text="Collapse repeats" />
                    </StackPanel>

                    <ui:Button Margin="16,0,0,0"
                               Padding="10,5,10,5"
                               Appearance="Secondary"
                               Content="Clear"
                               Command="{Binding ClearFiltersCommand}" />
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <TextBlock Style="{StaticResource Tertiary}" FontSize="11" Text="{Binding SourceNote}" />
                    <TextBlock Margin="12,0,0,0"
                               FontSize="11"
                               Style="{StaticResource Tertiary}"
                               Text="{Binding CountSummary}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- List + detail -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="380" />
                <ColumnDefinition Width="2*" MinWidth="280" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,12,0" Padding="4">
                <Grid>
                    <ListView ItemsSource="{Binding Alerts}"
                              SelectedItem="{Binding SelectedAlert, Mode=TwoWay}"
                              BorderThickness="0"
                              Background="Transparent"
                              HorizontalContentAlignment="Stretch"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="4,6,4,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0"
                                            VerticalAlignment="Top"
                                            Margin="0,2,10,0"
                                            Style="{StaticResource SeverityChip}">
                                        <TextBlock Style="{StaticResource SeverityChipText}" Text="{Binding Severity}" />
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       Text="{Binding RuleId}" />
                                            <TextBlock Margin="8,0,0,0"
                                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Headline}" />
                                        </StackPanel>

                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="12"
                                                   Style="{StaticResource Secondary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding TargetRef}" />

                                        <TextBlock Margin="0,2,0,0"
                                                   FontSize="11"
                                                   FontFamily="Cascadia Mono, Consolas"
                                                   Style="{StaticResource Tertiary}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding HasEvidence, Converter={StaticResource BoolToVisibility}}"
                                                   Text="{Binding Evidence}" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0" HorizontalAlignment="Right">
                                        <!-- Repeat count lives here, not beside the title: a long
                                             title would push it off the row exactly when collapsing
                                             is on and the count matters most. -->
                                        <Border Margin="0,0,0,2"
                                                Padding="7,1,7,1"
                                                CornerRadius="9"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                Visibility="{Binding IsRepeated, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding RepeatText}" />
                                        </Border>
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="11"
                                                   Style="{StaticResource Secondary}"
                                                   Text="{Binding RelativeTime}" />
                                        <TextBlock HorizontalAlignment="Right"
                                                   FontSize="10"
                                                   Style="{StaticResource Tertiary}"
                                                   Text="{Binding TimestampText}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>

                    <!-- Empty is a state, not a failure: say which one. -->
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                MaxWidth="420"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock HorizontalAlignment="Center"
                                   FontSize="16"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="{Binding EmptyTitle}" />
                        <TextBlock Margin="0,6,0,0"
                                   TextAlignment="Center"
                                   Style="{StaticResource Tertiary}"
                                   Text="{Binding EmptyDetail}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Detail pane -->
            <Border Grid.Column="1" Style="{StaticResource Card}">
                <Grid>
                    <!--
                        ContentControl rather than a Visibility binding: with no selection the
                        content is null and the template simply does not render, so there is no
                        need for an inverse-boolean converter the panel contract cannot ship.
                    -->
                    <!--
                        The ContentTemplate is applied even when Content is null, so the static
                        labels inside it would sit on top of the placeholder. HasSelection is a
                        plain bool, so the app-level converter hides the whole pane instead.
                    -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                      <ContentControl Content="{Binding SelectedAlert}">
                        <ContentControl.ContentTemplate>
                          <DataTemplate>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Border Style="{StaticResource SeverityChip}">
                                    <TextBlock Style="{StaticResource SeverityChipText}" Text="{Binding Severity}" />
                                </Border>
                                <TextBlock Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding RuleId}" />
                            </StackPanel>

                            <TextBlock Margin="0,10,0,0"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       TextWrapping="Wrap"
                                       Text="{Binding Headline}" />

                            <TextBlock Margin="0,10,0,0" Style="{StaticResource Secondary}" Text="{Binding TargetRef}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Tertiary}" FontSize="11" Text="{Binding TimestampText}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Tertiary}" FontSize="11" Text="{Binding Scanner, StringFormat='scanner: {0}'}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Tertiary}" FontSize="11" Text="{Binding ConfidenceText, StringFormat='confidence: {0}'}" />
                            <TextBlock Margin="0,2,0,0" Style="{StaticResource Tertiary}" FontSize="11" Text="{Binding Tags, StringFormat='tags: {0}'}" />

                            <TextBlock Margin="0,14,0,4"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="Evidence" />
                            <Border Padding="10"
                                    CornerRadius="6"
                                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                <TextBox FontFamily="Cascadia Mono, Consolas"
                                         FontSize="12"
                                         IsReadOnly="True"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextWrapping="Wrap"
                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                         Text="{Binding Evidence, Mode=OneWay}" />
                            </Border>

                            <TextBlock Margin="0,14,0,4"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                       Text="Attributes" />
                            <ItemsControl ItemsSource="{Binding Fields}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="130" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Margin="0,0,10,0"
                                                       FontSize="11"
                                                       FontFamily="Cascadia Mono, Consolas"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                    </ScrollViewer>

                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               MaxWidth="240"
                               TextAlignment="Center"
                               Text="Select an alert to see its evidence and full attribute bag.">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tertiary}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
