<UserControl x:Class="DefenseClaw.App.Views.Panels.AlertsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             panels:CompactLayout.Below="960">
    <!--
        Severity tiles and filters above, virtualized table left, detail pane right. The table is a DataGrid (DcDataGrid) so
        WPF's own VirtualizingStackPanel does the recycling - the alert stream on a busy box
        is mostly the same handful of signatures repeating, and scrolling has to stay cheap.

        On the shared Dc* design system. The four severity tiles (CRITICAL / HIGH / MEDIUM / LOW, big tone numbers, the shared
        DcInteractiveTile) are the severity filter: pressing one shows only that severity, pressing it again shows all, and the
        multi-select the deep link needs ("High and above") is the same state the tiles show. They replace the old chips (a
        segmented control cannot show a set), so the only local visual left is the small INFO chip, which appears when the list has INFO
        rows (an egress decision that only looks like an LLM call). The Kind popup (All kinds / Blocks / Audit / Scans / Egress) sits
        in the strip beside the repeat fold. Keyboard: Ctrl+F focuses the filter box, Esc closes the review
        dialog and then the detail pane (both handled in the code-behind).

        The detail pane exists only while an alert is selected (see AuditPanel for why): with no selection the
        list takes the whole width, with one the two split, and on a narrow panel (CompactLayout, under 960 px)
        the detail replaces the list until it is closed.
    -->
    <UserControl.Resources>
        <!-- The time cell: the clock time (the date too when it is not today); its tooltip is how long ago it was. -->
        <Style x:Key="AlertTimeText" TargetType="TextBlock" BasedOn="{StaticResource DcCellText}">
            <Setter Property="ToolTip" Value="{Binding RelativeTime}" />
            <Setter Property="ctl:DcCellToolTip.OnlyWhenTrimmed" Value="False" />
        </Style>

        <!--
            The row menu, shared by every row (right-click, or the "..." button). The row under the pointer is selected first unless it
            is already part of the selection (ctl:DcRowMenu), so the actions apply to what the operator sees selected. Acknowledge and
            Dismiss name exactly the selected rows by id (the same review as the toolbar's selection buttons), with the CLI's own preview
            first, so nothing here changes anything by itself. The whole-severity-class flow is the strip's "by severity" buttons.
        -->
        <!-- The whole-severity-class flow, opened from the strip's "By severity..." button. -->
        <ContextMenu x:Key="BySeverityMenu">
            <MenuItem Header="Acknowledge by severity…"
                      Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                      ToolTip="Acknowledges every active alert of one severity in DefenseClaw. Shows a preview first."
                      Click="OnAcknowledgeBySeverity" />
            <MenuItem Header="Dismiss by severity…"
                      Style="{StaticResource DcDangerMenuItem}"
                      Icon="{ctl:DcSymbolIcon AlertOff24}"
                      ToolTip="Dismisses every active alert of one severity from the active list. Shows a preview first."
                      Click="OnDismissBySeverity" />
        </ContextMenu>

        <ContextMenu x:Key="AlertRowMenu">
            <MenuItem Header="Copy details"
                      Icon="{ctl:DcSymbolIcon Copy24}"
                      InputGestureText="Ctrl+C"
                      Click="OnCopyDetails" />
            <Separator />
            <MenuItem Header="Acknowledge selected…"
                      Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                      ToolTip="Opens the acknowledge review for exactly the selected alerts, by id. Shows a preview first."
                      Click="OnAcknowledge" />
            <MenuItem Header="Dismiss selected…"
                      Style="{StaticResource DcDangerMenuItem}"
                      Icon="{ctl:DcSymbolIcon AlertOff24}"
                      ToolTip="Opens the dismiss review for exactly the selected alerts, by id. Shows a preview first."
                      Click="OnDismiss" />
        </ContextMenu>

        <Style x:Key="AlertRow" TargetType="DataGridRow" BasedOn="{StaticResource DcDataGridRow}">
            <Setter Property="ContextMenu" Value="{StaticResource AlertRowMenu}" />
        </Style>

        <Style x:Key="AlertListCard" TargetType="Border" BasedOn="{StaticResource DcCardFlush}">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Style.Triggers>
                <!-- With the inspector open the list's right edge meets its divider: square, no border of its own on that side. -->
                <DataTrigger Binding="{Binding HasSelection}" Value="True">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                    <Setter Property="CornerRadius" Value="0" />
                    <Setter Property="BorderThickness" Value="1,1,0,1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasSelection}" Value="True" />
                        <Condition Binding="{Binding Path=(panels:CompactLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            Severity chip. ON: the severity's own tone (tinted fill + tone text via DcBadge) and a
            check mark. OFF: outline only, dim text, no tone. State is never colour alone - the
            check mark and the outline carry it, so it reads in every theme and for colour-blind users.
            Tag = the severity key ("Critical" ... "Info"). Two chips are swapped by IsChecked because
            a template trigger cannot override the tone triggers inside DcBadge.
        -->
        <Style x:Key="SeverityToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource DcFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Grid>
                            <Border x:Name="OffChip"
                                    Padding="10,4,10,4"
                                    CornerRadius="{DynamicResource DcRadiusS}"
                                    BorderThickness="1"
                                    BorderBrush="{DynamicResource DcControlBorderBrush}"
                                    Background="Transparent">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="11"
                                               Opacity="0"
                                               Text="&#xE73E;" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource DcTextSecondaryBrush}"
                                               Text="{Binding Severity}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Foreground="{DynamicResource DcTextSecondaryBrush}"
                                               Text="{Binding Count}" />
                                </StackPanel>
                            </Border>
                            <Border x:Name="OnChip"
                                    Style="{StaticResource DcBadge}"
                                    Tag="{TemplateBinding Tag}"
                                    Padding="10,4,10,4"
                                    BorderThickness="1"
                                    BorderBrush="Transparent"
                                    Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Margin="0,0,6,0"
                                               VerticalAlignment="Center"
                                               FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="11"
                                               Text="&#xE73E;" />
                                    <TextBlock VerticalAlignment="Center"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Text="{Binding Severity}" />
                                    <TextBlock Margin="6,0,0,0"
                                               VerticalAlignment="Center"
                                               FontSize="12"
                                               Text="{Binding Count}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="OnChip" Property="Visibility" Value="Visible" />
                                <Setter TargetName="OffChip" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="OffChip" Property="Background" Value="{DynamicResource DcSubtleBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the panel's name and count, the page actions as icons, the filter box. -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="AlertUrgent24"
                           ctl:DcIcon.Section="Observe"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           Caption="{Binding CountSummary}"
                           HasSearch="True"
                           SearchText="{Binding FilterText}"
                           SearchPlaceholder="Filter alerts…"
                           SearchAutomationName="Filter alerts"
                           SearchHelpText="Shows only alerts whose rule, kind, title, action, target, evidence, scanner or tags contain this text. Shortcut Ctrl+F; Esc clears it.">
            <ctl:DcPageToolbar.ConnectorSlot>
                <ctl:DcConnectorScopeChip Model="{Binding ConnectorChip}" />
            </ctl:DcPageToolbar.ConnectorSlot>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                               Command="{Binding OpenAcknowledgeSelectionCommand}"
                               ToolTip="Acknowledge selection…"
                               AutomationProperties.Name="Acknowledge selection"
                               AutomationProperties.HelpText="Available once a row is selected. Acknowledges exactly the selected alerts, by id, and nothing else. Shows a preview of what would match before anything is changed." />
                    <ui:Button Icon="{ctl:DcSymbolIcon AlertOff24}"
                               Command="{Binding OpenDismissSelectionCommand}"
                               ToolTip="Dismiss selection…"
                               AutomationProperties.Name="Dismiss selection"
                               AutomationProperties.HelpText="Available once a row is selected. Dismisses exactly the selected alerts, by id, from the active list. Shows a preview of what would match before anything is changed." />
                    <ui:Button Icon="{ctl:DcSymbolIcon FilterDismiss24}"
                               Command="{Binding OpenDismissFilteredCommand}"
                               ToolTip="{Binding FilteredText}"
                               AutomationProperties.Name="Dismiss filtered"
                               AutomationProperties.HelpText="Dismisses exactly the alerts the filters leave on screen, by id. Shows a preview of what would match before anything is changed." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Refresh (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5"
                               AutomationProperties.HelpText="Re-read the alert list from the gateway now. Shortcut F5." />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <!-- The selection readout and the actions that are not about the selection; then the result of the last acknowledge / dismiss -->
        <StackPanel Grid.Row="1">
            <WrapPanel Margin="{StaticResource DcCardGap}">
                <TextBlock Style="{StaticResource DcBody}"
                           Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Text="{Binding SelectionText}"
                           AutomationProperties.Name="Selection"
                           AutomationProperties.LiveSetting="Polite" />
                <ui:Button Content="Select all"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Click="OnSelectAll"
                           ToolTip="Select every row shown"
                           AutomationProperties.Name="Select all" />
                <ui:Button Content="Clear selection"
                           Margin="0,0,8,0"
                           Appearance="Secondary"
                           Click="OnClearSelection"
                           AutomationProperties.Name="Clear selection" />
                <ui:Button x:Name="BySeverityButton"
                           Content="By severity…"
                           Appearance="Secondary"
                           Click="OnBySeverity"
                           ToolTip="Acknowledge or dismiss a whole severity class in DefenseClaw, not only what is selected or loaded. Shows a preview first."
                           AutomationProperties.Name="By severity"
                           AutomationProperties.HelpText="Opens a menu: Acknowledge by severity or Dismiss by severity. Either acts on every active alert of one severity in DefenseClaw, as of a preview, and shows what would match before anything is changed." />
            </WrapPanel>
            <ui:InfoBar Margin="{StaticResource DcCardGap}"
                        Severity="Success"
                        IsClosable="True"
                        IsOpen="{Binding ShowActionSuccess, Mode=TwoWay}"
                        Message="{Binding ActionBannerText}"
                        AutomationProperties.LiveSetting="Polite" />
            <ui:InfoBar Margin="{StaticResource DcCardGap}"
                        Severity="Error"
                        IsClosable="True"
                        IsOpen="{Binding ShowActionError, Mode=TwoWay}"
                        Message="{Binding ActionBannerText}"
                        AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <!--
            The severity tiles: four equal tone-numbered tiles, each a DcInteractiveTile (a whole-card button; the tone is the number's
            colour and the severity is also the word, so colour is never the only carrier). The tile of a severity that is narrowing the
            list wears the selected look (Selector.IsSelected). The number is the loaded, un-acknowledged alerts of that severity whatever
            the other filters hide, like the Mac's.
        -->
        <ItemsControl Grid.Row="2"
                      Margin="0,0,-8,4"
                      ItemsSource="{Binding Tiles}"
                      KeyboardNavigation.TabNavigation="Continue"
                      AutomationProperties.Name="Severity filters">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Style="{StaticResource DcInteractiveTile}"
                            Margin="0,0,8,8"
                            Command="{Binding DataContext.SelectSeverityCommand, RelativeSource={RelativeSource AncestorType={x:Type panels:AlertsPanel}}}"
                            CommandParameter="{Binding}"
                            Selector.IsSelected="{Binding IsPicked}"
                            ToolTip="{Binding AutomationName}"
                            AutomationProperties.Name="{Binding AutomationName}"
                            AutomationProperties.HelpText="Shows only this severity; press it again to show every severity.">
                        <StackPanel>
                            <DockPanel LastChildFill="True">
                                <TextBlock DockPanel.Dock="Right"
                                           Style="{StaticResource DcCaption}"
                                           Margin="8,0,0,0"
                                           TextWrapping="NoWrap"
                                           Text="{Binding TileCaption}" />
                                <TextBlock Style="{StaticResource DcCaption}"
                                           TextTrimming="CharacterEllipsis"
                                           TextWrapping="NoWrap"
                                           Text="{Binding Severity}" />
                            </DockPanel>
                            <TextBlock Style="{StaticResource DcValue}"
                                       FontSize="28"
                                       Margin="0,2,0,0"
                                       Tag="{Binding SeverityKey}"
                                       Text="{Binding Count}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!--
            Filter strip (no card of its own): the Kind popup, the small INFO chip when there are INFO rows, the repeat fold, the reset,
            and the quiet mono lines about the source.
        -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
            <ComboBox Margin="0,0,12,8"
                      MinWidth="140"
                      VerticalAlignment="Center"
                      ItemsSource="{Binding KindChoices}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Value"
                      SelectedValue="{Binding KindFilter, Mode=TwoWay}"
                      ToolTip="Which kind of alert to list: findings from the audit log, scan findings, enforcement blocks or egress decisions."
                      AutomationProperties.Name="Kind" />

            <ToggleButton Style="{StaticResource SeverityToggle}"
                          Margin="0,0,12,8"
                          DataContext="{Binding InfoFilter}"
                          Tag="{Binding SeverityKey}"
                          IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                          Visibility="{Binding DataContext.ShowInfoFilter, RelativeSource={RelativeSource AncestorType={x:Type panels:AlertsPanel}}, Converter={StaticResource BoolToVisibility}}"
                          ToolTip="{Binding AutomationName}"
                          AutomationProperties.Name="{Binding AutomationName}"
                          AutomationProperties.HelpText="Shows or hides INFO alerts (egress decisions that only look like an LLM call) in the list." />

            <ui:ToggleSwitch Content="Collapse repeats"
                             IsChecked="{Binding CollapseRepeats, Mode=TwoWay}"
                             AutomationProperties.HelpText="Folds alerts with the same rule and action into one row with a count." />

            <ui:Button Style="{StaticResource DcToolbarIconButton}"
                       Margin="0,0,12,8"
                       Icon="{ctl:DcSymbolIcon FilterDismiss24}"
                       Command="{Binding ClearFiltersCommand}"
                       ToolTip="Clear filters"
                       AutomationProperties.Name="Clear filters"
                       AutomationProperties.HelpText="Turn every severity back on, show every kind and clear the text filter." />

            <TextBlock Style="{StaticResource DcResultCaption}" Margin="0,0,12,8" Text="{Binding SourceNote}" />
            <!-- Where the empty detail pane's "Select an alert ..." used to be. -->
            <TextBlock Margin="0,0,12,8" Text="Select an alert to see its evidence and full attribute bag.">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
                        <Setter Property="VerticalAlignment" Value="Center" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasSelection}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </WrapPanel>

        <!-- List + detail -->
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border x:Name="ListCard" Style="{StaticResource AlertListCard}">
                <Grid>
                    <!--
                        The table: Time, Severity, Kind (audit / scan / egress; the rule id is the inspector's title), Action, Target, Details (the title, with the repeat count
                        while repeats are folded), Run, and the row menu. Newest first until a header is clicked; the columns
                        share the width (DcGridColumns), the short ones keep a floor, and a cell says its whole value in a
                        tooltip while it is cut. Extended selection: Ctrl / Shift pick rows, the first one drives the detail
                        pane, and the row menu (right-click, or the "..." button) acts on the selection.
                    -->
                    <ui:DataGrid x:Name="AlertList"
                                 Style="{StaticResource DcDataGrid}"
                                 RowStyle="{StaticResource AlertRow}"
                                 ItemsSource="{Binding Alerts}"
                                 SelectedItem="{Binding SelectedAlert, Mode=TwoWay}"
                                 SelectionMode="Extended"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 ctl:DcGridColumns.Fit="True"
                                 SelectionChanged="OnAlertSelectionChanged"
                                 AutomationProperties.Name="Alerts, newest first">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Width="1*" MinWidth="104" Header="Time"
                                                SortMemberPath="Timestamp"
                                                ElementStyle="{StaticResource AlertTimeText}"
                                                Binding="{Binding TableTimeText}" />
                            <DataGridTemplateColumn Width="0.9*" MinWidth="84" Header="Severity"
                                                    SortMemberPath="SeverityRank">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ctl:DcSeverityBadge Text="{Binding Severity}"
                                                             Tone="{Binding SeverityKey}"
                                                             Margin="0,0,8,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="0.9*" MinWidth="70" Header="Kind"
                                                SortMemberPath="Kind"
                                                ElementStyle="{StaticResource DcCellTextQuiet}"
                                                Binding="{Binding KindLabel}" />
                            <DataGridTextColumn Width="1*" MinWidth="80" Header="Action"
                                                SortMemberPath="Action"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding Action}" />
                            <DataGridTextColumn Width="0.9*" MinWidth="64" Header="Target"
                                                SortMemberPath="TargetRef"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding TargetRef}" />
                            <!-- The repeat count sits before the title: a long title would push it off the row exactly when folding is on and the count matters most. -->
                            <DataGridTemplateColumn Width="2*" MinWidth="90" Header="Details"
                                                    SortMemberPath="Headline">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Left"
                                                    Style="{StaticResource DcChip}"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Visibility="{Binding IsRepeated, Converter={StaticResource BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding RepeatText}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource DcCellTextQuiet}" Text="{Binding Headline}" />
                                        </DockPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="0.9*" MinWidth="60" Header="Run"
                                                SortMemberPath="RunId"
                                                ElementStyle="{StaticResource DcCellTextMono}"
                                                Binding="{Binding RunId}" />
                            <DataGridTemplateColumn Width="32" Header="Actions"
                                                    CanUserSort="False"
                                                    HeaderStyle="{StaticResource DcDataGridActionsHeader}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ctl:DcRowMenuButton AutomationProperties.HelpText="Copy details, acknowledge or dismiss." />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>

                    <!-- Empty is a state, not a failure: say which one. -->
                    <StackPanel Style="{StaticResource DcEmptyState}"
                                MaxWidth="420"
                                Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ShieldCheckmark24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Inspector: opens while an alert is selected (ctl:DcInspector); the list takes the whole width otherwise. -->
            <ctl:DcInspector x:Name="Inspector"
                             Title="Alert details"
                             IsOpen="{Binding HasSelection}"
                             CloseCommand="{Binding ClearSelectionCommand}"
                             CloseAutomationName="Close alert details"
                             AutomationProperties.Name="Alert details"
                             Content="{Binding SelectedAlert}">
                <ctl:DcInspector.Badges>
                    <ctl:DcSeverityBadge Text="{Binding SelectedAlert.Severity}" Tone="{Binding SelectedAlert.SeverityKey}" />
                </ctl:DcInspector.Badges>
                <ctl:DcInspector.ContentTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Style="{StaticResource DcSectionHeader}" Margin="0,0,0,0" Text="{Binding RuleId}" />

                            <TextBlock Style="{StaticResource DcBody}"
                                       Margin="0,2,0,0"
                                       Text="{Binding Headline}" />
                            <TextBlock Style="{StaticResource DcTextSecondary}"
                                       Margin="0,10,0,0"
                                       Text="{Binding TargetRef}" />
                            <TextBlock Style="{StaticResource DcCaption}" Margin="0,2,0,0" Text="{Binding TimestampText}" />
                            <TextBlock Style="{StaticResource DcCaption}" Margin="0,2,0,0" Text="{Binding Scanner, StringFormat='scanner: {0}'}" />
                            <TextBlock Style="{StaticResource DcCaption}" Margin="0,2,0,0" Text="{Binding ConfidenceText, StringFormat='confidence: {0}'}" />
                            <TextBlock Style="{StaticResource DcCaption}" Margin="0,2,0,0" Text="{Binding Tags, StringFormat='tags: {0}'}" />

                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="DocumentSearch24" Section="Observe" Content="Evidence" />
                            <Border Style="{StaticResource DcCodeBlock}">
                                <TextBox Style="{StaticResource DcMonoTextBox}"
                                         AutomationProperties.Name="Evidence"
                                         Text="{Binding Evidence, Mode=OneWay}" />
                            </Border>

                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="TagMultiple24" Section="Observe" Content="Attributes" />
                            <!-- One shared key column: each attribute used to size its own, so the values started at a
                                 different x on every line. -->
                            <ItemsControl Grid.IsSharedSizeScope="True"
                                          ItemsSource="{Binding Fields}"
                                          AutomationProperties.Name="Alert attributes">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="{StaticResource DcFieldKeyMinWidth}" SharedSizeGroup="AlertFieldKey" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0"
                                                       Style="{StaticResource DcMono}"
                                                       Margin="0,0,10,0"
                                                       Text="{Binding Name}" />
                                            <TextBlock Grid.Column="1"
                                                       Style="{StaticResource DcCaption}"
                                                       Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Findings of the scans behind this alert (by run, else target), worst first; left out when there are none. -->
                            <StackPanel Visibility="{Binding Detail.FindingsVisible, Converter={StaticResource BoolToVisibility}}">
                                <ctl:DcCardHeader Margin="0,14,0,4" Symbol="ShieldError24" Section="Observe" Content="Findings" />
                                <TextBlock Style="{StaticResource DcCaption}"
                                           Margin="0,0,0,4"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding Detail.FindingsNote}" />
                                <ItemsControl ItemsSource="{Binding Detail.Findings}" AutomationProperties.Name="Findings">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource DcCodeBlock}" Margin="0,0,0,6">
                                                <StackPanel>
                                                    <DockPanel LastChildFill="True">
                                                        <ctl:DcSeverityBadge DockPanel.Dock="Left"
                                                                             Text="{Binding Severity}"
                                                                             Tone="{Binding SeverityKey}"
                                                                             Margin="0,0,8,0"
                                                                             VerticalAlignment="Center" />
                                                        <TextBlock Style="{StaticResource DcBody}"
                                                                   FontWeight="SemiBold"
                                                                   TextWrapping="Wrap"
                                                                   Text="{Binding Title}" />
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource DcTextSecondary}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}"
                                                               Text="{Binding Description}" />
                                                    <TextBlock Style="{StaticResource DcMono}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasLocation, Converter={StaticResource BoolToVisibility}}"
                                                               Text="{Binding Location}" />
                                                    <TextBlock Style="{StaticResource DcCaption}"
                                                               Margin="0,4,0,0"
                                                               TextWrapping="Wrap"
                                                               Visibility="{Binding HasRemediation, Converter={StaticResource BoolToVisibility}}"
                                                               Text="{Binding Remediation, StringFormat='Remediation: {0}'}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>

                            <!-- The target's earlier audit events (five), from the newest rows of the audit log; left out when there are none. -->
                            <StackPanel Visibility="{Binding Detail.HistoryVisible, Converter={StaticResource BoolToVisibility}}">
                                <ctl:DcCardHeader Margin="0,14,0,4" Symbol="History24" Section="Observe" Content="History for this target" />
                                <ItemsControl Grid.IsSharedSizeScope="True"
                                              ItemsSource="{Binding Detail.History}"
                                              AutomationProperties.Name="History for this target">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" SharedSizeGroup="AlertHistoryTime" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0"
                                                           Style="{StaticResource DcMono}"
                                                           Margin="0,0,10,0"
                                                           Text="{Binding TimeText}" />
                                                <TextBlock Grid.Column="1"
                                                           Style="{StaticResource DcCaption}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Text="{Binding Action}"
                                                           ToolTip="{Binding Action}" />
                                                <ctl:DcSeverityBadge Grid.Column="2"
                                                                     Text="{Binding Severity}"
                                                                     Tone="{Binding SeverityKey}"
                                                                     Margin="8,0,0,0" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource DcCaption}"
                                           Margin="0,2,0,0"
                                           AutomationProperties.LiveSetting="Polite"
                                           Text="{Binding Detail.HistoryNote}" />
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ctl:DcInspector.ContentTemplate>
            </ctl:DcInspector>
        </Grid>

        <!--
            Review dialog for acknowledge / dismiss. By severity it applies to a WHOLE severity class in DefenseClaw
            (not only the loaded rows); for a selection or the filtered rows it names exact ids. Either way it always shows the CLI's own dry-run first and the exact
            command that will run. The confirm button stays disabled until the preview exited 0 and
            matched something. Focus lands on Cancel, Tab stays inside the dialog, Esc closes it.
        -->
        <Grid x:Name="ReviewScrim"
              Grid.RowSpan="5"
              Style="{StaticResource DcScrim}"
              Visibility="{Binding IsReviewOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource DcDialogCard}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    KeyboardNavigation.ControlTabNavigation="Cycle"
                    AutomationProperties.Name="{Binding ReviewHeading}">
                <StackPanel>
                    <WrapPanel>
                        <TextBlock Style="{StaticResource DcSectionHeader}"
                                   Margin="0,0,10,0"
                                   VerticalAlignment="Center"
                                   Text="{Binding ReviewHeading}" />
                        <Border Style="{StaticResource DcBadge}"
                                Tag="{Binding TierKey}"
                                Margin="0,0,0,8"
                                VerticalAlignment="Center"
                                AutomationProperties.Name="{Binding TierText, StringFormat='Review tier: {0}'}">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding TierText}" />
                        </Border>
                    </WrapPanel>

                    <TextBlock Style="{StaticResource DcTextSecondary}"
                               Text="{Binding ReviewIntro}" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Margin="0,8,0,0"
                               AutomationProperties.LiveSetting="Polite"
                               Text="{Binding ChunkText}"
                               Visibility="{Binding HasChunkText, Converter={StaticResource BoolToVisibility}}" />

                    <StackPanel Style="{StaticResource DcField}" Margin="0,12,0,8"
                                Visibility="{Binding IsSeverityReview, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="Severity" />
                        <ComboBox x:Name="ReviewSeverityBox"
                                  HorizontalAlignment="Left"
                                  MinWidth="260"
                                  ItemsSource="{Binding ReviewSeverities}"
                                  SelectedItem="{Binding ReviewSeverity, Mode=TwoWay}"
                                  AutomationProperties.Name="Severity to act on" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <ui:ProgressRing Width="18"
                                         Height="18"
                                         Margin="0,0,8,0"
                                         IsIndeterminate="True"
                                         Visibility="{Binding IsPreviewing, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource DcBody}"
                                   FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding PreviewSummary}" />
                    </StackPanel>

                    <Border Style="{StaticResource DcCodeBlock}"
                            Margin="0,8,0,0"
                            MaxHeight="150"
                            Visibility="{Binding HasPreviewOutput, Converter={StaticResource BoolToVisibility}}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <TextBox Style="{StaticResource DcMonoTextBox}"
                                     AutomationProperties.Name="Preview output"
                                     Text="{Binding PreviewOutput, Mode=OneWay}" />
                        </ScrollViewer>
                    </Border>

                    <ui:InfoBar Margin="0,8,0,0"
                                IsClosable="False"
                                Severity="Warning"
                                Title="You can preview, not apply"
                                IsOpen="{Binding HasReviewBlockedText, Mode=OneWay}"
                                Message="{Binding ReviewBlockedText}" />

                    <ui:InfoBar Margin="0,8,0,0"
                                IsClosable="False"
                                Severity="Error"
                                Title="That did not succeed"
                                IsOpen="{Binding HasReviewError}"
                                Message="{Binding ReviewError}"
                                AutomationProperties.LiveSetting="Assertive" />

                    <TextBlock Style="{StaticResource DcCaption}"
                               Margin="0,12,0,0"
                               Text="{Binding CommandNote}" />
                    <Border Style="{StaticResource DcCodeBlock}" Margin="0,6,0,0">
                        <TextBox Style="{StaticResource DcMonoTextBox}"
                                 AutomationProperties.Name="Command that will run"
                                 Text="{Binding ConfirmCommandText, Mode=OneWay}" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <ui:Button x:Name="ReviewCancelButton"
                                   Content="Cancel"
                                   Icon="{ctl:DcSymbolIcon Dismiss24}"
                                   Appearance="Secondary"
                                   Command="{Binding CancelReviewCommand}"
                                   ToolTip="Close without changing anything (Esc)" />
                        <ui:Button Margin="8,0,0,0"
                                   Content="{Binding ConfirmButtonText}"
                                   Icon="{ctl:DcSymbolIcon Checkmark24}"
                                   Appearance="Primary"
                                   Command="{Binding ConfirmReviewCommand}"
                                   IsEnabled="{Binding CanConfirmReview}"
                                   ToolTipService.ShowOnDisabled="True"
                                   ToolTip="{Binding InstallationBlockedReason}"
                                   Visibility="{Binding IsNotDestructive, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.HelpText="Runs the command shown above. Enabled only after the preview succeeded and matched at least one alert." />
                        <ui:Button Margin="8,0,0,0"
                                   Content="{Binding ConfirmButtonText}"
                                   Appearance="Danger"
                                   Icon="{ctl:DcSymbolIcon Delete24}"
                                   Command="{Binding ConfirmReviewCommand}"
                                   IsEnabled="{Binding CanConfirmReview}"
                                   ToolTipService.ShowOnDisabled="True"
                                   ToolTip="{Binding InstallationBlockedReason}"
                                   Visibility="{Binding IsDestructive, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.HelpText="Runs the destructive command shown above. Enabled only after the preview succeeded and matched at least one alert." />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
