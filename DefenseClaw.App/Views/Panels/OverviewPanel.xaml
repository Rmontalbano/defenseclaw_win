<UserControl x:Class="DefenseClaw.App.Views.Panels.OverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls">
    <!--
        Dashboard layout mirroring the TUI's boxes, on the shared Dc* design system
        (Themes\DefenseClaw.xaml). Every severity / state colour is a Tag on a Dc* tone style
        bound to the plain string key the view-model already exposes, so both themes track the
        system and no converter is needed. The panel keeps no local styles.

        Accessibility: every list item announces through its record's ToString() (the view-model
        rows override it), every list carries a name, and status text that changes on its own
        (doctor progress) is a polite live region.
    -->
    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HeaderedContentControl Grid.Row="0"
                                Style="{StaticResource DcPageHeader}"
                                ctl:DcIcon.Symbol="AppsListDetail24"
                                ctl:DcIcon.Section="Overview">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource DcPageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource DcPageSubtitle}" Text="{Binding Description}" />
                </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel Style="{StaticResource DcActionBar}">
                <TextBlock Style="{StaticResource DcStatusText}" Text="{Binding LastUpdatedText}" />
                <!-- AsyncRelayCommand disables itself while it runs, so no IsEnabled plumbing. -->
                <ui:Button Content="Refresh"
                           Command="{Binding RefreshCommand}"
                           AutomationProperties.HelpText="Poll the gateway again and re-read the audit counts, enforcement lists and doctor results. Shortcut F5.">
                    <ui:Button.Icon>
                        <ctl:DcSymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </HeaderedContentControl>

        <ScrollViewer Grid.Row="1" Style="{StaticResource DcPageScroll}">
            <StackPanel>

                <!-- Gateway headline, then the severity tiles. Two full-width cards, not two columns: side by side
                     the tiles had ~350 px to share, wrapped 2+2+1 and stretched the gateway card (three short lines)
                     to the same height, leaving it half empty. Stacked, the five tiles get one row at every
                     window width the app allows. -->
                <Border Style="{StaticResource DcCard}" Margin="{StaticResource DcCardGap}">
                    <StackPanel>
                        <!-- WrapPanel, not StackPanel: the version and uptime must fall to a
                             second line on a narrow window instead of being clipped. -->
                        <WrapPanel>
                            <ctl:DcStatusGlyph Tone="{Binding GatewayStateKey}"
                                               GlyphSize="20"
                                               DotSize="12"
                                               Margin="0,0,10,0" />
                            <TextBlock Style="{StaticResource DcSectionHeader}"
                                       Margin="0"
                                       FontSize="20"
                                       VerticalAlignment="Center"
                                       Text="{Binding GatewayHeadline}" />
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding VersionText}" />
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Margin="14,0,0,0"
                                       VerticalAlignment="Center"
                                       Text="{Binding UptimeText, StringFormat='uptime {0}'}" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource DcTextSecondary}"
                                   Margin="0,8,0,0"
                                   Text="{Binding GatewayDetail}" />
                        <TextBox Style="{StaticResource DcMonoTextBox}"
                                 Margin="0,8,0,0"
                                 AutomationProperties.Name="DefenseClaw data directory"
                                 Text="{Binding DataDirectoryText, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource DcCaption}"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding DataDirectorySourceText}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}" Margin="{StaticResource DcCardGap}">
                    <StackPanel>
                        <ctl:DcCardHeader Symbol="DataBarVertical24" Section="Observe" Content="Audit severity — last 24 hours" />
                        <!-- Equal-width tiles (112 px; the widest count seen - "139,825" at 24 px - fits) in a wrap
                             panel: five tiles take one row at the 940 px minimum window, and a sixth wraps as a whole
                             tile instead of squeezing the digits. The negative right margin cancels the last tile's gap
                             so a full row ends flush with the card padding. -->
                        <ItemsControl Margin="0,0,-8,4"
                                      ItemsSource="{Binding SeverityTiles}"
                                      AutomationProperties.Name="Audit events by severity, last 24 hours">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DcToneTile}"
                                            Tag="{Binding SeverityKey}"
                                            Width="112"
                                            Padding="12,10,12,10"
                                            Margin="0,0,8,8">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DcValue}"
                                                       Tag="{Binding SeverityKey}"
                                                       Text="{Binding Value}" />
                                            <!-- The severity glyph repeats the label in a shape (nothing under Default). -->
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:DcSeverityGlyph Tone="{Binding SeverityKey}"
                                                                     GlyphSize="12"
                                                                     Gap="6"
                                                                     Margin="0,2,0,0" />
                                                <TextBlock Style="{StaticResource DcTileLabel}" Text="{Binding Label}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource DcBody}" Text="{Binding AuditSummary}" />
                        <TextBlock Style="{StaticResource DcCaption}"
                                   Margin="0,4,0,0"
                                   Text="{Binding AuditNote}" />
                    </StackPanel>
                </Border>

                <!-- What Needs Attention -->
                <Border Style="{StaticResource DcCard}" Margin="{StaticResource DcCardGap}">
                    <StackPanel>
                        <ctl:DcCardHeader Symbol="Warning24" Tint="Orange" Content="What needs attention" />
                        <ItemsControl ItemsSource="{Binding Attention}"
                                      AutomationProperties.Name="What needs attention">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0"
                                                Style="{StaticResource DcToneBar}"
                                                Tag="{Binding SeverityKey}" />
                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <ctl:DcSeverityGlyph Tone="{Binding SeverityKey}"
                                                                     Gap="8" />
                                                <TextBlock Style="{StaticResource DcBody}"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Title}" />
                                            </StackPanel>
                                            <TextBlock Style="{StaticResource DcTextSecondary}"
                                                       Margin="0,2,0,0"
                                                       Text="{Binding Detail}" />
                                            <Border Style="{StaticResource DcCodeBlock}"
                                                    Margin="0,6,0,0"
                                                    HorizontalAlignment="Left"
                                                    Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox Style="{StaticResource DcMonoTextBox}"
                                                         AutomationProperties.Name="Suggested command"
                                                         AutomationProperties.HelpText="Read-only text you can select and copy. The app never runs it for you."
                                                         Text="{Binding Command, Mode=OneWay}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Doctor (health check). Results come from doctor_cache.json, never from a probe the
                     panel starts by itself; the button runs 'defenseclaw doctor' on purpose. -->
                <Border Style="{StaticResource DcCard}" Margin="{StaticResource DcCardGap}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                                <ctl:DcCardHeader Symbol="HeartPulse24"
                                                  Tint="Green"
                                                  Margin="0,0,10,0"
                                                  HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="Health check (doctor)" />
                                <Border Style="{StaticResource DcBadge}"
                                        Tag="Warn"
                                        VerticalAlignment="Center"
                                        ToolTip="These results are older than 15 minutes."
                                        Visibility="{Binding DoctorIsStale, Converter={StaticResource BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource DcBadgeText}" Text="STALE" />
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="1" Style="{StaticResource DcActionBar}">
                                <ui:ProgressRing Width="20"
                                                 Height="20"
                                                 IsIndeterminate="True"
                                                 Visibility="{Binding IsDoctorRunning, Converter={StaticResource BoolToVisibility}}" />
                                <ui:Button Content="Cancel"
                                           Icon="{ctl:DcSymbolIcon Dismiss24}"
                                           Appearance="Secondary"
                                           Command="{Binding CancelDoctorCommand}"
                                           Visibility="{Binding IsDoctorRunning, Converter={StaticResource BoolToVisibility}}"
                                           AutomationProperties.HelpText="Stop the doctor run and kill its process tree." />
                                <ui:Button Content="Run doctor"
                                           Icon="{ctl:DcSymbolIcon Stethoscope24}"
                                           Command="{Binding RunDoctorCommand}"
                                           ToolTip="Runs 'defenseclaw doctor': read-only probes of every configured service, usually 10-30 seconds. Writes only its own results cache."
                                           AutomationProperties.HelpText="Runs defenseclaw doctor. Read-only probes of every configured service, usually 10 to 30 seconds; it writes only its own results cache." />
                            </StackPanel>
                        </Grid>

                        <!-- Live region: progress and outcome are announced without moving focus. -->
                        <TextBlock Style="{StaticResource DcCaption}"
                                   Margin="0,8,0,0"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding DoctorRunMessage}"
                                   Visibility="{Binding DoctorHasRunMessage, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Never run: a normal state on a fresh install, not a fault. -->
                        <StackPanel Style="{StaticResource DcEmptyState}"
                                    Visibility="{Binding DoctorIsEmpty, Converter={StaticResource BoolToVisibility}}">
                            <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ShieldSettings24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="Doctor has not run yet" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}"
                                       Text="doctor_cache.json does not exist. Run doctor to check credentials, endpoints and connector wiring; the result is kept here so it does not need re-probing every time you open this page." />
                        </StackPanel>

                        <!-- Cache exists but could not be read: a different state from never run. -->
                        <ui:InfoBar Margin="0,10,0,0"
                                    IsClosable="False"
                                    Severity="Warning"
                                    Title="Doctor results could not be read"
                                    IsOpen="{Binding DoctorHasReadError}"
                                    Message="{Binding DoctorReadError}" />

                        <StackPanel Visibility="{Binding DoctorHasData, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <ctl:DcStatusGlyph Tone="{Binding DoctorStateKey}"
                                                   Margin="0,0,10,0" />
                                <TextBlock Style="{StaticResource DcBody}"
                                           FontWeight="SemiBold"
                                           Text="{Binding DoctorVerdict}" />
                                <TextBlock Style="{StaticResource DcCaption}"
                                           Margin="10,0,0,0"
                                           VerticalAlignment="Center"
                                           Text="{Binding DoctorAsOfText}" />
                            </StackPanel>

                            <ItemsControl Margin="0,10,0,0"
                                          ItemsSource="{Binding DoctorTiles}"
                                          AutomationProperties.Name="Doctor check counts">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource DcToneTile}"
                                                Tag="{Binding SeverityKey}"
                                                Margin="0,0,10,0">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource DcValue}"
                                                           Tag="{Binding SeverityKey}"
                                                           Text="{Binding Value}" />
                                                <TextBlock Style="{StaticResource DcTileLabel}" Text="{Binding Label}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource DcCaption}"
                                       Margin="0,8,0,0"
                                       Text="Results are as of the last time doctor ran (from this page, a terminal or the TUI); opening this page never re-runs it. They go STALE after 15 minutes."
                                       Visibility="{Binding DoctorIsStale, Converter={StaticResource BoolToVisibility}}" />

                            <StackPanel Margin="0,12,0,0"
                                        Visibility="{Binding DoctorHasProblems, Converter={StaticResource BoolToVisibility}}">
                                <ctl:DcCardHeader Symbol="ShieldError24" Tint="Red" Content="Failing and warning checks" />
                                <ItemsControl ItemsSource="{Binding DoctorChecks}"
                                              AutomationProperties.Name="Failing and warning doctor checks">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource DcSubtleRow}" Margin="0,0,0,6">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0"
                                                            Style="{StaticResource DcBadge}"
                                                            Tag="{Binding StatusKey}"
                                                            MinWidth="52"
                                                            VerticalAlignment="Top"
                                                            Margin="0,0,10,0">
                                                        <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding StatusText}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Style="{StaticResource DcBody}"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Label}" />
                                                        <TextBlock Style="{StaticResource DcCaption}"
                                                                   Margin="0,2,0,0"
                                                                   Text="{Binding Detail}"
                                                                   Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource DcCaption}"
                                           Text="{Binding DoctorProblemsNote}" />
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Services + Scanners -->
                <Grid Margin="{StaticResource DcCardGap}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="{StaticResource DcColumnGap}" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource DcCard}">
                        <StackPanel>
                            <ctl:DcCardHeader Symbol="Server24" Section="Overview" Content="Services" />
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Margin="0,0,0,10"
                                       Text="Liveness and enforcement posture are separate: a subsystem can run while enforcement stays off, and &quot;disabled&quot; is a configuration, not a fault." />
                            <ItemsControl ItemsSource="{Binding ServiceRows}"
                                          AutomationProperties.Name="Services">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ctl:DcStatusGlyph Grid.Column="0"
                                                               Tone="{Binding StateKey}"
                                                               SlotHeight="18"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <WrapPanel>
                                                    <TextBlock Style="{StaticResource DcBody}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource DcTextSecondary}"
                                                               Margin="8,0,0,0"
                                                               Text="{Binding StateText}" />
                                                    <TextBlock Style="{StaticResource DcCaption}"
                                                               Margin="8,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding SinceText}" />
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource DcCaption}"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasPosture, Converter={StaticResource BoolToVisibility}}"
                                                           Text="{Binding Posture}" />
                                                <TextBlock Style="{StaticResource DcCaption}"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"
                                                           Text="{Binding Detail}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource DcCard}">
                        <StackPanel>
                            <ctl:DcCardHeader Symbol="ScanText24" Section="Govern" Content="Scanners" />
                            <ItemsControl ItemsSource="{Binding ScannerRows}"
                                          AutomationProperties.Name="Scanners">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ctl:DcStatusGlyph Grid.Column="0"
                                                               Tone="{Binding StateKey}"
                                                               SlotHeight="18"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <WrapPanel>
                                                    <TextBlock Style="{StaticResource DcBody}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource DcTextSecondary}"
                                                               Margin="8,0,0,0"
                                                               Text="{Binding StateText}" />
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource DcCaption}"
                                                           Margin="0,2,0,0"
                                                           Text="{Binding Detail}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Connectors -->
                <Border Style="{StaticResource DcCard}" Margin="{StaticResource DcCardGap}">
                    <StackPanel>
                        <ctl:DcCardHeader Symbol="PlugConnected24" Section="Discover" Content="Connectors" />
                        <ItemsControl ItemsSource="{Binding ConnectorRows}"
                                      AutomationProperties.Name="Connectors">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DcSubtleRow}"
                                            Margin="0,0,0,10"
                                            Padding="12">
                                        <!-- The state mark has its own column so every line below lines up with the name, whatever size the style draws it. -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ctl:DcStatusGlyph Grid.Column="0"
                                                               Tone="{Binding StateKey}"
                                                               SlotHeight="18"
                                                               Margin="0,0,10,0"
                                                               VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1">
                                                <WrapPanel>
                                                    <TextBlock Style="{StaticResource DcBody}"
                                                               FontWeight="SemiBold"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource DcTextSecondary}"
                                                               Margin="10,0,0,0"
                                                               VerticalAlignment="Center"
                                                               Text="{Binding StateText}" />
                                                </WrapPanel>

                                                <!-- Mode, fail-mode and source are metadata, not status: neutral chips. -->
                                                <WrapPanel Margin="0,6,0,0">
                                                    <Border Style="{StaticResource DcChip}" Margin="0,0,6,4">
                                                        <TextBlock Style="{StaticResource DcBadgeText}"
                                                                   Text="{Binding Mode, StringFormat='mode {0}'}" />
                                                    </Border>
                                                    <Border Style="{StaticResource DcChip}" Margin="0,0,6,4">
                                                        <TextBlock Style="{StaticResource DcBadgeText}"
                                                                   Text="{Binding FailMode, StringFormat='fail-mode {0}'}" />
                                                    </Border>
                                                    <Border Style="{StaticResource DcChip}" Margin="0,0,6,4">
                                                        <TextBlock Style="{StaticResource DcBadgeText}"
                                                                   Text="{Binding Source, StringFormat='source {0}'}" />
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Style="{StaticResource DcCaption}"
                                                           Margin="0,4,0,0"
                                                           Visibility="{Binding HasCounters, Converter={StaticResource BoolToVisibility}}"
                                                           Text="{Binding Counters}" />
                                                <TextBlock Style="{StaticResource DcCaption}"
                                                           Margin="0,2,0,0"
                                                           Text="{Binding Surface}" />
                                                <TextBlock Style="{StaticResource DcCaption}"
                                                           Margin="0,2,0,0"
                                                           Text="{Binding LastActivity}" />
                                                <TextBlock Style="{StaticResource DcToneText}"
                                                           Tag="Warn"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"
                                                           Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}"
                                                           Text="{Binding Drift}" />

                                                <ui:InfoBar Margin="0,8,0,0"
                                                            IsClosable="False"
                                                            Severity="Warning"
                                                            Title="Fail-mode mismatch"
                                                            IsOpen="{Binding HasWarning}"
                                                            Message="{Binding WarningText}" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Enforcement -->
                <Border Style="{StaticResource DcCard}">
                    <StackPanel>
                        <ctl:DcCardHeader Symbol="ShieldLock24" Section="Govern" Content="Enforcement" />
                        <ItemsControl ItemsSource="{Binding EnforcementTiles}"
                                      AutomationProperties.Name="Enforcement lists">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource DcToneTile}"
                                            Tag="{Binding SeverityKey}"
                                            Margin="0,0,10,10"
                                            MinWidth="150">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource DcValue}"
                                                       Tag="{Binding SeverityKey}"
                                                       Text="{Binding Value}" />
                                            <TextBlock Style="{StaticResource DcTileLabel}" Text="{Binding Label}" />
                                            <TextBlock Style="{StaticResource DcCaption}"
                                                       Margin="0,2,0,0"
                                                       Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}"
                                                       Text="{Binding Caption}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource DcBody}" Text="{Binding EnforcementSummary}" />
                        <TextBlock Style="{StaticResource DcCaption}"
                                   Margin="0,4,0,0"
                                   Text="{Binding EnforcementNote}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
