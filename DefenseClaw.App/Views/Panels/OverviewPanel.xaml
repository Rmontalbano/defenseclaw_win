<UserControl x:Class="DefenseClaw.App.Views.Panels.OverviewPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        Dashboard layout mirroring the TUI's boxes. Every colour comes from a DynamicResource
        so both themes track the system, and every severity/state colour is chosen by a
        DataTrigger on a plain string key from the view-model - no converters, because a
        panel is only allowed to be two files.
    -->
    <UserControl.Resources>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="Padding" Value="16" />
        </Style>

        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <Style x:Key="Primary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Secondary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Tertiary" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Liveness dot. "disabled" is deliberate configuration, so it stays neutral. -->
        <Style x:Key="StateDot" TargetType="Ellipse">
            <Setter Property="Width" Value="9" />
            <Setter Property="Height" Value="9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding StateKey}" Value="Ok">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Warn">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding StateKey}" Value="Bad">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="GatewayDot" TargetType="Ellipse">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding GatewayStateKey}" Value="Ok">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GatewayStateKey}" Value="Warn">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding GatewayStateKey}" Value="Bad">
                    <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Left accent bar, by severity key. -->
        <Style x:Key="SeverityBar" TargetType="Border">
            <Setter Property="Width" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Margin" Value="0,0,12,0" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="High">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Medium">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileBorder" TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14,10,14,10" />
            <Setter Property="Margin" Value="0,0,10,10" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="High">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Medium">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Ok">
                    <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SeverityKey}" Value="Critical">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SeverityKey}" Value="High">
                    <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24,20,24,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock FontSize="26"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                           Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0"
                           FontSize="13"
                           Style="{StaticResource Secondary}"
                           Text="{Binding Description}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Margin="0,0,12,0"
                           VerticalAlignment="Center"
                           Style="{StaticResource Tertiary}"
                           Text="{Binding LastUpdatedText}" />
                <!-- AsyncRelayCommand disables itself while it runs, so no IsEnabled plumbing. -->
                <ui:Button Content="Refresh" Command="{Binding RefreshCommand}">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </Grid>

        <ScrollViewer Grid.Row="1"
                      Padding="0,0,8,0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,0,24">

                <!-- Gateway headline + severity tiles -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <!-- WrapPanel, not StackPanel: the version and uptime must fall to a
                                 second line on a narrow window instead of being clipped. -->
                            <WrapPanel>
                                <Ellipse Style="{StaticResource GatewayDot}" Margin="0,0,10,0" />
                                <TextBlock FontSize="20"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           Text="{Binding GatewayHeadline}" />
                                <TextBlock Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Tertiary}"
                                           Text="{Binding VersionText}" />
                                <TextBlock Margin="14,0,0,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource Tertiary}"
                                           Text="{Binding UptimeText, StringFormat='uptime {0}'}" />
                            </WrapPanel>
                            <TextBlock Margin="0,8,0,0"
                                       Style="{StaticResource Secondary}"
                                       Text="{Binding GatewayDetail}" />
                            <TextBlock Margin="0,6,0,0"
                                       FontFamily="Cascadia Mono, Consolas"
                                       FontSize="11"
                                       Style="{StaticResource Tertiary}"
                                       Text="{Binding DataDirectoryText}" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}" MinWidth="330">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Audit severity — last 24 hours" />
                            <ItemsControl ItemsSource="{Binding SeverityTiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource TileBorder}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource TileValue}" Text="{Binding Value}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                           Text="{Binding Label}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource Secondary}" Text="{Binding AuditSummary}" />
                            <TextBlock Margin="0,4,0,0"
                                       FontSize="11"
                                       Style="{StaticResource Tertiary}"
                                       Text="{Binding AuditNote}" />
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- What Needs Attention -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="What needs attention" />
                        <ItemsControl ItemsSource="{Binding Attention}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Style="{StaticResource SeverityBar}" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock FontWeight="SemiBold"
                                                       Style="{StaticResource Primary}"
                                                       Text="{Binding Title}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       Style="{StaticResource Secondary}"
                                                       Text="{Binding Detail}" />
                                            <Border Margin="0,6,0,0"
                                                    Padding="8,4,8,4"
                                                    HorizontalAlignment="Left"
                                                    CornerRadius="4"
                                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                                    Visibility="{Binding HasCommand, Converter={StaticResource BoolToVisibility}}">
                                                <TextBox FontFamily="Cascadia Mono, Consolas"
                                                         FontSize="12"
                                                         IsReadOnly="True"
                                                         BorderThickness="0"
                                                         Padding="0"
                                                         Background="Transparent"
                                                         Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                                         Text="{Binding Command, Mode=OneWay}" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Services + Scanners -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,14,0">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Services" />
                            <TextBlock Margin="0,-6,0,10"
                                       FontSize="11"
                                       Style="{StaticResource Tertiary}"
                                       Text="Liveness and enforcement posture are separate: a subsystem can run while enforcement stays off, and &quot;disabled&quot; is a configuration, not a fault." />
                            <ItemsControl ItemsSource="{Binding ServiceRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Margin="0,5,10,0"
                                                     VerticalAlignment="Top"
                                                     Style="{StaticResource StateDot}" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Style="{StaticResource Primary}"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               Style="{StaticResource Secondary}"
                                                               Text="{Binding StateText}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               FontSize="11"
                                                               VerticalAlignment="Center"
                                                               Style="{StaticResource Tertiary}"
                                                               Text="{Binding SinceText}" />
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="12"
                                                           Style="{StaticResource Secondary}"
                                                           Visibility="{Binding HasPosture, Converter={StaticResource BoolToVisibility}}"
                                                           Text="{Binding Posture}" />
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Style="{StaticResource Tertiary}"
                                                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}"
                                                           Text="{Binding Detail}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardTitle}" Text="Scanners" />
                            <ItemsControl ItemsSource="{Binding ScannerRows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,9">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0"
                                                     Margin="0,5,10,0"
                                                     VerticalAlignment="Top"
                                                     Style="{StaticResource StateDot}" />
                                            <StackPanel Grid.Column="1">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock FontWeight="SemiBold"
                                                               Style="{StaticResource Primary}"
                                                               Text="{Binding Name}" />
                                                    <TextBlock Margin="8,0,0,0"
                                                               Style="{StaticResource Secondary}"
                                                               Text="{Binding StateText}" />
                                                </StackPanel>
                                                <TextBlock Margin="0,2,0,0"
                                                           FontSize="11"
                                                           Style="{StaticResource Tertiary}"
                                                           Text="{Binding Detail}" />
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Connectors -->
                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Connectors" />
                        <ItemsControl ItemsSource="{Binding ConnectorRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,10"
                                            Padding="12"
                                            CornerRadius="6"
                                            Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource StateDot}" />
                                                <TextBlock Margin="10,0,0,0"
                                                           FontWeight="SemiBold"
                                                           FontSize="14"
                                                           Style="{StaticResource Primary}"
                                                           Text="{Binding Name}" />
                                                <TextBlock Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource Secondary}"
                                                           Text="{Binding StateText}" />
                                                <TextBlock Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource Secondary}"
                                                           Text="{Binding Mode, StringFormat='mode {0}'}" />
                                                <TextBlock Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource Secondary}"
                                                           Text="{Binding FailMode, StringFormat='fail-mode {0}'}" />
                                                <TextBlock Margin="10,0,0,0"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           Style="{StaticResource Tertiary}"
                                                           Text="{Binding Source, StringFormat='source {0}'}" />
                                            </StackPanel>

                                            <TextBlock Margin="19,6,0,0"
                                                       FontSize="12"
                                                       Style="{StaticResource Secondary}"
                                                       Visibility="{Binding HasCounters, Converter={StaticResource BoolToVisibility}}"
                                                       Text="{Binding Counters}" />
                                            <TextBlock Margin="19,2,0,0"
                                                       FontSize="11"
                                                       Style="{StaticResource Tertiary}"
                                                       Text="{Binding Surface}" />
                                            <TextBlock Margin="19,2,0,0"
                                                       FontSize="11"
                                                       Style="{StaticResource Tertiary}"
                                                       Text="{Binding LastActivity}" />
                                            <TextBlock Margin="19,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource SystemFillColorCautionBrush}"
                                                       Visibility="{Binding HasDrift, Converter={StaticResource BoolToVisibility}}"
                                                       Text="{Binding Drift}" />

                                            <ui:InfoBar Margin="0,8,0,0"
                                                        IsClosable="False"
                                                        Severity="Warning"
                                                        Title="Fail-mode mismatch"
                                                        IsOpen="{Binding HasWarning}"
                                                        Message="{Binding WarningText}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Enforcement -->
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Enforcement" />
                        <ItemsControl ItemsSource="{Binding EnforcementTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource TileBorder}" MinWidth="150">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource TileValue}" Text="{Binding Value}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Text="{Binding Label}" />
                                            <TextBlock Margin="0,2,0,0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                       Visibility="{Binding HasCaption, Converter={StaticResource BoolToVisibility}}"
                                                       Text="{Binding Caption}" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Style="{StaticResource Secondary}" Text="{Binding EnforcementSummary}" />
                        <TextBlock Margin="0,4,0,0"
                                   FontSize="11"
                                   Style="{StaticResource Tertiary}"
                                   Text="{Binding EnforcementNote}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
