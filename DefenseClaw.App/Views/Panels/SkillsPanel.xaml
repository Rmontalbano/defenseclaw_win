<UserControl x:Class="DefenseClaw.App.Views.Panels.SkillsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:govern="clr-namespace:DefenseClaw.App.Views.Panels.Govern"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SkillsPanelViewModel}"
             mc:Ignorable="d">
    <!--
        Skills panel. Data is the CLI command 'skill list' with its JSON flag (one read per visit / Refresh / scope change),
        not the gateway's /skills, which answers "not connected" on a standalone install.
        Row layout, the review dialog and the result card are shared with the other Govern panels
        (Views\Panels\Govern\); the logic lives in ViewModels\Govern\GovernPanelViewModelBase.cs.
        Keys: F5 refresh (shell), Ctrl+F filter, Esc closes the dialog / result card / clears the filter.

        Layout. Everything under the header is one scrolling page (PageScroll): the toolbar, the banners and the list
        together are taller than the page is with the shell's gateway banner open, and they used to share it, so the list
        kept whatever the fixed rows above it left over. Now the list is the last thing on the page with a height of its
        own: the rest of the viewport under the chrome, and never less than 250 DIPs (FillHeightConverter). A ScrollViewer
        measures its content with unlimited height, and a virtualizing list measured that way realizes every row, so the
        list keeps a definite height and its own scroller. The result card of a read-only command sits under the list and
        is scrolled into view when it opens.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DefenseClaw.App;component/Views/Panels/Govern/GovernTable.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the busy ring and "as of 12:04", the refresh icon, the filter box. -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="PuzzlePiece24"
                           ctl:DcIcon.Section="Govern"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           Caption="{Binding HeaderStatusText}"
                           HasSearch="True"
                           SearchText="{Binding FilterText}"
                           SearchPlaceholder="Filter skills…"
                           SearchAutomationName="Filter skills"
                           SearchHelpText="Matches name, description, connector, state, scan result and registry. Shortcut Ctrl+F; Esc clears it.">
            <ctl:DcPageToolbar.Leading>
                <ui:ProgressRing Width="16"
                                 Height="16"
                                 Margin="12,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Working" />
            </ctl:DcPageToolbar.Leading>
            <ctl:DcPageToolbar.ConnectorSlot>
                <ctl:DcConnectorScopeChip Model="{Binding ConnectorChip}" />
            </ctl:DcPageToolbar.ConnectorSlot>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowDownload24}"
                               Command="{Binding ToggleInstallFormCommand}"
                               IsEnabled="{Binding CanChange}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Install skill…'}"
                               AutomationProperties.Name="Install skill…"
                               AutomationProperties.HelpText="Install a ClawHub skill with 'defenseclaw skill install'. You review the command first." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ScanText24}"
                               Command="{Binding ScanAllCommand}"
                               IsEnabled="{Binding CanScanAll}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="{Binding DataUntrustedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Scan all skills…'}"
                               AutomationProperties.Name="Scan all skills…"
                               AutomationProperties.HelpText="Runs 'defenseclaw skill scan --all' and records the results. You review the command first." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               IsEnabled="{Binding IsIdle}"
                               ToolTip="Read the skill list again (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5" />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      Style="{StaticResource DcPageScroll}"
                      Focusable="False"
                      AutomationProperties.Name="Skills page">
            <StackPanel x:Name="PageContent">
                <!-- Toolbar, banners and the caption: what the list's height is worked out from. -->
                <StackPanel x:Name="Chrome">
                    <!-- Filter strip: which state, which connector, and the reason the next action records. -->
                    <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Show" />
                            <ComboBox Width="160"
                                      ItemsSource="{Binding StatusFilters}"
                                      SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                      AutomationProperties.Name="Show skills in state" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Connector scope" />
                            <ComboBox MinWidth="200"
                                      ItemsSource="{Binding Connectors}"
                                      SelectedItem="{Binding SelectedConnector, Mode=TwoWay}"
                                      AutomationProperties.Name="Connector scope"
                                      AutomationProperties.HelpText="Which connector's skills to list, and which connector block, allow and the other actions apply to when a row does not name one." />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Reason" />
                            <ui:TextBox MinWidth="180"
                                        Width="220"
                                        PlaceholderText="Recorded with the action"
                                        Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Reason"
                                        AutomationProperties.HelpText="Sent as --reason with block, allow, disable and quarantine." />
                        </StackPanel>
                    </WrapPanel>

                    <!-- Why Scan is off: the scanner is not installed. -->
                    <TextBlock Style="{StaticResource DcToneText}"
                               Tag="Warn"
                               Margin="{StaticResource DcCardGap}"
                               TextWrapping="Wrap"
                               Text="{Binding ScanUnavailableReason}"
                               Visibility="{Binding HasScanUnavailableReason, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />

                    <!-- Install a skill (skill install) -->
                    <Border Style="{StaticResource DcCard}"
                            Margin="{StaticResource DcCardGap}"
                            Visibility="{Binding IsInstallFormOpen, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel>
                            <ctl:DcCardHeader Symbol="ArrowDownload24" Section="Govern" Content="Install a skill" />
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Text="Runs 'defenseclaw skill install'. The skill is downloaded from ClawHub, copied into the connector's skill folder and scanned. The scope is the connector chosen in the toolbar; 'All configured connectors' installs into every one. You review the exact command before anything runs." />

                            <StackPanel Margin="0,12,0,8">
                                <TextBlock Style="{StaticResource DcFieldLabel}" Text="ClawHub skill name" />
                                <ui:TextBox Text="{Binding InstallName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            AutomationProperties.Name="Skill to install" />
                            </StackPanel>

                            <CheckBox Content="Force: overwrite an existing skill of the same name"
                                      IsChecked="{Binding InstallForce, Mode=TwoWay}" />
                            <CheckBox Margin="0,6,0,0"
                                      Content="Apply the configured skill__actions policy based on scan severity"
                                      IsChecked="{Binding InstallApplyActionPolicy, Mode=TwoWay}" />

                            <TextBlock Style="{StaticResource DcToneText}"
                                       Tag="Bad"
                                       Margin="0,10,0,0"
                                       TextWrapping="Wrap"
                                       Text="{Binding InstallFormError}"
                                       Visibility="{Binding HasInstallFormError, Converter={StaticResource BoolToVisibility}}"
                                       AutomationProperties.LiveSetting="Assertive" />

                            <StackPanel Margin="0,12,0,0"
                                        HorizontalAlignment="Right"
                                        Orientation="Horizontal">
                                <ui:Button Margin="0,0,8,0"
                                           Content="Cancel"
                                           Icon="{ctl:DcSymbolIcon Dismiss24}"
                                           Command="{Binding ToggleInstallFormCommand}" />
                                <ui:Button Appearance="Primary"
                                           Content="Review command"
                                           Icon="{ctl:DcSymbolIcon ClipboardCheckmark24}"
                                           Command="{Binding SubmitInstallFormCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Result of the last action and a stale-data warning -->
                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                Title="{Binding ResultTitle}"
                                Message="{Binding ResultMessage}"
                                Severity="{Binding ResultSeverity}"
                                IsOpen="{Binding IsResultOpen, Mode=TwoWay}"
                                IsClosable="True"
                                AutomationProperties.LiveSetting="Polite" />
                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                Title="Showing an older read"
                                Message="{Binding RefreshWarning}"
                                Severity="Warning"
                                IsOpen="{Binding HasRefreshWarning, Mode=OneWay}"
                                IsClosable="False"
                                AutomationProperties.LiveSetting="Polite" />
                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                Title="Incomplete discovery"
                                Message="{Binding PartialDiscoveryMessage}"
                                Severity="Warning"
                                IsOpen="{Binding HasPartialDiscovery, Mode=OneWay}"
                                IsClosable="False"
                                AutomationProperties.LiveSetting="Polite" />

                    <TextBlock Style="{StaticResource DcResultCaption}"
                               Margin="{StaticResource DcCardGap}"
                               Text="{Binding CaptionText}" />
                </StackPanel>

                <!-- Content: exactly one of these is visible -->
                <StackPanel Style="{StaticResource DcEmptyState}"
                            Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing Width="32"
                                     Height="32"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Reading skills" />
                    <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Reading skills from the CLI…" />
                </StackPanel>

                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowCliMissing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Press Refresh to try again. The command and its output are in Activity." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="PuzzlePiece24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Search24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="No skills match the filter" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="The filter hides every skill the CLI listed. Clear it to see them all." />
                        <ui:Button Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Content="Clear filter"
                                   Icon="{ctl:DcSymbolIcon FilterDismiss24}"
                                   Command="{Binding ClearFilterCommand}" />
                    </StackPanel>
                </Border>

                <!-- The list: a dense table with a height of its own (the rest of the viewport, at least 250), virtualized. Each row's actions
                     are in its "..." menu (and on right-click); a selected row opens its details under itself. -->
                <ui:DataGrid x:Name="RowGrid"
                             Style="{StaticResource DcDataGrid}"
                             RowStyle="{StaticResource GovernGridRow}"
                             RowDetailsTemplate="{StaticResource GovernRowDetails}"
                             RowDetailsVisibilityMode="VisibleWhenSelected"
                             SelectionMode="Single"
                             AutomationProperties.Name="Skills"
                             ItemsSource="{Binding Rows}"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ctl:DcGridColumns.Fit="True"
                             panels:NestedScroll.ForwardWheel="True"
                             Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                    <ui:DataGrid.Height>
                        <MultiBinding Converter="{x:Static govern:FillHeightConverter.Instance}" ConverterParameter="250">
                            <Binding ElementName="PageScroll" Path="ViewportHeight" />
                            <Binding ElementName="Chrome" Path="ActualHeight" />
                        </MultiBinding>
                    </ui:DataGrid.Height>
                    <ui:DataGrid.Columns>
                        <DataGridTemplateColumn Width="1*" MinWidth="110" Header="Status"
                                                SortMemberPath="StateLabel"
                                                CellTemplate="{StaticResource GovernStatusCell}" />
                        <DataGridTemplateColumn Width="1.5*" MinWidth="100" Header="Name"
                                                SortMemberPath="DisplayTitle"
                                                ClipboardContentBinding="{Binding DisplayTitle}"
                                                CellTemplate="{StaticResource GovernNameCell}" />
                        <DataGridTextColumn Width="2.2*" MinWidth="100" Header="Description"
                                            SortMemberPath="Description"
                                            ElementStyle="{StaticResource DcCellTextQuiet}"
                                            Binding="{Binding Description}" />
                        <DataGridTemplateColumn Width="1.3*" MinWidth="120" Header="Scan"
                                                SortMemberPath="ScanLabel"
                                                CellTemplate="{StaticResource GovernScanCell}" />
                        <DataGridTextColumn Width="1*" MinWidth="76" Header="Connector"
                                            SortMemberPath="ConnectorLabel"
                                            ElementStyle="{StaticResource DcCellTextQuiet}"
                                            Binding="{Binding ConnectorLabel}" />
                        <DataGridTextColumn Width="1.3*" MinWidth="80" Header="Source"
                                            SortMemberPath="SourceText"
                                            ElementStyle="{StaticResource DcCellTextMono}"
                                            Binding="{Binding SourceText}" />
                        <DataGridTemplateColumn Width="32" Header="Actions"
                                                CanUserSort="False"
                                                HeaderStyle="{StaticResource DcDataGridActionsHeader}"
                                                CellTemplate="{StaticResource GovernMenuCell}" />
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <!-- Result of a read-only command (info): under the list, scrolled into view when it opens. -->
                <govern:GovernOutputCard />
            </StackPanel>
        </ScrollViewer>

        <!-- Review dialog for every state-changing command -->
        <govern:GovernConfirmOverlay Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</UserControl>
