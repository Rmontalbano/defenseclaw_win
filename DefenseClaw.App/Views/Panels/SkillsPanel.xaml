<UserControl x:Class="DefenseClaw.App.Views.Panels.SkillsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:govern="clr-namespace:DefenseClaw.App.Views.Panels.Govern"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:SkillsPanelViewModel}"
             mc:Ignorable="d">
    <!--
        Skills panel. Data is the CLI command 'skill list' with its JSON flag (one read per visit / Refresh / scope change),
        not the gateway's /skills, which answers "not connected" on a standalone install.
        Row layout, the review dialog and the result card are shared with the other Govern panels
        (Views\Panels\Govern\); the logic lives in ViewModels\Govern\GovernPanelViewModelBase.cs.
        Keys: F5 refresh (shell), Ctrl+F filter, Esc closes the dialog / result card / clears the filter.
    -->
    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HeaderedContentControl Grid.Row="0" Style="{StaticResource DcPageHeader}">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource DcPageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource DcPageSubtitle}" Text="{Binding Description}" />
                </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel Style="{StaticResource DcActionBar}">
                <ui:ProgressRing Width="16"
                                 Height="16"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Working" />
                <TextBlock Style="{StaticResource DcStatusText}" Text="{Binding HeaderStatusText}" />
                <ui:Button Content="Refresh"
                           Command="{Binding RefreshCommand}"
                           IsEnabled="{Binding IsIdle}"
                           ToolTip="Read the skill list again (F5)">
                    <ui:Button.Icon>
                        <ui:SymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource DcToolbar}">
            <WrapPanel Style="{StaticResource DcToolbarPanel}">
                <ui:TextBox x:Name="FilterBox"
                            Width="240"
                            PlaceholderText="Filter skills (Ctrl+F)"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Filter skills"
                            AutomationProperties.HelpText="Matches name, description, connector, state and scan result. Escape clears it." />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Show" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                              AutomationProperties.Name="Show skills in state" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Connector scope" />
                    <ComboBox MinWidth="200"
                              ItemsSource="{Binding Connectors}"
                              SelectedItem="{Binding SelectedConnector, Mode=TwoWay}"
                              AutomationProperties.Name="Connector scope"
                              AutomationProperties.HelpText="Which connector's skills to list, and which connector block, allow and the other actions apply to when a row does not name one." />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Reason" />
                    <ui:TextBox MinWidth="180"
                                Width="220"
                                PlaceholderText="Recorded with the action"
                                Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Reason"
                                AutomationProperties.HelpText="Sent as --reason with block, allow, disable and quarantine." />
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Result of the last action, result of a read-only command, and a stale-data warning -->
        <StackPanel Grid.Row="2">
            <ui:InfoBar Margin="{StaticResource DcCardGap}"
                        Title="{Binding ResultTitle}"
                        Message="{Binding ResultMessage}"
                        Severity="{Binding ResultSeverity}"
                        IsOpen="{Binding IsResultOpen, Mode=TwoWay}"
                        IsClosable="True"
                        AutomationProperties.LiveSetting="Polite" />
            <govern:GovernOutputCard />
            <ui:InfoBar Margin="{StaticResource DcCardGap}"
                        Title="Showing an older read"
                        Message="{Binding RefreshWarning}"
                        Severity="Warning"
                        IsOpen="{Binding HasRefreshWarning, Mode=OneWay}"
                        IsClosable="False"
                        AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <TextBlock Grid.Row="3"
                   Style="{StaticResource DcCaption}"
                   Margin="{StaticResource DcCardGap}"
                   Text="{Binding CaptionText}" />

        <!-- Content: exactly one of these is visible -->
        <Grid Grid.Row="4">
            <!--
                Everything but the list scrolls as one block: the empty and error cards carry a paragraph of
                explanation, and in a short window the row they sit in is smaller than the card, which used to
                clip it (an empty card, or a sentence cut mid-line). MinHeight = the viewport keeps the loading
                spinner centred when there is room. The list below has its own scroller and sits on top.
            -->
            <ScrollViewer Style="{StaticResource DcPageScroll}" Focusable="False">
                <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <StackPanel Style="{StaticResource DcEmptyState}"
                                Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing Width="32"
                                         Height="32"
                                         IsIndeterminate="True"
                                         AutomationProperties.Name="Reading skills" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Reading skills from the CLI…" />
                    </StackPanel>

                    <Border Style="{StaticResource DcCard}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowCliMissing, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                            <ui:SymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DcCard}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                            <ui:SymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Press Refresh to try again. The command and its output are in Activity." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DcCard}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                            <ui:SymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="PuzzlePiece24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DcCard}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DcEmptyState}">
                            <ui:SymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Search24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="No skills match the filter" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="The filter hides every skill the CLI listed. Clear it to see them all." />
                            <ui:Button Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Content="Clear filter"
                                       Command="{Binding ClearFilterCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <ItemsControl AutomationProperties.Name="Skills"
                          ItemsSource="{Binding Rows}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Style="{StaticResource DcPageScroll}"
                                      CanContentScroll="True"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <govern:GovernRowView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Review dialog for every state-changing command -->
        <govern:GovernConfirmOverlay Grid.Row="0" Grid.RowSpan="5" />
    </Grid>
</UserControl>
