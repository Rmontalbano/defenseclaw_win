<UserControl x:Class="DefenseClaw.App.Views.Panels.DiscoverReviewOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:DiscoverActionReview}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             IsTabStop="False"
             Focusable="False">
    <!--
        The confirm-and-run dialog shared by the three Discover panels. DataContext is a
        DiscoverActionReview (the panel binds it: DataContext="{Binding Review}"). It sits on top of
        the panel's content (Grid.RowSpan) and is collapsed until IsOpen. Tab is confined to the
        dialog while it is up.
    -->
    <Grid x:Name="Scrim"
          Style="{StaticResource DcScrim}"
          KeyboardNavigation.TabNavigation="Cycle"
          KeyboardNavigation.ControlTabNavigation="Cycle"
          Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
        <Border Style="{StaticResource DcDialogCard}"
                MaxHeight="640"
                AutomationProperties.Name="{Binding Heading}"
                AutomationProperties.HelpText="Review the exact command before it runs. Press Escape to close.">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource DcSectionHeader}"
                               Text="{Binding Heading}" />

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Border Style="{StaticResource DcBadge}" Tag="{Binding TierKey}" Margin="0,0,8,0">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding TierLabel}" />
                        </Border>
                        <Border Style="{StaticResource DcBadge}"
                                Tag="Warn"
                                Visibility="{Binding RestartsGateway, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="Restarts the gateway" />
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource DcTextSecondary}"
                               Margin="0,0,0,12"
                               Text="{Binding Explanation}" />

                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                IsClosable="False"
                                IsOpen="{Binding RestartsGateway}"
                                Severity="Warning"
                                Title="Gateway restart"
                                Message="{Binding RestartNotice}" />

                    <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                IsClosable="False"
                                IsOpen="{Binding HasWarning}"
                                Severity="Warning"
                                Title="Before you continue"
                                Message="{Binding WarningText}" />

                    <TextBlock Style="{StaticResource DcCaption}"
                               Margin="0,0,0,6"
                               Text="This is the exact command that will run. Nothing happens until you confirm." />

                    <ItemsControl ItemsSource="{Binding Steps}" Focusable="False" IsTabStop="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal"
                                                Visibility="{Binding DataContext.MultipleSteps, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource DcCardTitle}"
                                                   Margin="0,0,8,4"
                                                   Text="{Binding Heading}" />
                                        <TextBlock Style="{StaticResource DcCaption}"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,0,4"
                                                   Text="{Binding Purpose}" />
                                    </StackPanel>
                                    <Border Style="{StaticResource DcCodeBlock}">
                                        <TextBox Style="{StaticResource DcMonoTextBox}"
                                                 AutomationProperties.Name="Command"
                                                 Text="{Binding CommandText, Mode=OneWay}" />
                                    </Border>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <Border Style="{StaticResource DcBadge}" Tag="{Binding StatusKey}">
                                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding StatusText}" />
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ui:ProgressRing Width="24"
                                     Height="24"
                                     HorizontalAlignment="Left"
                                     Margin="0,4,0,8"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Running the command"
                                     Visibility="{Binding IsRunning, Converter={StaticResource BoolToVisibility}}" />

                    <!-- Result, after the run -->
                    <StackPanel Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}"
                                AutomationProperties.LiveSetting="Polite">
                        <Border Style="{StaticResource DcBadge}"
                                Tag="{Binding ResultKey}"
                                HorizontalAlignment="Left"
                                Margin="0,0,0,6">
                            <TextBlock Style="{StaticResource DcBadgeText}"
                                       TextWrapping="Wrap"
                                       Text="{Binding ResultText}" />
                        </Border>
                        <Border Style="{StaticResource DcCodeBlock}"
                                MaxHeight="200"
                                Visibility="{Binding HasResultOutput, Converter={StaticResource BoolToVisibility}}">
                            <TextBox Style="{StaticResource DcMonoTextBox}"
                                     AutomationProperties.Name="Command output"
                                     VerticalScrollBarVisibility="Auto"
                                     Text="{Binding ResultOutput, Mode=OneWay}" />
                        </Border>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,16,0,0">
                        <ui:Button x:Name="CopyButton"
                                   Content="Copy command"
                                   Margin="0,0,8,0"
                                   Command="{Binding CopyCommand}"
                                   AutomationProperties.Name="Copy the command to the clipboard" />
                        <ui:Button x:Name="CancelButton"
                                   Content="Cancel"
                                   Margin="0,0,8,0"
                                   Command="{Binding DismissCommand}"
                                   Visibility="{Binding IsConfirming, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.Name="Cancel and close without running" />
                        <ui:Button x:Name="RunButton"
                                   Appearance="Primary"
                                   Content="{Binding PrimaryText}"
                                   Command="{Binding ConfirmCommand}"
                                   Visibility="{Binding ShowRunButton, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.HelpText="Runs the command shown above." />
                        <ui:Button x:Name="DangerButton"
                                   Appearance="Danger"
                                   Content="{Binding PrimaryText}"
                                   Command="{Binding ConfirmCommand}"
                                   Visibility="{Binding ShowDangerButton, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.HelpText="Runs the destructive command shown above." />
                        <ui:Button x:Name="CloseButton"
                                   Appearance="Primary"
                                   Content="Close"
                                   Command="{Binding DismissCommand}"
                                   Visibility="{Binding IsFinished, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
