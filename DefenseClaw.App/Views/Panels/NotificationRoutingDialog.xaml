<UserControl x:Class="DefenseClaw.App.Views.Panels.NotificationRoutingDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:NotificationRoutingViewModel}"
             mc:Ignorable="d"
             IsTabStop="False"
             Focusable="False">
    <!--
        Notification routing (CUST-271): the TUI's Notifications Routing wizard as a dialog on the Setup hub. Six switches seeded from
        config.yaml, the master switch above them (the Overview's own reviewed action), and one review for all the changes: the shared
        DiscoverReviewOverlay at the bottom shows every `setup notifications-set` command together and runs them in order. DataContext is a
        NotificationRoutingViewModel (the Setup panel binds it: DataContext="{Binding Routing}"). The scrim is collapsed until IsOpen, and Tab
        is confined to the dialog while it is up. These are the gateway's own desktop notifications; the tray alerts are Settings' (the note says so).
    -->
    <UserControl.Resources>
        <!-- One switch: its name and what it controls, a word when it has moved, and the toggle. -->
        <DataTemplate x:Key="RoutingRowTemplate" DataType="{x:Type vm:RoutingRow}">
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DcBody}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="{Binding Label}" />
                        <Border Style="{StaticResource DcBadge}"
                                Tag="Warn"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsChanged, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding ChangeText}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource DcCaption}" Text="{Binding Description}" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Text="{Binding UnavailableText}"
                               Visibility="{Binding IsUnavailable, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <ui:ToggleSwitch Grid.Column="1"
                                 VerticalAlignment="Center"
                                 IsChecked="{Binding IsOn, Mode=TwoWay}"
                                 IsEnabled="{Binding IsAvailable}"
                                 AutomationProperties.Name="{Binding AutomationName}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid x:Name="Scrim"
              Style="{StaticResource DcScrim}"
              KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle"
              Visibility="{Binding IsOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Style="{StaticResource DcDialogCard}"
                    MaxWidth="640"
                    MaxHeight="720"
                    Margin="24"
                    AutomationProperties.Name="Notification routing">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Heading -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcSectionHeader}"
                                       AutomationProperties.HeadingLevel="Level1"
                                       Text="{Binding Title}" />
                            <ui:ProgressRing Width="16"
                                             Height="16"
                                             Margin="10,0,0,0"
                                             IsIndeterminate="True"
                                             AutomationProperties.Name="Checking this DefenseClaw's options"
                                             Visibility="{Binding IsChecking, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource DcBody}" Text="{Binding Subtitle}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Focusable="False">
                        <StackPanel Margin="0,0,8,0">
                            <!-- The ways the dialog can be unable to change anything, one bar each, the installation first. -->
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Warning"
                                        Title="State-changing actions disabled"
                                        IsOpen="{Binding HasInstallationBlock, Mode=OneWay}"
                                        Message="{Binding InstallationBlockedReason, Mode=OneWay}" />
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Error"
                                        Title="config.yaml could not be read"
                                        IsOpen="{Binding HasConfigProblem, Mode=OneWay}"
                                        Message="{Binding ConfigProblem, Mode=OneWay}" />
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Warning"
                                        Title="These settings may be out of date"
                                        IsOpen="{Binding IsStale, Mode=OneWay}"
                                        Message="{Binding StaleReason, Mode=OneWay}" />
                            <ui:InfoBar Margin="0,0,0,10"
                                        IsClosable="False"
                                        Severity="Warning"
                                        Title="This DefenseClaw's options could not be checked"
                                        IsOpen="{Binding HasHelpProblem, Mode=OneWay}"
                                        Message="{Binding HelpProblem, Mode=OneWay}" />

                            <!-- Whose notifications these are. -->
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Margin="0,0,0,12"
                                       Text="{Binding ScopeNote}" />

                            <!-- The master switch: the Overview's action, with its words. -->
                            <Border Style="{StaticResource DcSubtleRow}" Margin="0,0,0,12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Style="{StaticResource DcBody}"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.LiveSetting="Polite"
                                                   Text="{Binding MasterText}" />
                                        <TextBlock Style="{StaticResource DcCaption}"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding MasterDetail}"
                                                   Visibility="{Binding HasMasterDetail, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource DcCaption}"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding MasterOffNote}"
                                                   Visibility="{Binding ShowMasterOffNote, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                    <ui:Button Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Content="{Binding MasterButtonText}"
                                               Icon="{ctl:DcSymbolIcon Power24}"
                                               Command="{Binding ToggleMasterCommand}"
                                               ToolTipService.ShowOnDisabled="True"
                                               ToolTip="{Binding MasterTip}"
                                               AutomationProperties.Name="{Binding MasterButtonText, StringFormat='Desktop notifications: {0}'}"
                                               AutomationProperties.HelpText="Shows the exact command first, the same one the Overview's notifications button runs." />
                                </Grid>
                            </Border>

                            <!-- Event types -->
                            <ctl:DcCardHeader Margin="0,0,0,8"
                                              AutomationProperties.HeadingLevel="Level2"
                                              Symbol="Alert24"
                                              Section="Setup"
                                              Content="Events" />
                            <ItemsControl ItemsSource="{Binding CategoryRows}"
                                          ItemTemplate="{StaticResource RoutingRowTemplate}"
                                          IsTabStop="False"
                                          IsEnabled="{Binding CanEdit}"
                                          AutomationProperties.Name="Which events raise a notification" />

                            <!-- Sources -->
                            <ctl:DcCardHeader Margin="0,6,0,8"
                                              AutomationProperties.HeadingLevel="Level2"
                                              Symbol="PlugConnected24"
                                              Section="Setup"
                                              Content="Sources" />
                            <ItemsControl ItemsSource="{Binding SourceRows}"
                                          ItemTemplate="{StaticResource RoutingRowTemplate}"
                                          IsTabStop="False"
                                          IsEnabled="{Binding CanEdit}"
                                          AutomationProperties.Name="Which sources raise a notification" />

                            <!-- Rollout -->
                            <CheckBox Margin="0,4,0,2"
                                      Content="Restart the gateway after the change"
                                      IsChecked="{Binding RestartAfter, Mode=TwoWay}"
                                      AutomationProperties.HelpText="Unchecking adds --no-restart to every command" />
                            <TextBlock Style="{StaticResource DcCaption}"
                                       Margin="28,0,0,10"
                                       Text="{Binding RestartNote}" />

                            <!-- What happened to the last review. -->
                            <Border Style="{StaticResource DcSubtleRow}"
                                    Margin="0,4,0,0"
                                    AutomationProperties.LiveSetting="Polite"
                                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource DcBadge}"
                                            Tag="{Binding ResultKey}"
                                            HorizontalAlignment="Left">
                                        <TextBlock Style="{StaticResource DcBadgeText}"
                                                   TextWrapping="Wrap"
                                                   Text="{Binding ResultText}" />
                                    </Border>
                                    <ui:Button Grid.Column="1"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Top"
                                               Content="Dismiss"
                                               Command="{Binding DismissResultCommand}"
                                               AutomationProperties.Name="Dismiss the result" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- What would run, and the way out. -->
                    <StackPanel Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Style="{StaticResource DcCardTitle}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding Summary}" />
                        <ItemsControl ItemsSource="{Binding ChangeLines}"
                                      IsTabStop="False"
                                      AutomationProperties.Name="Changes to apply">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource DcCaption}" Margin="8,0,0,0" Text="{Binding}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Grid Margin="0,10,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:Button Grid.Column="0"
                                       Content="Refresh"
                                       Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                                       Command="{Binding RefreshCommand}"
                                       ToolTip="Reads config.yaml and this DefenseClaw's options again and starts the switches from what the file says."
                                       AutomationProperties.Name="Read config.yaml again" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Margin="0,0,8,0"
                                           Content="Close"
                                           Command="{Binding CloseCommand}"
                                           ToolTip="Esc"
                                           AutomationProperties.Name="Close the notification routing dialog" />
                                <ui:Button Appearance="Primary"
                                           Content="Review changes…"
                                           Icon="{ctl:DcSymbolIcon Play24}"
                                           Command="{Binding ReviewChangesCommand}"
                                           ToolTipService.ShowOnDisabled="True"
                                           ToolTip="{Binding ReviewTip}"
                                           AutomationProperties.HelpText="{Binding ReviewTip}" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- The review of the moved switches (one step for each), and of the master switch. Sits on top of the dialog. -->
        <panels:DiscoverReviewOverlay DataContext="{Binding Review}" />
    </Grid>
</UserControl>
