<UserControl x:Class="DefenseClaw.App.Views.Panels.McpsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:govern="clr-namespace:DefenseClaw.App.Views.Panels.Govern"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:McpsPanelViewModel}"
             mc:Ignorable="d">
    <!--
        MCPs panel. Data is the CLI command 'mcp list' with its JSON flag (one read per visit / Refresh / scope change).
        Row actions and the review dialog are shared with the other Govern panels; the "Add MCP server"
        form (mcp set) is the one panel-specific piece. Keys: F5 refresh (shell), Ctrl+F filter, Esc closes
        the dialog / form / result card / clears the filter.
    -->
    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <HeaderedContentControl Grid.Row="0" Style="{StaticResource DcPageHeader}"
                                ctl:DcIcon.Symbol="PlugConnected24"
                                ctl:DcIcon.Section="Govern">
            <HeaderedContentControl.Header>
                <StackPanel>
                    <TextBlock Style="{StaticResource DcPageTitle}" Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource DcPageSubtitle}" Text="{Binding Description}" />
                </StackPanel>
            </HeaderedContentControl.Header>
            <StackPanel Style="{StaticResource DcActionBar}">
                <ui:ProgressRing Width="16"
                                 Height="16"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Working" />
                <TextBlock Style="{StaticResource DcStatusText}" Text="{Binding HeaderStatusText}" />
                <ui:Button Content="Refresh"
                           Command="{Binding RefreshCommand}"
                           IsEnabled="{Binding IsIdle}"
                           ToolTip="Read the MCP server list again (F5)">
                    <ui:Button.Icon>
                        <ctl:DcSymbolIcon Symbol="ArrowClockwise24" />
                    </ui:Button.Icon>
                </ui:Button>
            </StackPanel>
        </HeaderedContentControl>

        <!-- Toolbar -->
        <Border Grid.Row="1" Style="{StaticResource DcToolbar}">
            <WrapPanel Style="{StaticResource DcToolbarPanel}">
                <ui:TextBox x:Name="FilterBox"
                            Width="240"
                            PlaceholderText="Filter MCP servers (Ctrl+F)"
                            Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                            AutomationProperties.Name="Filter MCP servers"
                            AutomationProperties.HelpText="Matches name, transport, command, URL, connector and state. Escape clears it." />
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Show" />
                    <ComboBox Width="160"
                              ItemsSource="{Binding StatusFilters}"
                              SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                              AutomationProperties.Name="Show MCP servers in state" />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Connector scope" />
                    <ComboBox MinWidth="200"
                              ItemsSource="{Binding Connectors}"
                              SelectedItem="{Binding SelectedConnector, Mode=TwoWay}"
                              AutomationProperties.Name="Connector scope"
                              AutomationProperties.HelpText="Which connector's MCP servers to list, and which connector Add MCP server writes to. All configured connectors means every one." />
                </StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Reason" />
                    <ui:TextBox MinWidth="180"
                                Width="220"
                                PlaceholderText="Recorded with the action"
                                Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                AutomationProperties.Name="Reason"
                                AutomationProperties.HelpText="Sent as --reason with block and allow." />
                </StackPanel>
                <ui:Button Content="Add MCP server…"
                           Command="{Binding ToggleSetFormCommand}"
                           IsEnabled="{Binding IsIdle}"
                           ToolTip="Register or update a server with 'defenseclaw mcp set'. You review the command first.">
                    <ui:Button.Icon>
                        <ctl:DcSymbolIcon Symbol="PlugConnected24" />
                    </ui:Button.Icon>
                </ui:Button>
            </WrapPanel>
        </Border>

        <!-- Add / update an MCP server (mcp set) -->
        <Border Grid.Row="2"
                Style="{StaticResource DcCard}"
                Margin="{StaticResource DcCardGap}"
                Visibility="{Binding IsSetFormOpen, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <ctl:DcCardHeader Symbol="PlugConnected24" Section="Govern" Content="Add or update an MCP server" />
                <TextBlock Style="{StaticResource DcCaption}"
                           Text="Runs 'defenseclaw mcp set'. Give either a command (a local server) or a URL (a remote server), not both. The scope is the connector chosen in the toolbar; 'All configured connectors' writes to every one. You review the exact command before anything runs." />

                <WrapPanel Margin="0,12,0,0">
                    <StackPanel Width="280" Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="Name (required)" />
                        <ui:TextBox Text="{Binding SetName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Server name" />
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="Transport" />
                        <ComboBox HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding TransportChoices}"
                                  SelectedItem="{Binding SetTransport, Mode=TwoWay}"
                                  AutomationProperties.Name="Transport"
                                  AutomationProperties.HelpText="stdio runs a local command, sse connects to a URL. Leave it on infer to send no --transport." />
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="Command (local server, e.g. npx or uvx)" />
                        <ui:TextBox Text="{Binding SetCommand, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Command" />
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="URL (remote server, http or https)" />
                        <ui:TextBox Text="{Binding SetUrl, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="URL" />
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="Arguments (one per line, or a JSON array)" />
                        <ui:TextBox AcceptsReturn="True"
                                    MinLines="3"
                                    MaxLines="6"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    Text="{Binding SetArgs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Command arguments"
                                    AutomationProperties.HelpText="One argument per line; sent to the CLI as a JSON array, so commas inside an argument are safe. Only for a command, not a URL." />
                    </StackPanel>
                    <StackPanel Width="280" Margin="0,0,12,8">
                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="Environment (one KEY=VAL per line)" />
                        <ui:TextBox AcceptsReturn="True"
                                    MinLines="3"
                                    MaxLines="6"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto"
                                    HorizontalScrollBarVisibility="Auto"
                                    Text="{Binding SetEnv, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Environment variables"
                                    AutomationProperties.HelpText="Sent as one --env flag per line. Values are visible in the confirm box, Activity and to other processes: no secrets." />
                    </StackPanel>
                </WrapPanel>

                <TextBlock Style="{StaticResource DcCaption}"
                           Text="Environment values are placed on the command line: they show in the review, in Activity and to other processes on this machine. Do not put secrets here." />

                <CheckBox Margin="0,8,0,0"
                          Content="Skip the security scan (the server is added unchecked)"
                          IsChecked="{Binding SetSkipScan, Mode=TwoWay}" />

                <TextBlock Style="{StaticResource DcToneText}"
                           Tag="Bad"
                           Margin="0,10,0,0"
                           TextWrapping="Wrap"
                           Text="{Binding SetFormError}"
                           Visibility="{Binding HasSetFormError, Converter={StaticResource BoolToVisibility}}"
                           AutomationProperties.LiveSetting="Assertive" />

                <StackPanel Margin="0,12,0,0"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <ui:Button Margin="0,0,8,0"
                               Content="Cancel"
                               Icon="{ctl:DcSymbolIcon Dismiss24}"
                               Command="{Binding ToggleSetFormCommand}" />
                    <ui:Button Appearance="Primary"
                               Content="Review command"
                               Icon="{ctl:DcSymbolIcon ClipboardCheckmark24}"
                               Command="{Binding SubmitSetFormCommand}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- Result of the last action, result of a read-only command, and a stale-data warning -->
        <StackPanel Grid.Row="3">
            <ui:InfoBar Margin="{StaticResource DcCardGap}"
                        Title="{Binding ResultTitle}"
                        Message="{Binding ResultMessage}"
                        Severity="{Binding ResultSeverity}"
                        IsOpen="{Binding IsResultOpen, Mode=TwoWay}"
                        IsClosable="True"
                        AutomationProperties.LiveSetting="Polite" />
            <govern:GovernOutputCard />
            <ui:InfoBar Margin="{StaticResource DcCardGap}"
                        Title="Showing an older read"
                        Message="{Binding RefreshWarning}"
                        Severity="Warning"
                        IsOpen="{Binding HasRefreshWarning, Mode=OneWay}"
                        IsClosable="False"
                        AutomationProperties.LiveSetting="Polite" />
        </StackPanel>

        <TextBlock Grid.Row="4"
                   Style="{StaticResource DcCaption}"
                   Margin="{StaticResource DcCardGap}"
                   Text="{Binding CaptionText}" />

        <!-- Content: exactly one of these is visible -->
        <Grid Grid.Row="5">
            <!--
                Everything but the list scrolls as one block: the empty and error cards carry a paragraph of
                explanation, and in a short window the row they sit in is smaller than the card, which used to
                clip it (an empty card, or a sentence cut mid-line). MinHeight = the viewport keeps the loading
                spinner centred when there is room. The list below has its own scroller and sits on top.
            -->
            <ScrollViewer Style="{StaticResource DcPageScroll}" Focusable="False">
                <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                    <StackPanel Style="{StaticResource DcEmptyState}"
                                Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
                        <ui:ProgressRing Width="32"
                                         Height="32"
                                         IsIndeterminate="True"
                                         AutomationProperties.Name="Reading MCP servers" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Reading MCP servers from the CLI…" />
                    </StackPanel>

                    <Border Style="{StaticResource DcCard}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowCliMissing, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                            <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DcCard}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                            <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Press Refresh to try again. The command and its output are in Activity." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DcCard}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                            <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="PlugConnected24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource DcCard}"
                            VerticalAlignment="Top"
                            Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Style="{StaticResource DcEmptyState}">
                            <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Search24" />
                            <TextBlock Style="{StaticResource DcEmptyTitle}" Text="No MCP servers match the filter" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}" Text="The filter hides every server the CLI listed. Clear it to see them all." />
                            <ui:Button Margin="0,12,0,0"
                                       HorizontalAlignment="Center"
                                       Content="Clear filter"
                                       Icon="{ctl:DcSymbolIcon FilterDismiss24}"
                                       Command="{Binding ClearFilterCommand}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>

            <ItemsControl AutomationProperties.Name="MCP servers"
                          ItemsSource="{Binding Rows}"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Standard"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer Style="{StaticResource DcPageScroll}"
                                      CanContentScroll="True"
                                      Focusable="False">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <govern:GovernRowView />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <!-- Review dialog for every state-changing command -->
        <govern:GovernConfirmOverlay Grid.Row="0" Grid.RowSpan="6" />
    </Grid>
</UserControl>
