<UserControl x:Class="DefenseClaw.App.Views.Panels.InventoryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             xmlns:govern="clr-namespace:DefenseClaw.App.Views.Panels.Govern"
             d:DataContext="{d:DesignInstance Type=vm:InventoryPanelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <!--
        Migrated to the shared design system (Themes\DefenseClaw.xaml); the local styles below are the components
        grid's cell text and the narrow/wide switch of its master-detail block.

        Two views share the page (the segmented control at the top of the strip): Components, the AI components inventory.db
        recorded, and AI BOM, what a reviewed aibom scan printed as JSON, browsed as the TUI's Inventory panel does (Summary and
        a table per kind with a detail pane). They take turns in the same master-detail block, so the sizing below serves both:
        the components grid or BomGrid in the master card, ComponentsDetail or BomDetail in the detail card.

        Layout. At the window's 940 x 620 DIP minimum the page has ~663 x 498 DIP to itself (sidebar, title bar
        and status strip take the rest), which is less than the toolbar, the scan note, the grid and the table
        browser add up to. So the header stays put and everything under it is one scrolling page (PageScroll).
        A ScrollViewer measures its content with unlimited height, and a DataGrid measured that way realizes
        every row - so nothing here is star-sized inside the scroller. Instead the code-behind gives the
        components block a definite height (whatever is left of the viewport under the toolbar and banners, and
        never less than 300) and the table browser keeps its fixed 320: each grid still gets a bounded viewport
        and virtualizes on its own. The page scrolls only when the pieces do not fit.
    -->
    <UserControl.Resources>
        <!-- Cell text: DcCellText - trimmed with an ellipsis, the full value in a tooltip only while it is actually trimmed. -->

        <!--
            Narrow layout (the code-behind sets the block's Tag to "Narrow" below ~860 DIPs of block width): the
            grid takes the full width and the raw-row detail drops underneath it, so the six columns that matter
            (vendor, name, ecosystem, framework, version, installs) all fit at the minimum window width instead
            of sharing it with a 260 DIP side pane.
        -->
        <Style x:Key="InventoryMasterCard" TargetType="Border" BasedOn="{StaticResource DcCardFlush}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=MasterDetail}" Value="Narrow">
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The wide position is a style setter, not a local Grid.Column: a local value would beat the narrow trigger. -->
        <Style x:Key="InventoryDetailCard" TargetType="Border" BasedOn="{StaticResource DcCardCompact}">
            <Setter Property="Grid.Column" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, ElementName=MasterDetail}" Value="Narrow">
                    <Setter Property="Grid.Row" Value="1" />
                    <Setter Property="Grid.Column" Value="0" />
                    <Setter Property="Grid.ColumnSpan" Value="3" />
                    <Setter Property="Height" Value="220" />
                    <Setter Property="Margin" Value="0,12,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--
            The components grid is one of two things the master card shows: the AI BOM view takes its place. The visibility is in the style
            (a local Visibility would beat a trigger), and the grid stays where it is in the tree.
        -->
        <Style x:Key="InventoryComponentsGrid" TargetType="{x:Type ui:DataGrid}" BasedOn="{StaticResource DcDataGrid}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding UsingFallbackView}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBomView}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The table browser reads inventory.db: it is there when the database is and the Components view is on. -->
        <Style x:Key="InventoryTableBrowser" TargetType="{x:Type ui:CardExpander}" BasedOn="{StaticResource {x:Type ui:CardExpander}}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasDatabase}" Value="False">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBomView}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The AI BOM grid's Verdict column: the policy verdict as a state pill, a dash for a row nothing evaluated. -->
        <DataTemplate x:Key="BomVerdictCell">
            <Grid>
                <ctl:DcStatePill HorizontalAlignment="Left"
                                 Text="{Binding Verdict}"
                                 Tone="{Binding VerdictTone}"
                                 Visibility="{Binding HasVerdict, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock Text="—">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource DcCaption}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasVerdict}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>

        <!--
            A scan-scope chip. ON: a check mark and the selected fill. OFF: the outline alone, dim text. State is never colour alone - the check mark and
            the outline carry it.
        -->
        <Style x:Key="BomScopeChip" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="FocusVisualStyle" Value="{DynamicResource DcFocusVisualStyle}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Chip"
                                Padding="9,3,9,3"
                                CornerRadius="{DynamicResource DcRadiusS}"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource DcControlBorderBrush}"
                                Background="Transparent">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="Mark"
                                           Margin="0,0,5,0"
                                           VerticalAlignment="Center"
                                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="12"
                                           Opacity="0"
                                           Text="&#xE73E;" />
                                <TextBlock x:Name="Label"
                                           VerticalAlignment="Center"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource DcTextSecondaryBrush}"
                                           Text="{TemplateBinding Content}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DcSubtleBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Chip" Property="Background" Value="{DynamicResource DcSelectedBrush}" />
                                <Setter TargetName="Mark" Property="Opacity" Value="1" />
                                <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource DcTextPrimaryBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the scan status, the page actions as icons (Generate AI BOM uses the connector and the scope picked in the strips below), the search. -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="BookDatabase24"
                           ctl:DcIcon.Section="Discover"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           Caption="{Binding ToolbarCaption}"
                           HasSearch="True"
                           SearchText="{Binding SearchText}"
                           SearchWidth="280"
                           SearchPlaceholder="{Binding SearchPlaceholder}"
                           SearchAutomationName="{Binding SearchAutomationName}"
                           SearchHelpText="{Binding SearchHelp}">
            <ctl:DcPageToolbar.ConnectorSlot>
                <ctl:DcConnectorScopeChip Model="{Binding ConnectorChip}" />
            </ctl:DcPageToolbar.ConnectorSlot>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <!-- AI BOM view only: the output of the last Generate, as the CLI printed it. -->
                    <ui:Button Icon="{ctl:DcSymbolIcon Save24}"
                               Command="{Binding SaveBomCommand}"
                               IsEnabled="{Binding CanSaveBom}"
                               Visibility="{Binding IsBomView, Converter={StaticResource BoolToVisibility}}"
                               ToolTip="Save the AI BOM as JSON… (the output of aibom scan --json). It lists your connectors' skills, plugins and MCP servers, so share it with care."
                               AutomationProperties.Name="Save AI BOM JSON…"
                               AutomationProperties.HelpText="Save the generated AI BOM to a file you choose." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ClipboardTaskListLtr24}"
                               Command="{Binding GenerateAiBomCommand}"
                               ToolTipService.ShowOnDisabled="True"
                               ToolTip="{Binding InstallationBlockedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Generate AI BOM… defenseclaw aibom scan --json: inventories the skills, plugins, MCP servers, agents, tools, models and memory of the connector chosen under AI BOM and the categories under Scope. Records a scan event in audit.db, so it asks first.'}"
                               AutomationProperties.Name="Generate AI BOM…"
                               AutomationProperties.HelpText="Builds an AI bill of materials for the connector chosen under AI BOM and the categories under Scope. Records a scan event, so it shows the exact command first." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Re-read inventory.db (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5"
                               AutomationProperties.HelpText="Re-read inventory.db (F5)." />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      Style="{StaticResource DcPageScroll}"
                      AutomationProperties.Name="Inventory page">
            <StackPanel x:Name="PageContent">
                <!-- Toolbar, banners and the generated AI BOM: measured by the code-behind to size the grid under them. -->
                <StackPanel x:Name="Chrome">
                    <!--
                        Filter strip: which of the page's two views shows - the AI components inventory.db recorded, or the AI BOM a scan of the
                        connectors' own configuration printed - how the rollup is grouped, which connector the AI BOM is generated for, and (AI BOM
                        view) the TUI's two scope shortcuts.
                    -->
                    <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                        <ctl:DcSegmented x:Name="ViewSwitch"
                                         SelectedValue="{Binding ActiveView, Mode=TwoWay}"
                                         AutomationProperties.Name="Inventory view"
                                         AutomationProperties.HelpText="Components lists the AI components inventory.db recorded. AI BOM lists what a scan of your connectors' own configuration printed: skills, plugins, MCP servers, agents, tools, models and memory.">
                            <ctl:DcSegment Value="components"
                                           Content="Components"
                                           ToolTip="The AI components in the latest full scan in inventory.db" />
                            <ctl:DcSegment Value="bom"
                                           Content="AI BOM"
                                           ToolTip="The AI bill of materials a scan of your connectors' own configuration printed" />
                        </ctl:DcSegmented>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsComponentsView, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Group by" />
                            <ComboBox Width="110"
                                      AutomationProperties.Name="Group by"
                                      ItemsSource="{Binding GroupByOptions}"
                                      SelectedItem="{Binding GroupBy}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="AI BOM" />
                            <ComboBox Width="220"
                                      AutomationProperties.Name="Connector for the AI BOM"
                                      ItemsSource="{Binding BomConnectors}"
                                      SelectedItem="{Binding SelectedBomConnector}" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding IsBomView, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="{Binding BomBrowser.ScopeLabel}" />
                            <ui:Button Content="All scope"
                                       Appearance="Secondary"
                                       Command="{Binding BomBrowser.ShowAllScopeCommand}"
                                       ToolTip="Scan every category (aibom scan with no --only)"
                                       AutomationProperties.Name="Scan every category" />
                            <ui:Button Content="Fast"
                                       Appearance="Secondary"
                                       Command="{Binding BomBrowser.ShowFastScopeCommand}"
                                       ToolTip="Scan skills, plugins and MCP servers only (aibom scan --only skills,plugins,mcp)"
                                       AutomationProperties.Name="Scan skills, plugins and MCP servers only" />
                        </StackPanel>
                    </WrapPanel>

                    <!-- The AI BOM view: the categories the next scan covers (the only list of aibom scan), as the TUI's scope chips. -->
                    <ItemsControl Margin="0,0,0,4"
                                  Focusable="False"
                                  AutomationProperties.Name="Categories to scan"
                                  ItemsSource="{Binding BomBrowser.ScopeChips}"
                                  Visibility="{Binding IsBomView, Converter={StaticResource BoolToVisibility}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Style="{StaticResource BomScopeChip}"
                                              Content="{Binding Label}"
                                              IsChecked="{Binding IsActive, Mode=TwoWay}"
                                              AutomationProperties.Name="{Binding AutomationName}"
                                              AutomationProperties.HelpText="Include or leave out this category when the AI BOM is generated." />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Banners and the generated AI BOM -->
                    <StackPanel Visibility="{Binding IsComponentsView, Converter={StaticResource BoolToVisibility}}">
                        <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                    Title="inventory.db"
                                    IsClosable="False"
                                    IsOpen="{Binding HasError}"
                                    Message="{Binding ErrorMessage}"
                                    Severity="Warning" />

                        <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                    Title="Where these numbers come from"
                                    IsClosable="False"
                                    IsOpen="{Binding HasScanNote}"
                                    Message="{Binding ScanNote}"
                                    Severity="Informational" />

                        <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                    Title="No component rollup for this inventory.db"
                                    IsClosable="False"
                                    IsOpen="{Binding UsingFallbackView}"
                                    Message="This inventory.db does not have the scan tables the rollup is built from (ai_scans, ai_signals and ai_confidence_snapshots, with their scan_id columns), so there is nothing to group. Use the table browser at the bottom to inspect whatever tables this install does have."
                                    Severity="Informational" />

                    </StackPanel>

                    <!--
                        The AI BOM view's chrome: how the last run came out, what it could not read, and the tabs. A run that came to nothing (it did not
                        finish, its output was too large or not JSON) has its sentence in a bar, because it is the only thing on the page to read.
                    -->
                    <StackPanel Visibility="{Binding IsBomView, Converter={StaticResource BoolToVisibility}}">
                        <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                    Title="AI BOM"
                                    IsClosable="False"
                                    IsOpen="{Binding BomFailed, Mode=OneWay}"
                                    Message="{Binding BomStatus}"
                                    Severity="Warning" />

                        <TextBlock Margin="0,0,0,8"
                                   Style="{StaticResource DcCaption}"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="{Binding BomStatus}"
                                   Visibility="{Binding BomBrowser.HasSnapshot, Converter={StaticResource BoolToVisibility}}" />

                        <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                    Title="Not everything came through"
                                    IsClosable="False"
                                    IsOpen="{Binding HasBomWarning, Mode=OneWay}"
                                    Message="{Binding BomWarning}"
                                    Severity="Warning" />

                        <!--
                            The TUI's Inventory sub-tabs. Eight of them are wider than the narrowest page, so they wrap; the counts are the rows under
                            the connector scope. Tools is there only when some connector listed a tool.
                        -->
                        <ctl:DcSegmented x:Name="BomTabs"
                                         Margin="0,0,0,8"
                                         SelectedValue="{Binding BomBrowser.ActiveTab, Mode=TwoWay}"
                                         AutomationProperties.Name="AI BOM tab"
                                         AutomationProperties.HelpText="Summary, then one list per kind of thing the scan inventoried.">
                            <ctl:DcSegmented.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ctl:DcSegmented.ItemsPanel>
                            <ctl:DcSegment Value="summary" Padding="10,0,10,0" Content="Summary" />
                            <ctl:DcSegment Value="skills" Padding="10,0,10,0" Content="Skills" Count="{Binding BomBrowser.SkillsCount}" />
                            <ctl:DcSegment Value="plugins" Padding="10,0,10,0" Content="Plugins" Count="{Binding BomBrowser.PluginsCount}" />
                            <ctl:DcSegment Value="mcp" Padding="10,0,10,0" Content="MCPs" Count="{Binding BomBrowser.McpCount}" />
                            <ctl:DcSegment Value="agents" Padding="10,0,10,0" Content="Agents" Count="{Binding BomBrowser.AgentsCount}" />
                            <ctl:DcSegment Value="tools"
                                           Padding="10,0,10,0"
                                           Content="Tools"
                                           Count="{Binding BomBrowser.ToolsCount}"
                                           IsEnabled="{Binding BomBrowser.ShowToolsTab}"
                                           Visibility="{Binding BomBrowser.ShowToolsTab, Converter={StaticResource BoolToVisibility}}" />
                            <ctl:DcSegment Value="models" Padding="10,0,10,0" Content="Models" Count="{Binding BomBrowser.ModelsCount}" />
                            <ctl:DcSegment Value="memory" Padding="10,0,10,0" Content="Memory" Count="{Binding BomBrowser.MemoryCount}" />
                        </ctl:DcSegmented>

                        <!-- The TUI's 2 / 3 / 4 keys on Skills and Plugins; the count of what the tab shows. -->
                        <WrapPanel Margin="0,0,0,4"
                                   Style="{StaticResource DcToolbarPanel}"
                                   Visibility="{Binding BomBrowser.HasFilterRow, Converter={StaticResource BoolToVisibility}}">
                            <ctl:DcSegmented SelectedValue="{Binding BomBrowser.StatusFilter, Mode=TwoWay}"
                                             AutomationProperties.Name="Skills filter"
                                             Visibility="{Binding BomBrowser.IsSkillsTab, Converter={StaticResource BoolToVisibility}}">
                                <ctl:DcSegment Value="all" Content="All" />
                                <ctl:DcSegment Value="eligible" Content="Eligible" ToolTip="Skills the agent can load" />
                                <ctl:DcSegment Value="warning" Content="Warning" ToolTip="Skills with a warning verdict" />
                                <ctl:DcSegment Value="blocked" Content="Blocked" ToolTip="Skills on the block list or rejected by a scan" />
                            </ctl:DcSegmented>
                            <ctl:DcSegmented SelectedValue="{Binding BomBrowser.StatusFilter, Mode=TwoWay}"
                                             AutomationProperties.Name="Plugins filter"
                                             Visibility="{Binding BomBrowser.IsPluginsTab, Converter={StaticResource BoolToVisibility}}">
                                <ctl:DcSegment Value="all" Content="All" />
                                <ctl:DcSegment Value="loaded" Content="Loaded" ToolTip="Plugins whose status is loaded" />
                                <ctl:DcSegment Value="disabled" Content="Disabled" ToolTip="Plugins whose status is disabled" />
                                <ctl:DcSegment Value="blocked" Content="Blocked" ToolTip="Plugins on the block list or rejected by a scan" />
                            </ctl:DcSegmented>
                            <TextBlock Style="{StaticResource DcResultCaption}"
                                       Margin="0,0,12,8"
                                       VerticalAlignment="Center"
                                       AutomationProperties.LiveSetting="Polite"
                                       Text="{Binding BomBrowser.ResultCaption}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>

                <!--
                    Main content: grid + detail pane. Row 0's height is set in code (see UpdateLayoutSizes) so the
                    grid inside always has a definite, bounded height; row 1 is the detail pane when the block is
                    narrow and empty (zero high) when it is wide.
                -->
                <Grid x:Name="MasterDetail" Tag="Wide">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="MasterRow" Height="300" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2.2*" />
                        <ColumnDefinition Width="{StaticResource DcColumnGap}" />
                        <ColumnDefinition Width="1*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource InventoryMasterCard}">
                        <Grid>
                            <!--
                                Column widths are star weights with a floor (MinWidth) each, resolved to plain widths by
                                the code-behind (ApplyColumnWidths / ColumnSizing): a wide grid shares its width between
                                the columns (no dead space at the right edge); a narrow one gives the first six columns -
                                vendor to installs - the whole width and scrolls sideways to identity, presence and last
                                seen, instead of squeezing all nine. The DataGrid's own star sizing is not used because
                                it goes stale when the grid starts empty, which this one always does.

                                Virtualization needs both CanContentScroll (WPF-UI's DataGrid style leaves it off, which
                                makes the grid measure - and realize - every row) and VirtualizingWhenGrouping (WPF turns
                                virtualization off for grouped items unless it is asked for).
                            -->
                            <ui:DataGrid x:Name="ComponentsGrid"
                                         Style="{StaticResource InventoryComponentsGrid}"
                                         SelectionMode="Single"
                                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                         Sorting="OnComponentsSorting"
                                         AutomationProperties.Name="AI components in the latest scan"
                                         ItemsSource="{Binding ComponentsView}"
                                         SelectedItem="{Binding SelectedComponent}">
                                <ui:DataGrid.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock Style="{StaticResource DcBody}"
                                                           Margin="6,10,0,4"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Name, StringFormat='{}{0}'}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ui:DataGrid.GroupStyle>
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn Width="1.3*" MinWidth="110" Header="Vendor"
                                                        SortMemberPath="VendorDisplay"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding VendorDisplay}" />
                                    <DataGridTextColumn Width="2.2*" MinWidth="140" Header="Name"
                                                        SortMemberPath="Name"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding Name}" />
                                    <DataGridTextColumn Width="0.8*" MinWidth="100" Header="Ecosystem"
                                                        SortMemberPath="EcosystemDisplay"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding EcosystemDisplay}" />
                                    <DataGridTextColumn Width="1.2*" MinWidth="104" Header="Framework"
                                                        SortMemberPath="Framework"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding Framework}" />
                                    <DataGridTextColumn Width="0.7*" MinWidth="80" Header="Version"
                                                        SortMemberPath="Version"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding Version}" />
                                    <DataGridTextColumn Width="0.5*" MinWidth="80" Header="Installs"
                                                        SortMemberPath="InstallCount"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding InstallCountDisplay}" />
                                    <DataGridTextColumn Width="1.1*" MinWidth="112" Header="Identity"
                                                        SortMemberPath="IdentityScore"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding IdentityDisplay}" />
                                    <DataGridTextColumn Width="1.1*" MinWidth="112" Header="Presence"
                                                        SortMemberPath="PresenceScore"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding PresenceDisplay}" />
                                    <DataGridTextColumn Width="1.2*" MinWidth="140" Header="Last seen"
                                                        SortMemberPath="LastSeen"
                                                        ElementStyle="{StaticResource DcCellText}"
                                                        Binding="{Binding LastSeenDisplay}" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>

                            <!-- Why the grid is empty: no database yet / no rollup / nothing found / search hides all -->
                            <Grid Visibility="{Binding IsComponentsView, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Style="{StaticResource DcEmptyState}"
                                            MaxWidth="440"
                                            Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolToVisibility}}">
                                    <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Database24" />
                                    <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                                    <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                                </StackPanel>

                                <ui:ProgressRing IsIndeterminate="True"
                                                 Width="32"
                                                 Height="32"
                                                 AutomationProperties.Name="Reading inventory.db"
                                                 Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <!--
                                The AI BOM view's table: Summary (Metric, Value) or one kind's rows. Its columns are the TUI's for the tab, built by the
                                code-behind when the tab (or the Connector column) changes, and sized the way the components grid's are (ColumnSizing).
                                Rows are in the order the CLI printed them.
                            -->
                            <ui:DataGrid x:Name="BomGrid"
                                         Style="{StaticResource DcDataGrid}"
                                         AutoGenerateColumns="False"
                                         CanUserSortColumns="False"
                                         SelectionMode="Single"
                                         AutomationProperties.Name="AI BOM rows"
                                         AutomationProperties.HelpText="The rows of the tab chosen above. Select one for its fields."
                                         ItemsSource="{Binding BomBrowser.Rows}"
                                         SelectedItem="{Binding BomBrowser.SelectedRow, Mode=TwoWay}"
                                         Visibility="{Binding IsBomView, Converter={StaticResource BoolToVisibility}}" />

                            <!-- Why the table is empty: no AI BOM yet, none for this connector, a category not collected, nothing found, a filter or search that hides all. -->
                            <Grid Visibility="{Binding IsBomView, Converter={StaticResource BoolToVisibility}}">
                                <StackPanel Style="{StaticResource DcEmptyState}"
                                            MaxWidth="440"
                                            Visibility="{Binding BomBrowser.ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                                    <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ClipboardTaskListLtr24" />
                                    <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding BomBrowser.EmptyTitle}" />
                                    <TextBlock Style="{StaticResource DcEmptyDetail}"
                                               Text="{Binding BomBrowser.EmptyDetail}"
                                               Visibility="{Binding BomBrowser.HasEmptyDetail, Converter={StaticResource BoolToVisibility}}" />
                                    <ui:Button Margin="0,12,0,0"
                                               HorizontalAlignment="Center"
                                               Content="Generate AI BOM…"
                                               Icon="{ctl:DcSymbolIcon ClipboardTaskListLtr24}"
                                               Command="{Binding GenerateAiBomCommand}"
                                               Visibility="{Binding BomBrowser.ShowGenerate, Converter={StaticResource BoolToVisibility}}"
                                               ToolTipService.ShowOnDisabled="True"
                                               ToolTip="{Binding InstallationBlockedReason, Converter={x:Static govern:ChangeTipConverter.Instance}, ConverterParameter='Generate AI BOM… defenseclaw aibom scan --json for the connector chosen under AI BOM and the categories under Scope. Records a scan event in audit.db, so it asks first.'}"
                                               AutomationProperties.HelpText="Builds an AI bill of materials. Records a scan event, so it shows the exact command first." />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="DetailCard" Style="{StaticResource InventoryDetailCard}">
                        <Grid>
                            <!-- Components view: every column of the selected component. -->
                            <Grid x:Name="ComponentsDetail" Visibility="{Binding IsComponentsView, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ctl:DcCardHeader Grid.Row="0" Symbol="Code24" Section="Discover" Content="Raw row detail" />

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding DetailRows}"
                                                  Focusable="False"
                                                  AutomationProperties.Name="Every column of the selected component">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Style="{StaticResource DcField}">
                                                    <TextBlock Style="{StaticResource DcFieldLabel}" Text="{Binding Key}" />
                                                    <TextBlock Style="{StaticResource DcFieldValueMono}" Text="{Binding Value}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <TextBlock Grid.Row="1"
                                           Style="{StaticResource DcEmptyDetail}"
                                           VerticalAlignment="Center"
                                           Text="Select a row to see every column."
                                           Visibility="{Binding NoComponentSelected, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>

                            <!--
                                AI BOM view: the TUI's detail fields of the selected row, in its order, then what else the scan said about it (a newer
                                runtime's additions appear here by presence). On the Summary tab: the scan's coverage notes.
                            -->
                            <Grid x:Name="BomDetail" Visibility="{Binding IsBomView, Converter={StaticResource BoolToVisibility}}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <ctl:DcCardHeader Grid.Row="0" Symbol="Code24" Section="Discover" Content="{Binding BomBrowser.DetailHeading}" />

                                <ScrollViewer Grid.Row="1"
                                              VerticalScrollBarVisibility="Auto"
                                              Visibility="{Binding BomBrowser.HasDetail, Converter={StaticResource BoolToVisibility}}">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding BomBrowser.DetailFields}"
                                                      Focusable="False"
                                                      AutomationProperties.Name="Fields of the selected AI BOM row">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Style="{StaticResource DcField}">
                                                        <TextBlock Style="{StaticResource DcFieldLabel}" Text="{Binding Key}" />
                                                        <TextBlock Style="{StaticResource DcFieldValueMono}" Text="{Binding Value}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Visibility="{Binding BomBrowser.HasMore, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource DcCardTitle}"
                                                       Margin="0,6,0,8"
                                                       Text="Also in this scan" />
                                            <ItemsControl ItemsSource="{Binding BomBrowser.DetailMore}"
                                                          Focusable="False"
                                                          AutomationProperties.Name="Other fields the scan listed for the selected AI BOM row">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Style="{StaticResource DcField}">
                                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="{Binding Key}" />
                                                            <TextBlock Style="{StaticResource DcFieldValueMono}" Text="{Binding Value}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <TextBlock Grid.Row="1"
                                           Style="{StaticResource DcEmptyDetail}"
                                           VerticalAlignment="Center"
                                           Text="{Binding BomBrowser.DetailEmptyText}"
                                           Visibility="{Binding BomBrowser.ShowDetailEmpty, Converter={StaticResource BoolToVisibility}}" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Table browser: power-user access to every other table/view InventoryReader discovers -->
                <ui:CardExpander x:Name="TableBrowser"
                                 Style="{StaticResource InventoryTableBrowser}"
                                 Margin="0,12,0,0"
                                 Header="Table browser (all tables in inventory.db)">
                    <Grid Margin="0,10,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="320" />
                        </Grid.RowDefinitions>

                        <WrapPanel Grid.Row="0" Style="{StaticResource DcToolbarPanel}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Table or view" />
                                <ComboBox Width="240"
                                          AutomationProperties.Name="Table or view to browse"
                                          ItemsSource="{Binding Tables}"
                                          SelectedItem="{Binding SelectedTable}"
                                          DisplayMemberPath="Name" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="{Binding SelectedTable.Summary, Mode=OneWay}" />
                        </WrapPanel>

                        <!-- Cost warning for a selected view, with the explicit "load anyway" (ai_components_v aggregates every scan: 15-20 s). -->
                        <StackPanel Grid.Row="1">
                            <ui:InfoBar Margin="{StaticResource DcCardGap}"
                                        Title="Slow to open"
                                        IsClosable="False"
                                        IsOpen="{Binding HasTableBrowserNote}"
                                        Message="{Binding TableBrowserNote}"
                                        Severity="Warning" />
                            <ui:Button Margin="{StaticResource DcCardGap}"
                                       HorizontalAlignment="Left"
                                       Content="Load this view anyway"
                                       Icon="{ctl:DcSymbolIcon ArrowSync24}"
                                       Command="{Binding LoadSelectedViewCommand}"
                                       Visibility="{Binding IsViewLoadPending, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <ui:InfoBar Grid.Row="2"
                                    Margin="{StaticResource DcCardGap}"
                                    Title="Could not browse table"
                                    IsClosable="False"
                                    IsOpen="{Binding HasTableBrowserError}"
                                    Message="{Binding TableBrowserError}"
                                    Severity="Warning" />

                        <Grid Grid.Row="3">
                            <ui:DataGrid x:Name="BrowserGrid"
                                         Style="{StaticResource DcDataGrid}"
                                         AutoGenerateColumns="True"
                                         AutomationProperties.Name="Rows of the selected table"
                                         ItemsSource="{Binding BrowsedRows}" />
                            <ui:ProgressRing IsIndeterminate="True"
                                             Width="28"
                                             Height="28"
                                             AutomationProperties.Name="Loading the table"
                                             Visibility="{Binding IsTableLoading, Converter={StaticResource BoolToVisibility}}" />
                            <TextBlock Style="{StaticResource DcEmptyDetail}"
                                       VerticalAlignment="Center"
                                       Text="Pick a table above to browse its rows."
                                       Visibility="{Binding NoTableSelected, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                    </Grid>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <!-- Confirm-and-run dialog (collapsed until a change is requested) -->
        <panels:DiscoverReviewOverlay Grid.RowSpan="5" DataContext="{Binding Review}" />
    </Grid>
</UserControl>
