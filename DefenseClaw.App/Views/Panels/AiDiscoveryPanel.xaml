<UserControl x:Class="DefenseClaw.App.Views.Panels.AiDiscoveryPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             d:DataContext="{d:DesignInstance Type=vm:AiDiscoveryPanelViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             panels:CompactLayout.Below="960">
    <!--
        Migrated to the shared design system (Themes\DefenseClaw.xaml); the only local styles are the page's placement beside the
        inspector and two data templates shared by the cards and the inspector.
        Order is deliberate: coverage first (what was looked at, and when), then what was found (the latest scan's counts, a Products |
        Models switch, and the list it picks), then the runtime section, then where the data came from.

        Products are the cards. Models are a table with a flush inspector (ctl:DcInspector) that exists only while a model is selected:
        with none the page takes the whole width, with one the two split, and on a narrow panel (CompactLayout, under 960 px) the
        inspector replaces the page until it is closed (Esc, or its X). Everything the data does not carry is left out - the Modality,
        Relevance and Owners columns and the filters on them when no model has one, the Show all models switch when the runtime does not
        classify its models, the Provenance block of a model with no lineage, an identity or presence band on a card whose components have
        none, a runtime line on a signal that has no process - so a DefenseClaw 0.8.10 install gets exactly what its files and database hold.
    -->
    <UserControl.Resources>
        <!-- The page: the whole width until a model is selected; then it makes room for the inspector, or, on a narrow panel, steps aside. -->
        <Style x:Key="AiPageScroll" TargetType="ScrollViewer" BasedOn="{StaticResource DcPageScroll}">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.ColumnSpan" Value="2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasModelSelection}" Value="True">
                    <Setter Property="Grid.ColumnSpan" Value="1" />
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding HasModelSelection}" Value="True" />
                        <Condition Binding="{Binding Path=(panels:CompactLayout.IsCompact), RelativeSource={RelativeSource Self}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Collapsed" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>

        <!-- One signal as a block: its state, its name and the scanner's confidence, then its detector, model, process and activity lines (those it has). -->
        <DataTemplate x:Key="DiscoverySignalTemplate">
            <StackPanel Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal">
                    <ctl:DcStatePill Margin="0,0,8,0"
                                     VerticalAlignment="Center"
                                     Text="{Binding StateText}"
                                     Tone="{Binding StateKey}"
                                     Visibility="{Binding HasState, Converter={StaticResource BoolToVisibility}}" />
                    <TextBlock Style="{StaticResource DcBody}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource DcCaption}"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding ConfidenceText}"
                               Visibility="{Binding HasConfidence, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
                <TextBlock Style="{StaticResource DcMono}"
                           Margin="0,2,0,0"
                           Text="{Binding DetailText}"
                           Visibility="{Binding HasDetail, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- A label and its value (the inspector's facts): one shared key column. -->
        <DataTemplate x:Key="DiscoveryFactTemplate">
            <Grid Margin="0,0,0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource DcCaption}" Margin="0,0,10,0" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Style="{StaticResource DcBody}" Text="{Binding Value}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar. No search box up here: this page is a stack of cards with the component list in the middle of it, so the filter stays
             over the list it filters (a filter box in the toolbar would change rows far below the fold). -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="Bot24"
                           ctl:DcIcon.Section="Discover"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           Caption="{Binding StatusMessage}">
            <ctl:DcPageToolbar.ConnectorSlot>
                <ctl:DcConnectorScopeChip Model="{Binding ConnectorChip}" />
            </ctl:DcPageToolbar.ConnectorSlot>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Refresh (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5"
                               AutomationProperties.HelpText="Re-read the discovery files and ask the gateway for its live status (F5)." />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ScrollViewer x:Name="PageScroll" Style="{StaticResource AiPageScroll}">
            <StackPanel>
                <ui:InfoBar Margin="{StaticResource DcCardGap}"
                            Title="AI Discovery"
                            IsClosable="False"
                            IsOpen="{Binding HasError}"
                            Message="{Binding ErrorMessage}"
                            Severity="Warning" />

                <!-- Coverage: what is being looked at, what is not, and what the last scan covered. -->
                <Border Style="{StaticResource DcCard}" Margin="{StaticResource DcCardGap}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ctl:DcCardHeader Symbol="Eye24" Section="Discover" Content="Discovery coverage" />
                            <Border Style="{StaticResource DcBadge}"
                                    Tag="{Binding CoverageBadgeKey}"
                                    Margin="10,0,0,8"
                                    VerticalAlignment="Top">
                                <!-- The status glyph repeats the badge's tone as a shape under Linear and TUI; Default draws none. -->
                                <StackPanel Orientation="Horizontal">
                                    <ctl:DcStatusGlyph Tone="{Binding CoverageBadgeKey}" ShowDot="False" GlyphSize="12" Gap="5" />
                                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding CoverageBadgeText}" />
                                </StackPanel>
                            </Border>
                            <ui:ProgressRing Width="18"
                                             Height="18"
                                             Margin="10,0,0,8"
                                             IsIndeterminate="True"
                                             AutomationProperties.Name="Asking the gateway for its live status"
                                             Visibility="{Binding IsLiveLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>

                        <TextBlock Style="{StaticResource DcBody}" Text="{Binding CoverageHeadline}" />
                        <TextBlock Style="{StaticResource DcTextSecondary}"
                                   Margin="0,6,0,0"
                                   Text="{Binding CoverageLooksAt}" />
                        <TextBlock Style="{StaticResource DcTextSecondary}"
                                   Margin="0,6,0,0"
                                   Text="{Binding CoverageGaps}"
                                   Visibility="{Binding HasCoverageGaps, Converter={StaticResource BoolToVisibility}}" />
                        <TextBlock Style="{StaticResource DcTextSecondary}"
                                   Margin="0,6,0,0"
                                   Text="{Binding CoverageLastScan}" />

                        <ui:InfoBar Margin="0,10,0,0"
                                    IsClosable="False"
                                    IsOpen="{Binding HasCoverageNote}"
                                    Message="{Binding CoverageNote}"
                                    Severity="Warning" />

                        <TextBlock Style="{StaticResource DcCaption}"
                                   Margin="0,10,0,0"
                                   Text="{Binding CoverageCaveatText}" />

                        <WrapPanel Style="{StaticResource DcToolbarPanel}" Margin="0,12,0,0">
                            <ui:Button Appearance="Primary"
                                       Content="Run scan…"
                                       Icon="{ctl:DcSymbolIcon Play24}"
                                       Command="{Binding RunScanCommand}"
                                       ToolTip="defenseclaw agent discovery scan: asks the running gateway for one immediate AI discovery scan, which is what the component cards read."
                                       AutomationProperties.HelpText="Asks the gateway for one immediate AI discovery scan. Shows the exact command first." />
                            <ui:Button Content="{Binding ToggleDiscoveryText}"
                                       Icon="{ctl:DcSymbolIcon Power24}"
                                       Command="{Binding ToggleDiscoveryCommand}"
                                       AutomationProperties.HelpText="Turns the AI discovery service on or off in config.yaml. Shows the exact command first." />
                            <CheckBox Content="Restart the gateway now"
                                      IsChecked="{Binding RestartOnToggle}"
                                      ToolTip="On: turning discovery on or off also restarts the gateway so it takes effect. Off: only config.yaml changes; it applies at the next restart."
                                      AutomationProperties.HelpText="Applies to turning AI Discovery on or off." />
                            <ui:Button Content="Re-detect agents…"
                                       Icon="{ctl:DcSymbolIcon ArrowSync24}"
                                       Command="{Binding RefreshConnectorsCommand}"
                                       ToolTip="defenseclaw agent discover --refresh --no-emit-otel: re-checks which agent CLIs are installed and rewrites the connector table under Sources. Does not change the component cards."
                                       AutomationProperties.HelpText="Re-checks which agent command-line tools are installed. Shows the exact command first." />
                        </WrapPanel>

                        <TextBlock Style="{StaticResource DcCaption}"
                                   Margin="0,4,0,0"
                                   Text="{Binding LastRunSummary}" />
                    </StackPanel>
                </Border>

                <!-- Honesty banner: what confidence means and does not mean -->
                <ui:InfoBar Margin="{StaticResource DcCardGap}"
                            Title="About these confidence numbers"
                            IsClosable="False"
                            IsOpen="True"
                            Severity="Informational"
                            Message="Confidence comes from signature/heuristic matches (process names, config files, MCP registrations, package manifests, environment variable names), not verified installs. A high score does not prove the product is present, and a genuinely running tool can be missed if nothing matched. Evidence is a hashed fingerprint (type, quality, match kind); DefenseClaw does not retain literal file paths." />

                <!-- Components -->
                <TextBlock Style="{StaticResource DcSectionHeader}" Text="Detected components" />

                <!-- The latest scan, as the TUI's header line: how many are active, and how many new, changed or gone, and the files read.
                     Only the counts the source has; the note says whose they are and when. -->
                <ItemsControl Focusable="False"
                              ItemsSource="{Binding HeaderChips}"
                              AutomationProperties.Name="Counts from the latest scan"
                              Visibility="{Binding HasHeader, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- A count, or a key=value diagnostic of the TUI's header (model-lookup=offline), which says what it means when hovered. -->
                            <Border Style="{StaticResource DcBadge}"
                                    Tag="{Binding ToneKey}"
                                    Margin="0,0,8,6"
                                    ToolTip="{Binding Description}"
                                    ToolTipService.IsEnabled="{Binding HasDescription}"
                                    AutomationProperties.Name="{Binding Text}"
                                    AutomationProperties.HelpText="{Binding Description}">
                                <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding Text}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource DcCaption}"
                           Margin="0,0,0,8"
                           Text="{Binding HeaderNote}"
                           Visibility="{Binding HasHeaderNote, Converter={StaticResource BoolToVisibility}}" />

                <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                    <!-- Products are the tools, agents and SDKs found; Models are the local AI models (files on disk, or what a local model server lists). -->
                    <ctl:DcSegmented x:Name="ViewSwitch"
                                     SelectedValue="{Binding ActiveView, Mode=TwoWay}"
                                     AutomationProperties.Name="Discovery view"
                                     AutomationProperties.HelpText="Products lists the AI tools, agents and SDKs found. Models lists the local AI models found, with their own filters.">
                        <ctl:DcSegment Value="products"
                                       Content="Products"
                                       Count="{Binding ProductCount}"
                                       ToolTip="AI tools, agents and SDKs" />
                        <ctl:DcSegment Value="models"
                                       Content="Models"
                                       Count="{Binding ModelCount}"
                                       ToolTip="Local AI models: model files on disk and what a local model server lists" />
                    </ctl:DcSegmented>

                    <ui:TextBox x:Name="SearchBox"
                                Width="300"
                                PlaceholderText="Search products and models…  (Ctrl+F)"
                                AutomationProperties.Name="Search products and models"
                                Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </WrapPanel>

                <!--
                    Models only. Each filter exists only when the data can answer it (see the view-model): Show all models when the runtime
                    classifies its models (the recommended view is the default there), Modality and Relevance when some model names one;
                    Confidence always can. The note under the row says how many models the recommended view kept off the list.
                -->
                <StackPanel Visibility="{Binding IsModelsView, Converter={StaticResource BoolToVisibility}}">
                    <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                        <CheckBox Content="Show all models"
                                  Margin="0,0,16,8"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding ShowAllModels}"
                                  Visibility="{Binding HasRecommendedScope, Converter={StaticResource BoolToVisibility}}"
                                  ToolTip="Off lists the recommended models: at least 80% confident, and primary, or a supporting speech, audio, vision or embedding model that an application owns. A model a local model server listed with no confidence of its own is always listed. Choosing a Modality or Relevance lifts the primary / supporting rule."
                                  AutomationProperties.Name="Show all models"
                                  AutomationProperties.HelpText="Also list the models the recommended view hides: low-confidence, embedded and unowned supporting ones." />

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasModalityFilter, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Modality" />
                            <ComboBox Width="150"
                                      ItemsSource="{Binding ModalityChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding ModalityFilter, Mode=TwoWay}"
                                      AutomationProperties.Name="Modality" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasRelevanceFilter, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Relevance" />
                            <ComboBox Width="150"
                                      ItemsSource="{Binding RelevanceChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding RelevanceFilter, Mode=TwoWay}"
                                      ToolTip="How central the model is to the application that owns it, as the scanner classified it."
                                      AutomationProperties.Name="Relevance" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Confidence" />
                            <ComboBox Width="150"
                                      ItemsSource="{Binding ConfidenceChoices}"
                                      DisplayMemberPath="Label"
                                      SelectedValuePath="Key"
                                      SelectedValue="{Binding ConfidenceFilter, Mode=TwoWay}"
                                      ToolTip="{Binding ConfidenceFilterHelp}"
                                      AutomationProperties.Name="Confidence" />
                        </StackPanel>

                        <ui:Button Content="Reset filters"
                                   Appearance="Secondary"
                                   Icon="{ctl:DcSymbolIcon ArrowReset24}"
                                   Command="{Binding ResetModelFiltersCommand}"
                                   Visibility="{Binding HasActiveModelFilters, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.HelpText="{Binding ResetFiltersHelp}" />

                        <TextBlock Style="{StaticResource DcResultCaption}"
                                   Margin="0,0,12,8"
                                   VerticalAlignment="Center"
                                   Text="{Binding ModelCaption}"
                                   AutomationProperties.LiveSetting="Polite" />
                    </WrapPanel>

                    <TextBlock Style="{StaticResource DcCaption}"
                               Margin="0,0,0,8"
                               Text="{Binding ModelScopeNote}"
                               Visibility="{Binding HasModelScopeNote, Converter={StaticResource BoolToVisibility}}"
                               AutomationProperties.LiveSetting="Polite" />
                </StackPanel>

                <ItemsControl ItemsSource="{Binding CardsView}"
                              Focusable="False"
                              AutomationProperties.Name="Detected AI components"
                              Visibility="{Binding IsProductsView, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ui:CardExpander Margin="{StaticResource DcCardGap}"
                                             AutomationProperties.Name="{Binding HeaderDisplay}">
                                <ui:CardExpander.Header>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource DcBody}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Vendor}" />
                                        <TextBlock Style="{StaticResource DcBody}"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Text="{Binding Product}" />
                                        <!-- The strongest state among the card's signals: a product with a new process is new. The tooltip counts them. -->
                                        <ctl:DcStatePill Margin="12,0,0,0"
                                                         VerticalAlignment="Center"
                                                         Text="{Binding State}"
                                                         Tone="{Binding StateKey}"
                                                         ToolTip="{Binding StateTally}"
                                                         Visibility="{Binding HasState, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Style="{StaticResource DcBadge}"
                                                Tag="{Binding ConfidenceKey}"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource DcBadgeText}"
                                                       Text="{Binding ConfidenceDisplay, StringFormat='{}{0} confidence'}" />
                                        </Border>
                                        <Border Style="{StaticResource DcChip}"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding SignalCountDisplay}" />
                                        </Border>
                                    </StackPanel>
                                </ui:CardExpander.Header>
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource DcField}">
                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="Detectors" />
                                            <TextBlock Style="{StaticResource DcFieldValue}" Text="{Binding DetectorsDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource DcField}">
                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="Categories" />
                                            <TextBlock Style="{StaticResource DcFieldValue}" Text="{Binding CategoriesDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Style="{StaticResource DcField}">
                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="Sources" />
                                            <TextBlock Style="{StaticResource DcFieldValue}" Text="{Binding SourcesDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource DcField}">
                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="First seen" />
                                            <TextBlock Style="{StaticResource DcFieldValue}" Text="{Binding FirstSeenDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource DcField}">
                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="Last seen" />
                                            <TextBlock Style="{StaticResource DcFieldValue}" Text="{Binding LastSeenDisplay}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2"
                                                    Style="{StaticResource DcField}"
                                                    Visibility="{Binding HasLastActive, Converter={StaticResource BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="Last active" />
                                            <TextBlock Style="{StaticResource DcFieldValue}" Text="{Binding LastActiveDisplay}" />
                                        </StackPanel>
                                    </Grid>
                                    <!-- Only a card whose components have a confidence snapshot: how sure the engine is of what it is and that it is there. -->
                                    <Grid Visibility="{Binding HasBands, Converter={StaticResource BoolToVisibility}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Style="{StaticResource DcField}">
                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="Identity" />
                                            <TextBlock Style="{StaticResource DcFieldValue}" Text="{Binding IdentityText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Style="{StaticResource DcField}">
                                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="Presence" />
                                            <TextBlock Style="{StaticResource DcFieldValue}" Text="{Binding PresenceText}" />
                                        </StackPanel>
                                    </Grid>

                                    <!-- Each signal: its state, name and confidence, then the detector, model, process (pid, user) and activity lines it has. -->
                                    <TextBlock Style="{StaticResource DcFieldLabel}" Margin="0,4,0,6" Text="Signals" />
                                    <ItemsControl Focusable="False"
                                                  ItemsSource="{Binding SignalLines}"
                                                  ItemTemplate="{StaticResource DiscoverySignalTemplate}"
                                                  AutomationProperties.Name="Signals" />
                                    <TextBlock Style="{StaticResource DcCaption}"
                                               Margin="0,0,0,8"
                                               Text="{Binding SignalOverflow}"
                                               Visibility="{Binding HasSignalOverflow, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Style="{StaticResource DcCaption}" Text="{Binding EvidenceSummary}" />
                                </StackPanel>
                            </ui:CardExpander>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!--
                    The Models table: Model, State, [Owners], [Modality], [Relevance], Confidence, Status / format, Sources. The bracketed
                    columns are turned on by the code-behind when some model carries what they show (an owner, a modality, a relevance): a
                    DefenseClaw 0.8.10 install, whose models carry none, gets the columns it always had. It shows only while at least one
                    model passes the search and the filters (a grid first laid out with no rows keeps the column widths it worked out for
                    none), and it scrolls inside its own height so the rest of the page stays within reach.
                -->
                <Border Style="{StaticResource DcCardFlush}"
                        Margin="{StaticResource DcCardGap}"
                        Visibility="{Binding ShowModelTable, Converter={StaticResource BoolToVisibility}}">
                    <ui:DataGrid x:Name="ModelList"
                                 Style="{StaticResource DcDataGrid}"
                                 MaxHeight="520"
                                 ItemsSource="{Binding ModelsView}"
                                 SelectedItem="{Binding SelectedModel, Mode=TwoWay}"
                                 SelectionMode="Single"
                                 VirtualizingPanel.ScrollUnit="Pixel"
                                 PreviewMouseWheel="OnModelListWheel"
                                 AutomationProperties.Name="Local models"
                                 AutomationProperties.HelpText="The local AI models found. Select one for its details.">
                        <ui:DataGrid.Columns>
                            <DataGridTextColumn Width="2.2*" MinWidth="150" Header="Model"
                                                SortMemberPath="NormalizedId"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding ModelId}" />
                            <DataGridTemplateColumn Width="1*" MinWidth="86" Header="State" SortMemberPath="StateWeight">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ctl:DcStatePill Margin="0,0,8,0"
                                                         HorizontalAlignment="Left"
                                                         Text="{Binding StateText}"
                                                         Tone="{Binding StateKey}"
                                                         Visibility="{Binding HasState, Converter={StaticResource BoolToVisibility}}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn x:Name="OwnersColumn" Width="1.3*" MinWidth="96" Header="Owners" Visibility="Collapsed"
                                                SortMemberPath="OwnersDisplay"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding OwnersDisplay}" />
                            <DataGridTextColumn x:Name="ModalityColumn" Width="1*" MinWidth="84" Header="Modality"
                                                SortMemberPath="ModalityDisplay"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding ModalityDisplay}" />
                            <DataGridTextColumn x:Name="RelevanceColumn" Width="1*" MinWidth="90" Header="Relevance" Visibility="Collapsed"
                                                SortMemberPath="RelevanceRank"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding RelevanceDisplay}" />
                            <DataGridTextColumn Width="1*" MinWidth="88" Header="Confidence"
                                                SortMemberPath="EffectiveDiscoveryConfidence"
                                                ElementStyle="{StaticResource DcCellText}"
                                                Binding="{Binding ConfidenceLabel}" />
                            <DataGridTextColumn Width="1.4*" MinWidth="110" Header="Status / format"
                                                SortMemberPath="StatusFormatDisplay"
                                                ElementStyle="{StaticResource DcCellTextQuiet}"
                                                Binding="{Binding StatusFormatDisplay}" />
                            <DataGridTextColumn Width="1.6*" MinWidth="110" Header="Sources"
                                                SortMemberPath="SourcesDisplay"
                                                ElementStyle="{StaticResource DcCellTextQuiet}"
                                                Binding="{Binding SourcesDisplay}" />
                        </ui:DataGrid.Columns>
                    </ui:DataGrid>
                </Border>

                <!-- Empty: discovery off / no scan yet / the latest scan found none (of the view on screen) -->
                <Border Style="{StaticResource DcCard}"
                        Margin="{StaticResource DcCardGap}"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Search24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                    </StackPanel>
                </Border>

                <!-- Empty: the search or the filters hide everything -->
                <Border Style="{StaticResource DcCard}"
                        Margin="{StaticResource DcCardGap}"
                        Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Search24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding NoMatchTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding NoMatchDetail}" />
                    </StackPanel>
                </Border>

                <!-- Runtime coverage: explicit state for versions that do not have it -->
                <TextBlock Style="{StaticResource DcSectionHeader}" Text="Runtime" />
                <Border Style="{StaticResource DcCard}" Margin="{StaticResource DcCardGap}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <ctl:DcCardHeader Symbol="Pulse24" Section="Observe" Content="{Binding RuntimeTitle}" />
                            <Border Style="{StaticResource DcBadge}"
                                    Tag="{Binding RuntimeBadgeKey}"
                                    Margin="10,0,0,8"
                                    VerticalAlignment="Top">
                                <StackPanel Orientation="Horizontal">
                                    <ctl:DcStatusGlyph Tone="{Binding RuntimeBadgeKey}" ShowDot="False" GlyphSize="12" Gap="5" />
                                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding RuntimeBadgeText}" />
                                </StackPanel>
                            </Border>
                            <ui:ProgressRing Width="18"
                                             Height="18"
                                             Margin="10,0,0,8"
                                             IsIndeterminate="True"
                                             AutomationProperties.Name="Asking the gateway for runtime coverage"
                                             Visibility="{Binding IsRuntimeLoading, Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource DcTextSecondary}" Text="{Binding RuntimeDetail}" />

                        <ItemsControl Margin="0,10,0,0"
                                      Focusable="False"
                                      AutomationProperties.Name="Runtime coverage planes"
                                      ItemsSource="{Binding RuntimePlanes}"
                                      Visibility="{Binding HasRuntimeSnapshot, Converter={StaticResource BoolToVisibility}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Style="{StaticResource DcBadge}" Tag="{Binding StateKey}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <ctl:DcStatusGlyph Tone="{Binding StateKey}" ShowDot="False" GlyphSize="12" Gap="5" />
                                                    <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding StateText}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Style="{StaticResource DcBody}" VerticalAlignment="Center" Text="{Binding Name}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource DcCaption}"
                                                   Margin="0,4,0,0"
                                                   Text="{Binding Reason}"
                                                   Visibility="{Binding HasReason, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ui:DataGrid Margin="0,10,0,0"
                                     MaxHeight="260"
                                     AutoGenerateColumns="False"
                                     IsReadOnly="True"
                                     GridLinesVisibility="Horizontal"
                                     HeadersVisibility="Column"
                                     AutomationProperties.Name="Runtime findings"
                                     ItemsSource="{Binding RuntimeFindings}"
                                     Visibility="{Binding HasRuntimeSnapshot, Converter={StaticResource BoolToVisibility}}">
                            <ui:DataGrid.Columns>
                                <DataGridTextColumn Width="90" Header="Severity" Binding="{Binding Severity}" />
                                <DataGridTextColumn Width="70" Header="Score" Binding="{Binding ScoreDisplay}" />
                                <DataGridTextColumn Width="*" Header="Process" Binding="{Binding Process}" />
                                <DataGridTextColumn Width="70" Header="PID" Binding="{Binding PidDisplay}" />
                                <DataGridTextColumn Width="140" Header="Agent" Binding="{Binding Agent}" />
                                <DataGridTextColumn Width="*" Header="Providers" Binding="{Binding Providers}" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </StackPanel>
                </Border>

                <!-- Sources section -->
                <ui:CardExpander Header="Sources: where these cards came from" IsExpanded="True">
                    <StackPanel Margin="0,8,0,0">
                        <ItemsControl ItemsSource="{Binding Sources}"
                                      Focusable="False"
                                      AutomationProperties.Name="Data sources">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource DcBody}" FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock Style="{StaticResource DcTextSecondary}" Text="{Binding Detail}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0">
                                            <Border Style="{StaticResource DcBadge}"
                                                    Tag="{Binding AvailabilityKey}"
                                                    HorizontalAlignment="Right">
                                                <TextBlock Style="{StaticResource DcBadgeText}" Text="{Binding AvailabilityText}" />
                                            </Border>
                                            <TextBlock Style="{StaticResource DcCaption}"
                                                       Margin="0,4,0,0"
                                                       HorizontalAlignment="Right">
                                                <Run Text="updated " />
                                                <Run Text="{Binding LastUpdatedDisplay, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Expander Margin="0,6,0,0" Header="Recent scans (ai.discovery audit bucket)">
                            <ItemsControl Margin="0,8,0,0"
                                          Focusable="False"
                                          AutomationProperties.Name="Recent discovery scans"
                                          ItemsSource="{Binding ScanHistory}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Style="{StaticResource DcCaption}" Text="{Binding TimestampDisplay}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource DcBody}" Text="{Binding Summary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Expander Margin="0,6,0,0" Header="Connector discovery (agent_discovery.json)">
                            <ui:DataGrid Margin="0,8,0,0"
                                         Height="220"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         GridLinesVisibility="Horizontal"
                                         HeadersVisibility="Column"
                                         AutomationProperties.Name="Connector discovery"
                                         ItemsSource="{Binding ConnectorDiscovery}">
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn Width="120" Header="Connector" Binding="{Binding Name}" />
                                    <DataGridTextColumn Width="110" Header="Status" Binding="{Binding StatusDisplay}" />
                                    <DataGridTextColumn Width="120" Header="Version" Binding="{Binding Version}" />
                                    <DataGridTextColumn Width="*" Header="Config path" Binding="{Binding ConfigPath}" />
                                    <DataGridTextColumn Width="*" Header="Binary path" Binding="{Binding BinaryPath}" />
                                    <DataGridTextColumn Width="140" Header="Error" Binding="{Binding Error}" />
                                    <!-- An installed agent DefenseClaw is not set up for: opens the review of its observe-mode setup command. -->
                                    <DataGridTemplateColumn Width="80" Header="Action">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ui:Button Content="Add"
                                                           Appearance="Transparent" BorderThickness="0"
                                                           Foreground="{DynamicResource DcAccentBrush}"
                                                           Padding="6,2,6,2"
                                                           Command="{Binding DataContext.AddConnectorCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                           CommandParameter="{Binding}"
                                                           AutomationProperties.Name="{Binding AddAutomationName}"
                                                           AutomationProperties.HelpText="Opens a review of the setup command. Nothing runs until you confirm."
                                                           Visibility="{Binding CanAdd, Converter={StaticResource BoolToVisibility}}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </Expander>

                        <Expander Margin="0,6,0,0" Header="Connector selection (agent_selection.json)">
                            <ui:DataGrid Margin="0,8,0,0"
                                         Height="140"
                                         AutoGenerateColumns="False"
                                         IsReadOnly="True"
                                         GridLinesVisibility="Horizontal"
                                         HeadersVisibility="Column"
                                         AutomationProperties.Name="Connector selection"
                                         ItemsSource="{Binding ConnectorSelections}">
                                <ui:DataGrid.Columns>
                                    <DataGridTextColumn Width="120" Header="Connector" Binding="{Binding Connector}" />
                                    <DataGridTextColumn Width="*" Header="Executable" Binding="{Binding Executable}" />
                                    <DataGridTextColumn Width="140" Header="Version" Binding="{Binding RawVersion}" />
                                    <DataGridTextColumn Width="150" Header="Selected at" Binding="{Binding SelectedAtDisplay}" />
                                    <DataGridTextColumn Width="150" Header="Expires at" Binding="{Binding ExpiresAtDisplay}" />
                                    <DataGridTextColumn Width="110" Header="Source" Binding="{Binding Source}" />
                                </ui:DataGrid.Columns>
                            </ui:DataGrid>
                        </Expander>
                    </StackPanel>
                </ui:CardExpander>
            </StackPanel>
        </ScrollViewer>

        <!-- Inspector: opens while a model is selected (ctl:DcInspector); the page takes the whole width otherwise. -->
        <ctl:DcInspector x:Name="ModelInspector"
                         Title="Model details"
                         IsOpen="{Binding HasModelSelection}"
                         CloseCommand="{Binding ClearModelSelectionCommand}"
                         CloseAutomationName="Close model details"
                         AutomationProperties.Name="Model details"
                         Content="{Binding SelectedModel}">
            <ctl:DcInspector.Badges>
                <ctl:DcStatePill Text="{Binding SelectedModel.StateText}"
                                 Tone="{Binding SelectedModel.StateKey}"
                                 Visibility="{Binding SelectedModel.HasState, Converter={StaticResource BoolToVisibility}}" />
            </ctl:DcInspector.Badges>
            <ctl:DcInspector.ContentTemplate>
                <DataTemplate>
                    <StackPanel>
                        <TextBlock Style="{StaticResource DcSectionHeader}" Margin="0" Text="{Binding ModelId}" />
                        <TextBlock Style="{StaticResource DcCaption}" Margin="0,4,0,0" Text="{Binding Summary}" />

                        <ctl:DcCardHeader Margin="0,14,0,4" Symbol="Info24" Section="Discover" Content="Details" />
                        <ItemsControl Focusable="False"
                                      ItemsSource="{Binding Facts}"
                                      ItemTemplate="{StaticResource DiscoveryFactTemplate}"
                                      AutomationProperties.Name="Model details" />

                        <!-- Where the model comes from, only when the runtime says: publisher, country, root and base models, derivation, source. -->
                        <StackPanel Visibility="{Binding HasProvenance, Converter={StaticResource BoolToVisibility}}">
                            <ctl:DcCardHeader Margin="0,14,0,4" Symbol="BranchFork24" Section="Discover" Content="Provenance" />
                            <ItemsControl Focusable="False"
                                          ItemsSource="{Binding ProvenanceFacts}"
                                          ItemTemplate="{StaticResource DiscoveryFactTemplate}"
                                          AutomationProperties.Name="Model provenance" />
                        </StackPanel>

                        <ctl:DcCardHeader Margin="0,14,0,4" Symbol="Eye24" Section="Discover" Content="Observations" />
                        <ItemsControl Focusable="False"
                                      ItemsSource="{Binding Observations}"
                                      ItemTemplate="{StaticResource DiscoverySignalTemplate}"
                                      AutomationProperties.Name="Observations of this model" />
                        <TextBlock Style="{StaticResource DcCaption}"
                                   Text="{Binding ObservationOverflow}"
                                   Visibility="{Binding HasObservationOverflow, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </DataTemplate>
            </ctl:DcInspector.ContentTemplate>
        </ctl:DcInspector>
        </Grid>

        <!-- Confirm-and-run dialog (collapsed until a change is requested) -->
        <panels:DiscoverReviewOverlay Grid.RowSpan="2" DataContext="{Binding Review}" />
    </Grid>
</UserControl>
