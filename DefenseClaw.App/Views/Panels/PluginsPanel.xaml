<UserControl x:Class="DefenseClaw.App.Views.Panels.PluginsPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
             xmlns:govern="clr-namespace:DefenseClaw.App.Views.Panels.Govern"
             xmlns:panels="clr-namespace:DefenseClaw.App.Views.Panels"
             xmlns:vm="clr-namespace:DefenseClaw.App.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:PluginsPanelViewModel}"
             mc:Ignorable="d">
    <!--
        Plugins panel. Data is the CLI command 'plugin list' with its JSON and connector flags (there is no gateway
        endpoint for plugins), one read per visit / Refresh / scope change. Severity comes from
        scan.max_severity. Entries the CLI lists that are not plugins (Claude Code's own store) are kept in a
        collapsed, dimmed section at the bottom with an explanation and no actions except Info.
        Keys: F5 refresh (shell), Ctrl+F filter, Esc closes the dialog / form / result card / clears the filter.

        Layout. Plugin lists are short, so everything under the header is one scrolling page (PageScroll) and the rows are
        plain content of it - no scroller of their own. It used to be a fixed stack of toolbar, form and banners above a
        scroller for the list, which left the list whatever the rows above it did not take: 146 DIPs with the shell's
        gateway banner open. The result card of a read-only command sits at the end of the page and is scrolled into view
        when it opens.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/DefenseClaw.App;component/Views/Panels/Govern/GovernTable.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid Style="{StaticResource DcPage}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: the busy ring and "as of 12:04", the page actions as icons, the filter box. -->
        <ctl:DcPageToolbar x:Name="PageToolbar"
                           Grid.Row="0"
                           ctl:DcIcon.Symbol="PuzzleCube24"
                           ctl:DcIcon.Section="Govern"
                           Title="{Binding Title}"
                           TitleToolTip="{Binding Description}"
                           Caption="{Binding HeaderStatusText}"
                           HasSearch="True"
                           SearchText="{Binding FilterText}"
                           SearchPlaceholder="Filter plugins…"
                           SearchAutomationName="Filter plugins"
                           SearchHelpText="Matches name, description, version, origin, connector and state. Shortcut Ctrl+F; Esc clears it.">
            <ctl:DcPageToolbar.Leading>
                <ui:ProgressRing Width="16"
                                 Height="16"
                                 Margin="12,0,0,0"
                                 IsIndeterminate="True"
                                 Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"
                                 AutomationProperties.Name="Working" />
            </ctl:DcPageToolbar.Leading>
            <ctl:DcPageToolbar.Actions>
                <StackPanel Style="{StaticResource DcToolbarActions}">
                    <ui:Button Icon="{ctl:DcSymbolIcon PuzzleCube24}"
                               Command="{Binding ToggleInstallFormCommand}"
                               IsEnabled="{Binding IsIdle}"
                               ToolTip="Install plugin…"
                               AutomationProperties.Name="Install plugin…"
                               AutomationProperties.HelpText="Install from a path, npm, clawhub:// or a URL with 'defenseclaw plugin install'. You review the command first." />
                    <ui:Button Icon="{ctl:DcSymbolIcon ArrowClockwise24}"
                               Command="{Binding RefreshCommand}"
                               IsEnabled="{Binding IsIdle}"
                               ToolTip="Read the plugin list again (F5)"
                               AutomationProperties.Name="Refresh"
                               AutomationProperties.AcceleratorKey="F5" />
                </StackPanel>
            </ctl:DcPageToolbar.Actions>
        </ctl:DcPageToolbar>

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      Style="{StaticResource DcPageScroll}"
                      Focusable="False"
                      AutomationProperties.Name="Plugins page">
            <StackPanel x:Name="PageContent">
                <StackPanel x:Name="Chrome">
                <!-- Filter strip: which state, which connector, and the reason the next action records. -->
                <WrapPanel Margin="0,0,0,4" Style="{StaticResource DcToolbarPanel}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Show" />
                        <ComboBox Width="160"
                                  ItemsSource="{Binding StatusFilters}"
                                  SelectedItem="{Binding SelectedStatusFilter, Mode=TwoWay}"
                                  AutomationProperties.Name="Show plugins in state" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Connector scope" />
                        <ComboBox MinWidth="200"
                                  ItemsSource="{Binding Connectors}"
                                  SelectedItem="{Binding SelectedConnector, Mode=TwoWay}"
                                  AutomationProperties.Name="Connector scope"
                                  AutomationProperties.HelpText="Which connector's plugins to list, and which connector Install plugin targets. All configured connectors means every one." />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource DcToolbarLabel}" Text="Reason" />
                        <ui:TextBox MinWidth="180"
                                    Width="220"
                                    PlaceholderText="Recorded with the action"
                                    Text="{Binding Reason, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    AutomationProperties.Name="Reason"
                                    AutomationProperties.HelpText="Sent as --reason with block, allow, disable and quarantine." />
                    </StackPanel>
                </WrapPanel>

                <!-- Install a plugin (plugin install) -->
                <Border Style="{StaticResource DcCard}"
                        Margin="{StaticResource DcCardGap}"
                        Visibility="{Binding IsInstallFormOpen, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <ctl:DcCardHeader Symbol="ArrowDownload24" Section="Govern" Content="Install a plugin" />
                        <TextBlock Style="{StaticResource DcCaption}"
                                   Text="Runs 'defenseclaw plugin install'. The plugin is fetched or copied, placed in the connector's plugin folder and scanned. The scope is the connector chosen in the toolbar; 'All configured connectors' installs into every one that has a plugin folder. You review the exact command before anything runs." />

                        <StackPanel Margin="0,12,0,8">
                            <TextBlock Style="{StaticResource DcFieldLabel}" Text="Local path, npm package, clawhub:// URI or https URL" />
                            <ui:TextBox Text="{Binding InstallNameOrPath, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        AutomationProperties.Name="Plugin to install" />
                        </StackPanel>

                        <CheckBox Content="Force: overwrite an existing plugin of the same name"
                                  IsChecked="{Binding InstallForce, Mode=TwoWay}" />
                        <CheckBox Margin="0,6,0,0"
                                  Content="Apply the configured plugin_actions policy based on scan severity"
                                  IsChecked="{Binding InstallApplyActionPolicy, Mode=TwoWay}" />

                        <TextBlock Style="{StaticResource DcToneText}"
                                   Tag="Bad"
                                   Margin="0,10,0,0"
                                   TextWrapping="Wrap"
                                   Text="{Binding InstallFormError}"
                                   Visibility="{Binding HasInstallFormError, Converter={StaticResource BoolToVisibility}}"
                                   AutomationProperties.LiveSetting="Assertive" />

                        <StackPanel Margin="0,12,0,0"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <ui:Button Margin="0,0,8,0"
                                       Content="Cancel"
                                       Icon="{ctl:DcSymbolIcon Dismiss24}"
                                       Command="{Binding ToggleInstallFormCommand}" />
                            <ui:Button Appearance="Primary"
                                       Content="Review command"
                                       Icon="{ctl:DcSymbolIcon ClipboardCheckmark24}"
                                       Command="{Binding SubmitInstallFormCommand}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Result of the last action and a stale-data warning -->
                <ui:InfoBar Margin="{StaticResource DcCardGap}"
                            Title="{Binding ResultTitle}"
                            Message="{Binding ResultMessage}"
                            Severity="{Binding ResultSeverity}"
                            IsOpen="{Binding IsResultOpen, Mode=TwoWay}"
                            IsClosable="True"
                            AutomationProperties.LiveSetting="Polite" />
                <ui:InfoBar Margin="{StaticResource DcCardGap}"
                            Title="Showing an older read"
                            Message="{Binding RefreshWarning}"
                            Severity="Warning"
                            IsOpen="{Binding HasRefreshWarning, Mode=OneWay}"
                            IsClosable="False"
                            AutomationProperties.LiveSetting="Polite" />

                <TextBlock Style="{StaticResource DcResultCaption}"
                           Margin="{StaticResource DcCardGap}"
                           Text="{Binding CaptionText}" />

                </StackPanel>

                <!-- Content -->
                <StackPanel Style="{StaticResource DcEmptyState}"
                            Visibility="{Binding ShowLoading, Converter={StaticResource BoolToVisibility}}">
                    <ui:ProgressRing Width="32"
                                     Height="32"
                                     IsIndeterminate="True"
                                     AutomationProperties.Name="Reading plugins" />
                    <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Reading plugins from the CLI…" />
                </StackPanel>

                <Border Style="{StaticResource DcCard}"
                        Margin="{StaticResource DcCardGap}"
                        Visibility="{Binding ShowCliMissing, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Margin="{StaticResource DcCardGap}"
                        Visibility="{Binding ShowError, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="ErrorCircle24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding ErrorTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding ErrorMessage}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="Press Refresh to try again. The command and its output are in Activity." />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Margin="{StaticResource DcCardGap}"
                        Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}" MaxWidth="560">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="PuzzleCube24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="{Binding EmptyTitle}" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="{Binding EmptyDetail}" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource DcCard}"
                        Margin="{StaticResource DcCardGap}"
                        Visibility="{Binding ShowNoMatch, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Style="{StaticResource DcEmptyState}">
                        <ctl:DcSymbolIcon Style="{StaticResource DcEmptyIcon}" Symbol="Search24" />
                        <TextBlock Style="{StaticResource DcEmptyTitle}" Text="No plugins match the filter" />
                        <TextBlock Style="{StaticResource DcEmptyDetail}" Text="The filter hides every plugin the CLI listed. Clear it to see them all." />
                        <ui:Button Margin="0,12,0,0"
                                   HorizontalAlignment="Center"
                                   Content="Clear filter"
                                   Icon="{ctl:DcSymbolIcon FilterDismiss24}"
                                   Command="{Binding ClearFilterCommand}" />
                    </StackPanel>
                </Border>

                <!-- The list: a dense table with a height of its own (the rest of the viewport, at least 250), virtualized. Each row's actions
                     are in its "..." menu (and on right-click); a selected row opens its details under itself. -->
                <ui:DataGrid x:Name="RowGrid"
                             Style="{StaticResource DcDataGrid}"
                             RowStyle="{StaticResource GovernGridRow}"
                             RowDetailsTemplate="{StaticResource GovernRowDetails}"
                             RowDetailsVisibilityMode="VisibleWhenSelected"
                             SelectionMode="Single"
                             AutomationProperties.Name="Plugins"
                             ItemsSource="{Binding Rows}"
                             VirtualizingPanel.ScrollUnit="Pixel"
                             ctl:DcGridColumns.Fit="True"
                             panels:NestedScroll.ForwardWheel="True"
                             Visibility="{Binding ShowList, Converter={StaticResource BoolToVisibility}}">
                    <ui:DataGrid.Height>
                        <MultiBinding Converter="{x:Static govern:FillHeightConverter.Instance}" ConverterParameter="250">
                            <Binding ElementName="PageScroll" Path="ViewportHeight" />
                            <Binding ElementName="Chrome" Path="ActualHeight" />
                        </MultiBinding>
                    </ui:DataGrid.Height>
                    <ui:DataGrid.Columns>
                    <DataGridTemplateColumn Width="1*" MinWidth="110" Header="Status"
                                            SortMemberPath="StateLabel"
                                            CellTemplate="{StaticResource GovernStatusCell}" />
                    <DataGridTextColumn Width="1.6*" MinWidth="100" Header="Name"
                                        SortMemberPath="DisplayTitle"
                                        ElementStyle="{StaticResource DcCellText}"
                                        Binding="{Binding DisplayTitle}" />
                    <DataGridTextColumn Width="0.7*" MinWidth="56" Header="Version"
                                        SortMemberPath="Version"
                                        ElementStyle="{StaticResource DcCellTextQuiet}"
                                        Binding="{Binding Version}" />
                    <DataGridTextColumn Width="1*" MinWidth="64" Header="Origin"
                                        SortMemberPath="Origin"
                                        ElementStyle="{StaticResource DcCellTextQuiet}"
                                        Binding="{Binding Origin}" />
                    <DataGridTemplateColumn Width="1.3*" MinWidth="120" Header="Scan"
                                            SortMemberPath="ScanLabel"
                                            CellTemplate="{StaticResource GovernScanCell}" />
                    <DataGridTextColumn Width="1*" MinWidth="76" Header="Connector"
                                        SortMemberPath="ConnectorLabel"
                                        ElementStyle="{StaticResource DcCellTextQuiet}"
                                        Binding="{Binding ConnectorLabel}" />
                    <DataGridTextColumn Width="1.3*" MinWidth="80" Header="Source"
                                        SortMemberPath="SourceText"
                                        ElementStyle="{StaticResource DcCellTextMono}"
                                        Binding="{Binding SourceText}" />
                    <DataGridTemplateColumn Width="32" Header="Actions"
                                            CanUserSort="False"
                                            HeaderStyle="{StaticResource DcDataGridActionsHeader}"
                                            CellTemplate="{StaticResource GovernMenuCell}" />
                    </ui:DataGrid.Columns>
                </ui:DataGrid>

                <!-- Entries the CLI lists that are not plugins -->
                <Expander Margin="0,4,0,0"
                          Header="{Binding ArtifactHeader}"
                          AutomationProperties.Name="Entries the CLI lists that are not plugins"
                          Visibility="{Binding HasArtifacts, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Margin="0,8,0,0">
                        <TextBlock Style="{StaticResource DcCaption}"
                                   Margin="0,0,0,8"
                                   Text="DefenseClaw 0.8.10 treats every folder in Claude Code's plugin store as a plugin. These are shown so nothing the CLI reported is hidden, but they are not plugins: the only action offered is Info." />
                        <ui:DataGrid Style="{StaticResource DcDataGrid}"
                                     RowStyle="{StaticResource GovernGridRow}"
                                     SelectionMode="Single"
                                     AutomationProperties.Name="Listing artifacts"
                                     ItemsSource="{Binding ArtifactRows}"
                                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                     ctl:DcGridColumns.Fit="True"
                                     panels:NestedScroll.ForwardWheel="True">
                            <ui:DataGrid.Columns>
                    <DataGridTemplateColumn Width="1*" MinWidth="104" Header="Status" SortMemberPath="StateLabel" CellTemplate="{StaticResource GovernStatusCell}" />
                    <DataGridTextColumn Width="2*" MinWidth="110" Header="Name"
                                        SortMemberPath="DisplayTitle"
                                        ElementStyle="{StaticResource DcCellText}"
                                        Binding="{Binding DisplayTitle}" />
                    <DataGridTextColumn Width="1*" MinWidth="84" Header="Connector"
                                        SortMemberPath="ConnectorLabel"
                                        ElementStyle="{StaticResource DcCellTextQuiet}"
                                        Binding="{Binding ConnectorLabel}" />
                    <DataGridTemplateColumn Width="32" Header="Actions"
                                            CanUserSort="False"
                                            HeaderStyle="{StaticResource DcDataGridActionsHeader}"
                                            CellTemplate="{StaticResource GovernMenuCell}" />
                            </ui:DataGrid.Columns>
                        </ui:DataGrid>
                    </StackPanel>
                </Expander>

                <!-- Result of a read-only command (info): at the end of the page, scrolled into view when it opens. -->
                <govern:GovernOutputCard />
            </StackPanel>
        </ScrollViewer>

        <!-- Review dialog for every state-changing command -->
        <govern:GovernConfirmOverlay Grid.Row="0" Grid.RowSpan="2" />
    </Grid>
</UserControl>
