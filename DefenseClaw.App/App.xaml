<Application x:Class="DefenseClaw.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
        No StartupUri: the shell composes its services first, and the dashboard window is built
        on demand (DashboardHost) - not at all on a minimized autostart - so App.OnStartup owns
        window creation. ShutdownMode stays OnExplicitShutdown: with no window at startup, the
        tray's Exit item is the only way out.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!--
                    WPF-UI's dictionaries style the Fluent controls. The theme here is the
                    seed value only: AppearanceService (created first thing in App.OnStartup,
                    before any window) applies the saved style and light/dark, or the OS's when
                    the mode is System, and keeps it in step afterwards.
                -->
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />

                <!--
                    The shared design system (Dc* keys): spacing, type, cards, tone badges,
                    page header, toolbar, empty state, focus ring. Must stay AFTER the two WPF-UI
                    dictionaries above - it is built on their brushes and re-points WPF-UI's
                    focus-visual keys. See Themes\DefenseClaw.xaml for the key index. It merges the
                    Default style's tokens itself; AppearanceService merges the chosen style's
                    after everything here, so it is the last dictionary and wins.
                -->
                <ResourceDictionary Source="Themes/DefenseClaw.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
