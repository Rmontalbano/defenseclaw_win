<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DefenseClaw.App</RootNamespace>
    <AssemblyName>DefenseClaw.App</AssemblyName>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      WPF0001 is the experimental-API diagnostic guarding Application.ThemeMode, the .NET 9
      Fluent theming switch this shell is built on. Opting in is deliberate.
    -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!--
      The one binary asset in the repo. Generated from ShieldIconFactory (Running state)
      by a throwaway harness, so the compiled file icon — Explorer, Start menu, alt-tab
      fallback — is the same shield the tray and taskbar draw at runtime. Regenerate by
      rendering CreateImage at 16/24/32/48/64/128/256 and repacking; do not hand-edit.
    -->
    <ApplicationIcon>Assets\DefenseClaw.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DefenseClaw.Core\DefenseClaw.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!--
      Pinned to 2.3.2: 2.4.1 ships only net462 and net10.0-windows assets, so a
      net9.0-windows project silently falls back to the .NET Framework build (NU1701).
    -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <!--
      Latest stable (6.3.1.120) ships net8.0-windows7.0 assets alongside net6.0-windows7.0
      and net462; a net9.0-windows project resolves the net8.0-windows7.0 asset cleanly
      (same TFM family, lower version) with no NU1701 fallback, unlike the H.NotifyIcon
      case above where the only modern asset targeted a *newer* TFM than this project.
    -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
