<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>DefenseClaw.App</RootNamespace>
    <AssemblyName>DefenseClaw.App</AssemblyName>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!--
      WPF0001 is the experimental-API diagnostic guarding Application.ThemeMode, the .NET 9
      Fluent theming switch this shell is built on. Opting in is deliberate.
    -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
    <!--
      The one binary asset in the repo. Generated from Services/ShieldArtwork.cs (the brand
      mark, Running state), the same source the tray and window icons are drawn from at
      runtime, so the compiled file icon (Explorer, Start menu, pinned taskbar buttons) is
      the same mark. Do not hand-edit: set DC_WRITE_APP_ICON=1 and run DefenseClaw.App.Tests
      filtered to FullyQualifiedName~AppIconTests (see that class). AppIconTests fails while
      the committed file and the artwork disagree.
    -->
    <ApplicationIcon>Assets\DefenseClaw.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    Release publish tuning. Only the self-contained single-file publish (the release recipe in
    .github/workflows/ci.yml) sees this; build, test and any other publish are untouched.

    This is a login-autostart tray app, so what a user feels is how fast it gets to a tray icon.
    The app is NOT trimmed and must stay that way (WPF's BAML/reflection, the config model and the
    view-model bindings are all reflection-driven); nothing below trims.

    PublishReadyToRun: precompiles the app and its NuGet assemblies (App, Core, WPF-UI, YamlDotNet,
    CommunityToolkit, AvalonEdit, H.NotifyIcon, ...), so startup runs native code instead of
    JIT-compiling ~1,000 methods first. Measured with a startup harness (not the app exe): 1,049
    methods / ~130-150 ms of JIT down to 359 / ~55 ms. The shared framework already ships
    precompiled and is left as Microsoft built it: PublishReadyToRunComposite=false. The default for a
    self-contained publish is a composite image that recompiles the framework too (+25 MB, and a
    ~99 MB image the single-file host has to extract on first run) for no measurable wall-clock gain.

    EnableCompressionInSingleFile is deliberately OFF. It shrinks the exe 187 MB -> 81 MB, but every
    compressed managed assembly is inflated into private memory on every launch and stays there for
    the life of the process. Measured on the real exe, tray-only (minimized), 15 s after launch,
    3 alternating rounds (2026-09-29):
      v0.3.1  JIT, uncompressed        ~1.23 s to idle, ~1.8 s CPU, 55 MB private / 134 MB working set
      R2R + compressed                 ~1.00 s to idle, ~0.9 s CPU, 130 MB private / 250 MB working set
      R2R, uncompressed (this)         ~1.15 s to idle, ~0.7 s CPU, 49 MB private / 114 MB working set
    Compression bought ~0.1 s at login for +80 MB private memory held all day by a tray app.
  -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != '' and '$(SelfContained)' == 'true' and '$(PublishSingleFile)' == 'true'">
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishReadyToRunComposite>false</PublishReadyToRunComposite>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\DefenseClaw.Core\DefenseClaw.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets DefenseClaw.App.Tests reach the internal helpers (parsers, classifiers, argv builders). -->
    <InternalsVisibleTo Include="DefenseClaw.App.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
    <!--
      Pinned to 2.3.2: 2.4.1 ships only net462 and net10.0-windows assets, so a
      net9.0-windows project silently falls back to the .NET Framework build (NU1701).
    -->
    <PackageReference Include="H.NotifyIcon.Wpf" Version="2.3.2" />
    <!--
      Latest stable (6.3.1.120) ships net8.0-windows7.0 assets alongside net6.0-windows7.0
      and net462; a net9.0-windows project resolves the net8.0-windows7.0 asset cleanly
      (same TFM family, lower version) with no NU1701 fallback, unlike the H.NotifyIcon
      case above where the only modern asset targeted a *newer* TFM than this project.
    -->
    <PackageReference Include="AvalonEdit" Version="6.3.1.120" />
  </ItemGroup>

</Project>
