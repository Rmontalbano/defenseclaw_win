<ui:FluentWindow x:Class="DefenseClaw.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:shell="clr-namespace:DefenseClaw.App.Views.Shell"
                 xmlns:ctl="clr-namespace:DefenseClaw.App.Views.Controls"
                 Title="DefenseClaw for Windows"
                 Width="1200"
                 Height="800"
                 MinWidth="940"
                 MinHeight="620"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 WindowStartupLocation="CenterScreen">

    <Grid>
        <!--
            The shell, top to bottom (CUST-383, the Mac v1.1.34 hierarchy without its chrome): the window row (title bar: sidebar toggle, name,
            the palette's search box, the look controls), the menu bar's row, the gateway status strip, the banners, then the sidebar and the
            page, whose own toolbar is the panel's title, actions and search.
        -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition x:Name="MenuBarRow" Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            32 px, not WPF-UI's default 48: the caption buttons are 30 px tall and top-aligned, so at 48 the title
            text sat 9 px below their centre line and the bar wasted 16 px of a window that already scrolls its sidebar.
        -->
        <!--
            The title bar is the window's toolbar, where the Mac keeps its sidebar toggle and its Command Palette button: the sidebar toggle at
            the left (it used to take a 40 px row of its own at the top of the sidebar), the palette's "Search panels and commands" box in the
            middle (Ctrl+K; it used to be an icon on the status strip), and at the right the shortcuts list (F1) and the two look controls: the
            Appearance button, which opens the style + mode flyout below, and a one-click light/dark toggle (a sun while dark, a moon while
            light: the icon is where a click goes; the name and tooltip say so in words). The look controls are hidden when there is no
            AppearanceService (a host built without one).
        -->
        <ui:TitleBar x:Name="ShellTitleBar" Grid.Row="0" Height="32" Title="DefenseClaw for Windows">
            <ui:TitleBar.Header>
                <!-- A header replaces WPF-UI's title text, so the title is drawn here; it is not hit-testable, so a press on it still drags the window. -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button x:Name="SidebarToggleButton"
                               Margin="6,0,2,0"
                               Appearance="Transparent"
                               Height="26"
                               MinHeight="0"
                               Padding="8,0,8,0"
                               BorderThickness="0"
                               VerticalAlignment="Center"
                               Click="OnSidebarToggleClick"
                               ToolTip="Show or hide the sidebar"
                               AutomationProperties.Name="Toggle sidebar"
                               AutomationProperties.HelpText="Shows the sidebar's names, or folds it to a strip of icons.">
                        <ui:Button.Icon>
                            <ctl:DcSymbolIcon Symbol="PanelLeft24" FontSize="14" />
                        </ui:Button.Icon>
                    </ui:Button>
                    <TextBlock x:Name="TitleText"
                               Margin="6,0,12,0"
                               VerticalAlignment="Center"
                               FontSize="12"
                               IsHitTestVisible="False"
                               Text="DefenseClaw for Windows" />
                </StackPanel>
            </ui:TitleBar.Header>
            <ui:TitleBar.CenterContent>
                <shell:PaletteLauncher x:Name="PaletteLauncher"
                                       Width="320"
                                       VerticalAlignment="Center"
                                       ButtonBase.Click="OnPaletteButtonClick" />
            </ui:TitleBar.CenterContent>
            <ui:TitleBar.TrailingContent>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0,0,6,0">
                    <ui:Button x:Name="ShortcutsButton"
                               Margin="0,0,2,0"
                               Appearance="Transparent"
                               Height="26"
                               MinHeight="0"
                               Padding="8,0,8,0"
                               BorderThickness="0"
                               Click="OnShortcutsButtonClick"
                               ToolTip="Keyboard shortcuts (F1)"
                               AutomationProperties.Name="Show keyboard shortcuts"
                               AutomationProperties.AcceleratorKey="F1">
                        <ui:Button.Icon>
                            <ctl:DcSymbolIcon Symbol="Keyboard24" FontSize="14" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button x:Name="AppearanceButton"
                               Appearance="Transparent"
                               Height="26"
                               MinHeight="0"
                               Padding="8,0,8,0"
                               BorderThickness="0"
                               Click="OnAppearanceButtonClick"
                               ToolTip="Appearance: style and light or dark"
                               AutomationProperties.Name="Appearance"
                               AutomationProperties.HelpText="Opens a menu to choose the style (Default, Linear, TUI, Cisco) and the mode (System, Light, Dark).">
                        <ui:Button.Icon>
                            <ctl:DcSymbolIcon Symbol="PaintBrush24" FontSize="14" />
                        </ui:Button.Icon>
                    </ui:Button>

                    <ui:Button x:Name="ThemeToggleButton"
                               Margin="2,0,0,0"
                               Appearance="Transparent"
                               Height="26"
                               MinHeight="0"
                               Padding="8,0,8,0"
                               BorderThickness="0"
                               Click="OnThemeToggleClick"
                               AutomationProperties.AcceleratorKey="Ctrl+Shift+L">
                        <ui:Button.Icon>
                            <ctl:DcSymbolIcon x:Name="ThemeToggleIcon" Symbol="WeatherMoon24" FontSize="14" />
                        </ui:Button.Icon>
                    </ui:Button>
                </StackPanel>
            </ui:TitleBar.TrailingContent>
        </ui:TitleBar>

        <!-- The menu bar (CUST-384) in MenuBarRow (CUST-383), directly under the title bar: File, View, Monitor, Commands, Go, Help. Built in ShellMenuBar. -->
        <shell:ShellMenuBar x:Name="MenuBar" Grid.Row="1" />

        <!--
            Status strip: one line, always visible, always from the GatewayMonitor snapshot.
            Left to right it reads as a hierarchy: the state pill (the one thing that must be
            noticed), the detail sentence (trims first when the window is narrow), then the
            supporting facts as chips (Watchdog, Guardrail, Keys, alerts, connector, redaction, policy, running,
            stale, version) and the gateway's own Refresh. Every colour is a Dc tone chosen by Tag, so the dot and pill follow a
            live light/dark switch. The sentence and the chips are the StatusStripControl: it hides chips,
            lowest priority first, when the window has no room for them (see ChipStripPanel). Status only (CUST-383): the palette and the
            shortcuts moved up to the title bar, and Refresh is an icon, so the facts get the width and the row is a toolbar button high.
        -->
        <Border Grid.Row="2" Style="{StaticResource DcStatusStrip}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource DcBadge}"
                        Tag="{Binding StateTone}"
                        Padding="10,4,12,4"
                        VerticalAlignment="Center"
                        ToolTip="{Binding StateDetail}">
                    <StackPanel Orientation="Horizontal">
                        <!-- The state as a mark: a tone dot under Default, a status circle under Linear, a flat shape under TUI. -->
                        <ctl:DcStatusGlyph Tone="{Binding StateTone}"
                                           Margin="0,0,8,0" />
                        <TextBlock x:Name="StateText"
                                   Style="{StaticResource DcBadgeText}"
                                   FontSize="13"
                                   VerticalAlignment="Center"
                                   AutomationProperties.Name="{Binding StateAutomationName}"
                                   AutomationProperties.LiveSetting="Polite"
                                   shell:LiveRegion.RaisedByCode="True"
                                   Text="{Binding StateLabel}" />
                    </StackPanel>
                </Border>

                <!--
                    The detail sentence and the chips (Watchdog, Guardrail, Keys, alerts, connector, redaction, policy, running, stale,
                    version) are the strip's own: its view-model is Strip, and it takes whatever room the pill and the buttons leave.
                -->
                <shell:StatusStripControl x:Name="StatusStrip"
                                          Grid.Column="1"
                                          Margin="12,0,12,0"
                                          VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Style="{StaticResource DcToolbarActions}">
                    <ui:Button x:Name="GatewayRefreshButton"
                               Icon="{ctl:DcSymbolIcon ArrowSync24}"
                               Command="{Binding RefreshCommand}"
                               ToolTip="Check the gateway now. F5 refreshes the panel you are viewing."
                               AutomationProperties.Name="Refresh gateway status"
                               AutomationProperties.HelpText="Polls the gateway immediately instead of waiting for the next automatic check." />
                </StackPanel>
            </Grid>
        </Border>

        <!--
            Banner region, above the content frame. The 12 px gap sits on each banner's top edge, not on the
            stack: a closed banner is collapsed (margin and all), so with nothing to say the region takes no
            height at all instead of 12 px above the sidebar.
        -->
        <StackPanel Grid.Row="3" Margin="24,0,24,0">
            <!-- "DefenseClaw X is available" (UpdateWatcher): informational, so it leads the region and the warnings stay visible below it. -->
            <shell:UpdateBanner />

            <!-- "DefenseClaw for Windows X is available" (SelfUpdateService): this app's own update; Update now opens the review. -->
            <shell:SelfUpdateBanner DataContext="{Binding SelfUpdate}" />

            <ui:InfoBar Margin="0,12,0,0"
                        IsClosable="False"
                        Severity="Warning"
                        Title="WSL gateway detected"
                        IsOpen="{Binding ShowWslBanner}"
                        Message="{Binding WslMessage}" />

            <!--
                The gateway said 401 to the token we sent: config.yaml's token (or the env var) was probably rotated. Not an InfoBar (its
                content is not hosted, and this one has an action): a slim bar of the High tone's tokens, like the update banner beside it.
            -->
            <Border Margin="0,12,0,0"
                    Padding="12,8,8,8"
                    Background="{DynamicResource DcToneHighSubtleBrush}"
                    BorderBrush="{DynamicResource DcToneHighBrush}"
                    BorderThickness="{DynamicResource DcBorderThickness}"
                    CornerRadius="{DynamicResource DcControlRadius}"
                    Visibility="{Binding ShowTokenBanner, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ctl:DcSymbolIcon Grid.Column="0"
                                      Margin="0,0,10,0"
                                      VerticalAlignment="Center"
                                      Symbol="Key24"
                                      FontSize="20"
                                      Foreground="{DynamicResource DcToneHighBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource DcBody}"
                                   FontWeight="SemiBold"
                                   AutomationProperties.LiveSetting="Polite"
                                   Text="Gateway token rejected" />
                        <TextBlock Style="{StaticResource DcCaption}"
                                   Text="The gateway refused the token the app sent. The token in config.yaml may have been rotated." />
                    </StackPanel>
                    <ui:Button Grid.Column="2"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Content="Reload config"
                               Command="{Binding ReloadConfigCommand}"
                               AutomationProperties.Name="Reload config"
                               AutomationProperties.HelpText="Re-reads config.yaml and the .env file, then polls the gateway again." />
                </Grid>
            </Border>

            <ui:InfoBar Margin="0,12,0,0"
                        IsClosable="False"
                        Severity="Error"
                        Title="config.yaml could not be read"
                        IsOpen="{Binding ShowConfigErrorBanner}"
                        Message="{Binding ConfigErrorMessage}" />

            <ui:InfoBar Margin="0,12,0,0"
                        IsClosable="False"
                        Severity="Warning"
                        Title="{Binding DegradedTitle}"
                        IsOpen="{Binding ShowDegradedBanner}"
                        Message="{Binding DegradedMessage}" />

            <!-- The reviewed start (GatewayLifecycle): drawn only while the gateway is down; disabled with the reason as its tooltip. -->
            <ui:Button Margin="0,8,0,0"
                       Appearance="Primary"
                       Content="Start gateway"
                       Icon="{ctl:DcSymbolIcon Play24}"
                       Command="{Binding StartGatewayCommand}"
                       Visibility="{Binding ShowStartGateway, Converter={StaticResource BoolToVisibility}}"
                       ToolTipService.ShowOnDisabled="True"
                       ToolTip="{Binding StartGatewayTip}"
                       AutomationProperties.Name="Start gateway"
                       AutomationProperties.HelpText="{Binding StartGatewayTip}" />

            <!--
                A panel whose InitializeAsync threw (PanelCatalog.PanelFaulted). Driven from
                MainWindow.xaml.cs rather than the view-model: it is shell plumbing, not
                gateway state, and it is the only banner the operator can dismiss - the
                others describe a condition that is still true.
            -->
            <ui:InfoBar x:Name="PanelFaultBar"
                        Margin="0,12,0,0"
                        IsClosable="True"
                        IsOpen="False"
                        Severity="Error"
                        Title="A panel failed to load" />

            <!--
                Not-initialized gets its own banner rather than an InfoBar: it has to offer
                the init command as copyable text. The app shows the command and never runs
                it itself - every mutation belongs to the CLI, recorded in Activity. "Set up DefenseClaw" opens the guided first-run window, which shows
                the exact commands and runs them only after a confirm.
            -->
            <Border Style="{StaticResource DcCardCompact}"
                    Margin="0,12,0,0"
                    Visibility="{Binding ShowNotInitializedBanner, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <ctl:DcCardHeader Symbol="Warning24"
                               Tint="Amber"
                               Content="DefenseClaw is installed but not initialized" />
                    <TextBlock Style="{StaticResource DcTextSecondary}"
                               Text="{Binding NotInitializedMessage}" />
                    <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                        <ui:Button Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Appearance="Primary"
                                   Content="Set up DefenseClaw"
                                   Icon="{ctl:DcSymbolIcon ShieldCheckmark24}"
                                   AutomationProperties.HelpText="Opens guided setup. Shows the exact commands first; nothing runs until you confirm."
                                   Command="{Binding OpenFirstRunCommand}" />
                        <Border Style="{StaticResource DcCodeBlock}" VerticalAlignment="Center">
                            <TextBox Style="{StaticResource DcMonoTextBox}"
                                     AutomationProperties.Name="Initialize command"
                                     Text="defenseclaw init" />
                        </Border>
                        <ui:Button Margin="8,0,0,0"
                                   VerticalAlignment="Center"
                                   Content="Copy"
                                   Icon="{ctl:DcSymbolIcon Copy24}"
                                   AutomationProperties.Name="Copy the defenseclaw init command"
                                   Command="{Binding CopyCommandCommand}"
                                   CommandParameter="defenseclaw init" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <!--
            Sidebar. Items are added in code from Services\PanelCatalog.cs so that adding or
            replacing a panel never requires editing this file. 218 DIPs open, the Mac's sidebar (its 210 ideal column plus its list inset);
            its toggle is the title bar's (SidebarToggleButton), so the entries start right under the strip.
        -->
        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="4"
                           IsBackButtonVisible="Collapsed"
                           IsPaneToggleVisible="False"
                           OpenPaneLength="218"
                           PaneDisplayMode="Left">
            <ui:NavigationView.Resources>
                <!--
                    The items and their icons are made in code, so this is how an icon learns its section: it looks up the
                    sidebar item it sits in (Themes\DefenseClaw.xaml, DcNavIcon). Icons outside an item are untouched.
                -->
                <Style TargetType="{x:Type ui:SymbolIcon}" BasedOn="{StaticResource DcNavIcon}" />
            </ui:NavigationView.Resources>
        </ui:NavigationView>

        <!--
            Overlays. They start under the title bar so the window buttons stay usable (and cover the menu bar, the strip and
            the page), and sit last in the grid so they draw over the sidebar and the page. Each host binds to the shell
            view-model's flag; the controls themselves get their own DataContext in code.
        -->
        <Grid x:Name="PaletteHost"
              Grid.Row="1"
              Grid.RowSpan="4"
              Visibility="{Binding IsPaletteOpen, Converter={StaticResource BoolToVisibility}}">
            <shell:CommandPaletteControl x:Name="Palette" />
        </Grid>

        <Grid x:Name="ShortcutsHost"
              Grid.Row="1"
              Grid.RowSpan="4"
              Visibility="{Binding IsShortcutsOpen, Converter={StaticResource BoolToVisibility}}">
            <shell:ShortcutsOverlay x:Name="Shortcuts" />
        </Grid>

        <!--
            The Appearance flyout: a light-dismiss popup under the title-bar button, right edges aligned (placed in
            code, MainWindow.PlaceAppearanceFlyout). Esc or a click elsewhere closes it; closing with Esc puts focus back
            on the button. Choosing inside it applies at once, so it stays open while the operator tries things.
        -->
        <Popup x:Name="AppearancePopup"
               PlacementTarget="{Binding ElementName=AppearanceButton}"
               Placement="Custom"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade"
               Closed="OnAppearancePopupClosed">
            <shell:AppearanceFlyout x:Name="AppearanceFlyoutControl" />
        </Popup>
    </Grid>
</ui:FluentWindow>
