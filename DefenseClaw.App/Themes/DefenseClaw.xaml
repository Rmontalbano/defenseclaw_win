<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!--
        DefenseClaw shared design system.

        Merged into App.xaml AFTER the WPF-UI theme dictionaries, so every key below can be used from
        any panel, window or flyout with {StaticResource Dc...}. Nothing here hardcodes a text colour:
        every brush is a {DynamicResource} onto a WPF-UI / Fluent theme brush, so light and dark (and a
        live OS theme switch) are handled by ThemesDictionary, not by this file. The one deliberate
        exception is DcScrimBrush (a black veil is right in both themes).

        Voice: the prefix is Dc, then a role, never a value ("DcCard", not "DcBorder8"). Panels keep a
        local style only for a visual that exists in exactly one panel.

        =============================================================================================
        SPACING (Double / Thickness / GridLength / CornerRadius)
          DcSpaceXS 4 | DcSpaceS 8 | DcSpaceM 12 | DcSpaceL 16 | DcSpaceXL 24 | DcSpaceXXL 32
                                 The scale. Use for one-off gaps; prefer the semantic keys below.
          DcPageMargin           24,20,24,20  Margin of a panel's root Grid (also style DcPage).
          DcHeaderMargin         0,0,0,16     Space under the page header (baked into DcPageHeader).
          DcSectionGap           0,0,0,16     Bottom margin between major sections of a page.
          DcCardGap              0,0,0,12     Bottom margin between stacked cards / toolbars / banners.
          DcColumnGap            12 (GridLength) Width of the spacer column between side-by-side cards.
          DcInlineGap            0,0,8,0      Right margin between neighbouring inline items.
          DcFieldGap             0,0,0,8      Bottom margin under a label/value field (baked into DcField).
          DcFieldKeyMinWidth     130          MinWidth of the key column in a side-by-side key/value Grid.
          DcCardPadding          16           Inside a DcCard.
          DcCardPaddingCompact   12           Inside a DcCardCompact (dense card / detail pane).
          DcCardPaddingFlush     4            Inside a DcCardFlush (card that hosts a list or grid).
          DcRadiusS 4 | DcRadiusM 6 | DcRadiusL 8
                                 Corner radii: badges, chips and inner rows | code blocks | cards.
          DcMonoFontFamily       Cascadia Mono, Consolas, Courier New.

        TYPOGRAPHY (TextBlock styles; sizes in px)
          DcPageTitle            26 semibold, primary. One per page: the panel name.
          DcPageSubtitle         13, secondary, wraps. One sentence under the title.
          DcSectionHeader        16 semibold, primary. Heads a group of cards, a dialog, an empty state.
          DcCardTitle            14 semibold, primary. Heads the content of one card.
          DcBody                 14, primary, wraps. Running text.
          DcTextSecondary        14, secondary, wraps. Supporting text at body size.
          DcCaption              12, secondary, wraps. Notes, timestamps, counts, hints. (There is no
                                 tertiary style on purpose: TextFillColorTertiary is 3.3:1 on a light
                                 card, below WCAG AA. Hierarchy comes from size and weight.)
          DcMono                 12 monospace, primary, wraps. Paths, argv, ids, log lines (TextBlock).
          DcMonoTextBox          TextBox: read-only, borderless, transparent, mono, wraps, selectable,
                                 no minimum size (a one-line path is 16 tall, not 32).
                                 Use where the operator will want to copy the text.
          DcFieldLabel           12, secondary. The label of a field.
          DcFieldValue           14, primary, wraps. The value of a field.
          DcFieldValueMono       12 monospace, primary, wraps. A value that is a path/id/command.
          DcFieldLabelInline / DcFieldValueInline
                                 Label and value for the side-by-side (2-column Grid) key/value layout.
          DcColumnHeader         11 semibold, secondary, trims. Header cell of a hand-built table.
          DcValue                24 semibold, primary. Big number; tone-coloured by Tag (see TONES).
          DcTileLabel            11, secondary. The caption under a DcValue.
          DcStatusText           13, secondary, centred vertically. "Polled 22:10" beside a button.
          DcToolbarLabel         Label inside a DcToolbarPanel.

        SURFACES (Border / Grid styles)
          DcCard                 Card: padding 16, radius 8, 1px card stroke, card fill.
          DcCardCompact          Same, padding 12.
          DcCardFlush            Same, padding 4 - the host for a ListView / DataGrid / log list.
          DcSubtleRow            Inner row inside a card: inset fill, radius 4, padding 8.
          DcCodeBlock            Inset block for monospace text: inset fill, radius 6, padding 12,8.
          DcDialogCard           The confirm-dialog card that sits on a DcScrim.
          DcScrim                Full-panel Grid that dims the page behind a DcDialogCard.
          DcScrimBrush           The dimming brush itself (#99000000).

        LAYOUT
          DcPage                 Grid style: root of a panel; applies DcPageMargin.
          DcPageScroll           ScrollViewer style: vertical auto, horizontal off, room for the bar.
          DcPageHeader           HeaderedContentControl: Header = title+subtitle block, Content =
                                 right-aligned actions. Applies DcHeaderMargin.
          DcActionBar            StackPanel for the header's Content: horizontal, buttons spaced 8.
          DcToolbar              Border: the card that holds a filter/toolbar row.
          DcToolbarPanel         WrapPanel inside a DcToolbar: spaces buttons, combos, text boxes,
                                 toggles and DcToolbarLabels, and wraps at narrow widths.
          DcField                StackPanel: label above value, DcFieldGap under it.

        EMPTY STATE
          DcEmptyState           StackPanel, centred, max 480 wide.
          DcEmptyIcon            ui:SymbolIcon, 40px, muted.
          DcEmptyTitle           16 semibold, centred.
          DcEmptyDetail          13 secondary, centred, wraps.

        TONES (status colour) - one vocabulary for badges, dots, bars, tiles, values and text
          The tone is chosen by the element's Tag, so the key can come from any view-model property
          ("{Binding SeverityKey}", "{Binding ExitBadgeKey}") or be a literal (Tag="Ok").
          Tag value        Meaning                          WPF-UI palette
          Critical | Bad   critical severity / failed       SystemFillColorCritical (red)
          High | Warn     high severity / needs a look     SystemFillColorCaution (amber)
          Medium           medium severity                  SystemFillColorAttention (accent blue)
          Ok               healthy / passed / success       SystemFillColorSuccess (green)
          Low | Info | Neutral | anything else | unset       neutral grey
          DcBadge + DcBadgeText   Pill: tinted fill, tone-coloured text. Put the TextBlock inside.
          DcChip                  Neutral metadata tag (mode, connector, "stdin secret"); no tone.
          DcBadgeText             11 semibold text for DcBadge / DcChip.
          DcToneText              Semibold text coloured by tone (bare severity column).
          DcToneDot / DcToneDotLarge  10px / 12px status dot.
          DcToneBar               4px left accent bar on a row (transparent when neutral).
          DcToneTile              Stat tile: tinted fill, card stroke, min width 104.

        SHELL (added with the shell rework; safe to use anywhere)
          DcStatusStrip           Border: the always-visible one-line gateway strip under the title bar
                                  (padding 24,8, 1px rule underneath).
          DcKeyCap                Border: a keyboard shortcut in a hint, palette row or shortcuts overlay.
          DcKeyCapText            TextBlock inside a DcKeyCap (11px semibold mono, inherits the cap's colour).

        FOCUS
          DcFocusVisualStyle      Two-tone 2px ring outside the element (FocusVisualStyle=...).
          DcFocusVisualStyleInset The same ring drawn inside the bounds, for list/grid items.
          DefaultControlFocusVisualStyle / DefaultCollectionFocusVisualStyle are WPF-UI's own keys;
          they are re-pointed at the two styles above so every WPF-UI control shows the ring.
    -->

    <!-- ===== Spacing ===================================================================== -->
    <sys:Double x:Key="DcSpaceXS">4</sys:Double>
    <sys:Double x:Key="DcSpaceS">8</sys:Double>
    <sys:Double x:Key="DcSpaceM">12</sys:Double>
    <sys:Double x:Key="DcSpaceL">16</sys:Double>
    <sys:Double x:Key="DcSpaceXL">24</sys:Double>
    <sys:Double x:Key="DcSpaceXXL">32</sys:Double>

    <Thickness x:Key="DcPageMargin">24,20,24,20</Thickness>
    <Thickness x:Key="DcHeaderMargin">0,0,0,16</Thickness>
    <Thickness x:Key="DcSectionGap">0,0,0,16</Thickness>
    <Thickness x:Key="DcCardGap">0,0,0,12</Thickness>
    <GridLength x:Key="DcColumnGap">12</GridLength>
    <Thickness x:Key="DcInlineGap">0,0,8,0</Thickness>
    <Thickness x:Key="DcFieldGap">0,0,0,8</Thickness>
    <sys:Double x:Key="DcFieldKeyMinWidth">130</sys:Double>
    <Thickness x:Key="DcCardPadding">16</Thickness>
    <Thickness x:Key="DcCardPaddingCompact">12</Thickness>
    <Thickness x:Key="DcCardPaddingFlush">4</Thickness>

    <CornerRadius x:Key="DcRadiusS">4</CornerRadius>
    <CornerRadius x:Key="DcRadiusM">6</CornerRadius>
    <CornerRadius x:Key="DcRadiusL">8</CornerRadius>

    <FontFamily x:Key="DcMonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>

    <!-- The one non-theme colour: a black veil dims the page in light and dark alike. -->
    <SolidColorBrush x:Key="DcScrimBrush" Color="#99000000" />

    <!-- ===== Typography ================================================================== -->
    <Style x:Key="DcPageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="DcPageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DcSectionHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DcCardTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DcBody" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DcTextSecondary" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DcCaption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DcMono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DcMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <!-- Read-only mono text the operator can select and copy. Keeps WPF-UI's TextBox template. -->
    <Style x:Key="DcMonoTextBox" TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="FontFamily" Value="{StaticResource DcMonoFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="IsReadOnly" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <!-- WPF-UI's TextBox is at least 32 tall and 88 wide: a one-line path or command sat at the top of a
             half-empty box (and next to a caption it looked misaligned). This is text, not an input field. -->
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <!-- Bare template: WPF-UI's draws a bottom underline that reads as a stray rule in a code block. -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root"
                            Margin="-1"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="{StaticResource DcRadiusS}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource FocusStrokeColorOuterBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcFieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DcFieldValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DcFieldValueMono" TargetType="TextBlock" BasedOn="{StaticResource DcMono}" />

    <Style x:Key="DcFieldLabelInline" TargetType="TextBlock" BasedOn="{StaticResource DcFieldLabel}">
        <Setter Property="Margin" Value="0,2,12,4" />
    </Style>

    <Style x:Key="DcFieldValueInline" TargetType="TextBlock" BasedOn="{StaticResource DcFieldValue}">
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <Style x:Key="DcColumnHeader" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- Big number. Tag picks the tone: Critical|Bad, High|Warn, Medium, Ok; otherwise primary. -->
    <Style x:Key="DcValue" TargetType="TextBlock">
        <Setter Property="FontSize" Value="24" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Bad">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="High">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Medium">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Ok">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcTileLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DcStatusText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DcToolbarLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,6,8" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- ===== Surfaces ==================================================================== -->
    <Style x:Key="DcCard" TargetType="Border">
        <Setter Property="Padding" Value="{StaticResource DcCardPadding}" />
        <Setter Property="CornerRadius" Value="{StaticResource DcRadiusL}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
    </Style>

    <Style x:Key="DcCardCompact" TargetType="Border" BasedOn="{StaticResource DcCard}">
        <Setter Property="Padding" Value="{StaticResource DcCardPaddingCompact}" />
    </Style>

    <Style x:Key="DcCardFlush" TargetType="Border" BasedOn="{StaticResource DcCard}">
        <Setter Property="Padding" Value="{StaticResource DcCardPaddingFlush}" />
    </Style>

    <!-- Inset well: SolidBackgroundFillColorSecondary is darker than the card fill in both themes. -->
    <Style x:Key="DcSubtleRow" TargetType="Border">
        <Setter Property="Padding" Value="8" />
        <Setter Property="CornerRadius" Value="{StaticResource DcRadiusS}" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DcCodeBlock" TargetType="Border">
        <Setter Property="Padding" Value="12,8,12,8" />
        <Setter Property="CornerRadius" Value="{StaticResource DcRadiusM}" />
        <Setter Property="Background" Value="{DynamicResource SolidBackgroundFillColorSecondaryBrush}" />
    </Style>

    <Style x:Key="DcDialogCard" TargetType="Border">
        <Setter Property="Padding" Value="20" />
        <Setter Property="MaxWidth" Value="560" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="{StaticResource DcRadiusL}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource ApplicationBackgroundBrush}" />
    </Style>

    <Style x:Key="DcScrim" TargetType="Grid">
        <Setter Property="Background" Value="{StaticResource DcScrimBrush}" />
    </Style>

    <!-- ===== Tones (chosen by Tag) ======================================================= -->
    <Style x:Key="DcBadge" TargetType="Border">
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="CornerRadius" Value="{StaticResource DcRadiusS}" />
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Bad">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="High">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Medium">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Ok">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcChip" TargetType="Border">
        <Setter Property="Padding" Value="8,2,8,2" />
        <Setter Property="CornerRadius" Value="{StaticResource DcRadiusS}" />
        <Setter Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- No Foreground here: the text inherits its tone from the DcBadge / DcChip around it. -->
    <Style x:Key="DcBadgeText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <Style x:Key="DcToneText" TargetType="TextBlock">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Bad">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="High">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Medium">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Ok">
                <Setter Property="Foreground" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcToneDot" TargetType="Ellipse">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource SystemFillColorNeutralBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Bad">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="High">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Medium">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Ok">
                <Setter Property="Fill" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcToneDotLarge" TargetType="Ellipse" BasedOn="{StaticResource DcToneDot}">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
    </Style>

    <Style x:Key="DcToneBar" TargetType="Border">
        <Setter Property="Width" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Margin" Value="0,0,12,0" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Bad">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="High">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Medium">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Ok">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="DcToneTile" TargetType="Border">
        <Setter Property="Padding" Value="14,10,14,10" />
        <Setter Property="MinWidth" Value="104" />
        <Setter Property="CornerRadius" Value="{StaticResource DcRadiusL}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource SystemFillColorNeutralBackgroundBrush}" />
        <Style.Triggers>
            <Trigger Property="Tag" Value="Critical">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Bad">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCriticalBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="High">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Warn">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorCautionBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Medium">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorAttentionBackgroundBrush}" />
            </Trigger>
            <Trigger Property="Tag" Value="Ok">
                <Setter Property="Background" Value="{DynamicResource SystemFillColorSuccessBackgroundBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Layout ====================================================================== -->
    <Style x:Key="DcPage" TargetType="Grid">
        <Setter Property="Margin" Value="{StaticResource DcPageMargin}" />
    </Style>

    <Style x:Key="DcPageScroll" TargetType="ScrollViewer">
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="Padding" Value="0,0,8,0" />
    </Style>

    <!--
        Page header. Header = the title block, Content = the actions, e.g.
            <HeaderedContentControl Style="{StaticResource DcPageHeader}">
                <HeaderedContentControl.Header>
                    <StackPanel>
                        <TextBlock Style="{StaticResource DcPageTitle}" Text="{Binding Title}" />
                        <TextBlock Style="{StaticResource DcPageSubtitle}" Text="{Binding Description}" />
                    </StackPanel>
                </HeaderedContentControl.Header>
                <StackPanel Style="{StaticResource DcActionBar}"> ... </StackPanel>
            </HeaderedContentControl>
        With no Content the actions column collapses.
    -->
    <Style x:Key="DcPageHeader" TargetType="HeaderedContentControl">
        <Setter Property="Margin" Value="{StaticResource DcHeaderMargin}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Grid.Column="0"
                                          ContentSource="Header"
                                          VerticalAlignment="Top" />
                        <ContentPresenter x:Name="Actions"
                                          Grid.Column="1"
                                          Margin="16,0,0,0"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Top" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Actions" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Header actions. Implicit styles in Style.Resources apply to this panel's descendants only. -->
    <Style x:Key="DcActionBar" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Style.Resources>
            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
    </Style>

    <!--
        Filter / toolbar row. Card padding is 12 on every side once you count the 8-12px each child
        carries on its right and bottom, so the last item and the last wrapped row sit flush.
    -->
    <Style x:Key="DcToolbar" TargetType="Border" BasedOn="{StaticResource DcCard}">
        <Setter Property="Padding" Value="12,12,0,4" />
        <Setter Property="Margin" Value="{StaticResource DcCardGap}" />
    </Style>

    <Style x:Key="DcToolbarPanel" TargetType="WrapPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Style.Resources>
            <Style TargetType="{x:Type ui:Button}" BasedOn="{StaticResource {x:Type ui:Button}}">
                <Setter Property="Margin" Value="0,0,12,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="{x:Type ComboBox}" BasedOn="{StaticResource {x:Type ComboBox}}">
                <Setter Property="Margin" Value="0,0,12,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="{x:Type ui:TextBox}" BasedOn="{StaticResource {x:Type ui:TextBox}}">
                <Setter Property="Margin" Value="0,0,12,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="{x:Type ui:ToggleSwitch}" BasedOn="{StaticResource {x:Type ui:ToggleSwitch}}">
                <Setter Property="Margin" Value="0,0,12,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style TargetType="{x:Type CheckBox}" BasedOn="{StaticResource {x:Type CheckBox}}">
                <Setter Property="Margin" Value="0,0,12,8" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Style.Resources>
    </Style>

    <Style x:Key="DcField" TargetType="StackPanel">
        <Setter Property="Margin" Value="{StaticResource DcFieldGap}" />
    </Style>

    <!-- ===== Empty state ================================================================= -->
    <Style x:Key="DcEmptyState" TargetType="StackPanel">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="Margin" Value="24" />
    </Style>

    <Style x:Key="DcEmptyIcon" TargetType="{x:Type ui:SymbolIcon}">
        <Setter Property="FontSize" Value="40" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}" />
    </Style>

    <Style x:Key="DcEmptyTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
    </Style>

    <Style x:Key="DcEmptyDetail" TargetType="TextBlock">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Center" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
    </Style>

    <!-- ===== Shell ======================================================================= -->
    <Style x:Key="DcStatusStrip" TargetType="Border">
        <Setter Property="Padding" Value="24,8,24,8" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
    </Style>

    <!-- A shortcut key. Secondary text on a control-fill chip with a hairline: legible in both themes. -->
    <Style x:Key="DcKeyCap" TargetType="Border">
        <Setter Property="Padding" Value="6,1,6,1"/>
        <Setter Property="CornerRadius" Value="{StaticResource DcRadiusS}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="DcKeyCapText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DcMonoFontFamily}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- ===== Keyboard focus ============================================================== -->
    <!--
        Windows 11 style two-tone ring: a 2px outer stroke and a 1px inner stroke in opposing
        colours, so it reads on any card, tile or badge in either theme. The two stroke brushes are
        FocusStrokeColorOuter / Inner (white/black in dark, black/white in light).
    -->
    <Style x:Key="DcFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Rectangle Margin="-2"
                                   RadiusX="6"
                                   RadiusY="6"
                                   StrokeThickness="2"
                                   Stroke="{DynamicResource FocusStrokeColorOuterBrush}" />
                        <Rectangle Margin="-0.5"
                                   RadiusX="4"
                                   RadiusY="4"
                                   StrokeThickness="1"
                                   Stroke="{DynamicResource FocusStrokeColorInnerBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="DcFocusVisualStyleInset">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Grid SnapsToDevicePixels="True" IsHitTestVisible="False">
                        <Rectangle Margin="1"
                                   RadiusX="4"
                                   RadiusY="4"
                                   StrokeThickness="2"
                                   Stroke="{DynamicResource FocusStrokeColorOuterBrush}" />
                        <Rectangle Margin="2.5"
                                   RadiusX="3"
                                   RadiusY="3"
                                   StrokeThickness="1"
                                   Stroke="{DynamicResource FocusStrokeColorInnerBrush}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- WPF-UI's controls take their focus ring from these two keys (DynamicResource). -->
    <Style x:Key="DefaultControlFocusVisualStyle" BasedOn="{StaticResource DcFocusVisualStyle}" />
    <Style x:Key="DefaultCollectionFocusVisualStyle" BasedOn="{StaticResource DcFocusVisualStyleInset}" />
</ResourceDictionary>
