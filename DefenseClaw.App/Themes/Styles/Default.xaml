<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <!--
        Style "Default": the Fluent look the app has always had. Unlike Linear and TUI this file holds no
        colour of its own - every brush token takes its colour from the WPF-UI colour the Dc styles used before the
        token layer existed (Themes\DefenseClaw.xaml lists which), so Default is the same colours it was, in both
        modes: WPF-UI's own Light/Dark dictionary decides which, and the OS accent flows through
        AccentFillColorDefault / SystemAccentColorSecondary exactly as it did.

        A brush here copies a colour that exists at the moment the file is loaded, so it has to be loaded AFTER WPF-UI's
        theme dictionary has been swapped (and after its accent keys were written); AppearanceService does that on
        every change, which is why there is one Default file for both modes: the mode lives in WPF-UI.
        (Themes\DefenseClaw.xaml also merges a copy, so a host that only has the Dc dictionaries still resolves every
        token - with whatever WPF-UI colours exist at that moment.)

        Token vocabulary, shared by every style (see Themes\DefenseClaw.xaml for what consumes each):
          Brushes  DcWindowBackground, DcSurface (card), DcRaised (keycap, control-like), DcInset (code block,
                   subtle row), DcDialog (dialog / flyout card), DcSubtle (chip, hover), DcSelected,
                   DcZebra (the alternate row of a striped table), DcBorder (hairline), DcControlBorder,
                   DcTextPrimary/Secondary/Tertiary, DcAccent,
                   DcAccentHover, DcOnAccent, DcFocusRing (outer), DcFocusRingInner,
                   DcTone{Critical,High,Medium,Low,Ok,Neutral} and DcTone...Subtle (foreground / tinted fill),
                   DcDanger, DcDangerHover, DcOnDanger (the destructive button: fill, hover fill, label)
          Icons    DcIconBrush (default icon), DcIconMutedBrush, DcTint{Indigo,Blue,Violet,Teal,Green,Amber,Orange,Red,
                   Pink,Gray}Brush (the palette), DcSection{Overview,Observe,Govern,Discover,Setup,Updates}Brush (a card
                   header's tint) and DcNavIcon{...}Brush (the sidebar's and a page header's); DcGlyphFamily, a string:
                   Dot | Linear | Terminal, the shape set of the status and severity glyphs
          Fonts    DcUiFontFamily, DcMonoFontFamily      Size DcFontSize
          Shape    DcRadiusS/M/L, DcControlRadius, DcBarRadius, DcDotRadius (a status dot), DcFocusRadius* (doubles), DcBorderThickness
          Density  DcCardPadding, DcCardPaddingCompact, DcCardPaddingFlush
          Effect   DcFlyoutShadow
    -->

    <!-- ===== Brushes (colours of WPF-UI's) ================================================ -->
    <SolidColorBrush x:Key="DcWindowBackgroundBrush" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="DcSurfaceBrush" Color="{DynamicResource CardBackgroundFillColorDefault}" />
    <SolidColorBrush x:Key="DcRaisedBrush" Color="{DynamicResource ControlFillColorDefault}" />
    <SolidColorBrush x:Key="DcInsetBrush" Color="{DynamicResource SolidBackgroundFillColorSecondary}" />
    <SolidColorBrush x:Key="DcDialogBrush" Color="{DynamicResource ApplicationBackgroundColor}" />
    <SolidColorBrush x:Key="DcSubtleBrush" Color="{DynamicResource SubtleFillColorSecondary}" />
    <SolidColorBrush x:Key="DcSelectedBrush" Color="{DynamicResource ControlFillColorSecondary}" />
    <!-- Translucent, so the same step works on the window and on a card: 4% white in dark, 3.5% black in light. -->
    <SolidColorBrush x:Key="DcZebraBrush" Color="{DynamicResource SubtleFillColorTertiary}" />
    <SolidColorBrush x:Key="DcBorderBrush" Color="{DynamicResource CardStrokeColorDefault}" />
    <SolidColorBrush x:Key="DcControlBorderBrush" Color="{DynamicResource ControlStrokeColorDefault}" />

    <SolidColorBrush x:Key="DcTextPrimaryBrush" Color="{DynamicResource TextFillColorPrimary}" />
    <SolidColorBrush x:Key="DcTextSecondaryBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DcTextTertiaryBrush" Color="{DynamicResource TextFillColorTertiary}" />

    <SolidColorBrush x:Key="DcAccentBrush" Color="{DynamicResource AccentFillColorDefault}" />
    <SolidColorBrush x:Key="DcAccentHoverBrush" Color="{DynamicResource AccentFillColorSecondary}" />
    <SolidColorBrush x:Key="DcOnAccentBrush" Color="{DynamicResource TextOnAccentFillColorPrimary}" />

    <SolidColorBrush x:Key="DcFocusRingBrush" Color="{DynamicResource FocusStrokeColorOuter}" />
    <SolidColorBrush x:Key="DcFocusRingInnerBrush" Color="{DynamicResource FocusStrokeColorInner}" />

    <SolidColorBrush x:Key="DcToneCriticalBrush" Color="{DynamicResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="DcToneCriticalSubtleBrush" Color="{DynamicResource SystemFillColorCriticalBackground}" />
    <SolidColorBrush x:Key="DcToneHighBrush" Color="{DynamicResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="DcToneHighSubtleBrush" Color="{DynamicResource SystemFillColorCautionBackground}" />
    <!-- WPF-UI's "attention" brush is the accent's secondary step, written by its accent manager. -->
    <SolidColorBrush x:Key="DcToneMediumBrush" Color="{DynamicResource SystemAccentColorSecondary}" />
    <SolidColorBrush x:Key="DcToneMediumSubtleBrush" Color="{DynamicResource SystemFillColorAttentionBackground}" />
    <!-- WPF-UI has no cyan status colour, and this one file serves both modes: Low is a fixed teal mid-tone that clears 3:1 on the light card and the dark one alike (as the Teal tint below does). -->
    <SolidColorBrush x:Key="DcToneLowBrush" Color="#0B8FA1" />
    <SolidColorBrush x:Key="DcToneLowSubtleBrush" Color="#1A0B8FA1" />
    <SolidColorBrush x:Key="DcToneOkBrush" Color="{DynamicResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="DcToneOkSubtleBrush" Color="{DynamicResource SystemFillColorSuccessBackground}" />
    <SolidColorBrush x:Key="DcToneNeutralBrush" Color="{DynamicResource SystemFillColorNeutral}" />
    <SolidColorBrush x:Key="DcToneNeutralSubtleBrush" Color="{DynamicResource SystemFillColorNeutralBackground}" />
    <!--
        The destructive button (Appearance="Danger"): a fill, a hover / pressed fill and the label on both. WPF-UI's own is a fixed
        #F44336 under this theme's text colour at 3.2-3.7:1 in dark; these clear 4.5:1 in either mode (AppearanceContrastTests).
    -->
    <SolidColorBrush x:Key="DcDangerBrush" Color="#C62828" />
    <SolidColorBrush x:Key="DcDangerHoverBrush" Color="#B71C1C" />
    <SolidColorBrush x:Key="DcOnDangerBrush" Color="#FFFFFF" />

    <!--
        ===== Icons: restrained =====
        Icons are the secondary text colour (the muted step for the big empty-state glyphs), the sidebar and the page
        headers included; the only colour is the tint on a card header. Those tints are the one place this file holds
        colours of its own: this one file serves both modes, so each is a mid-tone that clears 3:1 on the light card
        and on the dark one alike (AppearanceContrastTests holds every one to it).
    -->
    <SolidColorBrush x:Key="DcIconBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DcIconMutedBrush" Color="{DynamicResource TextFillColorTertiary}" />

    <SolidColorBrush x:Key="DcTintIndigoBrush" Color="#6C74F0" />
    <SolidColorBrush x:Key="DcTintBlueBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="DcTintVioletBrush" Color="#8E63F2" />
    <SolidColorBrush x:Key="DcTintTealBrush" Color="#0B8FA1" />
    <SolidColorBrush x:Key="DcTintGreenBrush" Color="#17984F" />
    <SolidColorBrush x:Key="DcTintAmberBrush" Color="#B8770B" />
    <SolidColorBrush x:Key="DcTintOrangeBrush" Color="#DC560A" />
    <SolidColorBrush x:Key="DcTintRedBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DcTintPinkBrush" Color="#E0448C" />
    <SolidColorBrush x:Key="DcTintGrayBrush" Color="#7C8794" />

    <SolidColorBrush x:Key="DcSectionOverviewBrush" Color="#6C74F0" />
    <SolidColorBrush x:Key="DcSectionObserveBrush" Color="#0B8FA1" />
    <SolidColorBrush x:Key="DcSectionGovernBrush" Color="#8E63F2" />
    <SolidColorBrush x:Key="DcSectionDiscoverBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="DcSectionSetupBrush" Color="#E0448C" />
    <SolidColorBrush x:Key="DcSectionUpdatesBrush" Color="#17984F" />

    <SolidColorBrush x:Key="DcNavIconOverviewBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DcNavIconObserveBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DcNavIconGovernBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DcNavIconDiscoverBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DcNavIconSetupBrush" Color="{DynamicResource TextFillColorSecondary}" />
    <SolidColorBrush x:Key="DcNavIconUpdatesBrush" Color="{DynamicResource TextFillColorSecondary}" />

    <!-- The status glyph is the plain tone dot the app has always had, and the severity glyph draws nothing. -->
    <sys:String x:Key="DcGlyphFamily">Dot</sys:String>

    <!-- ===== Type ========================================================================= -->
    <!--
        Windows keep the system message font (what they inherit when nothing sets one) under Default: the service
        clears its window-font override rather than apply this, so a machine whose message font is not Segoe UI
        (a CJK locale) is unchanged. The value is what the other styles' UI font is measured against.
    -->
    <FontFamily x:Key="DcUiFontFamily">Segoe UI</FontFamily>
    <FontFamily x:Key="DcMonoFontFamily">Cascadia Mono, Consolas, Courier New</FontFamily>
    <sys:Double x:Key="DcFontSize">14</sys:Double>

    <!-- ===== Shape ======================================================================== -->
    <CornerRadius x:Key="DcRadiusS">4</CornerRadius>
    <CornerRadius x:Key="DcRadiusM">6</CornerRadius>
    <CornerRadius x:Key="DcRadiusL">8</CornerRadius>
    <CornerRadius x:Key="DcControlRadius">4</CornerRadius>
    <CornerRadius x:Key="DcBarRadius">2</CornerRadius>
    <!-- A status dot is round: a radius larger than the dot is wide, which Border clamps to a circle. -->
    <CornerRadius x:Key="DcDotRadius">99</CornerRadius>
    <Thickness x:Key="DcBorderThickness">1</Thickness>

    <!-- The two-tone focus ring: outer and inner stroke radii, for the ring outside an element and the inset one. -->
    <sys:Double x:Key="DcFocusRadius">6</sys:Double>
    <sys:Double x:Key="DcFocusRadiusInner">4</sys:Double>
    <sys:Double x:Key="DcFocusRadiusInset">4</sys:Double>
    <sys:Double x:Key="DcFocusRadiusInsetInner">3</sys:Double>

    <!-- ===== Density ====================================================================== -->
    <Thickness x:Key="DcCardPadding">16</Thickness>
    <Thickness x:Key="DcCardPaddingCompact">12</Thickness>
    <Thickness x:Key="DcCardPaddingFlush">4</Thickness>

    <!-- ===== Effect ======================================================================= -->
    <DropShadowEffect x:Key="DcFlyoutShadow" BlurRadius="18" ShadowDepth="2" Opacity="0.35" Color="Black" />
</ResourceDictionary>
